// DOCS/274 — anonymous classes: `new class { ... }` expressions.
// DataProviderManager singleton (private provider list with
// register/validate/count), isolation between two instances,
// immediate (unbound) calls, inheritance from a named parent
// (`extends` and `:` forms, plus MI), call arguments, interpolation
// holes (including `new class` inside a hole), and nesting.
// Exit code 0 = exact.
class Provider {
    string name;

    construct(string n) {
        this.name = n;
    }

    string describe() {
        return this.name;
    }
}

class Service {
    string title;

    construct(string t) {
        this.title = t;
    }

    string label() {
        return "service:" + this.title;
    }
}

class NamedA {
    string aval;

    construct(string v) {
        this.aval = v;
    }

    string whoA() {
        return "A:" + this.aval;
    }
}

class NamedB {
    string bval;

    construct(string v) {
        this.bval = v;
    }

    string whoB() {
        return "B:" + this.bval;
    }
}

void check(bool ok, string label) {
    if (!ok) {
        printline("FAIL " + label);
        exit(1);
    }
}

void consumeCount(int n) {
    check(n >= 0, "consume-count");
    printline(n);
}

void main() {
    var DataProviderManager = new class {
        private Provider[] providers;

        construct {
            this.providers = [];
        }

        public void register(Provider p) {
            this.providers.add(p);
        }

        public int count() {
            return this.providers.length;
        }

        public void validate() {
            if (this.providers.length == 0) {
                printline("manager: no providers");
            } else {
                printline("manager: providers ok");
            }
        }
    };
    DataProviderManager.validate();
    check(DataProviderManager.count() == 0, "manager starts empty");
    DataProviderManager.register(new Provider("alpha"));
    DataProviderManager.register(new Provider("beta"));
    printline(DataProviderManager.count());
    check(DataProviderManager.count() == 2, "manager holds two");
    DataProviderManager.validate();

    var OtherManager = new class {
        private Provider[] providers;

        construct {
            this.providers = [];
        }

        public void register(Provider p) {
            this.providers.add(p);
        }

        public int count() {
            return this.providers.length;
        }
    };
    check(OtherManager.count() == 0, "second instance starts empty");
    OtherManager.register(new Provider("solo"));
    check(OtherManager.count() == 1, "second instance holds one");
    check(DataProviderManager.count() == 2, "first instance undisturbed");

    new class {
        public void hello() {
            printline("immediate hello");
        }
    }.hello();

    int answer = new class {
        public int value() {
            return 42;
        }
    }.value();
    check(answer == 42, "immediate return");
    printline(answer);

    var Dog = new class extends Service {
        construct {
            this.title = "Rex";
        }

        public string tag() {
            return this.label() + "!";
        }
    };
    printline(Dog.label());
    check(Dog.label() == "service:Rex", "inherited method");
    check(Dog.tag() == "service:Rex!", "own method");

    var Cat = new class : Service {
        construct {
            this.title = "Tom";
        }

        public string tag() {
            return this.label() + "?";
        }
    };
    check(Cat.label() == "service:Tom", "colon parent");
    check(Cat.tag() == "service:Tom?", "colon own method");

    var Both = new class extends NamedA, NamedB {
        construct {
            this.aval = "x";
            this.bval = "y";
        }

        public string both() {
            return this.whoA() + "+" + this.whoB();
        }
    };
    check(Both.both() == "A:x+B:y", "mi both");
    check(Both.aval == "x", "mi first parent field");
    check(Both.bval == "y", "mi second parent field");

    consumeCount(DataProviderManager.count());
    consumeCount(new class {
        public int value() {
            return 3;
        }
    }.value());

    printline($"manager holds {(DataProviderManager.count())} providers");
    printline($"hole {(new class {
        public int value() {
            return 7;
        }
    }.value())} done");

    var Outer = new class {
        public int nested() {
            var Inner = new class {
                public int value() {
                    return 9;
                }
            };
            return Inner.value() + 1;
        }
    };
    check(Outer.nested() == 10, "nested anon");

    var WithDefault = new class {
        string sep;

        construct(string s = "-") {
            this.sep = s;
        }

        public string get() {
            return this.sep;
        }
    };
    check(WithDefault.get() == "-", "all-defaulted construct");

    printline("anonymous classes ok");
}
