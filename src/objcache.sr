    fn.e.bind(fmtDone);
    fn.e.movNulRdi();
    fn.e.movAxRdi();
    fn.e.fillReg(6, -40);
    fn.e.subAxRsi();
    fn.e.epilogue();
    string err = fn.e.finish();
    if (err.length > 0) { return err; }
    prog.fns.add(fn);
    return "";
}
// length, r8 = int64 value) -> rax = concat buffer with the literal bytes
// plus the %lld rendering of the value, NUL-terminated. Output is capped
// at 32767 content bytes (documented tier bound: longer inputs truncate
// rather than overrun). Integer rendering is exact manual digit extraction
// (unsigned magnitude, so INT64_MIN renders correctly), matching the
// tree-walk int64.toString() byte for byte.
private string winEmitConcatSI(WinCtx ctx, WinProg prog) {
    WinFn fn = new WinFn();
    fn.fname = "__slv_concatSI";
    fn.e.abi = ctx.abi;
    fn.e.prologue(8);
    int bufHole = fn.e.absData(7, ctx.bufAOff);
    fn.rel(bufHole, 1, 2, ctx.bufAOff, "");
    fn.e.cmpRdxImm32(32767);
    int lenOk = fn.e.lab();
    fn.e.jcc(134, lenOk);
    fn.e.movRegImm32(2, 32767);
    fn.e.bind(lenOk);
    fn.e.movRsiRcx();
    fn.e.movRcxRdx();
    fn.e.repMovsb();
    fn.e.movRegImm32(6, 32767);
    fn.e.subRsiRdx();
    fn.e.movAxR8();
    fn.e.testAxAx();
    int posVal = fn.e.lab();
    fn.e.jcc(137, posVal);
    fn.e.cmpRsi0();
    int noDash = fn.e.lab();
    fn.e.jcc(132, noDash);
    fn.e.movAlImm(45);
    fn.e.stoAlRdi();
    fn.e.incRdi();
    fn.e.decRsi();
    fn.e.bind(noDash);
    // The '-' byte above rode AL: reload the value (still intact in R8)
    // before negating, or every negative renders from magnitude 211.
    fn.e.movAxR8();
    fn.e.negAx();
    fn.e.bind(posVal);
    fn.e.movRegImm32(1, 10);
    fn.e.movRegImm32(8, 0);
    int digLoop = fn.e.lab();
    fn.e.bind(digLoop);
    fn.e.xorEdxEdx();
    fn.e.divRcx();
    fn.e.pushRdx();
    fn.e.incR8();
    fn.e.testAxAx();
    fn.e.jcc(133, digLoop);
    int digNext = fn.e.lab();
    int digDone = fn.e.lab();
    fn.e.bind(digNext);
    fn.e.testR8R8();
    fn.e.jcc(132, digDone);
    fn.e.popRax();
    fn.e.decR8();
    fn.e.cmpRsi0();
    fn.e.jcc(132, digNext);
    fn.e.addAxImm32(48);
    fn.e.stoAlRdi();
    fn.e.incRdi();
    fn.e.decRsi();
    fn.e.jmp(digNext);
    fn.e.bind(digDone);
    fn.e.movNulRdi();
    int retHole = fn.e.absData(0, ctx.bufAOff);
    fn.rel(retHole, 1, 2, ctx.bufAOff, "");
    fn.e.epilogue();
    string err = fn.e.finish();
    if (err.length > 0) { return err; }
    prog.fns.add(fn);
    return "";
}

// Emit the __slv_concatSF helper: (rcx = literal address, rdx = literal
// length, r8 = float64 bits) -> rax = concat buffer with the literal bytes
// plus the %g rendering of the value (through __slv_fmtF into the float
// buffer, then appended), NUL-terminated with the same 32767-byte cap.
private string winEmitConcatSF(WinCtx ctx, WinProg prog) {
    WinFn fn = new WinFn();
    fn.fname = "__slv_concatSF";
    fn.e.abi = ctx.abi;
    if (ctx.helperFmtF < 0) { return "string values in 'concat'"; }
    // Two frame slots shelter the cursor (rdi) and the remaining count
    // (rsi) across the __slv_fmtF call below: helpers may use the volatile
    // registers freely, but rsi/rdi are callee-saved, so the callee is
    // allowed to clobber them and the caller must spill what stays live.
    fn.e.prologue(24);
    int bufHole = fn.e.absData(7, ctx.bufAOff);
    fn.rel(bufHole, 1, 2, ctx.bufAOff, "");
    fn.e.cmpRdxImm32(32767);
    int lenOk = fn.e.lab();
    fn.e.jcc(134, lenOk);
    fn.e.movRegImm32(2, 32767);
    fn.e.bind(lenOk);
    fn.e.movRsiRcx();
    fn.e.movRcxRdx();
    fn.e.repMovsb();
    fn.e.movRegImm32(6, 32767);
    fn.e.subRsiRdx();
    fn.e.spillReg(7, -8);
    fn.e.spillReg(6, -16);
    // The float-format call rides the proven anchored pair (callSetup /
    // callTeardown, exactly like the print path's __slv_fmtF call): the
    // anchor nests (r13 stacks), the outgoing area carries the Win64
    // shadow space, and rsp is 16-aligned at the call either way.
    fn.e.callSetup(2);
    fn.e.movRcxR8();
    int fbufHole = fn.e.absData(2, ctx.bufFOff);
    fn.rel(fbufHole, 1, 2, ctx.bufFOff, "");
    int callHole = fn.e.callHole();
    fn.rel(callHole, 0, 0, ctx.helperFmtF, "");
    fn.e.callTeardown();
    fn.e.fillReg(6, -16);
    fn.e.fillReg(7, -8);
    int srcHole = fn.e.absData(8, ctx.bufFOff);
    fn.rel(srcHole, 1, 2, ctx.bufFOff, "");
    // The byte load below rides AL, so the remaining length rides RCX (a
    // full-width register this loop owns): holding it in RAX would corrupt
    // the count on the first byte and overrun the float buffer.
    fn.e.movRcxRax();
    int cpLoop = fn.e.lab();
    int cpDone = fn.e.lab();
    fn.e.bind(cpLoop);
    fn.e.testRcxRcx();
    fn.e.jcc(132, cpDone);
    fn.e.cmpRsi0();
    fn.e.jcc(132, cpDone);
    fn.e.movAlR8();
    fn.e.stoAlRdi();
    fn.e.incRdi();
    fn.e.incR8();
    fn.e.decRsi();
    fn.e.decRcx();
    fn.e.jmp(cpLoop);
    fn.e.bind(cpDone);
    fn.e.movNulRdi();
    int retHole = fn.e.absData(0, ctx.bufAOff);
    fn.rel(retHole, 1, 2, ctx.bufAOff, "");
    fn.e.epilogue();
    string err = fn.e.finish();
    if (err.length > 0) { return err; }
    prog.fns.add(fn);
    return "";
}

// Count the local declarations a body introduces (var decls plus C-for init
// decls, range-for desugared the same way) so the frame reserves them all up
// front. Slots are still assigned in encounter order during lowering.
private int winCountLocals(Node block) {
    if (block.kind == ND_VAR_DECL) { return 1; }
    if (block.kind == ND_FOR_RANGE) { return 1 + winCountLocals(block.child(2)); }
    if (block.kind == ND_FOR_C) {
        int n = 0;
        if (block.childCount() >= 4) {
            if (block.child(0).kind == ND_VAR_DECL) { n = 1; }
            n = n + winCountLocals(block.child(3));
        }
        return n;
    }
    if (block.kind == ND_IF_STMT) {
        int n = 0;
        if (block.childCount() > 1) { n = winCountLocals(block.child(1)); }
        if (block.childCount() > 2) { n = n + winCountLocals(block.child(2)); }
        return n;
    }
    if (block.kind == ND_WHILE) {
        if (block.childCount() < 2) { return 0; }
        return winCountLocals(block.child(1));
    }
    if (block.kind == ND_BLOCK) {
        int n = 0;
        for (int i = 0; i < block.childCount(); i++) { n = n + winCountLocals(block.child(i)); }
        return n;
    }
    return 0;
}

// Fill `unit` with the real lowering of one in-tier entry file: one FUNC per
// reached user function (main under the entry symbol), .rdata with the program's
// strings, UNDEF imports for printf/ExitProcess when used, and REL32/ABS64
// relocations. abi selects the calling convention (0 = Win64 for COFF,
// 1 = SysV for ELF — same ISA, same tier predicate, same loud boundary).
// Returns "" or the loud fallback reason (never a stub).
public string winLowerUnit(string filekey, int64 hash, int srcLen, int stamp, Node[] program, ObjUnit unit, int abi) {
    string reason = macTierReason(program);
    if (reason.length > 0) { return reason; }
    WinCtx ctx = new WinCtx();
    ctx.abi = abi;
    ctx.reserveBlobs();
    // Lower only the reached closure the predicate admitted above, so the
    // two can never disagree: unreached functions get no signature and no
    // .text — no lowered caller can reference them, because any reached
    // caller of their name would have pulled them into the closure.
    string[] reached = macReachableSet(program);
    for (int i = 0; i < program.length; i++) {
        Node item = program[i];
        if (item.kind == ND_FUNC) {
            if (!macNameIn(reached, item.name)) { continue; }
            Node params = item.child(0);
            string kinds = "";
            for (int pi = 0; pi < params.childCount(); pi++) {
                kinds = kinds + winScalarOf(params.child(pi).typeHint);
            }
            string ret = "v";
            if (item.typeHint != "" && item.typeHint != "void") {
                ret = winScalarOf(item.typeHint);
            }
            ctx.fnNames.add(item.name);
            ctx.fnPKinds.add(kinds);
            ctx.fnRets.add(ret);
        } else if (item.kind == ND_CONST) {
            Node v = item.child(0);
            if (v.kind == ND_INT_LIT) {
                ctx.constNames.add(item.name);
                ctx.constVals.add(v.intVal);
                ctx.constKinds.add(winScalarOf(item.typeHint));
            } else if (v.kind == ND_BOOL_LIT) {
                ctx.constNames.add(item.name);
                if (v.boolVal) { ctx.constVals.add(1); }
                else { ctx.constVals.add(0); }
                ctx.constKinds.add(winScalarOf(item.typeHint));
            } else if (v.kind == ND_CHAR_LIT) {
                ctx.constNames.add(item.name);
                int cv = v.charVal;
                ctx.constVals.add(int64(cv));
                ctx.constKinds.add(winScalarOf(item.typeHint));
            }
        }
    }
    // Native helper functions (one home per helper, called from lowered user
    // code by name through the same call machinery): __slv_timeNow serves
    // the time.now() clock read, __slv_concatSI/SF serve literal+scalar
    // string concats, __slv_fmtF formats float64 values. Registered after
    // the user signatures so helper indices follow the user functions in
    // both tables.
    ctx.fnNames.add("__slv_timeNow");
    ctx.fnPKinds.add("");
    ctx.fnRets.add("f");
    ctx.helperTimeNow = ctx.fnNames.length - 1;
    ctx.fnNames.add("__slv_concatSI");
    ctx.fnPKinds.add("iii");
    ctx.fnRets.add("i");
    ctx.helperConcatSI = ctx.fnNames.length - 1;
    ctx.fnNames.add("__slv_concatSF");
    ctx.fnPKinds.add("iii");
    ctx.fnRets.add("i");
    ctx.helperConcatSF = ctx.fnNames.length - 1;
    ctx.fnNames.add("__slv_fmtF");
    ctx.fnPKinds.add("ii");
    ctx.fnRets.add("i");
    ctx.helperFmtF = ctx.fnNames.length - 1;
    WinProg prog = new WinProg();
    for (int f = 0; f < program.length; f++) {
        Node item = program[f];
        if (item.kind == ND_FUNC) {
            if (!macNameIn(reached, item.name)) { continue; }
            int fi = ctx.findFn(item.name);
            string err = winLowerFuncInto(ctx, prog, item, fi);
            if (err.length > 0) { return err; }
        }
    }
    string helperErr = winEmitTimeNow(ctx, prog);
    if (helperErr.length > 0) { return helperErr; }
    helperErr = winEmitConcatSI(ctx, prog);
    if (helperErr.length > 0) { return helperErr; }
    helperErr = winEmitConcatSF(ctx, prog);
    if (helperErr.length > 0) { return helperErr; }
    helperErr = winEmitFmtF(ctx, prog);
    if (helperErr.length > 0) { return helperErr; }
    unit.filekey = filekey;
    unit.datab = databName(filekey);
    unit.gas = 0;
    unit.impDlls = [];
    unit.impNames = [];
    unit.undefSingles = [];
    unit.undefImports = [];
    if (ctx.usesPrintf) {
        unit.impDlls.add(ctx.printfDll());
        unit.impNames.add(ctx.printfName());
        unit.undefImports.add(0);
    }
    if (ctx.usesExit) {
        unit.undefImports.add(unit.impDlls.length);
        unit.impDlls.add(ctx.exitDll());
        unit.impNames.add(ctx.exitName());
    }
    // QPC clock pair for the __slv_timeNow helper: unconditional (mirrors
    // the ARM lowering's unconditional exit import). kernel32 is always
    // loaded, so runNative always resolves these; LINUX/MAC objects carry
    // the same note but validate only and never bind it.
    unit.undefImports.add(unit.impDlls.length);
    unit.impDlls.add("kernel32.dll");
    unit.impNames.add("QueryPerformanceFrequency");
    unit.undefImports.add(unit.impDlls.length);
    unit.impDlls.add("kernel32.dll");
    unit.impNames.add("QueryPerformanceCounter");
    ObjWriter dw = new ObjWriter();
    for (int z = 0; z < ctx.blobTotal; z++) { dw.u8(0); }
    for (int s = 0; s < ctx.strs.length; s++) {
        dw.rawStr(ctx.strs[s]);
        dw.u8(0);
    }
    unit.data = dw.out;
    unit.code = [];
    unit.defNames = [];
    unit.defOffs = [];
    unit.defSizes = [];
    unit.undefFuncs = [];
    unit.relSites = [];
    unit.relKinds = [];
    unit.relTargets = [];
    unit.relIdx = [];
    unit.relNames = [];
    for (int g = 0; g < prog.fns.length; g++) {
        WinFn wfn = prog.fns[g];
        string wname = wfn.fname;
        int base = unit.code.length;
        if (wname == "main") {
            unit.defNames.add(objInterpEntrySym(filekey, hash));
        } else {
            unit.defNames.add("__slv_fn_" + wname);
        }
        unit.defOffs.add(base);
        unit.defSizes.add(wfn.e.code.length);
        for (int c = 0; c < wfn.e.code.length; c++) { unit.code.add(wfn.e.code[c]); }
        for (int r = 0; r < wfn.rsites.length; r++) {
            int ri = wfn.ridx[r];
            if (wfn.rkinds[r] == 0 && wfn.rtgts[r] == 4 && ri < 0) {
                if (ri == -1) {
                    if (ctx.usesPrintf) { ri = 1; }
                    else { ri = 0; }
                } else if (ri == -2 || ri == -3) {
                    int qb = 0;
                    if (ctx.usesPrintf) { qb++; }
                    if (ctx.usesExit) { qb++; }
                    if (ri == -3) { qb++; }
                    ri = qb;
                } else {
                    return "unresolvable import reference in '" + wname + "'";
                }
            }
            unit.relSites.add(base + wfn.rsites[r]);
            unit.relKinds.add(wfn.rkinds[r]);
            unit.relTargets.add(wfn.rtgts[r]);
            unit.relIdx.add(ri);
            unit.relNames.add(wfn.rnames[r]);
        }
    }
    return "";
}

// ---------------------------------------------------------------------------
// mac-aarch64 REAL LOWERING (v1 object tier).
//
// AST-to-machine-code backend for the interpreter's mac-aarch64 objects:
// per-file units whose .text carries the actual compiled program logic (one
// FUNC per user function, AAPCS64 shapes throughout: 16-byte frames with
// stp prologues, x0-x7 argument registers, adrp+add data references, bl
// calls), .rdata carrying the program's real data (printf formats, string
// literals), and UNDEF externs for the note imports (libSystem.B.dylib!exit
// always, plus libSystem.B.dylib!printf when used). No stubs: anything
// outside the tier falls back LOUDLY (the reason string is the whole
// result) and no unit is produced for it.
//
// Boundary: intentionally the SAME subset the tier predicate accepts
// (macTierReason owns it — armLowerUnit re-checks it first so the two can
// never disagree). Integer/bool/char programs only: free functions (8 params
// max, no defaults), const scalars, void main() with no parameters, locals,
// assignment (plain + compound; the << form evaluates its RHS with no store,
// exactly like the interpreter and the x86-64 lowering), if/else, while,
// C-like for (range-for desugared onto it exactly like the predicate),
// break/continue, return, calls with exact arity, and print/printline of
// scalars and string literals.
//
// Semantics and code shapes mirror the silverc port's mac lowering
// (silverc/compiler/objcache.sr macLowerOwned/macEmit*, themselves mirroring
// silverc-rs src/arm64gen.rs): SP-relative frames (locals at slot*8, the
// operand stack above them in X9/X10 scratch), guarded divide/modulo (zero
// divisor prints through printf then exits 1; INT64_MIN / -1 traps with brk,
// mirroring idiv's loud hardware fault), print through the printf import
// with literal-safe formats (bools print as 1/0 and chars use %c, exactly
// like the verified tiers), and main ending in bl exit. Layouts come from
// the shared macCheckFunc, so lowering and predicate agree slot for slot.
//
// Two deliberate interpreter-scheme choices (documented, not drift):
// - Defined symbols use the entry symbol for main plus __slv_fn_<name> for
//   helpers (the port uses bare names, a linker concern). Single-file
//   interpreter units have no linker: the runner finds the entry by its
//   entry symbol regardless of program order.
// - The emitter is portable byte math (no regions); Mach-O containers stay
//   in emitMacho below. The runner never executes this path (ARM64 cannot
//   run on the x86-64 host) — validation only, with the loud boundary.
// ---------------------------------------------------------------------------

// sub Xd, Xn, #imm12 (64-bit, no shift).
private int a64SubImm(int rd, int rn, int imm12) {
    return int(0xD1000000 | ((imm12 & 0xFFF) << 10) | ((rn & 31) << 5) | (rd & 31));
}

// ldr Xt, [Xn, #off]: unsigned offset, 8-byte units (64-bit).
private int a64LdrImm(int rt, int rn, int off) {
    return int(0xF9400000 | (((off / 8) & 0xFFF) << 10) | ((rn & 31) << 5) | (rt & 31));
}

// str Xt, [Xn, #off]: unsigned offset, 8-byte units (64-bit).
private int a64StrImm(int rt, int rn, int off) {
    return int(0xF9000000 | (((off / 8) & 0xFFF) << 10) | ((rn & 31) << 5) | (rt & 31));
}

// stp Xt1, Xt2, [Xn, #off]!: pre-indexed pair store (64-bit).
private int a64StpPre(int rt1, int rt2, int rn, int off) {
    int64 q = int64(off / 8) & 0x7F;
    return int(0xA9800000 | (q << 15) | ((rt2 & 31) << 10) | ((rn & 31) << 5) | (rt1 & 31));
}

// ldp Xt1, Xt2, [Xn], #off: post-indexed pair load (64-bit).
private int a64LdpPost(int rt1, int rt2, int rn, int off) {
    int64 q = int64(off / 8) & 0x7F;
    return int(0xA8C00000 | (q << 15) | ((rt2 & 31) << 10) | ((rn & 31) << 5) | (rt1 & 31));
}

// movn Xd, #imm16, lsl #hw*16 (move inverted).
private int a64Movn(int rd, int imm16, int hw) {
    return int(0x92800000 | ((hw & 3) << 21) | ((imm16 & 0xFFFF) << 5) | (rd & 31));
}

// add Xd, Xn, Xm: shifted-register add, LSL #0 (64-bit).
private int a64AddReg(int rd, int rn, int rm) {
    return int(0x8B000000 | ((rm & 31) << 16) | ((rn & 31) << 5) | (rd & 31));
}

// sub Xd, Xn, Xm: shifted-register subtract, LSL #0 (64-bit).
private int a64SubReg(int rd, int rn, int rm) {
    return int(0xCB000000 | ((rm & 31) << 16) | ((rn & 31) << 5) | (rd & 31));
}

// mul Xd, Xn, Xm: 64-bit multiply.
private int a64Mul(int rd, int rn, int rm) {
    return int(0x9B007C00 | ((rm & 31) << 16) | ((rn & 31) << 5) | (rd & 31));
}

// cmp Xn, Xm: compare (subs XZR, Xn, Xm). Base 0xEB00001F.
private int a64CmpReg(int rn, int rm) {
    return int(3942645791 | ((rm & 31) << 16) | ((rn & 31) << 5));
}

// mov Xd, Xm: register move (orr Xd, XZR, Xm). Base 0xAA0003E0.
private int a64MovReg(int rd, int rm) {
    return int(2852127712 | ((rm & 31) << 16) | (rd & 31));
}

// b <label>: unconditional PC-relative branch.
private int a64B(int off) {
    return int(0x14000000 | ((int64(off / 4) & 0x3FFFFFF)));
}

// cbz Xt, <label>: branch if zero.
private int a64Cbz(int rt, int off) {
    return int(0xB4000000 | (((int64(off / 4) & 0x7FFFF) << 5) | (rt & 31)));
}

// cbnz Xt, <label>: branch if nonzero.
private int a64Cbnz(int rt, int off) {
    return int(0xB5000000 | (((int64(off / 4) & 0x7FFFF) << 5) | (rt & 31)));
}

// b.<cond> <label>: conditional branch (cond 0 = eq, 1 = ne, 10 = ge,
// 11 = lt, 12 = gt, 13 = le).
private int a64BCond(int cond, int off) {
    return int(0x54000000 | (((int64(off / 4) & 0x7FFFF) << 5) | (cond & 15)));
}

// ARM64 code buffer with intra-function labels. Calls and data references
// are recorded into the function (bl/data holes, resolved by symbol at unit
// finalization); jumps between labels patch here via finish() once the
// function is complete. Mirrors WinEmit's label/fixup shape in words: each
// fixup carries its base word (with the register/condition baked in) plus
// its kind (0 = b/bl 26-bit, 1 = cbz/cbnz/bcond 19-bit).
class ArmEmit {
    public prop int[] code;
    public prop int[] labPos;
    public prop int[] fixPos;
    public prop int[] fixLab;
    public prop int[] fixKind;
    public prop int[] fixBase;

    construct {
        this.code = [];
        this.labPos = [];
        this.fixPos = [];
        this.fixLab = [];
        this.fixKind = [];
        this.fixBase = [];
    }

    public void word(int w) {
        for (int i = 0; i < 4; i++) { this.code.add((w >> (i * 8)) & 0xFF); }
    }

    public int lab() {
        this.labPos.add(-1);
        return this.labPos.length - 1;
    }

    public void bind(int id) {
        this.labPos[id] = this.code.length;
    }

    private void fix(int id, int base, int kind) {
        this.word(base);
        this.fixPos.add(this.code.length - 4);
        this.fixLab.add(id);
        this.fixKind.add(kind);
        this.fixBase.add(base);
    }

    public void b(int id) {
        this.fix(id, a64B(0), 0);
    }

    public void cbz(int rt, int id) {
        this.fix(id, a64Cbz(rt, 0), 1);
    }

    public void cbnz(int rt, int id) {
        this.fix(id, a64Cbnz(rt, 0), 1);
    }

    // cond 0 = eq, 1 = ne, 10 = ge, 11 = lt, 12 = gt, 13 = le.
    public void bcond(int cond, int id) {
        this.fix(id, a64BCond(cond, 0), 1);
    }

    public string finish() {
        for (int i = 0; i < this.fixPos.length; i++) {
            int id = this.fixLab[i];
            if (id < 0 || id >= this.labPos.length || this.labPos[id] < 0) { return "unbound label"; }
            int pos = this.fixPos[i];
            int64 off = int64(this.labPos[id]) - int64(pos);
            int w = this.fixBase[i];
            if (this.fixKind[i] == 1) {
                if (off % 4 != 0 || off < -1048576 || off > 1048575) { return "branch out of range"; }
                w = w | int(((off / 4) & 0x7FFFF) << 5);
            } else {
                if (off % 4 != 0 || off < -134217728 || off > 134217727) { return "branch out of range"; }
                w = w | int((off / 4) & 0x3FFFFFF);
            }
            for (int k = 0; k < 4; k++) { this.code[pos + k] = int((w >> (k * 8)) & 0xFF); }
        }
        return "";
    }

    // Function epilogue: release the frame, restore the frame chain, return.
    public void epilogue(int frame) {
        if (frame > 0) { this.word(a64AddImm(31, 31, frame)); }
        this.word(a64LdpPost(29, 30, 31, 16));
        this.word(a64Ret(30));
    }
}

// Per-function ARM64 lowering state: the emitter, the shared layout (slots
// from macCheckFunc), the operand-stack depth, loop label stacks for
// break/continue, pending call relocations, and pending data references
// (adrp+add pairs patched with final data offsets at unit finalization).
class ArmFn {
    public prop ArmEmit e;
    public prop string fname;
    public prop int depth;
    public prop int[] brkLabs;
    public prop int[] contLabs;
    public prop int[] csites;
    public prop int[] cimported;
    public prop int[] cidx;
    public prop string[] cnames;
    public prop int[] darefAdrp;
    public prop int[] darefAdd;
    public prop int[] darefRd;
    public prop int[] darefOff;

    construct {
        this.e = new ArmEmit();
        this.fname = "";
        this.depth = 0;
        this.brkLabs = [];
        this.contLabs = [];
        this.csites = [];
        this.cimported = [];
        this.cidx = [];
        this.cnames = [];
        this.darefAdrp = [];
        this.darefAdd = [];
        this.darefRd = [];
        this.darefOff = [];
    }

    // Record a bl site: import call (imported 1, note import index in cidx)
    // or a call to a program-defined function (imported 0, ctx signature
    // index in cidx, name in cnames).
    public void callRef(int site, int imported, int idx, string name) {
        this.csites.add(site);
        this.cimported.add(imported);
        this.cidx.add(idx);
        this.cnames.add(name);
    }

    // Record an adrp+add data-reference pair against data offset off.
    public void dataRef(int adrpSite, int addSite, int rd, int off) {
        this.darefAdrp.add(adrpSite);
        this.darefAdd.add(addSite);
        this.darefRd.add(rd);
        this.darefOff.add(off);
    }
}

// Lowered-function holder: lowering appends one entry per program function
// here (prop arrays on a passed object keep growing, unlike raw array
// parameters), and the unit builder concatenates them with rebased sites.
class ArmProg {
    public prop ArmFn[] fns;

    construct {
        this.fns = [];
    }
}

// Scalar kind of an expression: 0 int, 1 bool, 2 char. Mirrors the tier
// walker's type rules (literals, const/var/param reads, operators, calls)
// so print lowering picks the format the value actually has. Assignment
// carries its RHS kind (the value eval produces); the << form evaluates its
// RHS with no store, exactly like the interpreter.
// Slot of a layout variable by name (-1 when absent). Slots are assigned
// in encounter order during lowering, exactly matching the walker's order
// in macCheckFunc, so this agrees with the predicate slot for slot.
private int macLayoutSlot(MacLayout layout, string name) {
    for (int i = 0; i < layout.varNames.length; i++) {
        if (layout.varNames[i] == name) { return layout.varSlots[i]; }
    }
    return -1;
}
private int armKindOf(MacCtx ctx, MacLayout layout, Node e) {
    if (e.kind == ND_INT_LIT) { return 0; }
    if (e.kind == ND_BOOL_LIT) { return 1; }
    if (e.kind == ND_CHAR_LIT) { return 2; }
    if (e.kind == ND_IDENT) {
        int ci = macFindConst(ctx, e.name);
        if (ci >= 0) {
            string ck = ctx.constKinds[ci];
            if (ck == "b") { return 1; }
            if (ck == "c") { return 2; }
            return 0;
        }
        int vi = macLayoutSlot(layout, e.name);
        if (vi >= 0) {
            string vk = layout.varKinds[vi];
            if (vk == "b") { return 1; }
            if (vk == "c") { return 2; }
            return 0;
        }
        return 0;
    }
    if (e.kind == ND_PAREN) {
        if (e.childCount() == 0) { return 0; }
        return armKindOf(ctx, layout, e.child(0));
    }
    if (e.kind == ND_UNARY) {
        if (e.childCount() == 0) { return 0; }
        if (e.op == UOP_NOT) { return 1; }
        return 0;
    }
    if (e.kind == ND_BINARY) {
        int op = e.op;
        if (op == OP_EQ || op == OP_NEQ || op == OP_LT || op == OP_LEQ || op == OP_GT || op == OP_GEQ || op == OP_AND || op == OP_OR) { return 1; }
        if (op == OP_MOVE) {
            if (e.childCount() < 2) { return 0; }
            return armKindOf(ctx, layout, e.child(1));
        }
        if ((op == OP_ASSIGN || op == OP_ADD_ASSIGN || op == OP_SUB_ASSIGN || op == OP_MUL_ASSIGN || op == OP_DIV_ASSIGN || op == OP_MOD_ASSIGN) && e.childCount() >= 2) {
            return armKindOf(ctx, layout, e.child(1));
        }
        return 0;
    }
    if (e.kind == ND_CALL) {
        int si = macFindSig(ctx, e.name);
        if (si >= 0) {
            string ret = ctx.sigRets[si];
            if (ret == "b") { return 1; }
            if (ret == "c") { return 2; }
        }
        return 0;
    }
    return 0;
}

// Minimal movz/movk/movn sequence materializing any 64-bit value into rd
// (mirrors the port's macMov64 exactly).
private void armMov64(ArmFn fn, int rd, int64 v) {
    int h0 = int(v & 0xFFFF);
    int h1 = int((v >> 16) & 0xFFFF);
    int h2 = int((v >> 32) & 0xFFFF);
    int h3 = int((v >> 48) & 0xFFFF);
    if (h0 == 0 && h1 == 0 && h2 == 0 && h3 == 0) {
        fn.e.word(a64Movz(rd, 0, 0));
        return;
    }
    if (h0 == 0xFFFF && h1 == 0xFFFF && h2 == 0xFFFF && h3 == 0xFFFF) {
        fn.e.word(a64Movn(rd, 0, 0));
        return;
    }
    bool first = true;
    if (h0 != 0) {
        fn.e.word(a64Movz(rd, h0, 0));
        first = false;
    }
    if (h1 != 0) {
        if (first) {
            fn.e.word(a64Movz(rd, h1, 1));
            first = false;
        } else {
            fn.e.word(a64Movk(rd, h1, 1));
        }
    }
    if (h2 != 0) {
        if (first) {
            fn.e.word(a64Movz(rd, h2, 2));
            first = false;
        } else {
            fn.e.word(a64Movk(rd, h2, 2));
        }
    }
    if (h3 != 0) {
        if (first) {
            fn.e.word(a64Movz(rd, h3, 3));
        } else {
            fn.e.word(a64Movk(rd, h3, 3));
        }
    }
}

// Operand-stack push/pop in frame slots (varSlots = layout.totalSlots -
// layout.maxDepth): values ride SP-relative slots, X9 primary with X10
// scratch, exactly like the port's macPush/macPopTo.
private void armPush(ArmFn fn, int varSlots) {
    int off = (fn.depth + varSlots) * 8;
    fn.e.word(a64StrImm(9, 31, off));
    fn.depth++;
}

private void armPopTo(ArmFn fn, int reg, int varSlots) {
    fn.depth--;
    int off = (fn.depth + varSlots) * 8;
    fn.e.word(a64LdrImm(reg, 31, off));
}

// Emit adrp+add materializing the address of unit data at dataOff into rd,
// recording the relocation pair (patched with the final offset plus
// PAGE21/PAGEOFF12 relocations at unit finalization).
private void armEmitDataAddr(ArmFn fn, int rd, int dataOff) {
    int adrpSite = fn.e.code.length;
    fn.e.word(a64Adrp(rd, 0));
    int addSite = fn.e.code.length;
    fn.e.word(a64AddImm(rd, rd, 0));
    fn.dataRef(adrpSite, addSite, rd, dataOff);
}

// Emit a bl placeholder recorded against a program-defined function
// (ctx signature index si) for the unit finalizer.
private void armEmitCallSym(ArmFn fn, int si, string name) {
    int site = fn.e.code.length;
    fn.e.word(a64Bl(0));
    fn.callRef(site, 0, si, name);
}

// Emit a bl placeholder recorded against a note import index.
private void armEmitCallImport(ArmFn fn, int importIdx) {
    int site = fn.e.code.length;
    fn.e.word(a64Bl(0));
    fn.callRef(site, 1, importIdx, "");
}

// The guarded divide/modulo trap: printf the reference text, then exit(1)
// through the real import (noreturn — the process is gone, exactly like the
// compiled binary on a fault). Import 1 is printf, import 0 is exit.
private void armEmitTrap(MacCtx ctx, ArmFn fn) {
    int ueOff = ctx.addStr("Unhandled exception\n");
    ctx.usesPrintf = true;
    armEmitDataAddr(fn, 0, ueOff);
    armEmitCallImport(fn, 1);
    fn.e.word(a64Movz(0, 1, 0));
    armEmitCallImport(fn, 0);
}

// Emit the guarded divide/modulo sequence: X9 holds the dividend and X10
// the divisor on entry; X9 holds the result on exit (X11 scratched, X0
// clobbered on the trap path only). A zero divisor takes the exact x64
// uncaught-exception path; INT64_MIN / -1 traps with brk, mirroring x64
// idiv's loud hardware fault instead of sdiv's silent wrap.
private void armEmitGuardedDivmod(MacCtx ctx, ArmFn fn, bool isMod) {
    int okZero = fn.e.lab();
    fn.e.cbnz(10, okZero);
    armEmitTrap(ctx, fn);
    fn.e.bind(okZero);
    int ok = fn.e.lab();
    fn.e.word(a64Movz(11, 32768, 3));
    fn.e.word(a64CmpReg(9, 11));
    fn.e.bcond(1, ok);
    armMov64(fn, 11, -1);
    fn.e.word(a64CmpReg(10, 11));
    fn.e.bcond(1, ok);
    fn.e.word(a64Brk(0));
    fn.e.bind(ok);
    if (isMod) {
        fn.e.word(a64Sdiv(11, 9, 10));
        fn.e.word(a64Msub(11, 11, 10, 9));
        fn.e.word(a64MovReg(9, 11));
    } else {
        fn.e.word(a64Sdiv(9, 9, 10));
    }
}

// True when every byte of s passes through printf unchanged except % (the
// caller doubles those): no NUL (it would truncate), printable ASCII only.
private bool armStrNative(string s) {
    if (s.length == 0) { return true; }
    for (int i = 0; i < s.length; i++) {
        int64 c = int64(s[i]);
        if (c < 1 || c > 127) { return false; }
    }
    return true;
}

// Lower one print/printline call (already validated by the tier predicate:
// exactly one argument, statement position). A string literal passes as the
// format itself (% escaped to %%, exactly like the port); any other scalar
// passes its value with a literal-safe format (bools print as 1/0, chars
// use %c), so native output matches the verified tiers byte for byte.
private string armLowerPrint(MacCtx ctx, MacLayout layout, ArmFn fn, Node call, bool newline) {
    Node arg = call.child(0);
    Node t = arg;
    while (t.kind == ND_PAREN && t.childCount() > 0) { t = t.child(0); }
    if (t.kind == ND_STRING_LIT) {
        string lit = t.strVal;
        if (!armStrNative(lit)) { return "unicode string literal in '" + fn.fname + "'"; }
        ObjWriter bw = new ObjWriter();
        for (int i = 0; i < lit.length; i++) {
            int64 c = int64(lit[i]);
            if (c == 37) {
                bw.u8(37);
                bw.u8(37);
            } else {
                bw.u8(c);
            }
        }
        if (newline) { bw.u8(10); }
        bw.u8(0);
        int strOff = ctx.addStrBytes(bw.out);
        ctx.usesPrintf = true;
        armEmitDataAddr(fn, 0, strOff);
        armEmitCallImport(fn, 1);
        return "";
    }
    int kind = armKindOf(ctx, layout, arg);
    string err = armLowerExpr(ctx, layout, fn, arg);
    if (err.length > 0) { return err; }
    ctx.usesPrintf = true;
    ObjWriter fw = new ObjWriter();
    if (kind == 2) {
        fw.u8(37);
        fw.u8(99);
        if (newline) { fw.u8(10); }
        fw.u8(0);
    } else if (newline) {
        fw.u8(37);
        fw.u8(108);
        fw.u8(108);
        fw.u8(100);
        fw.u8(10);
        fw.u8(0);
    } else {
        fw.u8(37);
        fw.u8(108);
        fw.u8(108);
        fw.u8(100);
        fw.u8(0);
    }
    int fmtOff = ctx.addStrBytes(fw.out);
    int varSlots = layout.totalSlots - layout.maxDepth;
    armEmitDataAddr(fn, 0, fmtOff);
    armPopTo(fn, 1, varSlots);
    armEmitCallImport(fn, 1);
    return "";
}

// Lower an expression, leaving its 64-bit value pushed at the operand
// depth. Stack-neutral per statement (depth resets at each statement, and
// call sequences use frame slots, so nested calls compose).
private string armLowerExpr(MacCtx ctx, MacLayout layout, ArmFn fn, Node e) {
    int varSlots = layout.totalSlots - layout.maxDepth;
    if (e.kind == ND_INT_LIT) {
        armMov64(fn, 9, e.intVal);
        armPush(fn, varSlots);
        return "";
    }
    if (e.kind == ND_BOOL_LIT) {
        if (e.boolVal) { armMov64(fn, 9, 1); }
        else { armMov64(fn, 9, 0); }
        armPush(fn, varSlots);
        return "";
    }
    if (e.kind == ND_CHAR_LIT) {
        int cv = e.charVal;
        armMov64(fn, 9, int64(cv));
        armPush(fn, varSlots);
        return "";
    }
    if (e.kind == ND_STRING_LIT) {
        return "string values in '" + fn.fname + "'";
    }
    if (e.kind == ND_IDENT) {
        int ci = macFindConst(ctx, e.name);
        if (ci >= 0) {
            armMov64(fn, 9, ctx.constVals[ci]);
        } else {
            int slot = macLayoutSlot(layout, e.name);
            if (slot < 0) { return "unknown variable '" + e.name + "' in '" + fn.fname + "'"; }
            fn.e.word(a64LdrImm(9, 31, slot * 8));
        }
        armPush(fn, varSlots);
        return "";
    }
    if (e.kind == ND_PAREN) {
        if (e.childCount() == 0) { return "unsupported expression in '" + fn.fname + "'"; }
        return armLowerExpr(ctx, layout, fn, e.child(0));
    }
    if (e.kind == ND_UNARY) {
        if (e.childCount() == 0) { return "unsupported expression in '" + fn.fname + "'"; }
        string uerr = armLowerExpr(ctx, layout, fn, e.child(0));
        if (uerr.length > 0) { return uerr; }
        armPopTo(fn, 9, varSlots);
        if (e.op == UOP_NEG) {
            fn.e.word(a64Movz(10, 0, 0));
            fn.e.word(a64SubReg(9, 10, 9));
            armPush(fn, varSlots);
            return "";
        }
        if (e.op == UOP_NOT) {
            int isFalse = fn.e.lab();
            int done = fn.e.lab();
            fn.e.cbnz(9, isFalse);
            fn.e.word(a64Movz(9, 1, 0));
            fn.e.b(done);
            fn.e.bind(isFalse);
            fn.e.word(a64Movz(9, 0, 0));
            fn.e.bind(done);
            armPush(fn, varSlots);
            return "";
        }
        return "unsupported unary operator in '" + fn.fname + "'";
    }
    if (e.kind == ND_BINARY) {
        return armLowerBinary(ctx, layout, fn, e);
    }
    if (e.kind == ND_CALL) {
        if (e.name == "print" || e.name == "printline") {
            return "print used as a value in '" + fn.fname + "'";
        }
        if (e.name == "exit" || e.name == "printf") {
            return "explicit '" + e.name + "' calls in '" + fn.fname + "'";
        }
        return armLowerCall(ctx, layout, fn, e);
    }
    return "unsupported expression in '" + fn.fname + "'";
}

// Binary operators. Arithmetic and comparisons evaluate lhs, then rhs, pop
// divisor-first — the reference stack-machine shape with X9 primary and
// X10 scratch. Division and modulo go through the guarded sequence (zero
// divisor and INT64_MIN / -1 trap).
private string armLowerBinary(MacCtx ctx, MacLayout layout, ArmFn fn, Node e) {
    int op = e.op;
    string cur = fn.fname;
    int varSlots = layout.totalSlots - layout.maxDepth;
    if (op == OP_ADD || op == OP_SUB || op == OP_MUL) {
        if (e.childCount() < 2) { return "unsupported expression in '" + cur + "'"; }
        string err = armLowerExpr(ctx, layout, fn, e.child(0));
        if (err.length > 0) { return err; }
        err = armLowerExpr(ctx, layout, fn, e.child(1));
        if (err.length > 0) { return err; }
        armPopTo(fn, 10, varSlots);
        armPopTo(fn, 9, varSlots);
        if (op == OP_ADD) { fn.e.word(a64AddReg(9, 9, 10)); }
        else if (op == OP_SUB) { fn.e.word(a64SubReg(9, 9, 10)); }
        else { fn.e.word(a64Mul(9, 9, 10)); }
        armPush(fn, varSlots);
        return "";
    }
    if (op == OP_DIV || op == OP_MOD) {
        if (e.childCount() < 2) { return "unsupported expression in '" + cur + "'"; }
        string derr = armLowerExpr(ctx, layout, fn, e.child(0));
        if (derr.length > 0) { return derr; }
        derr = armLowerExpr(ctx, layout, fn, e.child(1));
        if (derr.length > 0) { return derr; }
        armPopTo(fn, 10, varSlots);
        armPopTo(fn, 9, varSlots);
        if (op == OP_MOD) { armEmitGuardedDivmod(ctx, fn, true); }
        else { armEmitGuardedDivmod(ctx, fn, false); }
        armPush(fn, varSlots);
        return "";
    }
    if (op == OP_EQ || op == OP_NEQ || op == OP_LT || op == OP_LEQ || op == OP_GT || op == OP_GEQ) {
        if (e.childCount() < 2) { return "unsupported expression in '" + cur + "'"; }
        string cerr = armLowerExpr(ctx, layout, fn, e.child(0));
        if (cerr.length > 0) { return cerr; }
        cerr = armLowerExpr(ctx, layout, fn, e.child(1));
        if (cerr.length > 0) { return cerr; }
        armPopTo(fn, 10, varSlots);
        armPopTo(fn, 9, varSlots);
        fn.e.word(a64CmpReg(9, 10));
        int isTrue = fn.e.lab();
        int done = fn.e.lab();
        int cond = 10;
        if (op == OP_EQ) { cond = 0; }
        else if (op == OP_NEQ) { cond = 1; }
        else if (op == OP_LT) { cond = 11; }
        else if (op == OP_LEQ) { cond = 13; }
        else if (op == OP_GT) { cond = 12; }
        fn.e.bcond(cond, isTrue);
        fn.e.word(a64Movz(9, 0, 0));
        fn.e.b(done);
        fn.e.bind(isTrue);
        fn.e.word(a64Movz(9, 1, 0));
        fn.e.bind(done);
        armPush(fn, varSlots);
        return "";
    }
    if (op == OP_AND || op == OP_OR) {
        if (e.childCount() < 2) { return "unsupported expression in '" + cur + "'"; }
        string aerr = armLowerExpr(ctx, layout, fn, e.child(0));
        if (aerr.length > 0) { return aerr; }
        armPopTo(fn, 9, varSlots);
        int isFalse = fn.e.lab();
        int endLab = fn.e.lab();
        if (op == OP_AND) { fn.e.cbz(9, isFalse); }
        else {
            int isTrue = fn.e.lab();
            fn.e.cbnz(9, isTrue);
            aerr = armLowerExpr(ctx, layout, fn, e.child(1));
            if (aerr.length > 0) { return aerr; }
            armPopTo(fn, 9, varSlots);
            fn.e.cbnz(9, isTrue);
            fn.e.word(a64Movz(9, 0, 0));
            fn.e.b(endLab);
            fn.e.bind(isTrue);
            fn.e.word(a64Movz(9, 1, 0));
            fn.e.bind(endLab);
            armPush(fn, varSlots);
            return "";
        }
        aerr = armLowerExpr(ctx, layout, fn, e.child(1));
        if (aerr.length > 0) { return aerr; }
        armPopTo(fn, 9, varSlots);
        fn.e.cbz(9, isFalse);
        fn.e.word(a64Movz(9, 1, 0));
        fn.e.b(endLab);
        fn.e.bind(isFalse);
        fn.e.word(a64Movz(9, 0, 0));
        fn.e.bind(endLab);
        armPush(fn, varSlots);
        return "";
    }
    if (op == OP_ASSIGN || op == OP_ADD_ASSIGN || op == OP_SUB_ASSIGN || op == OP_MUL_ASSIGN || op == OP_MOVE || op == OP_DIV_ASSIGN || op == OP_MOD_ASSIGN) {
        if (e.childCount() < 2) { return "unsupported expression in '" + cur + "'"; }
        Node t = e.child(0);
        if (t.kind != ND_IDENT) { return "complex assignment targets in '" + cur + "'"; }
        int slot = macLayoutSlot(layout, t.name);
        if (slot < 0) { return "unknown variable '" + t.name + "' in '" + cur + "'"; }
        string verr = armLowerExpr(ctx, layout, fn, e.child(1));
        if (verr.length > 0) { return verr; }
        armPopTo(fn, 10, varSlots);
        // Plain assignment and the << move form both leave the RHS value in
        // X9; only plain assignment stores (the move form evaluates its RHS
        // with no store, exactly like the interpreter).
        if (op == OP_ASSIGN || op == OP_MOVE) {
            fn.e.word(a64MovReg(9, 10));
        } else if (op == OP_DIV_ASSIGN || op == OP_MOD_ASSIGN) {
            fn.e.word(a64LdrImm(9, 31, slot * 8));
            if (op == OP_MOD_ASSIGN) { armEmitGuardedDivmod(ctx, fn, true); }
            else { armEmitGuardedDivmod(ctx, fn, false); }
        } else {
            fn.e.word(a64LdrImm(9, 31, slot * 8));
            if (op == OP_ADD_ASSIGN) { fn.e.word(a64AddReg(9, 9, 10)); }
            else if (op == OP_SUB_ASSIGN) { fn.e.word(a64SubReg(9, 9, 10)); }
            else { fn.e.word(a64Mul(9, 9, 10)); }
        }
        if (op == OP_MOVE) {
            armPush(fn, varSlots);
            return "";
        }
        fn.e.word(a64StrImm(9, 31, slot * 8));
        armPush(fn, varSlots);
        return "";
    }
    return "unsupported binary operator in '" + cur + "'";
}

// Lower a call to a program-defined function (exact arity checked by the
// tier predicate). Arguments evaluate left to right onto the operand stack,
// then pop into X0.. in reverse, call, and push X0 back for value calls
// (void calls in statement position push nothing). AAPCS64 passes all 8
// tier-allowed parameters in registers, so no stack arguments exist here.
private string armLowerCall(MacCtx ctx, MacLayout layout, ArmFn fn, Node e) {
    string cur = fn.fname;
    int si = macFindSig(ctx, e.name);
    if (si < 0) { return "call to unknown function '" + e.name + "' in '" + cur + "'"; }
    string pks = ctx.sigParams[si];
    if (e.childCount() != pks.length) { return "arity mismatch calling '" + e.name + "' in '" + cur + "'"; }
    int varSlots = layout.totalSlots - layout.maxDepth;
    for (int i = 0; i < e.childCount(); i++) {
        string argErr = armLowerExpr(ctx, layout, fn, e.child(i));
        if (argErr.length > 0) { return argErr; }
    }
    for (int r = e.childCount() - 1; r >= 0; r--) {
        armPopTo(fn, r, varSlots);
    }
    armEmitCallSym(fn, si, e.name);
    string ret = ctx.sigRets[si];
    if (ret != "v") {
        fn.e.word(a64StrImm(0, 31, (fn.depth + varSlots) * 8));
        fn.depth++;
    }
    return "";
}

// Lower one statement. Value-producing positions (return) leave X0 set;
// statement calls and prints are depth-neutral by abandonment (depth
// resets at the next statement).
private string armLowerStmt(MacCtx ctx, MacLayout layout, ArmFn fn, Node s, bool isVoid, int mainEnd) {
    string cur = fn.fname;
    int varSlots = layout.totalSlots - layout.maxDepth;
    int frame = layout.frameBytes;
    fn.depth = 0;
    if (s.kind == ND_EXPR_STMT) {
        if (s.childCount() > 0) {
            Node inner = s.child(0);
            if (inner.kind == ND_CALL && (inner.name == "print" || inner.name == "printline")) {
                bool nl = inner.name == "printline";
                if (inner.childCount() != 1) { return "multi-argument print in '" + cur + "'"; }
                return armLowerPrint(ctx, layout, fn, inner, nl);
            }
            return armLowerExprAsStmt(ctx, layout, fn, inner);
        }
        return "";
    }
    if (s.kind == ND_VAR_DECL) {
        return armLowerLocalDecl(ctx, layout, fn, s);
    }
    if (s.kind == ND_RETURN) {
        if (s.childCount() == 0) {
            if (fn.fname == "main") {
                fn.e.b(mainEnd);
            } else {
                fn.e.epilogue(frame);
            }
            return "";
        }
        string rerr = armLowerExpr(ctx, layout, fn, s.child(0));
        if (rerr.length > 0) { return rerr; }
        armPopTo(fn, 0, varSlots);
        if (fn.fname == "main") {
            fn.e.b(mainEnd);
        } else {
            fn.e.epilogue(frame);
        }
        return "";
    }
    if (s.kind == ND_IF_STMT) {
        if (s.childCount() < 2) { return "unsupported statement in '" + cur + "'"; }
        string cerr = armLowerExpr(ctx, layout, fn, s.child(0));
        if (cerr.length > 0) { return cerr; }
        armPopTo(fn, 9, varSlots);
        int elseLab = fn.e.lab();
        int endLab = fn.e.lab();
        fn.e.cbz(9, elseLab);
        cerr = armLowerBlock(ctx, layout, fn, s.child(1), isVoid, mainEnd);
        if (cerr.length > 0) { return cerr; }
        fn.e.b(endLab);
        fn.e.bind(elseLab);
        if (s.childCount() > 2) {
            cerr = armLowerBlock(ctx, layout, fn, s.child(2), isVoid, mainEnd);
            if (cerr.length > 0) { return cerr; }
        }
        fn.e.bind(endLab);
        return "";
    }
    if (s.kind == ND_WHILE) {
        if (s.childCount() < 2) { return "unsupported statement in '" + cur + "'"; }
        int top = fn.e.lab();
        int endLab = fn.e.lab();
        fn.e.bind(top);
        string werr = armLowerExpr(ctx, layout, fn, s.child(0));
        if (werr.length > 0) { return werr; }
        armPopTo(fn, 9, varSlots);
        fn.e.cbz(9, endLab);
        fn.brkLabs.add(endLab);
        fn.contLabs.add(top);
        werr = armLowerBlock(ctx, layout, fn, s.child(1), isVoid, mainEnd);
        if (werr.length > 0) { return werr; }
        fn.brkLabs.pop();
        fn.contLabs.pop();
        fn.e.b(top);
        fn.e.bind(endLab);
        return "";
    }
    if (s.kind == ND_BREAK) {
        if (fn.brkLabs.length == 0) { return "break/continue outside a loop in '" + cur + "'"; }
        fn.e.b(fn.brkLabs[fn.brkLabs.length - 1]);
        return "";
    }
    if (s.kind == ND_CONTINUE) {
        if (fn.contLabs.length == 0) { return "break/continue outside a loop in '" + cur + "'"; }
        fn.e.b(fn.contLabs[fn.contLabs.length - 1]);
        return "";
    }
    if (s.kind == ND_FOR_RANGE) {
        Node desugared = winDesugarRange(s);
        return armLowerStmt(ctx, layout, fn, desugared, isVoid, mainEnd);
    }
    if (s.kind == ND_FOR_C) {
        return armLowerForC(ctx, layout, fn, s, isVoid, mainEnd);
    }
    return "unsupported statement in '" + cur + "'";
}

// An expression in statement position: calls to program functions run for
// effect, assignments store, everything else evaluates and is abandoned.
private string armLowerExprAsStmt(MacCtx ctx, MacLayout layout, ArmFn fn, Node inner) {
    string cur = fn.fname;
    if (inner.kind == ND_CALL) {
        if (inner.name == "print" || inner.name == "printline") {
            return "print used as a value in '" + cur + "'";
        }
        if (inner.name == "exit" || inner.name == "printf") {
            return "explicit '" + inner.name + "' calls in '" + cur + "'";
        }
        return armLowerCall(ctx, layout, fn, inner);
    }
    return armLowerExpr(ctx, layout, fn, inner);
}

private string armLowerLocalDecl(MacCtx ctx, MacLayout layout, ArmFn fn, Node s) {
    string cur = fn.fname;
    if (s.childCount() == 0) { return "uninitialized local '" + s.name + "' in '" + cur + "'"; }
    int kind = armKindOf(ctx, layout, s.child(0));
    string vk = "i";
    if (kind == 1) { vk = "b"; }
    else if (kind == 2) { vk = "c"; }
    if (s.typeHint != "" && s.typeHint != "var") {
        vk = macScalarOf(s.typeHint);
        if (vk.length == 0) { return "local '" + s.name + "' has non-tier type in '" + cur + "'"; }
    }
    string err = armLowerExpr(ctx, layout, fn, s.child(0));
    if (err.length > 0) { return err; }
    int varSlots = layout.totalSlots - layout.maxDepth;
    armPopTo(fn, 9, varSlots);
    int slot = macLayoutSlot(layout, s.name);
    fn.e.word(a64StrImm(9, 31, slot * 8));
    return "";
}

private string armLowerBlock(MacCtx ctx, MacLayout layout, ArmFn fn, Node block, bool isVoid, int mainEnd) {
    if (block.kind == ND_BLOCK) {
        for (int i = 0; i < block.childCount(); i++) {
            string err = armLowerStmt(ctx, layout, fn, block.child(i), isVoid, mainEnd);
            if (err.length > 0) { return err; }
        }
        return "";
    }
    return armLowerStmt(ctx, layout, fn, block, isVoid, mainEnd);
}

// C-like for: init once, then cond-check / body / update; continue runs the
// update, break leaves. Mirrors the predicate's desugar onto while.
private string armLowerForC(MacCtx ctx, MacLayout layout, ArmFn fn, Node s, bool isVoid, int mainEnd) {
    string cur = fn.fname;
    int varSlots = layout.totalSlots - layout.maxDepth;
    if (s.childCount() < 4) { return "unsupported statement in '" + cur + "'"; }
    Node init = s.child(0);
    if (init.kind == ND_VAR_DECL) {
        string derr = armLowerLocalDecl(ctx, layout, fn, init);
        if (derr.length > 0) { return derr; }
    } else if (init.kind == ND_EXPR_STMT) {
        if (init.childCount() > 0) {
            string ierr = armLowerExprAsStmt(ctx, layout, fn, init.child(0));
            if (ierr.length > 0) { return ierr; }
        }
    } else if (init.kind == ND_BINARY) {
        string berr = armLowerExpr(ctx, layout, fn, init);
        if (berr.length > 0) { return berr; }
    } else {
        return "unsupported for initializer in '" + cur + "'";
    }
    int top = fn.e.lab();
    int updLab = fn.e.lab();
    int endLab = fn.e.lab();
    fn.brkLabs.add(endLab);
    fn.contLabs.add(updLab);
    fn.e.bind(top);
    string cerr = armLowerExpr(ctx, layout, fn, s.child(1));
    if (cerr.length > 0) { return cerr; }
    armPopTo(fn, 9, varSlots);
    fn.e.cbz(9, endLab);
    cerr = armLowerBlock(ctx, layout, fn, s.child(3), isVoid, mainEnd);
    if (cerr.length > 0) { return cerr; }
    fn.brkLabs.pop();
    fn.contLabs.pop();
    fn.e.bind(updLab);
    fn.depth = 0;
    string uerr = armLowerExprAsStmt(ctx, layout, fn, s.child(2));
    if (uerr.length > 0) { return uerr; }
    fn.e.b(top);
    fn.e.bind(endLab);
    return "";
}

// Lower one function into prog: frame-chain prologue, parameter spills,
// body, then the function-end sequence (bl exit for main, epilogue
// fall-through otherwise — the port's shape).
private string armLowerFuncInto(MacCtx ctx, ArmProg prog, Node func, MacLayout layout) {
    ArmFn fn = new ArmFn();
    fn.fname = func.name;
    fn.e.word(a64StpPre(29, 30, 31, -16));
    fn.e.word(a64AddImm(29, 31, 0));
    int frame = layout.frameBytes;
    if (frame > 0) { fn.e.word(a64SubImm(31, 31, frame)); }
    Node params = func.child(0);
    for (int i = 0; i < params.childCount(); i++) {
        int slot = macLayoutSlot(layout, params.child(i).name);
        fn.e.word(a64StrImm(i, 31, slot * 8));
    }
    int mainEnd = fn.e.lab();
    bool isVoid = func.typeHint == "" || func.typeHint == "void";
    string err = armLowerBlock(ctx, layout, fn, func.child(1), isVoid, mainEnd);
    if (err.length > 0) { return err; }
    if (func.name == "main") {
        fn.e.bind(mainEnd);
        fn.e.word(a64Movz(0, 0, 0));
        armEmitCallImport(fn, 0);
        fn.e.word(a64Ret(30));
    } else {
        fn.e.epilogue(frame);
    }
    err = fn.e.finish();
    if (err.length > 0) { return err; }
    prog.fns.add(fn);
    return "";
}

// Fill `unit` with the real ARM64 lowering of one in-tier entry file: one
// FUNC per user function (main under the entry symbol), .rdata with the
// program's interned strings, UNDEF imports for exit/printf when used, and
// BRANCH26/PAGE21/PAGEOFF12 relocations. Returns "" or the loud fallback
// reason (never a stub).
public string armLowerUnit(string filekey, int64 hash, int srcLen, int stamp, Node[] program, ObjUnit unit) {
    string reason = macTierReason(program);
    if (reason.length > 0) { return reason; }
    MacCtx ctx = new MacCtx();
    // Same reached-closure rule as the Windows lowering above: unreached
    // functions get no signature and no .text, so predicate and lowering
    // agree on every entry.
    string[] reached = macReachableSet(program);
    for (int i = 0; i < program.length; i++) {
        Node item = program[i];
        if (item.kind == ND_FUNC) {
            if (!macNameIn(reached, item.name)) { continue; }
            Node params = item.child(0);
            string kinds = "";
            for (int pi = 0; pi < params.childCount(); pi++) {
                kinds = kinds + macScalarOf(params.child(pi).typeHint);
            }
            string ret = "v";
            if (item.typeHint != "" && item.typeHint != "void") {
                ret = macScalarOf(item.typeHint);
            }
            ctx.sigNames.add(item.name);
            ctx.sigParams.add(kinds);
            ctx.sigRets.add(ret);
        } else if (item.kind == ND_CONST) {
            Node v = item.child(0);
            if (v.kind == ND_INT_LIT) {
                ctx.constNames.add(item.name);
                ctx.constVals.add(v.intVal);
                ctx.constKinds.add(macScalarOf(item.typeHint));
            } else if (v.kind == ND_BOOL_LIT) {
                ctx.constNames.add(item.name);
                if (v.boolVal) { ctx.constVals.add(1); }
                else { ctx.constVals.add(0); }
                ctx.constKinds.add(macScalarOf(item.typeHint));
            } else if (v.kind == ND_CHAR_LIT) {
                ctx.constNames.add(item.name);
                int cv = v.charVal;
                ctx.constVals.add(int64(cv));
                ctx.constKinds.add(macScalarOf(item.typeHint));
            }
        }
    }
    ArmProg prog = new ArmProg();
    for (int f = 0; f < program.length; f++) {
        Node item = program[f];
        if (item.kind == ND_FUNC) {
            if (!macNameIn(reached, item.name)) { continue; }
            MacLayout layout = new MacLayout();
            string chk = macCheckFunc(ctx, item, layout);
            if (chk.length > 0) { return chk; }
            string err = armLowerFuncInto(ctx, prog, item, layout);
            if (err.length > 0) { return err; }
        }
    }
    unit.filekey = filekey;
    unit.datab = databName(filekey);
    unit.gas = 0;
    unit.impDlls = [];
    unit.impNames = [];
    // Import list: exit is always first, printf second when used (the port's
    // fixed order — every unit's note is identical for one program).
    unit.impDlls.add("/usr/lib/libSystem.B.dylib");
    unit.impNames.add("exit");
    if (ctx.usesPrintf) {
        unit.impDlls.add("/usr/lib/libSystem.B.dylib");
        unit.impNames.add("printf");
    }
    unit.undefSingles = [];
    unit.undefImports = [];
    unit.undefImports.add(0);
    if (ctx.usesPrintf) { unit.undefImports.add(1); }
    unit.data = [];
    for (int b = 0; b < ctx.idataBytes.length; b++) { unit.data.add(ctx.idataBytes[b]); }
    unit.code = [];
    unit.defNames = [];
    unit.defOffs = [];
    unit.defSizes = [];
    unit.undefFuncs = [];
    unit.relSites = [];
    unit.relKinds = [];
    unit.relTargets = [];
    unit.relIdx = [];
    unit.relNames = [];
    for (int g = 0; g < prog.fns.length; g++) {
        ArmFn wfn = prog.fns[g];
        string wname = wfn.fname;
        int base = unit.code.length;
        if (wname == "main") {
            unit.defNames.add(objInterpEntrySym(filekey, hash));
        } else {
            unit.defNames.add("__slv_fn_" + wname);
        }
        unit.defOffs.add(base);
        unit.defSizes.add(wfn.e.code.length);
        for (int c = 0; c < wfn.e.code.length; c++) { unit.code.add(wfn.e.code[c]); }
        for (int r = 0; r < wfn.csites.length; r++) {
            int site = base + wfn.csites[r];
            if (wfn.cimported[r] == 1) {
                unit.relSites.add(site);
                unit.relKinds.add(2);
                unit.relTargets.add(4);
                unit.relIdx.add(wfn.cidx[r]);
                unit.relNames.add("");
            } else {
                unit.relSites.add(site);
                unit.relKinds.add(2);
                unit.relTargets.add(0);
                unit.relIdx.add(wfn.cidx[r]);
                unit.relNames.add("");
            }
        }
        // Data references: encode the unit-relative offset into the pair
        // (page + low 12, the port's shape) and record the relocation pair
        // against the data anchor.
        for (int d = 0; d < wfn.darefAdrp.length; d++) {
            int unitOff = wfn.darefOff[d];
            int page = unitOff / 4096;
            int lo = unitOff - page * 4096;
            int rd = wfn.darefRd[d];
            int adrpSite = base + wfn.darefAdrp[d];
            int addSite = base + wfn.darefAdd[d];
            int aw = a64Adrp(rd, page);
            int dw = a64AddImm(rd, rd, lo);
            for (int k = 0; k < 4; k++) {
                unit.code[adrpSite + k] = int((aw >> (k * 8)) & 0xFF);
                unit.code[addSite + k] = int((dw >> (k * 8)) & 0xFF);
            }
            unit.relSites.add(adrpSite);
            unit.relKinds.add(3);
            unit.relTargets.add(2);
            unit.relIdx.add(unitOff);
            unit.relNames.add("");
            unit.relSites.add(addSite);
            unit.relKinds.add(4);
            unit.relTargets.add(2);
            unit.relIdx.add(unitOff);
            unit.relNames.add("");
        }
    }
    // Deterministic order: sort relocations by site (adrp/add pairs stay
    // adjacent — no other site can land between the two words — so linkers
    // pairing by adjacency keep working, exactly like the port's sort).
    for (int si = 1; si < unit.relSites.length; si++) {
        int kSite = unit.relSites[si];
        int kKind = unit.relKinds[si];
        int kTgt = unit.relTargets[si];
        int kIdx = unit.relIdx[si];
        string kName = unit.relNames[si];
        int sj = si - 1;
        while (sj >= 0 && kSite < unit.relSites[sj]) {
            unit.relSites[sj + 1] = unit.relSites[sj];
            unit.relKinds[sj + 1] = unit.relKinds[sj];
            unit.relTargets[sj + 1] = unit.relTargets[sj];
            unit.relIdx[sj + 1] = unit.relIdx[sj];
            unit.relNames[sj + 1] = unit.relNames[sj];
            sj--;
        }
        unit.relSites[sj + 1] = kSite;
        unit.relKinds[sj + 1] = kKind;
        unit.relTargets[sj + 1] = kTgt;
        unit.relIdx[sj + 1] = kIdx;
        unit.relNames[sj + 1] = kName;
    }
    return "";
}

// Internal symbol order shared by every writer (mirrors the references):
// section anchors, defined functions, the data anchor, then undefined
// symbols (functions, singletons, imports). Sizes ride alongside for the
// ELF st_size field (anchors, the datab, and undefined symbols carry 0).
private void objBuildSyms(ObjUnit unit, ObjSymTab t) {
    t.names.add(".text");
    t.sects.add(1);
    t.vals.add(0);
    t.funcs.add(0);
    t.sizes.add(0);
    t.names.add(".rdata");
    t.sects.add(2);
    t.vals.add(0);
    t.funcs.add(0);
    t.sizes.add(0);
    for (int i = 0; i < unit.defNames.length; i++) {
        t.names.add(unit.defNames[i]);
        t.sects.add(1);
        t.vals.add(unit.defOffs[i]);
        t.funcs.add(1);
        t.sizes.add(unit.defSizes[i]);
    }
    t.names.add(unit.datab);
    t.sects.add(2);
    t.vals.add(0);
    t.funcs.add(0);
    t.sizes.add(0);
    for (int i = 0; i < unit.undefFuncs.length; i++) {
        t.names.add(unit.undefFuncs[i]);
        t.sects.add(0);
        t.vals.add(0);
        t.funcs.add(1);
        t.sizes.add(0);
    }
    for (int i = 0; i < unit.undefSingles.length; i++) {
        int s = unit.undefSingles[i];
        if (s == 0) { t.names.add(objSingletonExc()); }
        else if (s == 1) { t.names.add(objSingletonTray()); }
        else { t.names.add(objSingletonGlobals()); }
        t.sects.add(0);
        t.vals.add(0);
        t.funcs.add(0);
        t.sizes.add(0);
    }
    for (int i = 0; i < unit.undefImports.length; i++) {
        t.names.add(objImportPrefix() + (string)unit.undefImports[i]);
        t.sects.add(0);
        t.vals.add(0);
        t.funcs.add(0);
        t.sizes.add(0);
    }
}

// Native symbol index for one unit reloc (mirrors the writer order above:
// 2 anchors, then defined[i], the datab, then undef tables in order).
// Returns -1 when the target has no entry (caller reports it loudly).
private int objSymIndexFor(ObjUnit unit, int tkind, int idx, string name) {
    if (tkind == 0) { return 2 + idx; }
    if (tkind == 2) { return 2 + unit.defNames.length; }
    if (tkind == 1) {
        for (int i = 0; i < unit.undefFuncs.length; i++) {
            if (unit.undefFuncs[i] == name) { return 2 + unit.defNames.length + 1 + i; }
        }
        return -1;
    }
    if (tkind == 3) {
        int base = 2 + unit.defNames.length + 1 + unit.undefFuncs.length;
        for (int i = 0; i < unit.undefSingles.length; i++) {
            if (unit.undefSingles[i] == idx) { return base + i; }
        }
        return -1;
    }
    int base2 = 2 + unit.defNames.length + 1 + unit.undefFuncs.length + unit.undefSingles.length;
    for (int i = 0; i < unit.undefImports.length; i++) {
        if (unit.undefImports[i] == idx) { return base2 + i; }
    }
    return -1;
}

// Minimal COFF relocatable object (Windows target): IMAGE_FILE_HEADER
// (Machine = AMD64) + .text (genuine machine code) + .rdata (data) +
// .slvnote (Silver note) + section/function/undefined symbols + .text
// relocations. Mirrors the reference emit_coff byte-exactly (3 sections,
// TimeDateStamp, strtab dedup, symbol classes, REL32 = 20 / ADDR64 = 1).
// Built only with byte pushes.
public int[] emitCoff(ObjUnit unit, int[] note, int stamp) {
    ObjSymTab syms = new ObjSymTab();
    objBuildSyms(unit, syms);
    string[] symNames = syms.names;
    int[] symSects = syms.sects;
    int[] symVals = syms.vals;
    int[] symFuncs = syms.funcs;
    int textPad = (unit.code.length + 3) / 4 * 4;
    int rdataPad = (unit.data.length + 3) / 4 * 4;
    int notePad = (note.length + 3) / 4 * 4;
    int textOff = 20 + 3 * 40;
    int rdataOff = textOff + textPad;
    int noteOff = rdataOff + rdataPad;
    int relocOff = noteOff + notePad;
    int symtabOff = relocOff + unit.relSites.length * 10;
    // String table for names longer than 8 bytes (deduped, like the ref).
    int[] strLens = [];
    string[] strNames = [];
    int strSize = 4;
    for (int i = 0; i < symNames.length; i++) {
        string nm = symNames[i];
        if (nm.length > 8) {
            bool seen = false;
            for (int j = 0; j < strNames.length; j++) {
                if (strNames[j] == nm) { seen = true; break; }
            }
            if (!seen) {
                strNames.add(nm);
                strLens.add(strSize);
                strSize += nm.length + 1;
            }
        }
    }
    ObjWriter w = new ObjWriter();
    // IMAGE_FILE_HEADER (20 bytes).
    w.u16(34404);
    w.u16(3);
    w.u32(stamp);
    w.u32(symtabOff);
    w.u32(symNames.length);
    w.u16(0);
    w.u16(0);
    // Section headers: .text, .rdata, .slvnote (40 bytes each).
    w.rawName(".text", 8);
    w.u32(unit.code.length);
    w.u32(0);
    w.u32(textPad);
    w.u32(textOff);
    if (unit.relSites.length > 0) { w.u32(relocOff); }
    else { w.u32(0); }
    w.u32(0);
    int nrelHdr = unit.relSites.length;
    if (nrelHdr > 65535) { nrelHdr = 65535; }
    w.u16(nrelHdr);
    w.u16(0);
    w.u32(1615855648);
    w.rawName(".rdata", 8);
    w.u32(unit.data.length);
    w.u32(0);
    w.u32(rdataPad);
    w.u32(rdataOff);
    w.u32(0);
    w.u32(0);
    w.u16(0);
    w.u16(0);
    w.u32(1073741888);
    w.rawName(".slvnote", 8);
    w.u32(note.length);
    w.u32(0);
    w.u32(notePad);
    w.u32(noteOff);
    w.u32(0);
    w.u32(0);
    w.u16(0);
    w.u16(0);
    w.u32(1073741888);
    // Raw data.
    w.rawPad(unit.code, textPad);
    w.rawPad(unit.data, rdataPad);
    w.rawPad(note, notePad);
    // Relocations (sorted by site for determinism).
    for (int i = 0; i < unit.relSites.length; i++) {
        int symidx = objSymIndexFor(unit, unit.relTargets[i], unit.relIdx[i], unit.relNames[i]);
        int rtype = 20;
        if (unit.relKinds[i] == 1) { rtype = 1; }
        w.u32(unit.relSites[i]);
        w.u32(symidx);
        w.u16(rtype);
    }
    // Symbol table (18 bytes each, no aux symbols).
    for (int i = 0; i < symNames.length; i++) {
        string nm = symNames[i];
        if (nm.length > 8) {
            int off = 0;
            for (int j = 0; j < strNames.length; j++) {
                if (strNames[j] == nm) { off = strLens[j]; break; }
            }
            w.u32(0);
            w.u32(off);
        } else {
            w.rawName(nm, 8);
        }
        w.u32(symVals[i]);
        w.u16(symSects[i]);
        int stype = 0;
        if (i >= 2) {
            if (symSects[i] == 0) {
                if (symFuncs[i] == 1) { stype = 32; }
            } else if (symFuncs[i] == 1) {
                stype = 32;
            }
        }
        w.u16(stype);
        if (i < 2) { w.u8(3); }
        else { w.u8(2); }
        w.u8(0);
    }
    w.u32(strSize);
    for (int i = 0; i < strNames.length; i++) {
        w.rawStr(strNames[i]);
        w.u8(0);
    }
    return w.out;
}

// Minimal ELF relocatable object (Linux target): ELF64 header (ET_REL,
// EM_X86_64) + .text (genuine machine code) + .rdata (data) + .slvnote
// (Silver note) + .shstrtab + .symtab + .strtab + .rela.text + .rela.data.
// Mirrors the reference emit_elf_rel byte-exactly (9 section headers, null +
// SECTION + GLOBAL syms, R_X86_64_64 = 1 / R_X86_64_PC32 = 2 relas with the
// written symbol index shifted by one for the leading null entry). Built
// only with byte pushes.
//
// .rela.data is always size-0: .rdata carries no pointers by construction,
// so no data-section relocation can exist. The section is still emitted
// (with the .symtab link, the .rdata info, alignment, and entry size) so
// every object carries the full relocation-section pair; the reader treats
// a non-empty .rela.data as corruption (loud, never silently ignored).
public int[] emitElf(ObjUnit unit, int[] note) {
    ObjSymTab syms = new ObjSymTab();
    objBuildSyms(unit, syms);
    // Section names and their offsets in .shstrtab.
    string[] secNames = [".text", ".rdata", ".slvnote", ".shstrtab", ".symtab", ".strtab", ".rela.text", ".rela.data"];
    ObjWriter sw = new ObjWriter();
    sw.u8(0);
    int[] nameOff = [];
    for (int i = 0; i < secNames.length; i++) {
        nameOff.add(sw.out.length);
        sw.rawStr(secNames[i]);
        sw.u8(0);
    }
    int[] shstr = sw.out;
    // Symbol names into .strtab (the null entry and section symbols use
    // st_name 0). Written order: null, SECTION .text, SECTION .rdata,
    // datab (GLOBAL OBJECT), defined FUNCs, undefined symbols.
    ObjWriter tw = new ObjWriter();
    tw.u8(0);
    int[] symNameOff = [];
    symNameOff.add(0);
    for (int i = 0; i < syms.names.length; i++) {
        if (i < 2) {
            symNameOff.add(0);
        } else {
            symNameOff.add(tw.out.length);
            tw.rawStr(syms.names[i]);
            tw.u8(0);
        }
    }
    int[] strtab = tw.out;
    int nsymsWritten = syms.names.length + 1;
    int textOff = 64;
    int rdataOff = textOff + unit.code.length;
    int noteOff = rdataOff + unit.data.length;
    int shstrOff = noteOff + note.length;
    int symOff = shstrOff + shstr.length;
    while (symOff % 8 != 0) { symOff++; }
    int strOff = symOff + nsymsWritten * 24;
    int relaOff = strOff + strtab.length;
    int relaLen = unit.relSites.length * 24;
    int shoff = relaOff + relaLen;
    while (shoff % 8 != 0) { shoff++; }
    ObjWriter w = new ObjWriter();
    // ELF header (64 bytes).
    w.u8(127);
    w.rawStr("ELF");
    w.u8(2);
    w.u8(1);
    w.u8(1);
    w.u8(0);
    for (int pi = 0; pi < 8; pi++) { w.u8(0); }
    w.u16(1);
    w.u16(62);
    w.u32(1);
    w.u64(0);
    w.u64(0);
    w.u64(shoff);
    w.u32(0);
    w.u16(64);
    w.u16(0);
    w.u16(0);
    w.u16(64);
    w.u16(9);
    w.u16(4);
    w.rawBytes(unit.code);
    w.rawBytes(unit.data);
    w.rawBytes(note);
    w.rawBytes(shstr);
    while (w.out.length < symOff) { w.u8(0); }
    // .symtab (24 bytes each): null, SECTION .text, SECTION .rdata, the
    // datab (GLOBAL OBJECT), defined FUNCs, undefined symbols.
    for (int zi = 0; zi < 24; zi++) { w.u8(0); }
    for (int i = 0; i < syms.names.length; i++) {
        int sect = syms.sects[i];
        int isFunc = syms.funcs[i];
        int bind = 0;
        int typ = 3;
        if (i >= 2) {
            if (sect == 0) {
                bind = 1;
                if (isFunc == 1) { typ = 2; }
                else { typ = 0; }
            } else if (isFunc == 1) {
                bind = 1;
                typ = 2;
            } else {
                bind = 1;
                typ = 1;
            }
        }
        int shndx = 0;
        if (sect == 1) { shndx = 1; }
        else if (sect == 2) { shndx = 2; }
        w.u32(symNameOff[i + 1]);
        w.u8(bind * 16 + typ);
        w.u8(0);
        w.u16(shndx);
        w.u64(syms.vals[i]);
        w.u64(syms.sizes[i]);
    }
    w.rawBytes(strtab);
    // .rela.text (24 bytes each, sorted by site): Rel32 calls become
    // R_X86_64_PC32, Abs64 addresses R_X86_64_64. Written symbol indices
    // shift by one for the leading null entry. The ABS64 addend rides the
    // entry read back out of the site bytes the emitter wrote (data offsets;
    // zero everywhere else), so raw inspection and RELA agree.
    for (int i = 0; i < unit.relSites.length; i++) {
        int symidx = objSymIndexFor(unit, unit.relTargets[i], unit.relIdx[i], unit.relNames[i]);
        int rtype = 2;
        int64 addend = 0;
        if (unit.relKinds[i] == 1) {
            rtype = 1;
            for (int b = 0; b < 8; b++) {
                addend = addend | (int64(unit.code[unit.relSites[i] + b] & 0xFF) << (b * 8));
            }
        }
        w.u64(unit.relSites[i]);
        w.u64((int64(symidx + 1) << 32) | int64(rtype));
        w.u64(addend);
    }
    while (w.out.length < shoff) { w.u8(0); }
    // Section headers (64 bytes each): NULL, .text, .rdata, .slvnote,
    // .shstrtab, .symtab, .strtab, .rela.text, .rela.data.
    w.sh(0, 0, 0, 0, 0, 0, 0, 0, 0);
    w.sh(nameOff[0], 1, 6, textOff, unit.code.length, 0, 0, 16, 0);
    w.sh(nameOff[1], 1, 2, rdataOff, unit.data.length, 0, 0, 1, 0);
    w.sh(nameOff[2], 1, 0, noteOff, note.length, 0, 0, 1, 0);
    w.sh(nameOff[3], 3, 0, shstrOff, shstr.length, 0, 0, 1, 0);
    w.sh(nameOff[4], 2, 0, symOff, nsymsWritten * 24, 6, 3, 8, 24);
    w.sh(nameOff[5], 3, 0, strOff, strtab.length, 0, 0, 1, 0);
    w.sh(nameOff[6], 4, 0, relaOff, relaLen, 5, 1, 8, 24);
    // .rela.data is size-0 by construction (see above); sh_info still names
    // .rdata (index 2) and sh_link the .symtab (index 5).
    w.sh(nameOff[7], 4, 0, relaOff + relaLen, 0, 5, 2, 8, 24);
    return w.out;
}

// Minimal Mach-O object (Mac target): mach_header_64 (ARM64, MH_OBJECT) +
// LC_SEGMENT_64 (__TEXT with __text, __rdata and __slvnote sections) +
// LC_SYMTAB + LC_DYSYMTAB + section relocations. Byte-compatible with the
// reference emit_macho_object (same order, same values), so objects
// interoperate across compilers. Built only with byte pushes.
//
// The symbol table is genuine: two non-extern section anchors (__text,
// __rdata), one defined FUNC symbol per lowered function owned by the file,
// the global data-anchor symbol (offset 0 in __rdata), and UNDEF entries
// for every cross-unit reference (imports, and the retired runner seam on
// stub-era objects). Relocations cover the bl calls
// (ARM64_RELOC_BRANCH26) and the adrp+add data pairs
// (ARM64_RELOC_PAGE21 / ARM64_RELOC_PAGEOFF12).
public int[] emitMacho(ObjUnit unit, int[] note) {
    // ARM64 reloc types (mach-o/reloc.h): BRANCH26=2, PAGE21=3, PAGEOFF12=4.
    ObjSymTab syms = new ObjSymTab();
    objBuildSyms(unit, syms);
    int segCmdSize = 72 + 3 * 80;
    int sizeOfCmds = segCmdSize + 24 + 80;
    int textOff = 32 + sizeOfCmds;
    int rdataOff = textOff + unit.code.length;
    int noteOff = rdataOff + unit.data.length;
    int relOff = noteOff + note.length;
    int relLen = unit.relSites.length * 8;
    int symOff = relOff + relLen;
    // nlist order: the two section anchors, the data anchor, defined
    // funcs, then undefined functions, singletons, and imports. The
    // string table lives in a holder object, not a raw array parameter:
    // arrays received as parameters silently stop growing past 8 entries
    // in this toolchain, while prop arrays on a passed object keep
    // growing (see ObjSymTab above).
    MacStrtab stab = new MacStrtab();
    int[] nStrx = [];
    int[] nType = [];
    int[] nSect = [];
    int64[] nValue = [];
    // Map internal sym index -> nlist index (section anchors ARE entries
    // here, so every internal index maps).
    int[] nlistOf = [];
    for (int i = 0; i < syms.names.length; i++) { nlistOf.add(0); }
    nlistOf[0] = 0;
    nStrx.add(stab.add("__text"));
    nType.add(14);
    nSect.add(1);
    nValue.add(0);
    nlistOf[1] = 1;
    nStrx.add(stab.add("__rdata"));
    nType.add(14);
    nSect.add(2);
    nValue.add(0);
    nlistOf[symsDatabIdx(unit)] = nStrx.length;
    nStrx.add(stab.add(unit.datab));
    nType.add(15);
    nSect.add(2);
    nValue.add(0);
    for (int d = 0; d < unit.defNames.length; d++) {
        int symIdx = 2 + d;
        nlistOf[symIdx] = nStrx.length;
        string dnm = unit.defNames[d];
        nStrx.add(stab.add(dnm));
        nType.add(15);
        nSect.add(1);
        int doff = unit.defOffs[d];
        nValue.add(doff);
    }
    for (int f = 0; f < unit.undefFuncs.length; f++) {
        int symIdx = 2 + unit.defNames.length + 1 + f;
        nlistOf[symIdx] = nStrx.length;
        string ufnm = unit.undefFuncs[f];
        nStrx.add(stab.add(ufnm));
        nType.add(1);
        nSect.add(0);
        nValue.add(0);
    }
    for (int q = 0; q < unit.undefSingles.length; q++) {
        int symIdx = 2 + unit.defNames.length + 1 + unit.undefFuncs.length + q;
        nlistOf[symIdx] = nStrx.length;
        string snm = objSingletonGlobals();
        if (unit.undefSingles[q] == 0) { snm = objSingletonExc(); }
        else if (unit.undefSingles[q] == 1) { snm = objSingletonTray(); }
        nStrx.add(stab.add(snm));
        nType.add(1);
        nSect.add(0);
        nValue.add(0);
    }
    for (int v = 0; v < unit.undefImports.length; v++) {
        int symIdx = 2 + unit.defNames.length + 1 + unit.undefFuncs.length + unit.undefSingles.length + v;
        nlistOf[symIdx] = nStrx.length;
        nStrx.add(stab.add(objImportPrefix() + (string)unit.undefImports[v]));
        nType.add(1);
        nSect.add(0);
        nValue.add(0);
    }
    int strOff = symOff + nStrx.length * 16;
    // Dysymtab ranges over the table above: 2 local anchors, then
    // 1 + defined external definitions (datab + funcs), then undefineds.
    int nlocal = 2;
    int nextdef = 1 + unit.defNames.length;
    int nundef = unit.undefFuncs.length + unit.undefSingles.length + unit.undefImports.length;
    ObjWriter w = new ObjWriter();
    // mach_header_64 (32 bytes).
    // MH_MAGIC_64 0xFEEDFACF.
    w.u32(int(4277009103));
    w.u32(int(0x0100000C));
    w.u32(0);
    w.u32(1);
    w.u32(3);
    w.u32(sizeOfCmds);
    w.u32(0);
    w.u32(0);
    // LC_SEGMENT_64 + 3 sections.
    w.u32(int(0x19));
    w.u32(segCmdSize);
    w.rawName("__TEXT", 16);
    w.u64(0);
    w.u64(unit.code.length + unit.data.length + note.length);
    w.u64(textOff);
    w.u64(unit.code.length + unit.data.length + note.length);
    w.u32(7);
    w.u32(5);
    w.u32(3);
    w.u32(0);
    // Section 1: __text.
    w.rawName("__text", 16);
    w.rawName("__TEXT", 16);
    w.u64(0);
    w.u64(unit.code.length);
    w.u32(textOff);
    w.u32(2);
    if (unit.relSites.length > 0) { w.u32(relOff); }
    else { w.u32(0); }
    w.u32(unit.relSites.length);
    w.u32(int(0x80000400));
    w.u32(0);
    w.u32(0);
    w.u32(0);
    // Section 2: __rdata.
    w.rawName("__rdata", 16);
    w.rawName("__TEXT", 16);
    w.u64(0);
    w.u64(unit.data.length);
    w.u32(rdataOff);
    w.u32(0);
    w.u32(0);
    w.u32(0);
    w.u32(0);
    w.u32(0);
    w.u32(0);
    w.u32(0);
    // Section 3: __slvnote.
    w.rawName("__slvnote", 16);
    w.rawName("__TEXT", 16);
    w.u64(0);
    w.u64(note.length);
    w.u32(noteOff);
    w.u32(0);
    w.u32(0);
    w.u32(0);
    w.u32(0);
    w.u32(0);
    w.u32(0);
    w.u32(0);
    // LC_SYMTAB.
    w.u32(2);
    w.u32(24);
    w.u32(symOff);
    w.u32(nStrx.length);
    w.u32(strOff);
    w.u32(stab.buf.length);
    // LC_DYSYMTAB (local anchors, external definitions, undefineds).
    w.u32(int(0xB));
    w.u32(80);
    w.u32(0);
    w.u32(nlocal);
    w.u32(nlocal);
    w.u32(nextdef);
    w.u32(nlocal + nextdef);
    w.u32(nundef);
    for (int z = 0; z < 12; z++) { w.u32(0); }
    w.rawBytes(unit.code);
    w.rawBytes(unit.data);
    w.rawBytes(note);
    // Relocation entries (8 bytes): r_address + packed
    // (symbolnum[24] | pcrel[1] | length[2] | extern[1] | type[4]).
    for (int i = 0; i < unit.relSites.length; i++) {
        int rsite = unit.relSites[i];
        int rkind = unit.relKinds[i];
        int rtarget = unit.relTargets[i];
        int ridx = unit.relIdx[i];
        string rname = unit.relNames[i];
        int symidx = objSymIndexFor(unit, rtarget, ridx, rname);
        int rtype = 2;
        if (rkind == 3) { rtype = 3; }
        else if (rkind == 4) { rtype = 4; }
        else if (rkind != 2) {
            printline("object cache: x86 relocation in a Mach-O object");
            exit(1);
        }
        int ni = nlistOf[symidx];
        int packed = ni | (1 << 24) | (2 << 25) | (1 << 27) | (rtype << 28);
        w.u32(rsite);
        w.u32(packed);
    }
    // nlist_64 entries (16 bytes).
    for (int i = 0; i < nStrx.length; i++) {
        int sx = nStrx[i];
        int nt = nType[i];
        int ns = nSect[i];
        int64 nv = nValue[i];
        w.u32(sx);
        w.u8(nt);
        w.u8(ns);
        w.u16(0);
        w.u64(nv);
    }
    w.rawBytes(stab.buf);
    return w.out;
}

// String-table builder on a holder object (see the note at the stab site:
// raw array parameters stop growing past 8 entries; prop arrays keep
// growing).
class MacStrtab {
    public prop int[] buf;

    construct {
        this.buf = [];
        this.buf.add(0);
    }

    // Append a NUL-terminated name, returning its offset.
    public int add(string name) {
        int off = this.buf.length;
        for (int i = 0; i < name.length; i++) {
            int c = name[i];
            this.buf.add(c);
        }
        this.buf.add(0);
        return off;
    }
}

// Internal symbol index of the data anchor (see objBuildSyms order:
// 2 anchors, then defined funcs, then the datab).
private int symsDatabIdx(ObjUnit unit) {
    return 2 + unit.defNames.length;
}

// Serialize one interpreter-built unit for the session target: the proper
// relocatable container per target with genuine .text machine code,
// .rdata, .slvnote, symbol table, and relocations.
public int[] emitObject(ObjUnit unit, string flags, int64 hash, int stamp, string targetOs) {
    int[] note = objEncodeNote(unit, flags, hash, stamp);
    if (targetOs == "LINUX") { return emitElf(unit, note); }
    if (targetOs == "MAC") { return emitMacho(unit, note); }
    return emitCoff(unit, note, stamp);
}

// True when the unit exceeds the v1 boundary (COFF section limit): the
// session skips emission and the driver keeps running from the verified
// AST/bytecode tiers (loud fallback, never a silent mislink). Real units
// carry a relocation per call site, so this is defensive only.
public bool objTooManyRelocs(ObjUnit unit) {
    return unit.relSites.length >= 65535;
}

// Silver object note (v5): SLVOBJ3 + flag-set string + source FNV-1 hash +
// emission stamp + globals-block size + import list + owner file key.
// Mirrors the reference encode_note byte-exactly (the interpreter always
// records gas 0 and an empty import list — the shape stays exact).
public int[] objEncodeNote(ObjUnit unit, string flags, int64 srcHash, int stamp) {
    ObjWriter w = new ObjWriter();
    w.rawStr("SLVOBJ3");
    w.strField(flags);
    w.u64(srcHash);
    w.u64(stamp);
    w.u64(unit.gas);
    w.u32(unit.impDlls.length);
    for (int i = 0; i < unit.impDlls.length; i++) {
        w.strField(unit.impDlls[i]);
        w.strField(unit.impNames[i]);
    }
    w.strField(unit.filekey);
    return w.out;
}

// Decode one note span into note. Returns "" when valid, else the exact
// reference error. A v4-era (SLVOBJ2) note fails here and the planner
// treats the object as stale — never a hard error.
private string objDecodeNote(ObjReader r, int noteOff, int noteLen, ObjNote note) {
    string badNote = "object cache: corrupt Silver note section";
    if (noteOff < 0 || noteLen <= 0 || noteOff + noteLen > r.size) { return badNote; }
    if (r.bytesAt(noteOff, 7) != "SLVOBJ3") { return badNote; }
    int pos = noteOff + 7;
    int flagLen = int(r.u32At(pos));
    pos += 4;
    if (flagLen < 0 || pos + flagLen + 8 + 8 + 8 + 4 > noteOff + noteLen) { return badNote; }
    note.flags = r.bytesAt(pos, flagLen);
    pos += flagLen;
    note.hash = r.u64At(pos);
    pos += 8;
    note.stamp = int(r.u64At(pos));
    pos += 8;
    note.gas = int(r.u64At(pos));
    pos += 8;
    int importCount = int(r.u32At(pos));
    pos += 4;
    if (importCount < 0 || importCount > 1000000) { return badNote; }
    note.impDlls = [];
    note.impNames = [];
    for (int i = 0; i < importCount; i++) {
        int dllLen = int(r.u32At(pos));
        pos += 4;
        if (dllLen < 0 || pos + dllLen > noteOff + noteLen) { return badNote; }
        string dll = r.bytesAt(pos, dllLen);
        pos += dllLen;
        int nameLen = int(r.u32At(pos));
        pos += 4;
        if (nameLen < 0 || pos + nameLen > noteOff + noteLen) { return badNote; }
        string nm = r.bytesAt(pos, nameLen);
        pos += nameLen;
        note.impDlls.add(dll);
        note.impNames.add(nm);
    }
    int keyLen = int(r.u32At(pos));
    pos += 4;
    if (keyLen < 0 || pos + keyLen > noteOff + noteLen) { return badNote; }
    note.filekey = r.bytesAt(pos, keyLen);
    return "";
}

// NUL-terminated name inside a string-table span.
private string objCStr(ObjReader r, int strOff, int strSize, int nameOff) {
    string[] parts = [];
    int p = strOff + nameOff;
    while (p < strOff + strSize) {
        int64 b = r.u8At(p);
        if (b < 0) { return ""; }
        if (b == 0) { break; }
        parts.add((string)char(int(b)));
        p++;
    }
    return parts.join("");
}

// Split a COFF object into its section spans: out holds
// [textOff, textLen, rdataOff, rdataLen, noteOff, noteLen].
// Returns "" on success, else the exact reference error. Sections match by
// name (like the reference split_coff): Machine must be AMD64 with exactly
// 3 sections and no optional header; VirtualSize is the exact data length
// while SizeOfRawData includes up-to-4 alignment padding.
private string objSplitCoff(ObjReader r, int[] out) {
    string bad = "object cache: corrupt COFF object";
    if (r.size < 20) { return bad; }
    if (int(r.u16At(0)) != 34404) { return bad; }
    if (int(r.u16At(2)) != 3 || int(r.u16At(16)) != 0) { return bad; }
    int textOff = -1;
    int textLen = 0;
    int rdataOff = -1;
    int rdataLen = 0;
    int noteOff = -1;
    int noteLen = 0;
    for (int i = 0; i < 3; i++) {
        int base = 20 + i * 40;
        string sname = r.bytesAt(base, 8);
        int vsize = int(r.u32At(base + 8));
        int rawsize = int(r.u32At(base + 16));
        int raw = int(r.u32At(base + 20));
        if (vsize < 0 || rawsize < 0 || raw < 0 || vsize > rawsize || raw + vsize > r.size) { return bad; }
        if (sname.startsWith(".text")) { textOff = raw; textLen = vsize; }
        else if (sname.startsWith(".rdata")) { rdataOff = raw; rdataLen = vsize; }
        else if (sname.startsWith(".slvnote")) { noteOff = raw; noteLen = vsize; }
    }
    if (textOff < 0 || rdataOff < 0 || noteOff < 0) { return bad; }
    out.add(textOff);
    out.add(textLen);
    out.add(rdataOff);
    out.add(rdataLen);
    out.add(noteOff);
    out.add(noteLen);
    return "";
}

// Split an ELF relocatable object into its section spans: out holds
// [textOff, textLen, rdataOff, rdataLen, noteOff, noteLen].
// Returns "" on success, else the exact reference error.
private string objSplitElf(ObjReader r, int[] out) {
    string bad = "object cache: corrupt ELF object";
    if (r.size < 64) { return bad; }
    if (int(r.u8At(0)) != 127 || int(r.u8At(1)) != 69 || int(r.u8At(2)) != 76 || int(r.u8At(3)) != 70) { return bad; }
    if (int(r.u8At(4)) != 2 || int(r.u8At(5)) != 1) { return bad; }
    if (int(r.u16At(16)) != 1 || int(r.u16At(18)) != 62) { return bad; }
    int shoff = int(r.u64At(40));
    int shnum = int(r.u16At(60));
    int shstrndx = int(r.u16At(62));
    if (shoff < 0 || shnum <= 0 || shstrndx < 0 || shstrndx >= shnum) { return bad; }
    if (shoff + shnum * 64 > r.size) { return bad; }
    int sbase = shoff + shstrndx * 64;
    int strOff = int(r.u64At(sbase + 24));
    int strSize = int(r.u64At(sbase + 32));
    if (strOff < 0 || strSize < 0 || strOff + strSize > r.size) { return bad; }
    int textOff = -1;
    int textLen = 0;
    int rdataOff = -1;
    int rdataLen = 0;
    int noteOff = -1;
    int noteLen = 0;
    for (int i = 0; i < shnum; i++) {
        int base = shoff + i * 64;
        int noff = int(r.u32At(base));
        int off = int(r.u64At(base + 24));
        int size = int(r.u64At(base + 32));
        if (noff < 0 || off < 0 || size < 0 || off + size > r.size) { return bad; }
        string sname = "";
        if (i > 0) { sname = objCStr(r, strOff, strSize, noff); }
        if (sname == ".text") { textOff = off; textLen = size; }
        else if (sname == ".rdata") { rdataOff = off; rdataLen = size; }
        else if (sname == ".slvnote") { noteOff = off; noteLen = size; }
    }
    if (textOff < 0 || rdataOff < 0 || noteOff < 0) { return bad; }
    out.add(textOff);
    out.add(textLen);
    out.add(rdataOff);
    out.add(rdataLen);
    out.add(noteOff);
    out.add(noteLen);
    return "";
}

// Split a Mach-O object into its section spans: out holds
// [textOff, textLen, rdataOff, rdataLen, noteOff, noteLen].
// Returns "" on success, else the exact reference error.
private string objSplitMacho(ObjReader r, int[] out) {
    string bad = "object cache: corrupt Mach-O object";
    if (r.size < 32) { return bad; }
    // MH_MAGIC_64 0xFEEDFACF.
    if (r.u32At(0) != int(4277009103)) { return bad; }
    if (r.u32At(4) != int(0x0100000C)) { return bad; }
    if (r.u32At(12) != 1) { return bad; }
    int ncmds = int(r.u32At(16));
    int off = 32;
    int textOff = -1;
    int textLen = 0;
    int rdataOff = -1;
    int rdataLen = 0;
    int noteOff = -1;
    int noteLen = 0;
    for (int i = 0; i < ncmds; i++) {
        int cmd = int(r.u32At(off));
        int cmdsize = int(r.u32At(off + 4));
        if (cmdsize < 8 || off + cmdsize > r.size) { return bad; }
        if (cmd == int(0x19)) {
            int nsects = int(r.u32At(off + 64));
            if (nsects < 0 || nsects > 100) { return bad; }
            for (int q = 0; q < nsects; q++) {
                int base = off + 72 + q * 80;
                if (base + 80 > r.size) { return bad; }
                int size = int(r.u64At(base + 40));
                int fileoff = int(r.u32At(base + 48));
                if (size < 0 || fileoff < 0 || fileoff + size > r.size) { return bad; }
                if (r.bytesAt(base, 6) == "__text") { textOff = fileoff; textLen = size; }
                else if (r.bytesAt(base, 7) == "__rdata") { rdataOff = fileoff; rdataLen = size; }
                else if (r.bytesAt(base, 9) == "__slvnote") { noteOff = fileoff; noteLen = size; }
            }
        }
        off += cmdsize;
    }
    if (textOff < 0 || rdataOff < 0 || noteOff < 0) { return bad; }
    out.add(textOff);
    out.add(textLen);
    out.add(rdataOff);
    out.add(rdataLen);
    out.add(noteOff);
    out.add(noteLen);
    return "";
}

// Parse just the Silver note (cheap freshness probe, mirrors the reference
// peek_note): split the container for the session target, decode the v5
// note into note. Returns true when the container and note are valid v5 —
// v4-era and foreign objects fail here and the planner treats them as
// stale, never a hard error.
public bool objPeekNote(ObjReader r, string targetOs, ObjNote note) {
    int[] spans = [];
    string serr = "";
    if (targetOs == "LINUX") { serr = objSplitElf(r, spans); }
    else if (targetOs == "MAC") { serr = objSplitMacho(r, spans); }
    else { serr = objSplitCoff(r, spans); }
    if (serr.length > 0) { return false; }
    string nerr = objDecodeNote(r, spans[4], spans[5], note);
    return nerr.length == 0;
}

// Fully parse one COFF object into obj (mirrors the reference parse_coff:
// code + data + note + symbol table with class/section checks + .text
// relocations with type checks, REL32 = 20 / ADDR64 = 1, ABS64 sites
// bounds-checked against the code length). Hard errors on any corruption.
public string objParseCoff(ObjReader r, ParsedObj obj) {
    string bad = "object cache: corrupt COFF object";
    int[] spans = [];
    string serr = objSplitCoff(r, spans);
    if (serr.length > 0) { return serr; }
    int textOff = spans[0];
    int textLen = spans[1];
    int rdataOff = spans[2];
    int rdataLen = spans[3];
    int noteOff = spans[4];
    int noteLen = spans[5];
    obj.code = [];
    for (int i = 0; i < textLen; i++) { obj.code.add(int(r.u8At(textOff + i))); }
    obj.data = [];
    for (int i = 0; i < rdataLen; i++) { obj.data.add(int(r.u8At(rdataOff + i))); }
    ObjNote note = new ObjNote();
    string nerr = objDecodeNote(r, noteOff, noteLen, note);
    if (nerr.length > 0) { return nerr; }
    obj.flags = note.flags;
    obj.hash = note.hash;
    obj.stamp = note.stamp;
    obj.gas = note.gas;
    obj.impDlls = note.impDlls;
    obj.impNames = note.impNames;
    obj.filekey = note.filekey;
    int symOff = int(r.u32At(8));
    int nsyms = int(r.u32At(12));
    if (symOff < 0 || nsyms < 2) { return bad; }
    // String table follows the symbol table.
    int strtabOff = symOff + nsyms * 18;
    int strtabLen = int(r.u32At(strtabOff));
    if (strtabLen < 4 || strtabOff + strtabLen > r.size) { return bad; }
    obj.symNames = [];
    obj.symSects = [];
    obj.symVals = [];
    obj.symIsFunc = [];
    for (int i = 0; i < nsyms; i++) {
        int base = symOff + i * 18;
        if (base + 18 > r.size) { return bad; }
        string name = "";
        if (r.u8At(base) == 0 && r.u8At(base + 1) == 0 && r.u8At(base + 2) == 0 && r.u8At(base + 3) == 0) {
            int strRef = int(r.u32At(base + 4));
            name = objCStr(r, strtabOff, strtabLen, strRef);
            if (name.length == 0) { return bad; }
        } else {
            string[] parts = [];
            for (int b = 0; b < 8; b++) {
                int64 c = r.u8At(base + b);
                if (c < 0) { return bad; }
                if (c == 0) { break; }
                parts.add((string)char(int(c)));
            }
            name = parts.join("");
        }
        int value = int(r.u32At(base + 8));
        int sect = int(r.u16At(base + 12));
        int stype = int(r.u16At(base + 14));
        int sclass = int(r.u8At(base + 16));
        if (value < 0 || sect < 0 || sect > 3) { return bad; }
        if (sclass != 2 && sclass != 3) { return bad; }
        obj.symNames.add(name);
        obj.symSects.add(sect);
        obj.symVals.add(value);
        if (stype == 32) { obj.symIsFunc.add(1); }
        else { obj.symIsFunc.add(0); }
    }
    // Relocations from the .text header (relptr at +24, count at +32).
    int relPtr = int(r.u32At(20 + 24));
    int nrel = int(r.u16At(20 + 32));
    if (relPtr < 0 || nrel < 0 || (nrel > 0 && relPtr + nrel * 10 > r.size)) { return bad; }
    obj.relSites = [];
    obj.relSyms = [];
    obj.relKinds = [];
    obj.relAddends = [];
    for (int i = 0; i < nrel; i++) {
        int base = relPtr + i * 10;
        int site = int(r.u32At(base));
        int sni = int(r.u32At(base + 4));
        int rtype = int(r.u16At(base + 8));
        if (site < 0 || sni < 0 || sni >= obj.symNames.length) { return bad; }
        int kind = -1;
        if (rtype == 20) { kind = 0; }
        else if (rtype == 1) { kind = 1; }
        else { return bad; }
        // COFF addends live in the site bytes.
        int64 addend = 0;
        if (kind == 1) {
            if (site + 8 > obj.code.length) { return bad; }
            addend = 0;
            for (int b = 0; b < 8; b++) {
                addend = addend | (int64(obj.code[site + b] & 0xFF) << (b * 8));
            }
        } else {
            if (site + 4 > obj.code.length) { return bad; }
        }
        obj.relSites.add(site);
        obj.relSyms.add(sni);
        obj.relKinds.add(kind);
        obj.relAddends.add(addend);
    }
    return "";
}

// Fully parse one ELF relocatable object into obj (mirrors the reference
// parse_elf_rel: sections by name, symbols from .symtab/.strtab,
// relocations from .rela.text; a non-empty .rela.data is corruption — a
// missing one is an older object and still validates).
// Hard errors on any corruption.
public string objParseElf(ObjReader r, ParsedObj obj) {
    string bad = "object cache: corrupt ELF object";
    int[] spans = [];
    string serr = objSplitElf(r, spans);
    if (serr.length > 0) { return serr; }
    int textOff = spans[0];
    int textLen = spans[1];
    int rdataOff = spans[2];
    int rdataLen = spans[3];
    int noteOff = spans[4];
    int noteLen = spans[5];
    obj.code = [];
    for (int i = 0; i < textLen; i++) { obj.code.add(int(r.u8At(textOff + i))); }
    obj.data = [];
    for (int i = 0; i < rdataLen; i++) { obj.data.add(int(r.u8At(rdataOff + i))); }
    ObjNote note = new ObjNote();
    string nerr = objDecodeNote(r, noteOff, noteLen, note);
    if (nerr.length > 0) { return nerr; }
    obj.flags = note.flags;
    obj.hash = note.hash;
    obj.stamp = note.stamp;
    obj.gas = note.gas;
    obj.impDlls = note.impDlls;
    obj.impNames = note.impNames;
    obj.filekey = note.filekey;
    int shoff = int(r.u64At(40));
    int shnum = int(r.u16At(60));
    int shstrndx = int(r.u16At(62));
    int sbase = shoff + shstrndx * 64;
    int strOff = int(r.u64At(sbase + 24));
    int strSize = int(r.u64At(sbase + 32));
    // Section index -> name (for STT_SECTION symbols).
    string[] secNames = [];
    for (int i = 0; i < shnum; i++) {
        int base = shoff + i * 64;
        int noff = int(r.u32At(base));
        if (i == 0) { secNames.add(""); }
        else { secNames.add(objCStr(r, strOff, strSize, noff)); }
    }
    // Locate .symtab, .strtab, .rela.text, .rela.data by name.
    int symOff = -1;
    int symSize = 0;
    int stabOff = -1;
    int stabSize = 0;
    int relaOff = -1;
    int relaSize = 0;
    bool hasRelaData = false;
    int relaDataSize = 0;
    for (int i = 1; i < shnum; i++) {
        int base = shoff + i * 64;
        int stype = int(r.u32At(base + 4));
        int off = int(r.u64At(base + 24));
        int size = int(r.u64At(base + 32));
        if (secNames[i] == ".symtab") {
            if (stype != 2) { return bad; }
            symOff = off;
            symSize = size;
        } else if (secNames[i] == ".strtab") {
            stabOff = off;
            stabSize = size;
        } else if (secNames[i] == ".rela.text") {
            relaOff = off;
            relaSize = size;
        } else if (secNames[i] == ".rela.data") {
            hasRelaData = true;
            relaDataSize = size;
        }
    }
    if (symOff < 0 || stabOff < 0) { return bad; }
    // .rela.data must be empty when present: .rdata carries no pointers by
    // construction, so a data relocation has no meaning the linker could
    // apply. A missing section is an older object and still validates.
    if (hasRelaData && relaDataSize != 0) { return bad; }
    int nsyms = symSize / 24;
    if (symOff + symSize > r.size || stabOff + stabSize > r.size) { return bad; }
    obj.symNames = [];
    obj.symSects = [];
    obj.symVals = [];
    obj.symIsFunc = [];
    for (int i = 0; i < nsyms; i++) {
        int base = symOff + i * 24;
        if (base + 24 > r.size) { return bad; }
        int nameOff = int(r.u32At(base));
        int info = int(r.u8At(base + 4));
        int shndx = int(r.u16At(base + 6));
        int64 value = r.u64At(base + 8);
        int64 size = r.u64At(base + 16);
        int typ = info & 0x0F;
        string name = "";
        if (i == 0) {
            name = "";
        } else if (typ == 3) {
            if (shndx < 0 || shndx >= secNames.length) { return bad; }
            name = secNames[shndx];
        } else {
            // String-table reference: the offset must land inside .strtab
            // with a terminator past it (an immediate NUL decodes to the
            // empty name, exactly like the reference).
            if (nameOff < 0 || nameOff >= stabSize) { return bad; }
            bool term = false;
            for (int t = stabOff + nameOff; t < stabOff + stabSize; t++) {
                if (r.u8At(t) == 0) { term = true; break; }
            }
            if (!term) { return bad; }
            name = objCStr(r, stabOff, stabSize, nameOff);
        }
        int sect = -1;
        if (shndx == 0) { sect = 0; }
        else if (shndx == 1) { sect = 1; }
        else if (shndx == 2) { sect = 2; }
        else { return bad; }
        if (value < 0 || value > 4294967295 || size < 0 || size > 4294967295) { return bad; }
        obj.symNames.add(name);
        obj.symSects.add(sect);
        obj.symVals.add(int(value));
        if (typ == 2) { obj.symIsFunc.add(1); }
        else { obj.symIsFunc.add(0); }
    }
    obj.relSites = [];
    obj.relSyms = [];
    obj.relKinds = [];
    obj.relAddends = [];
    if (relaOff >= 0) {
        if (relaSize % 24 != 0) { return bad; }
        if (relaOff + relaSize > r.size) { return bad; }
        int nrel = relaSize / 24;
        for (int i = 0; i < nrel; i++) {
            int base = relaOff + i * 24;
            int64 site = r.u64At(base);
            int64 rinfo = r.u64At(base + 8);
            int64 addend = r.u64At(base + 16);
            int sni = int(rinfo >> 32);
            int rtype = int(rinfo & 0xFFFFFFFF);
            if (site < 0 || site > 4294967295 || sni < 0 || sni >= obj.symNames.length) { return bad; }
            int kind = -1;
            if (rtype == 2) { kind = 0; }
            else if (rtype == 1) { kind = 1; }
            else { return bad; }
            obj.relSites.add(int(site));
            obj.relSyms.add(sni);
            obj.relKinds.add(kind);
            obj.relAddends.add(addend);
        }
    }
    return "";
}

// Fully parse one Mach-O object into obj (hard errors on any corruption).
// Relocation addends ride in the instruction immediates (Mach-O ARM64
// convention): bl placeholders must be zero; adrp/add immediates carry the
// unit-relative data offset, which the linker pairs by site adjacency (add
// at adrp + 4, same symbol).
public string objParseMacho(ObjReader r, ParsedObj obj) {
    string bad = "object cache: corrupt Mach-O object";
    int[] spans = [];
    string serr = objSplitMacho(r, spans);
    if (serr.length > 0) { return serr; }
    int textOff = spans[0];
    int textLen = spans[1];
    int rdataOff = spans[2];
    int rdataLen = spans[3];
    int noteOff = spans[4];
    int noteLen = spans[5];
    obj.code = [];
    for (int i = 0; i < textLen; i++) { obj.code.add(int(r.u8At(textOff + i))); }
    obj.data = [];
    for (int i = 0; i < rdataLen; i++) { obj.data.add(int(r.u8At(rdataOff + i))); }
    ObjNote note = new ObjNote();
    string nerr = objDecodeNote(r, noteOff, noteLen, note);
    if (nerr.length > 0) { return nerr; }
    obj.flags = note.flags;
    obj.hash = note.hash;
    obj.stamp = note.stamp;
    obj.gas = note.gas;
    obj.impDlls = note.impDlls;
    obj.impNames = note.impNames;
    obj.filekey = note.filekey;
    int ncmds = int(r.u32At(16));
    // Locate the LC_SYMTAB string table and the __text relocations. Spans
    // ride a holder object (raw array parameters stop growing past 8
    // entries; a foreign object could name many __text sections).
    int symoff = -1;
    int nsyms = 0;
    int stroff = -1;
    MacRelSpans relSpans = new MacRelSpans();
    int off = 32;
    for (int i = 0; i < ncmds; i++) {
        int cmd = int(r.u32At(off));
        int cmdsize = int(r.u32At(off + 4));
        if (cmdsize < 8 || off + cmdsize > r.size) { return bad; }
        if (cmd == int(0x19)) {
            int nsects = int(r.u32At(off + 64));
            for (int q = 0; q < nsects; q++) {
                int base = off + 72 + q * 80;
                if (base + 80 > r.size) { return bad; }
                if (r.bytesAt(base, 6) == "__text") {
                    int reloff = int(r.u32At(base + 56));
                    int nreloc = int(r.u32At(base + 60));
                    if (nreloc < 0) { return bad; }
                    if (nreloc > 0) {
                        relSpans.offs.add(reloff);
                        relSpans.counts.add(nreloc);
                    }
                }
            }
        } else if (cmd == 2) {
            symoff = int(r.u32At(off + 8));
            nsyms = int(r.u32At(off + 12));
            stroff = int(r.u32At(off + 16));
        }
        off += cmdsize;
    }
    if (symoff < 0 || nsyms <= 0 || stroff < 0) { return bad; }
    if (symoff + nsyms * 16 > r.size) { return bad; }
    obj.symNames = [];
    obj.symSects = [];
    obj.symVals = [];
    obj.symIsFunc = [];
    for (int i = 0; i < nsyms; i++) {
        int base = symoff + i * 16;
        if (base + 16 > r.size) { return bad; }
        int strx = int(r.u32At(base));
        int ntype = int(r.u8At(base + 4));
        int nsect = int(r.u8At(base + 5));
        int64 nvalue = r.u64At(base + 8);
        string[] nm = [];
        if (!macStrtabName(r, stroff, strx, nm)) { return bad; }
        string name = nm[0];
        if (nvalue < 0 || nvalue > 4294967295) { return bad; }
        if ((ntype & 224) != 0) { return bad; }
        int sect = -1;
        int isFunc = 0;
        if ((ntype & 14) == 14) {
            if (nsect != 1 && nsect != 2) { return bad; }
            sect = nsect;
            if (nsect == 1 && (ntype & 1) != 0) { isFunc = 1; }
        } else if ((ntype & 14) == 0) {
            if ((ntype & 1) == 0) { return bad; }
            sect = 0;
        } else {
            return bad;
        }
        obj.symNames.add(name);
        obj.symSects.add(sect);
        obj.symVals.add(int(nvalue));
        obj.symIsFunc.add(isFunc);
    }
    obj.relSites = [];
    obj.relSyms = [];
    obj.relKinds = [];
    obj.relAddends = [];
    for (int t = 0; t < relSpans.offs.length; t++) {
        for (int i = 0; i < relSpans.counts[t]; i++) {
            int base = relSpans.offs[t] + i * 8;
            if (base + 8 > r.size) { return bad; }
            int address = int(r.u32At(base));
            int packed = int(r.u32At(base + 4));
            int symnum = packed & 16777215;
            int pcrel = (packed >> 24) & 1;
            int length = (packed >> 25) & 3;
            int ext = (packed >> 27) & 1;
            int rtype = int((int64(packed) >> 28) & 15);
            if (ext != 1 || pcrel != 1 || length != 2 || symnum < 0 || symnum >= obj.symNames.length) { return bad; }
            if (address < 0 || address + 4 > obj.code.length) { return bad; }
            int word = macWordAt(obj.code, address);
            int kind = -1;
            int64 addend = 0;
            if (rtype == 2) {
                if (a64DecodeBlImm26(word) != 0 || (word >> 26) != 37) { return bad; }
                kind = 2;
            } else if (rtype == 3) {
                if ((word & int(0x9F000000)) != int(0x90000000)) { return bad; }
                kind = 3;
                addend = int64(a64DecodeAdrpPage(word)) << 12;
            } else if (rtype == 4) {
                if ((word & int(0xFF000000)) != int(0x91000000)) { return bad; }
                kind = 4;
                addend = a64DecodeAddImm12(word);
            } else {
                return bad;
            }
            obj.relSites.add(address);
            obj.relSyms.add(symnum);
            obj.relKinds.add(kind);
            obj.relAddends.add(addend);
        }
    }
    return "";
}

// __text relocation spans on a holder object (see the note at the spans
// site: raw array parameters stop growing past 8 entries).
class MacRelSpans {
    public prop int[] offs;
    public prop int[] counts;

    construct {
        this.offs = [];
        this.counts = [];
    }
}

// NUL-terminated name at strOff + strx (an immediate NUL decodes to the
// empty name, exactly like the reference). Returns false when the offset
// lands outside the file or no terminator follows.
private bool macStrtabName(ObjReader r, int strOff, int strx, string[] out) {
    if (strx < 0 || strOff + strx >= r.size) { return false; }
    string[] parts = [];
    int p = strOff + strx;
    bool term = false;
    while (p < r.size) {
        int64 b = r.u8At(p);
        if (b < 0) { return false; }
        if (b == 0) { term = true; break; }
        parts.add((string)char(int(b)));
        p++;
    }
    if (!term) { return false; }
    out.add(parts.join(""));
    return true;
}

// Fully parse one cached object for the session target (hard errors: a
// fresh-planned file whose object is corrupt fails loudly instead of being
// reused silently). Fills obj, returns "" or the exact reference error.
public string objParseObject(ObjReader r, string targetOs, ParsedObj obj) {
    if (targetOs == "LINUX") { return objParseElf(r, obj); }
    if (targetOs == "MAC") { return objParseMacho(r, obj); }
    return objParseCoff(r, obj);
}

// Fully parse one cached object for the session target (hard errors: a
// fresh-planned file whose object is corrupt fails loudly instead of being
// reused silently). Fills obj, returns "" or the exact reference error.
public string objParseObject(ObjReader r, string targetOs, ParsedObj obj) {
    if (targetOs == "LINUX") { return objParseElf(r, obj); }
    if (targetOs == "MAC") { return objParseMacho(r, obj); }
    return objParseCoff(r, obj);
}

// ---------------------------------------------------------------------------
// mac-aarch64 object-tier boundary predicate (mirrors silverc-rs
// mac_tier_fallback_reason and silverc/compiler/objcache.sr macTierReason
// exactly: same boundary, same reason strings).
//
// A program is in-tier when ALL of these hold:
//
// - Items are only free functions, const integer/bool/char items with
//   literal values, and import items. No structs, classes, enums, modules,
//   type aliases, globals, or any other item kind.
// - Exactly one main with no parameters and void return.
// - Only the call-graph closure from main is checked and lowered
//   (plain-call edges to program functions; method calls contribute no
//   edge and reject when reached): unreached functions — dead helpers,
//   uncalled stdlib bodies an `import *` prepends — are skipped, so they
//   never poison the verdict and are never emitted into the .o.
// - Every other REACHED function is free-standing (no overloads — duplicate
//   names fall back), takes at most 8 parameters, has no default values,
//   and uses only int/bool/char parameter and return types (void return
//   allowed).
// - No user function is named print, printline, printf, or exit (those
//   names are the tier's builtins/imports).
// - Statements: local int/bool/char declarations with an initializer,
//   plain/compound (+=, -=, *=, /=, %=) assignment to locals, if/else,
//   while, C-like for (range-for desugared onto it below, so both spellings
//   take the same verdicts), break/continue inside loops, return, calls, and
//   print/printline with exactly one argument. No foreach, match/switch,
//   exceptions, or destructuring. (This AST desugars ++/-- into +=/-= 1, so
//   they ride the assignment arm with identical strings; the << move form
//   rides it too.)
// - Expressions: integer/bool/char literals, const reads, local and
//   parameter reads, +, -, *, /, % (division and modulo lower exactly like
//   the x64 backend: a zero divisor takes the same uncaught-exception path
//   and INT64_MIN / -1 traps with brk, mirroring idiv's loud hardware
//   fault), unary -, !, comparisons, short-circuit &&/||, parentheses, calls to
//   program-defined functions with exact arity, and string literals ONLY as
//   the direct argument of print/printline.
// - Total frame (parameters + locals + operand slots) fits in 500 8-byte
//   slots.
//
// Kind/operator numbers below are this interpreter's ND_*/OP_* constants
// (ast.sr); the port's raw numbers ride in comments (Pnn) so the mapping
// stays reviewable. Reason strings are byte-identical to the references.
//
// The driver consults this on every object-cached path after parsing, and
// both real lowerings (winLowerUnit, armLowerUnit) re-check it first so the
// three can never disagree: an out-of-tier entry emits no object at all and
// prints the loud fallback (reference reason + the interpreter's
// verified-tier continuation), running from the verified AST/bytecode tiers.
// ---------------------------------------------------------------------------

// Whole-program tier context: function signatures, const values, and
// whether any print needs the printf import. Parameter and return kinds
// are single letters (i = int, b = bool, c = char, v = void) mirroring the
// reference TierCtx.
class MacCtx {
    public prop string[] sigNames;
    public prop string[] sigParams;
    public prop string[] sigRets;
    public prop string[] constNames;
    public prop string[] constKinds;
    public prop int64[] constVals;
    public prop bool usesPrintf;
    // Lowering-time .rdata image: deduplicated interned byte strings,
    // flattened into idataBytes with one cumulative end offset per blob in
    // idataEnds (each blob stored with its NUL terminator). Appended during
    // lowering and sliced into the unit at finalization. The predicate path
    // never interns, so these stay empty outside lowering.
    public prop int[] idataBytes;
    public prop int[] idataEnds;
    public prop int idataLen;

    construct {
        this.sigNames = [];
        this.sigParams = [];
        this.sigRets = [];
        this.constNames = [];
        this.constKinds = [];
        this.constVals = [];
        this.usesPrintf = false;
        this.idataBytes = [];
        this.idataEnds = [];
        this.idataLen = 0;
    }

    // Offset of s in .rdata (with NUL terminator), appending on first sight.
    public int addStr(string s) {
        int[] blob = [];
        for (int i = 0; i < s.length; i++) { blob.add(int64(s[i]) & 0xFF); }
        blob.add(0);
        return this.addStrBytes(blob);
    }

    // Offset of raw bytes b in .rdata, appending on first sight (content
    // equality — identical payloads share one copy).
    public int addStrBytes(int[] b) {
        int base = 0;
        for (int i = 0; i < this.idataEnds.length; i++) {
            int end = this.idataEnds[i];
            if (end - base == b.length) {
                bool same = true;
                for (int j = 0; j < b.length; j++) {
                    if (this.idataBytes[base + j] != b[j]) { same = false; break; }
                }
                if (same) { return base; }
            }
            base = end;
        }
        int off = this.idataLen;
        for (int k = 0; k < b.length; k++) { this.idataBytes.add(b[k]); }
        this.idataEnds.add(off + b.length);
        this.idataLen = this.idataLen + b.length;
        return off;
    }
}

// Per-function layout: variable slots plus operand-stack depth.
class MacLayout {
    public prop string[] varNames;
    public prop string[] varKinds;
    public prop int[] varSlots;
    public prop int totalSlots;
    public prop int maxDepth;
    public prop int frameBytes;

    construct {
        this.varNames = [];
        this.varKinds = [];
        this.varSlots = [];
        this.totalSlots = 0;
        this.maxDepth = 0;
        this.frameBytes = 0;
    }
}

// Checked-expression value: scalar kind (0 = int, 1 = bool, 2 = char,
// 3 = bare string literal) plus the operand-stack slots it needs.
class MacVal {
    public prop int kind;
    public prop int depth;

    construct {
        this.kind = 0;
        this.depth = 0;
    }
}

// Walker state for the boundary check (mirrors the reference Walker:
// locals accumulate slots, maxDepth tracks the operand area, loopDepth
// gates break/continue).
class MacWalk {
    public prop MacCtx ctx;
    public prop string fname;
    public prop bool voidFn;
    public prop string[] varNames;
    public prop string[] varKinds;
    public prop int nextSlot;
    public prop int maxDepth;
    public prop int loopDepth;
    // Live names a for-loop body must not redeclare: a body declaration
    // shadowing an outer (or loop-init) name would resolve uses to the
    // wrong slot, while the x64 backend scopes them apart — so collisions
    // fall back rather than diverge (mirrors the reference body_guard).
    public prop string[] guardNames;

    construct (MacCtx c) {
        this.ctx = c;
        this.fname = "";
        this.voidFn = false;
        this.varNames = [];
        this.varKinds = [];
        this.nextSlot = 0;
        this.maxDepth = 0;
        this.loopDepth = 0;
        this.guardNames = [];
    }
}

// Tier scalar letter for a declared type spelling, or "" when the type is
// outside the tier (only int/bool/char lower as 64-bit values).
private string macScalarOf(string t) {
    if (t == "int") { return "i"; }
    if (t == "bool") { return "b"; }
    if (t == "char") { return "c"; }
    return "";
}

private int macMax(int a, int b) {
    if (a > b) { return a; }
    return b;
}

private int macFindSig(MacCtx ctx, string name) {
    for (int i = 0; i < ctx.sigNames.length; i++) {
        if (ctx.sigNames[i] == name) { return i; }
    }
    return -1;
}

private int macFindConst(MacCtx ctx, string name) {
    for (int i = 0; i < ctx.constNames.length; i++) {
        if (ctx.constNames[i] == name) { return i; }
    }
    return -1;
}

private int macFindVar(MacWalk w, string name) {
    for (int i = 0; i < w.varNames.length; i++) {
        if (w.varNames[i] == name) { return i; }
    }
    return -1;
}

// Index of the first top-level function named `name` (-1 when no program
// function has that name). Builtin calls (print/exit/...) never match, so
// they contribute no edge.
private int macFuncIndex(Node[] program, string name) {
    for (int i = 0; i < program.length; i++) {
        Node item = program[i];
        if (item.kind == ND_FUNC && item.name == name) { return i; }
    }
    return -1;
}

private bool macNameIn(string[] names, string name) {
    for (int i = 0; i < names.length; i++) {
        if (names[i] == name) { return true; }
    }
    return false;
}

// Every plain-call callee name under n (generic child walk). Method calls
// contribute no edge: a reached method call already falls back ("method
// calls in ..."), so method-dispatched stdlib (time.now/stopwatch) can
// never matter to native execution and stays unreached.
private void macCollectCalls(Node n, string[] out) {
    if (n.kind == ND_CALL) {
        if (!macNameIn(out, n.name)) { out.add(n.name); }
    }
    for (int i = 0; i < n.childCount(); i++) { macCollectCalls(n.child(i), out); }
}

// The functions the tier checks and lowers: the call-graph closure from
// every `main` over plain-call edges to program functions. Unreached
// functions (dead helpers, uncalled stdlib bodies an `import *` prepends)
// are never checked and never emitted — they cannot affect native
// execution, because any program that could reach them at runtime is
// rejected at the reached caller instead.
private string[] macReachableSet(Node[] program) {
    string[] reached = [];
    for (int i = 0; i < program.length; i++) {
        Node item = program[i];
        if (item.kind == ND_FUNC && item.name == "main") {
            if (!macNameIn(reached, "main")) { reached.add("main"); }
        }
    }
    int cursor = 0;
    while (cursor < reached.length) {
        string cur = reached[cursor];
        cursor++;
        for (int i = 0; i < program.length; i++) {
            Node item = program[i];
            if (item.kind != ND_FUNC || item.name != cur) { continue; }
            string[] callees = [];
            macCollectCalls(item, callees);
            for (int c = 0; c < callees.length; c++) {
                if (macFuncIndex(program, callees[c]) < 0) { continue; }
                if (!macNameIn(reached, callees[c])) { reached.add(callees[c]); }
            }
        }
    }
    return reached;
}

// Why a program is outside the mac object tier ("" = in-tier). Reason
// strings mirror the reference mac_tier_fallback_reason exactly.
public string macTierReason(Node[] program) {
    MacCtx ctx = new MacCtx();
    // Pass 1: items and signatures, in program order so the first error
    // wins exactly like before. Only the call-graph closure from main is
    // admitted (macReachableSet): unreached functions — dead helpers and
    // the uncalled stdlib bodies an `import *` prepends (stopwatch, the
    // sleep overloads) — are skipped, so they no longer poison an in-tier
    // entry. Reached out-of-tier constructs still reject with the same
    // strings (honest fallback preserved).
    string[] reached = macReachableSet(program);
    for (int i = 0; i < program.length; i++) {
        Node item = program[i];
        if (item.kind == ND_FUNC) {
            if (!macNameIn(reached, item.name)) { continue; }
            if (item.name == "print" || item.name == "printline" || item.name == "printf" || item.name == "exit") {
                return "user function '" + item.name + "' collides with a tier builtin";
            }
            if (item.name.length >= 6 && item.name.substr(0, 6) == "__slv_") {
                return "user function '" + item.name + "' collides with a tier builtin";
            }
            if (macFindSig(ctx, item.name) >= 0) {
                return "overloaded function '" + item.name + "' (duplicate name)";
            }
            if (item.childCount() < 2) {
                return "function '" + item.name + "' has no body";
            }
            Node params = item.child(0);
            if (params.childCount() > 8) {
                return "function '" + item.name + "' takes " + (string)params.childCount() + " parameters (tier limit 8)";
            }
            string kinds = "";
            for (int pi = 0; pi < params.childCount(); pi++) {
                Node p = params.child(pi);
                string pk = macScalarOf(p.typeHint);
                if (pk.length == 0) {
                    return "parameter '" + p.name + "' of '" + item.name + "' has non-tier type";
                }
                if (p.childCount() > 0) {
                    return "default value on parameter '" + p.name + "' of '" + item.name + "'";
                }
                // No isVariadic field exists in this AST (only the `void ()`
                // fn-typed shape survives parsing as a non-scalar); either
                // way the reference string names both spellings.
                if (p.typeHint == "void ()") {
                    return "parameter '" + p.name + "' of '" + item.name + "' is variadic or function-typed";
                }
                kinds += pk;
            }
            string ret = "v";
            if (item.typeHint != "" && item.typeHint != "void") {
                ret = macScalarOf(item.typeHint);
                if (ret.length == 0) {
                    return "function '" + item.name + "' has non-tier return type";
                }
            }
            ctx.sigNames.add(item.name);
            ctx.sigParams.add(kinds);
            ctx.sigRets.add(ret);
        } else if (item.kind == ND_CONST) {
            string ck = macScalarOf(item.typeHint);
            if (ck.length == 0) {
                return "const '" + item.name + "' has non-tier type";
            }
            if (item.childCount() == 0) {
                return "const '" + item.name + "' needs a literal value";
            }
            Node v = item.child(0);
            if (v.kind == ND_INT_LIT) {
                ctx.constNames.add(item.name);
                ctx.constKinds.add(ck);
                ctx.constVals.add(v.intVal);
            } else if (v.kind == ND_BOOL_LIT) {
                ctx.constNames.add(item.name);
                ctx.constKinds.add(ck);
                if (v.boolVal) { ctx.constVals.add(1); }
                else { ctx.constVals.add(0); }
            } else if (v.kind == ND_CHAR_LIT) {
                ctx.constNames.add(item.name);
                ctx.constKinds.add(ck);
                int cv = v.charVal;
                ctx.constVals.add(int64(cv));
            } else {
                return "const '" + item.name + "' needs a literal value";
            }
        } else if (item.kind == ND_IMPORT) {
            // Import items carry no code.
        } else if (item.kind == ND_STRUCT_DEF) {
            return "struct definitions";
        } else if (item.kind == ND_CLASS_DEF) {
            return "class definitions";
        } else if (item.kind == ND_ENUM_DEF) {
            return "enum definitions";
        } else if (item.kind == ND_MODULE) {
            // Pure `mod export name;` declarations carry no code: the
            // tree-walking register only records the module name (eval.sr),
            // and the native tier has no module namespace, so there is
            // nothing to lower and the item is skipped. Anything else —
            // a real `mod name { ... }` block (items as children) or a bare
            // `mod name;` forward declaration (empty marker) — stays outside
            // the tier.
            if (item.childCount() == 0 && item.strVal == "export") { continue; }
            return "inline module blocks";
        } else if (item.kind == ND_TYPE_ALIAS) {
            return "type aliases";
        } else if (item.kind == ND_FOUND) {
            return "found items";
        } else if (item.kind == ND_COLLECT) {
            return "collect items";
        } else if (item.kind == ND_DEF_UNIT) {
            return "defunit items";
        } else if (item.kind == ND_ANNOTATION) {
            return "annotations";
        } else {
            return "top-level statements";
        }
    }
    // The entry contract: exactly one void main() with no parameters.
    int mi = macFindSig(ctx, "main");
    if (mi < 0) {
        return "no main function";
    }
    string mainParams = ctx.sigParams[mi];
    if (mainParams.length > 0) {
        return "main takes parameters";
    }
    string mainRet = ctx.sigRets[mi];
    if (mainRet != "v") {
        return "main returns a value";
    }
    // Pass 2: every reached function body (also flags printf use).
    for (int i = 0; i < program.length; i++) {
        Node item = program[i];
        if (item.kind == ND_FUNC) {
            if (!macNameIn(reached, item.name)) { continue; }
            MacLayout layout = new MacLayout();
            string err = macCheckFunc(ctx, item, layout);
            if (err.length > 0) { return err; }
        }
    }
    return "";
}

// Check one function body and compute its layout. Shared by the predicate
// and any future lowering, so they can never disagree about the boundary.
private string macCheckFunc(MacCtx ctx, Node func, MacLayout layout) {
    int si = macFindSig(ctx, func.name);
    if (si < 0) { return "missing signature in '" + func.name + "'"; }
    if (func.childCount() < 2) { return "missing body in '" + func.name + "'"; }
    MacWalk w = new MacWalk(ctx);
    w.fname = func.name;
    w.voidFn = ctx.sigRets[si] == "v";
    string pks = ctx.sigParams[si];
    Node params = func.child(0);
    for (int i = 0; i < params.childCount(); i++) {
        Node p = params.child(i);
        w.varNames.add(p.name);
        w.varKinds.add(pks[i..i + 1]);
    }
    w.nextSlot = params.childCount();
    Node body = func.child(1);
    string err = macWalkBlock(w, body, 0);
    if (err.length > 0) { return err; }
    if (w.nextSlot + w.maxDepth > 500) {
        return "frame too large in '" + func.name + "'";
    }
    layout.varNames = w.varNames;
    layout.varKinds = w.varKinds;
    layout.varSlots = [];
    for (int i = 0; i < w.varNames.length; i++) { layout.varSlots.add(i); }
    layout.totalSlots = w.nextSlot + w.maxDepth;
    layout.maxDepth = w.maxDepth;
    layout.frameBytes = (layout.totalSlots * 8 + 15) / 16 * 16;
    return "";
}

private string macWalkBlock(MacWalk w, Node block, int base) {
    if (block.kind == ND_BLOCK) {
        for (int i = 0; i < block.childCount(); i++) {
            string err = macWalkStmt(w, block.child(i), base);
            if (err.length > 0) { return err; }
        }
        return "";
    }
    return macWalkStmt(w, block, base);
}

// Check one local declaration and allocate its slot. Shared by the plain
// statement path and the C-like for initializer, so they can never disagree
// about the boundary. A declaration inside a for body that shadows a live
// name (or collides with a const) falls back rather than diverging, exactly
// like the reference body_guard.
private string macWalkLocalDecl(MacWalk w, Node s, int base) {
    if (s.childCount() == 0) {
        return "uninitialized local '" + s.name + "' in '" + w.fname + "'";
    }
    MacVal v = new MacVal();
    string err = macWalkExpr(w, s.child(0), false, base, v);
    if (err.length > 0) { return err; }
    if (v.kind == 3) {
        return "string values in '" + w.fname + "'";
    }
    string vk = "";
    if (v.kind == 0) { vk = "i"; }
    else if (v.kind == 1) { vk = "b"; }
    else if (v.kind == 4) { vk = "f"; }
    else { vk = "c"; }
    if (s.typeHint != "" && s.typeHint != "var") {
        if (tierFloatSpelling(s.typeHint)) {
            if (v.kind != 4) {
                return "local '" + s.name + "' has non-tier type in '" + w.fname + "'";
            }
            vk = "f";
        } else {
            if (v.kind == 4) {
                return "local '" + s.name + "' has non-tier type in '" + w.fname + "'";
            }
            vk = macScalarOf(s.typeHint);
            if (vk.length == 0) {
                return "local '" + s.name + "' has non-tier type in '" + w.fname + "'";
            }
        }
    }
    if (w.guardNames.contains(s.name)) {
        return "shadowed variable '" + s.name + "' in '" + w.fname + "'";
    }
    if (w.guardNames.length > 0 && macFindConst(w.ctx, s.name) >= 0) {
        return "loop variable '" + s.name + "' collides with a const in '" + w.fname + "'";
    }
    if (w.nextSlot >= 500) {
        return "frame too large in '" + w.fname + "'";
    }
    w.varNames.add(s.name);
    w.varKinds.add(vk);
    w.nextSlot++;
    w.maxDepth = macMax(w.maxDepth, base + v.depth);
    return "";
}

private string macWalkStmt(MacWalk w, Node s, int base) {
    if (s.kind == ND_EXPR_STMT) {
        if (s.childCount() == 0) { return ""; }
        MacVal v = new MacVal();
        string err = macWalkExpr(w, s.child(0), true, base, v);
        if (err.length > 0) { return err; }
        w.maxDepth = macMax(w.maxDepth, base + v.depth);
        return "";
    }
    if (s.kind == ND_VAR_DECL) {
        return macWalkLocalDecl(w, s, base);
    }
    if (s.kind == ND_RETURN) {
        if (s.childCount() == 0) {
            if (!w.voidFn) {
                return "empty return in '" + w.fname + "'";
            }
            return "";
        }
        if (w.voidFn) {
            return "return with a value in '" + w.fname + "'";
        }
        MacVal v = new MacVal();
        string err = macWalkExpr(w, s.child(0), false, base, v);
        if (err.length > 0) { return err; }
        if (v.kind == 3) {
            return "string values in '" + w.fname + "'";
        }
        if (v.kind == 4) {
            return "float return values in '" + w.fname + "'";
        }
        w.maxDepth = macMax(w.maxDepth, base + v.depth);
        return "";
    }
    if (s.kind == ND_IF_STMT) {
        if (s.childCount() < 2) {
            return "unsupported statement in '" + w.fname + "'";
        }
        MacVal v = new MacVal();
        string err = macWalkExpr(w, s.child(0), false, base, v);
        if (err.length > 0) { return err; }
        if (v.kind == 3) {
            return "string values in '" + w.fname + "'";
        }
        if (v.kind == 4) {
            return "float conditions in '" + w.fname + "'";
        }
        w.maxDepth = macMax(w.maxDepth, base + v.depth);
        err = macWalkBlock(w, s.child(1), base);
        if (err.length > 0) { return err; }
        if (s.childCount() > 2) {
            err = macWalkBlock(w, s.child(2), base);
            if (err.length > 0) { return err; }
        }
        return "";
    }
    if (s.kind == ND_WHILE) {
        if (s.childCount() < 2) {
            return "unsupported statement in '" + w.fname + "'";
        }
        MacVal v = new MacVal();
        string err = macWalkExpr(w, s.child(0), false, base, v);
        if (err.length > 0) { return err; }
        if (v.kind == 3) {
            return "string values in '" + w.fname + "'";
        }
        if (v.kind == 4) {
            return "float conditions in '" + w.fname + "'";
        }
        w.maxDepth = macMax(w.maxDepth, base + v.depth);
        w.loopDepth++;
        err = macWalkBlock(w, s.child(1), base);
        w.loopDepth--;
        if (err.length > 0) { return err; }
        return "";
    }
    // Port kinds 62/63 are break/continue; this AST numbers them 63/64
    // (62 is switch) — same strings.
    if (s.kind == ND_BREAK || s.kind == ND_CONTINUE) {
        if (w.loopDepth == 0) {
            return "break/continue outside a loop in '" + w.fname + "'";
        }
        return "";
    }
    // Range-for (this AST keeps it as its own node 56; the reference
    // parser desugars it onto the C-for node): desugar onto the same C-for
    // shape here — init `type var = start`, cond `var < end` (exclusive),
    // update `var = var + 1` — and fall into the C-for check below, so both
    // spellings take program-for-program identical verdicts. continue runs
    // the update, break leaves.
    if (s.kind == ND_FOR_RANGE) {
        if (s.childCount() < 3) {
            return "unsupported statement in '" + w.fname + "'";
        }
        Node initN = new Node(ND_VAR_DECL, s.line, s.col);
        initN.name = s.name;
        initN.typeHint = s.typeHint;
        initN.addChild(s.child(0));
        Node lhsN = new Node(ND_IDENT, s.line, s.col);
        lhsN.name = s.name;
        Node condN = new Node(ND_BINARY, s.line, s.col);
        condN.op = OP_LT;
        condN.addChild(lhsN);
        condN.addChild(s.child(1));
        Node uLhsN = new Node(ND_IDENT, s.line, s.col);
        uLhsN.name = s.name;
        Node aLhsN = new Node(ND_IDENT, s.line, s.col);
        aLhsN.name = s.name;
        Node oneN = new Node(ND_INT_LIT, s.line, s.col);
        oneN.intVal = 1;
        Node addN = new Node(ND_BINARY, s.line, s.col);
        addN.op = OP_ADD;
        addN.addChild(aLhsN);
        addN.addChild(oneN);
        Node updN = new Node(ND_BINARY, s.line, s.col);
        updN.op = OP_ASSIGN;
        updN.addChild(uLhsN);
        updN.addChild(addN);
        Node forN = new Node(ND_FOR_C, s.line, s.col);
        forN.addChild(initN);
        forN.addChild(condN);
        forN.addChild(updN);
        forN.addChild(s.child(2));
        s = forN;
    }
    // Port kind 55 is the C for loop (range-for arrives desugared above).
    if (s.kind == ND_FOR_C) {
        // C-like for (child(0)=init, child(1)=cond, child(2)=update,
        // child(3)=body): exact desugar onto while — init once, then
        // cond-check / body / update; continue runs the update, break
        // leaves.
        if (s.childCount() < 4) {
            return "unsupported statement in '" + w.fname + "'";
        }
        Node init = s.child(0);
        if (init.kind == ND_VAR_DECL) {
            if (init.childCount() == 0) {
                return "uninitialized local '" + init.name + "' in '" + w.fname + "'";
            }
            if (macFindConst(w.ctx, init.name) >= 0) {
                return "loop variable '" + init.name + "' collides with a const in '" + w.fname + "'";
            }
            if (macFindVar(w, init.name) >= 0) {
                return "shadowed variable '" + init.name + "' in '" + w.fname + "'";
            }
            string derr = macWalkLocalDecl(w, init, base);
            if (derr.length > 0) { return derr; }
        } else if (init.kind == ND_EXPR_STMT) {
            if (init.childCount() > 0) {
                MacVal iv = new MacVal();
                string ierr = macWalkExpr(w, init.child(0), true, base, iv);
                if (ierr.length > 0) { return ierr; }
                w.maxDepth = macMax(w.maxDepth, base + iv.depth);
            }
        } else if (init.kind == ND_BINARY) {
            MacVal iv = new MacVal();
            string ierr = macWalkExpr(w, init, true, base, iv);
            if (ierr.length > 0) { return ierr; }
            w.maxDepth = macMax(w.maxDepth, base + iv.depth);
        } else {
            return "unsupported for initializer in '" + w.fname + "'";
        }
        MacVal cv = new MacVal();
        string cerr = macWalkExpr(w, s.child(1), false, base, cv);
        if (cerr.length > 0) { return cerr; }
        if (cv.kind == 3) {
            return "string values in '" + w.fname + "'";
        }
        if (cv.kind == 4) {
            return "float conditions in '" + w.fname + "'";
        }
        w.maxDepth = macMax(w.maxDepth, base + cv.depth);
        MacVal uv = new MacVal();
        string uerr = macWalkExpr(w, s.child(2), true, base, uv);
        if (uerr.length > 0) { return uerr; }
        w.maxDepth = macMax(w.maxDepth, base + uv.depth);
        int guardBase = w.guardNames.length;
        for (int gi = 0; gi < w.varNames.length; gi++) { w.guardNames.add(w.varNames[gi]); }
        w.loopDepth++;
        string berr = macWalkBlock(w, s.child(3), base);
        w.loopDepth--;
        while (w.guardNames.length > guardBase) { w.guardNames.pop(); }
        if (berr.length > 0) { return berr; }
        return "";
    }
    // Port kind 64 is foreach; here it is 57 — same string.
    if (s.kind == ND_FOREACH) {
        return "foreach loops in '" + w.fname + "'";
    }
    // Port kind 76 is switch; here it is 62 — same string.
    if (s.kind == ND_SWITCH) {
        return "switch statements in '" + w.fname + "'";
    }
    if (s.kind == ND_TRY_CATCH) {
        return "try/catch in '" + w.fname + "'";
    }
    // Port kind 68 is throw; here it is 65 — same string.
    if (s.kind == ND_THROW) {
        return "throw in '" + w.fname + "'";
    }
    if (s.kind == ND_DESTRUCT) {
        return "tuple destructuring in '" + w.fname + "'";
    }
    // Port kind 73 is the alias declaration; here it is 66 — same string.
    if (s.kind == ND_ALIAS_DECL) {
        return "alias declarations in '" + w.fname + "'";
    }
    return "unsupported statement in '" + w.fname + "'";
}

// Check an expression, filling out with its scalar kind and the
// operand-stack slots it needs above base. inStmt allows the print
// builtins (void calls are statement-only).
private string macWalkExpr(MacWalk w, Node e, bool inStmt, int base, MacVal out) {
    if (e.kind == ND_INT_LIT) {
        out.kind = 0;
        out.depth = 1;
        return "";
    }
    if (e.kind == ND_BOOL_LIT) {
        out.kind = 1;
        out.depth = 1;
        return "";
    }
    if (e.kind == ND_CHAR_LIT) {
        out.kind = 2;
        out.depth = 1;
        return "";
    }
    if (e.kind == ND_FLOAT_LIT) {
        out.kind = 4;
        out.depth = 1;
        return "";
    }
    if (e.kind == ND_STRING_LIT) {
        out.kind = 3;
        out.depth = 0;
        return "";
    }
    if (e.kind == ND_IDENT) {
        int ci = macFindConst(w.ctx, e.name);
        if (ci >= 0) {
            string ck = w.ctx.constKinds[ci];
            if (ck == "i") { out.kind = 0; }
            else if (ck == "b") { out.kind = 1; }
            else { out.kind = 2; }
            out.depth = 1;
            return "";
        }
        int vi = macFindVar(w, e.name);
        if (vi < 0) {
            return "unknown variable '" + e.name + "' in '" + w.fname + "'";
        }
        string vk = w.varKinds[vi];
        if (vk == "i") { out.kind = 0; }
        else if (vk == "b") { out.kind = 1; }
        else if (vk == "f") { out.kind = 4; }
        else { out.kind = 2; }
        out.depth = 1;
        return "";
    }
    if (e.kind == ND_PAREN) {
        if (e.childCount() == 0) {
            return "unsupported expression in '" + w.fname + "'";
        }
        return macWalkExpr(w, e.child(0), false, base, out);
    }
    if (e.kind == ND_UNARY) {
        if (e.childCount() == 0) {
            return "unsupported expression in '" + w.fname + "'";
        }
        if (e.op == UOP_NEG) {
            MacVal v = new MacVal();
            string err = macWalkExpr(w, e.child(0), false, base, v);
            if (err.length > 0) { return err; }
            if (v.kind == 3) {
                return "string values in '" + w.fname + "'";
            }
            if (v.kind == 4) {
                return "unsupported float operation in '" + w.fname + "'";
            }
            out.kind = 0;
            out.depth = v.depth;
            return "";
        }
        if (e.op == UOP_NOT) {
            MacVal v = new MacVal();
            string err = macWalkExpr(w, e.child(0), false, base, v);
            if (err.length > 0) { return err; }
            if (v.kind == 3) {
                return "string values in '" + w.fname + "'";
            }
            if (v.kind == 4) {
                return "float logic operands in '" + w.fname + "'";
            }
            out.kind = 1;
            out.depth = v.depth;
            return "";
        }
        return "unsupported unary operator in '" + w.fname + "'";
    }
    if (e.kind == ND_BINARY) {
        return macWalkBinary(w, e, inStmt, base, out);
    }
    // Port kind 10 is the call with an isMember flag; this AST splits plain
    // calls (9) from method calls (10) — same strings.
    if (e.kind == ND_CALL) {
        return macWalkCall(w, e, inStmt, base, out);
    }
    if (e.kind == ND_METHOD_CALL) {
        return macWalkMethod(w, e, inStmt, base, out);
    }
    if (e.kind == ND_MEMBER) {
        return "member access in '" + w.fname + "'";
    }
    // Port kinds 24/67 are index forms; here they are 11/12 — same string.
    if (e.kind == ND_INDEX || e.kind == ND_SLICE) {
        return "indexing in '" + w.fname + "'";
    }
    // Port kind 65 is ternary; here it is 20 — same string.
    if (e.kind == ND_TERNARY) {
        return "ternary expressions in '" + w.fname + "'";
    }
    // Port kind 66 is the dictionary literal; here it is 24 — same string.
    if (e.kind == ND_DICT_LIT) {
        return "dictionaries in '" + w.fname + "'";
    }
    // Port kind 69 is string interpolation; here it is 22 — same string.
    if (e.kind == ND_INTERP) {
        return "string interpolation in '" + w.fname + "'";
    }
    // Port kind 70 is the tuple literal; here it is 18 — same string.
    if (e.kind == ND_TUPLE_LIT) {
        return "tuple literals in '" + w.fname + "'";
    }
    if (e.kind == ND_ARRAY_LIT) {
        return "array literals in '" + w.fname + "'";
    }
    // Port kind 74 is the struct literal; here it is 17 — same string.
    if (e.kind == ND_STRUCT_LIT) {
        return "struct literals in '" + w.fname + "'";
    }
    // Port kind 80 is the lambda; here it is 85 — same string.
    if (e.kind == ND_ANON_FN) {
        return "lambdas in '" + w.fname + "'";
    }
    // Port kind 86 is the cast; here it is 29 — same string.
    if (e.kind == ND_CAST) {
        return "casts in '" + w.fname + "'";
    }
    if (e.kind == ND_INDIRECT_CALL) {
        return "indirect calls in '" + w.fname + "'";
    }
    return "unsupported expression in '" + w.fname + "'";
}

private string macWalkBinary(MacWalk w, Node e, bool inStmt, int base, MacVal out) {
    int op = e.op;
    // Port ops 1/2/3 are add/sub/mul; here they are 0/1/2 — same string.
    if (op == OP_ADD || op == OP_SUB || op == OP_MUL) {
        if (e.childCount() < 2) {
            return "unsupported expression in '" + w.fname + "'";
        }
        MacVal l = new MacVal();
        MacVal r = new MacVal();
        string err = macWalkExpr(w, e.child(0), false, base, l);
        if (err.length > 0) { return err; }
        err = macWalkExpr(w, e.child(1), false, base + 1, r);
        if (err.length > 0) { return err; }
        if (l.kind == 3 || r.kind == 3) {
            return macWalkConcat(w, e, l, r, base, out);
        }
        if (l.kind == 4 || r.kind == 4) {
            if (l.kind != 4 || r.kind != 4) {
                return "mixed int and float operands in '" + w.fname + "'";
            }
            out.kind = 4;
            out.depth = macMax(l.depth, 1 + r.depth);
            return "";
        }
        out.kind = 0;
        out.depth = macMax(l.depth, 1 + r.depth);
        return "";
    }
    // Port ops 4/13 are division/modulo; here they are 3/4 — same
    // boundary: both lower through the guarded sequence, which prints
    // through printf on a zero divisor — so the import must exist even in
    // programs that never call print (mirrors the reference depth math
    // exactly).
    if (op == OP_DIV || op == OP_MOD) {
        if (e.childCount() < 2) {
            return "unsupported expression in '" + w.fname + "'";
        }
        MacVal l = new MacVal();
        MacVal r = new MacVal();
        string err = macWalkExpr(w, e.child(0), false, base, l);
        if (err.length > 0) { return err; }
        err = macWalkExpr(w, e.child(1), false, base + 1, r);
        if (err.length > 0) { return err; }
        if (l.kind == 3 || r.kind == 3) {
            return "string values in '" + w.fname + "'";
        }
        if (l.kind == 4 || r.kind == 4) {
            if (l.kind != 4 || r.kind != 4) {
                return "mixed int and float operands in '" + w.fname + "'";
            }
            if (op == OP_MOD) {
                return "unsupported float operation in '" + w.fname + "'";
            }
            // Float division never traps (zero divisor yields infinity,
            // exactly like the tree-walk), so no printf import is needed.
            out.kind = 4;
            out.depth = macMax(l.depth, 1 + r.depth);
            return "";
        }
        w.ctx.usesPrintf = true;
        out.kind = 0;
        out.depth = macMax(l.depth, 1 + r.depth);
        return "";
    }
    if (op == OP_EQ || op == OP_NEQ || op == OP_LT || op == OP_LEQ || op == OP_GT || op == OP_GEQ) {
        if (e.childCount() < 2) {
            return "unsupported expression in '" + w.fname + "'";
        }
        MacVal l = new MacVal();
        MacVal r = new MacVal();
        string err = macWalkExpr(w, e.child(0), false, base, l);
        if (err.length > 0) { return err; }
        err = macWalkExpr(w, e.child(1), false, base + 1, r);
        if (err.length > 0) { return err; }
        if (l.kind == 3 || r.kind == 3) {
            return "string values in '" + w.fname + "'";
        }
        if (l.kind == 4 || r.kind == 4) {
            if (l.kind != 4 || r.kind != 4) {
                return "mixed int and float operands in '" + w.fname + "'";
            }
        }
        out.kind = 1;
        out.depth = macMax(l.depth, 1 + r.depth);
        return "";
    }
    if (op == OP_AND || op == OP_OR) {
        if (e.childCount() < 2) {
            return "unsupported expression in '" + w.fname + "'";
        }
        MacVal l = new MacVal();
        MacVal r = new MacVal();
        string err = macWalkExpr(w, e.child(0), false, base, l);
        if (err.length > 0) { return err; }
        err = macWalkExpr(w, e.child(1), false, base, r);
        if (err.length > 0) { return err; }
        if (l.kind == 3 || r.kind == 3) {
            return "string values in '" + w.fname + "'";
        }
        if (l.kind == 4 || r.kind == 4) {
            return "float logic operands in '" + w.fname + "'";
        }
        out.kind = 1;
        out.depth = macMax(l.depth, r.depth);
        return "";
    }
    // Port ops 20/14/15/16/28/17/29 are the assign family (plain, +=, -=,
    // *=, the << move form, /=, %=); here they are 13/14/15/16/21/17/27 —
    // same strings. Compound division lowers through the guarded sequence,
    // which prints on a zero divisor.
    if (op == OP_ASSIGN || op == OP_ADD_ASSIGN || op == OP_SUB_ASSIGN || op == OP_MUL_ASSIGN || op == OP_MOVE || op == OP_DIV_ASSIGN || op == OP_MOD_ASSIGN) {
        if (e.childCount() < 2) {
            return "unsupported expression in '" + w.fname + "'";
        }
        Node t = e.child(0);
        if (t.kind != ND_IDENT) {
            return "complex assignment targets in '" + w.fname + "'";
        }
        int vari = macFindVar(w, t.name);
        if (vari < 0) {
            return "unknown variable '" + t.name + "' in '" + w.fname + "'";
        }
        MacVal v = new MacVal();
        string err = macWalkExpr(w, e.child(1), false, base, v);
        if (err.length > 0) { return err; }
        if (v.kind == 3) {
            return "string values in '" + w.fname + "'";
        }
        bool targetFloat = w.varKinds[vari] == "f";
        if (op == OP_ASSIGN) {
            if (targetFloat != (v.kind == 4)) {
                return "mixed int and float operands in '" + w.fname + "'";
            }
        } else {
            if (targetFloat || v.kind == 4) {
                return "unsupported float operation in '" + w.fname + "'";
            }
        }
        if (op == OP_DIV_ASSIGN || op == OP_MOD_ASSIGN) {
            w.ctx.usesPrintf = true;
        }
        out.kind = v.kind;
        out.depth = v.depth;
        return "";
    }
    // No inc/dec operator survives parsing in this AST (++ / -- desugar
    // to += / -= 1, which ride the assign arm above with identical
    // strings to the reference PostInc/PreInc handling).
    if (op == OP_COALESCE) {
        return "null coalescing in '" + w.fname + "'";
    }
    return "unsupported binary operator in '" + w.fname + "'";
}

private string macWalkCall(MacWalk w, Node e, bool inStmt, int base, MacVal out) {
    if (e.name == "print" || e.name == "printline") {
        if (!inStmt) {
            return "print used as a value in '" + w.fname + "'";
        }
        if (e.childCount() != 1) {
            return "multi-argument print in '" + w.fname + "'";
        }
        Node arg = e.child(0);
        if (arg.kind == ND_STRING_LIT) {
            w.ctx.usesPrintf = true;
            out.kind = 0;
            out.depth = 0;
            return "";
        }
        MacVal v = new MacVal();
        string err = macWalkExpr(w, arg, false, base, v);
        if (err.length > 0) { return err; }
        // String and float64 arguments print through the concat/format
        // helpers: their admittable shapes were already established while
        // walking the operand above (anything else errored there first).
        w.ctx.usesPrintf = true;
        out.kind = 0;
        out.depth = v.depth;
        return "";
    }
    if (e.name == "printf") {
        return "explicit 'printf' calls in '" + w.fname + "'";
    }
    if (e.name == "exit") {
        return macWalkExit(w, e, inStmt, base, out);
    }
    int si = macFindSig(w.ctx, e.name);
    if (si < 0) {
        return "call to unknown function '" + e.name + "' in '" + w.fname + "'";
    }
    string pks = w.ctx.sigParams[si];
    if (e.childCount() != pks.length) {
        return "arity mismatch calling '" + e.name + "' (takes " + (string)pks.length + ", given " + (string)e.childCount() + ") in '" + w.fname + "'";
    }
    int depth = 0;
    for (int i = 0; i < e.childCount(); i++) {
        MacVal v = new MacVal();
        string err = macWalkExpr(w, e.child(i), false, base + i, v);
        if (err.length > 0) { return err; }
        if (v.kind == 3) {
            return "string values in '" + w.fname + "'";
        }
        if (v.kind == 4) {
            return "float call arguments in '" + w.fname + "'";
        }
        depth = macMax(depth, i + v.depth);
    }
    string ret = w.ctx.sigRets[si];
    if (ret == "v") {
        if (!inStmt) {
            return "void call used as a value in '" + w.fname + "'";
        }
        out.kind = 0;
        out.depth = depth;
        return "";
    }
    if (ret == "i") { out.kind = 0; }
    else if (ret == "b") { out.kind = 1; }
    else { out.kind = 2; }
    out.depth = macMax(depth, 1);
    return "";
}

// Check a method call: only the zero-argument time.now() clock reads as a
// native QPC thunk (float64 milliseconds, the exact derivation in
// silverc/std/time.sr now()). The receiver must be the time module itself —
// a program-local `time` variable keeps the honest method-call fallback —
// and anything else does too.
private string macWalkMethod(MacWalk w, Node e, bool inStmt, int base, MacVal out) {
    if (e.name == "now" && e.childCount() == 1) {
        Node recv = e.child(0);
        if (recv.kind == ND_IDENT && recv.name == "time") {
            if (macFindVar(w, "time") < 0 && macFindConst(w.ctx, "time") < 0) {
                out.kind = 4;
                out.depth = 1;
                return "";
            }
        }
    }
    return "method calls in '" + w.fname + "'";
}

// Check a string-concat addition: the admittable shapes are a literal on
// the left with an int or float64 scalar on the right (the printline forms
// the benchmark needs), or two literals (folded at lowering). The string
// side must be a literal — never a computed string — so no intermediate
// buffer can be live: nested concats keep the honest "string values"
// fallback. Scalar on the left, bool/char scalars, and any other string
// operator do too.
private string macWalkConcat(MacWalk w, Node e, MacVal l, MacVal r, int base, MacVal out) {
    if (e.op != OP_ADD) {
        return "string values in '" + w.fname + "'";
    }
    if (e.childCount() < 2) {
        return "unsupported expression in '" + w.fname + "'";
    }
    bool leftLit = tierIsStringLit(e.child(0));
    bool rightLit = tierIsStringLit(e.child(1));
    if (leftLit && rightLit) {
        if (!winStrNative(tierStringLitText(e.child(0))) || !winStrNative(tierStringLitText(e.child(1)))) {
            return "unicode string literal in '" + w.fname + "'";
        }
        out.kind = 3;
        out.depth = 0;
        return "";
    }
    if (leftLit && (r.kind == 0 || r.kind == 4)) {
        if (!winStrNative(tierStringLitText(e.child(0)))) {
            return "unicode string literal in '" + w.fname + "'";
        }
        out.kind = 3;
        out.depth = r.depth;
        return "";
    }
    return "string values in '" + w.fname + "'";
}

// True for a string literal possibly wrapped in parentheses. Shared by the
// predicate and the lowering so both agree on the concat shapes.
private bool tierIsStringLit(Node e) {
    Node t = e;
    while (t.kind == ND_PAREN && t.childCount() > 0) { t = t.child(0); }
    return t.kind == ND_STRING_LIT;
}

// Spelling of a string literal possibly wrapped in parentheses.
private string tierStringLitText(Node e) {
    Node t = e;
    while (t.kind == ND_PAREN && t.childCount() > 0) { t = t.child(0); }
    return t.strVal;
}

// Spelling of a float literal possibly wrapped in parentheses, or "" when
// the node is not one. The tree-walk prints literal spellings verbatim
// (makeFloatStr), so direct-literal print/concat folds the same text while
// computed floats (and spelled locals, via winVarSpell) take their own
// exact paths. A unary minus is NOT a literal: its value is computed.
private string tierFloatLitText(Node e) {
    Node t = e;
    while (t.kind == ND_PAREN && t.childCount() > 0) { t = t.child(0); }
    if (t.kind == ND_FLOAT_LIT) { return t.strVal; }
    return "";
}

// Literal spelling remembered for a float local, or "" when the operand is
// not a spelled local (params, computed values, and cleared vars print with
// %g exactly like the tree-walk's makeFloat).
private string winVarSpell(WinFn fn, Node e) {
    Node t = e;
    while (t.kind == ND_PAREN && t.childCount() > 0) { t = t.child(0); }
    if (t.kind != ND_IDENT) { return ""; }
    int vi = fn.findVar(t.name);
    if (vi < 0 || vi >= fn.varSpells.length) { return ""; }
    return fn.varSpells[vi];
}
// Check an explicit exit call: statement position only (exit ends the
// process, so a value use is meaningless), with zero arguments (code 0) or
// exactly one integer argument. Anything else keeps the honest
// "explicit 'exit' calls" fallback. The lowering binds exit(int) to the
// ExitProcess import (winLowerExit), matching the tree-walk builtin which
// exits the process with the same code.
private string macWalkExit(MacWalk w, Node e, bool inStmt, int base, MacVal out) {
    if (!inStmt) {
        return "explicit 'exit' calls in '" + w.fname + "'";
    }
    if (e.childCount() == 0) {
        out.kind = 0;
        out.depth = 0;
        return "";
    }
    if (e.childCount() != 1) {
        return "explicit 'exit' calls in '" + w.fname + "'";
    }
    MacVal v = new MacVal();
    string err = macWalkExpr(w, e.child(0), false, base, v);
    if (err.length > 0) { return err; }
    if (v.kind != 0) {
        return "explicit 'exit' calls in '" + w.fname + "'";
    }
    out.kind = 0;
    out.depth = v.depth;
    return "";
}

// ---------------------------------------------------------------------------
// Native object runner helpers (see the NATIVE RUNNER notice at the top).
// Raw OS calls live each in their own single chained region; everything
// else is shared portable code. Non-Windows bodies report absence (0) so
// callers fall back loudly without ever transferring control.
// ---------------------------------------------------------------------------

// One RWX block of `size` bytes (MEM_COMMIT zero-fill,
// PAGE_EXECUTE_READWRITE): 12288 = MEM_COMMIT|MEM_RESERVE, 64 = PAGE_XRW.
// 0 when the mapping fails (caller falls back loudly).
private int objNatAlloc(int size) {
    #on WINDOWS
    return VirtualAlloc(null, size, 12288, 64);
    #else
    return 0;
    #off
}

// Raw copy of `n` bytes from the Silver string `src` to address `dst`.
// Callers only pass NUL-free chunks (see objNatBlit).
private void objNatCopy(int dst, string src, int n) {
    #on WINDOWS
    memcpy(dst, src, n);
    #else
    return;
    #off
}

// Call the machine code at `addr` with no arguments and marshal RAX back
// (the DOCS/259 G3 indirect-call shape: the address rides an int[] slot).
private int objNatCall(int addr) {
    #on WINDOWS
    int[] slots = [];
    slots.add(addr);
    return slots[0]();
    #else
    return 0;
    #off
}

// Release one block mapped by objNatAlloc (32768 = MEM_RELEASE).
private void objNatFree(int addr) {
    #on WINDOWS
    VirtualFree(addr, 0, 32768);
    #else
    return;
    #off
}

// High-resolution tick counter for the native-call timing below.
private int64 objNatTicks() {
    #on WINDOWS
    int64 c = 0;
    QueryPerformanceCounter(&c);
    return c;
    #else
    return 0;
    #off
}

// Tick frequency matching objNatTicks (0 when unavailable: no timing).
private int64 objNatFreq() {
    #on WINDOWS
    int64 f = 0;
    QueryPerformanceFrequency(&f);
    return f;
    #else
    return 0;
    #off
}

// Copy `bytes` (low-byte int[] values, NULs included) onto the RWX block at
// `base`: Silver strings are C strings, so .length stops at the first NUL
// and one memcpy cannot carry NUL bytes. The block arrives zero-filled, so
// NUL positions need no copy — only the NUL-free runs between them move,
// at their true offsets. Exact for every payload, including all-NUL ones.
private void objNatBlit(int base, int[] bytes) {
    int start = 0;
    while (start < bytes.length) {
        while (start < bytes.length && bytes[start] == 0) { start++; }
        if (start >= bytes.length) { break; }
        int end = start;
        while (end < bytes.length && bytes[end] != 0) { end++; }
        string chunk = "";
        for (int i = start; i < end; i++) {
            chunk = chunk + char(bytes[i]);
        }
        objNatCopy(base + start, chunk, chunk.length);
        start = end;
    }
}

// Import index of an __slv_imp_N symbol name (-1 when it is not one).
// The N selects the note's import list entry (dll + name), which the
// runner resolves to a real export address for its import thunk.
private int objImportIndex(string sym) {
    string prefix = objImportPrefix();
    if (sym.length <= prefix.length) { return -1; }
    if (icSliceRange(sym, 0, prefix.length) != prefix) { return -1; }
    string digits = icSliceRange(sym, prefix.length, sym.length);
    if (!digits.isDigits()) { return -1; }
    return (int)digits;
}

// Resolve dll!name to a live export address (0 when unavailable — the
// caller falls back loudly). The handle comes from the already-loaded
// module, so no library is loaded as a side effect.
private int winResolveImport(string dll, string name) {
    int h = winModHandle(dll);
    if (h == 0) { return 0; }
    return winProcAddr(h, name);
}

private int winModHandle(string name) {
    #on WINDOWS
    return GetModuleHandleA(name);
    #else
    return 0;
    #off
}

private int winProcAddr(int h, string name) {
    #on WINDOWS
    return GetProcAddress(h, name);
    #else
    return 0;
    #off
}

// Apply the parsed relocations onto the mutable `code` image for a block
// laid out as code@[base, base+len) with the .rdata coat at `rdataBase` and
// one 12-byte absolute-jump import thunk per note import at `thunkBase`:
// ABS64 sites take the datab (or other defined) address plus the site-byte
// addend, REL32 sites take target-(site+4). UNDEF __slv_imp_N imports bind
// their thunk (resolved by the caller to the real export). Any other
// undefined target is unresolvable in-process. Returns "" or the loud
// fallback reason (never a silent mislink).
private string objApplyRelocs(ParsedObj obj, int[] code, int base, int rdataBase, int thunkBase, int[] importAddrs) {
    for (int i = 0; i < obj.relSites.length; i++) {
        int site = obj.relSites[i];
        int sni = obj.relSyms[i];
        int kind = obj.relKinds[i];
        if (sni < 0 || sni >= obj.symNames.length) { return "object runner: relocation targets a missing symbol"; }
        string sym = obj.symNames[sni];
        int sect = obj.symSects[sni];
        int val = obj.symVals[sni];
        if (kind == 1) {
            if (site < 0 || site + 8 > code.length) { return "object runner: ABS64 site out of range"; }
            int64 target = 0;
            if (sect == 1) { target = int64(base + val); }
            else if (sect == 2) { target = int64(rdataBase + val); }
            else { return "object runner: unresolvable relocation target '" + sym + "'"; }
            target += obj.relAddends[i];
            for (int b = 0; b < 8; b++) { code[site + b] = int((target >> (b * 8)) & 0xFF); }
        } else {
            if (site < 0 || site + 4 > code.length) { return "object runner: REL32 site out of range"; }
            int64 target = 0;
            if (sect == 0) {
                int impIdx = objImportIndex(sym);
                if (impIdx < 0 || impIdx >= importAddrs.length) { return "object runner: unresolvable import '" + sym + "'"; }
                target = int64(thunkBase + impIdx * 12);
            } else if (sect == 1) { target = int64(base + val); }
            else if (sect == 2) { target = int64(rdataBase + val); }
            else { return "object runner: unresolvable relocation target '" + sym + "'"; }
            int64 rel = target - int64(base + site + 4);
            if (rel < -2147483648 || rel > 2147483647) { return "object runner: REL32 relocation out of range"; }
            for (int b2 = 0; b2 < 4; b2++) { code[site + b2] = int((rel >> (b2 * 8)) & 0xFF); }
        }
    }
    return "";
}

// An open object-cache session for one project and one host target.
class ObjSession {
    public prop bool ok;
    public prop string dir;
    public prop string root;
    public prop string projectName;
    public prop string targetOs;
    public prop string flags;
    public prop int createdStamp;
    // Native-call cost of the last runNative success, in microseconds (-1
    // when the host clock was unavailable). Read by the driver for --diag.
    public prop int lastNativeUs;
    // Record arrays keyed by /-separated relative path.
    public prop string[] keys;
    public prop int[] cTimes;
    public prop int[] mTimes;
    public prop int[] hashes;
    public prop int[] cachedAt;
    // Files observed this run: the source FNV-1 hash plus the `.sr`
    // modification time (the shared driver pair — no re-hash, no second
    // stat), and which tier fed the driver's tokens (1 = synced .srbc text,
    // 0 = fresh source).
    public prop string[] notedKeys;
    public prop int[] notedC;
    public prop int[] notedM;
    public prop int[] notedH;
    public prop int[] notedStamps;
    public prop int[] notedTiers;
    // RAM-staged entry bytes: the last fully-read .o of this run (set by the
    // freshness probe and the unify/verify reads on success). Within a
    // single run, validated artifacts stay RAM-resident between stages —
    // disk is cross-run persistence only (OVERHAUL.md): the unify step and
    // the runner consume the staged bytes without re-reading the files.
    public prop string stagedKey;
    public prop int64 stagedHash;
    public prop byte[] stagedBytes;
    // Real lowering input: the driver's parsed entry program (set via
    // setLowProgram before finish), and the loud skip reason ("": emit and
    // run normally). Out-of-tier entries emit nothing — never a stub — and
    // the driver continues from the verified tiers with this reason.
    public prop Node[] lowProgram;
    public prop bool lowHasProgram;
    public prop string lowSkip;

    // Open (or prepare) the object cache for `projName` rooted at `rootDir`,
    // targeting the auto-detected host (`hostOsName`, interpHostOs). When
    // the per-host cache root cannot be determined the session reports
    // !ok and callers fall back to the uncached tiers.
    //
    // Cross-target use: constructing with "LINUX" opens the linux-x86-64
    // directory under the same per-host cache root (the #on regions below
    // pick the ROOT by build host, objTargetDirName picks the SUBDIR by
    // this parameter) — the same trigger rule as the compilers' --os linux,
    // with per-target freshness from that directory's own project.sbcr —
    // and constructing with "MAC" opens mac-aarch64 the same way (the
    // Mach-O writer/validators serve that directory, on a Mac host and for
    // cross-target caches alike).
    // The driver always passes the auto-detected host (there is no --os
    // flag); the LINUX and MAC writers/validators are the implementation
    // that serves those directories, on their native hosts and for
    // cross-target caches alike.
    construct (string rootDir, string projName, string hostOsName) {
        this.ok = false;
        this.root = rootDir;
        this.projectName = projName;
        this.targetOs = hostOsName;
        this.flags = objFlagKey();
        this.createdStamp = icNowMillis();
        this.keys = [];
        this.cTimes = [];
        this.mTimes = [];
        this.hashes = [];
        this.cachedAt = [];
        this.notedKeys = [];
        this.notedC = [];
        this.notedM = [];
        this.notedH = [];
        this.notedStamps = [];
        this.notedTiers = [];
        this.stagedKey = "";
        this.stagedHash = 0;
        this.stagedBytes = [];
        this.lowProgram = [];
        this.lowHasProgram = false;
        this.lowSkip = "";
        this.lastNativeUs = -1;
        string guarded = icSanitize(projName);
        string sub = objTargetDirName(hostOsName);
        #on WINDOWS
        string appdata = fs.getenv("APPDATA");
        if (appdata.length == 0) { return; }
        this.dir = appdata + "\\silver cache\\" + guarded + "\\" + sub;
        #on LINUX
        this.dir = "/var/cache/silver/" + guarded + "/" + sub;
        #on MAC
        this.dir = "/Library/Caches/Silver/" + guarded + "/" + sub;
        #off
        icEnsureDirTree(this.dir);
        this.loadRecords();
        this.ok = true;
    }

    public int findRecord(string key) {
        for (int i = 0; i < this.keys.length; i++) {
            if (this.keys[i] == key) { return i; }
        }
        return -1;
    }

    private int findNoted(string key) {
        for (int i = 0; i < this.notedKeys.length; i++) {
            if (this.notedKeys[i] == key) { return i; }
        }
        return -1;
    }

    private void stageBytes(string key, int64 hash, byte[] raw) {
        this.stagedKey = key;
        this.stagedHash = hash;
        this.stagedBytes = raw;
    }

    private bool hasStaged(string key, int64 hash) {
        if (this.stagedKey != key) { return false; }
        if (this.stagedHash != hash) { return false; }
        return this.stagedBytes.length > 0;
    }

    // Observe the entry source. Freshness keys on the `.sr` modification
    // time plus the source FNV-1 hash — the same pair the driver stat-ed and
    // hashed once for the bytecode tier (OVERHAUL.md freshness steps 1-2, no
    // re-hash and no second stat here). Out-of-root entries are skipped: they
    // still run normally, they just are not object-cached.
    public void noteFileHashed(string absPath, int64 srcHash, int mtimeVal, bool fromBytecode) {
        if (!this.ok) { return; }
        string key = icRelPath(this.root, absPath);
        if (key.length == 0) { return; }
        if (objIsLocalKey(key) == 0) { return; }
        int stamp = icNowMillis();
        int tier = 0;
        if (fromBytecode) { tier = 1; }
        int idx = this.findNoted(key);
        if (idx >= 0) {
            this.notedC[idx] = stamp;
            this.notedM[idx] = mtimeVal;
            this.notedH[idx] = srcHash;
            this.notedStamps[idx] = stamp;
            this.notedTiers[idx] = tier;
            return;
        }
        this.notedKeys.add(key);
        this.notedC.add(stamp);
        this.notedM.add(mtimeVal);
        this.notedH.add(srcHash);
        this.notedStamps.add(stamp);
        this.notedTiers.add(tier);
    }

    // Hand the driver's parsed entry program to the real-lowering path
    // (called before finish; without it the x86-64 path skips silently and
    // the driver surfaces the parse diagnostics itself).
    public void setLowProgram(Node[] program) {
        this.lowProgram = program;
        this.lowHasProgram = true;
    }

    // Execution-plan probe for the driver's entry (OVERHAUL.md object-tier
    // hit): the record matches, the .o exists, and its note peeks with the
    // expected flag set + hash — with the bytes staged in RAM on success, so
    // the verify/run below consume them without re-reading the files. A hit
    // means the entry lowered natively before (out-of-tier entries emit no
    // object at all), so the driver may run from the staged object without
    // lexing, parsing, or syncing any tier first.
    public bool probeFresh(string absPath) {
        string key = icRelPath(this.root, absPath);
        int n = this.findNoted(key);
        if (n < 0) { return false; }
        return this.isFresh(n);
    }

    // Absolute path of the .o for a record key (mirrors the project tree,
    // always with the .o extension — never .obj).
    private string objectPath(string key) {
        int slash = -1;
        int dot = -1;
        for (int i = 0; i < key.length; i++) {
            if (key[i] == '/') { slash = i; }
            if (key[i] == '.') { dot = i; }
        }
        string base = key;
        if (dot > slash) { base = icSliceRange(key, 0, dot); }
        #on LINUX or MAC
        return this.dir + "/" + base + ".o";
        #off
        return this.dir + "\\" + base.replaceAll("/", "\\") + ".o";
    }

    // Freshness probe for one noted entry (mirrors the reference plan()):
    // the record matches (`.sr` mtime first, then source hash), the .o
    // exists, and its v5 note peeks with the expected flag set + hash.
    // Anything else - a changed source, a missing file, a v4-era object, a
    // foreign object, a compiler-emitted object under another flag set - is
    // stale (re-emit), never a hard error here and never silently reused.
    private bool isFresh(int n) {
        int idx = this.findRecord(this.notedKeys[n]);
        if (idx < 0) { return false; }
        if (this.mTimes[idx] != this.notedM[n]) { return false; }
        if (this.hashes[idx] != this.notedH[n]) { return false; }
        string probe = this.objectPath(this.notedKeys[n]);
        if (probe.length == 0 || !file.exists(probe)) { return false; }
        byte[] raw = [];
        try {
            raw = file.read(probe);
        } catch (int e) {
            return false;
        }
        if (raw.length == 0) { return false; }
        ObjReader r = new ObjReader(raw);
        ObjNote note = new ObjNote();
        if (!objPeekNote(r, this.targetOs, note)) { return false; }
        if (note.flags != this.flags) { return false; }
        if (note.hash != int64(this.notedH[n])) { return false; }
        if (this.stubEra(raw)) { return false; }
        // Validated: stage the bytes so the unify step and the runner below
        // consume them from RAM instead of re-reading the files.
        this.stageBytes(this.notedKeys[n], int64(this.notedH[n]), raw);
        return true;
    }

    // True when a .o is stub-era (its symbol table still references
    // the retired proof-stub seam): structurally valid but carrying no
    // program logic, so the planner treats it as stale and the entry
    // re-emits with real lowering. Every target lowers real program logic
    // now, so no fresh object references the seam on any target.
    private bool stubEra(byte[] raw) {
        ObjReader r = new ObjReader(raw);
        ParsedObj obj = new ParsedObj();
        if (objParseObject(r, this.targetOs, obj).length > 0) { return true; }
        for (int s = 0; s < obj.symNames.length; s++) {
            if (obj.symSects[s] == 0 && obj.symNames[s] == objInterpRunSym()) { return true; }
        }
        return false;
    }

    // Re-emit changed objects, merge the per-target record (+ .sbcri text
    // companion), then unify: fully parse the cached + refreshed objects
    // with the built-in readers before the driver runs from the verified
    // tokens. Returns "" on success, else the exact reference error — fails
    // loudly (never silently) when an object is missing or corrupt.
    public string finish() {
        this.sortNoted();
        for (int n = 0; n < this.notedKeys.length; n++) {
            if (!this.isFresh(n)) {
                // Real program lowering (never a stub): without a parsed
                // program the driver surfaces parse diagnostics itself,
                // so skip silently; out-of-tier entries record the loud
                // reason and emit nothing.
                if (!this.lowHasProgram) { continue; }
                ObjUnit unit = new ObjUnit();
                string lerr = "";
                if (this.targetOs == "MAC") {
                    lerr = armLowerUnit(this.notedKeys[n], int64(this.notedH[n]), this.notedM[n], this.notedStamps[n], this.lowProgram, unit);
                } else {
                    // Calling convention for the session target: Win64 on
                    // WINDOWS, SysV on LINUX (same ISA, same tier predicate).
                    int abi = 0;
                    if (this.targetOs == "LINUX") { abi = 1; }
                    lerr = winLowerUnit(this.notedKeys[n], int64(this.notedH[n]), this.notedM[n], this.notedStamps[n], this.lowProgram, unit, abi);
                }
                if (lerr.length > 0) {
                    this.lowSkip = lerr;
                    continue;
                }
                if (objTooManyRelocs(unit)) {
                    return "object cache: too many relocations in '" + this.notedKeys[n] + "' for one object file (v1 boundary)";
                }
                string objPath = this.objectPath(this.notedKeys[n]);
                if (objPath.length == 0) {
                    return "object cache: cannot place object for '" + this.notedKeys[n] + "'";
                }
                icEnsureDirTree(icDirname(objPath));
                int[] bytes = emitObject(unit, this.flags, int64(this.notedH[n]), this.notedStamps[n], this.targetOs);
                file.writeBytes(objPath, bytes);
                if (!file.exists(objPath) || file.getSize(objPath) != bytes.length) {
                    return "object cache: cannot write " + objPath + ": verification failed";
                }
                int idx = this.findRecord(this.notedKeys[n]);
                if (idx >= 0) {
                    this.mTimes[idx] = this.notedM[n];
                    this.hashes[idx] = this.notedH[n];
                    this.cachedAt[idx] = this.notedStamps[n];
                } else {
                    this.keys.add(this.notedKeys[n]);
                    this.cTimes.add(this.notedC[n]);
                    this.mTimes.add(this.notedM[n]);
                    this.hashes.add(this.notedH[n]);
                    this.cachedAt.add(this.notedStamps[n]);
                }
            }
        }

        this.sortRecords();

        // Reference-format binary record (v3: SBCR magic, version, creation
        // stamp, project name, emitting flag set, then per-file entries),
        // little-endian, byte-exact for other toolchains.
        ObjWriter w = new ObjWriter();
        w.rawStr("SBCR");
        w.u16(3);
        w.u64(this.createdStamp);
        w.strField(this.projectName);
        w.strField(this.flags);
        w.u32(this.keys.length);
        for (int rb = 0; rb < this.keys.length; rb++) {
            w.strField(this.keys[rb]);
            w.u64(this.cTimes[rb]);
            w.u64(this.mTimes[rb]);
            w.u64(this.hashes[rb]);
            w.u64(this.cachedAt[rb]);
        }
        string sbcrPath = "";
        string sbcriPath = "";
        #on WINDOWS
        sbcrPath = this.dir + "\\project.sbcr";
        sbcriPath = this.dir + "\\project.sbcri";
        #else
        sbcrPath = this.dir + "/project.sbcr";
        sbcriPath = this.dir + "/project.sbcri";
        #off
        icEnsureDirTree(this.dir);
        file.writeBytes(sbcrPath, w.out);

        // NUL-free text companion (authoritative read side): the SBCRI v2
        // shape plus the flag-set line the object record keys on.
        string[] lines = [];
        lines.add("SBCRI v2\n");
        lines.add("project " + icEscapeText(this.projectName) + "\n");
        lines.add("flags " + icEscapeText(this.flags) + "\n");
        lines.add("created " + (string)this.createdStamp + "\n");
        for (int re = 0; re < this.keys.length; re++) {
            lines.add(icEscapeText(this.keys[re]) + " " + (string)this.cTimes[re] + " " + (string)this.mTimes[re] + " " + icHex16(int64(this.hashes[re])) + " " + (string)this.cachedAt[re] + "\n");
        }
        file.writeString(sbcriPath, lines.join(""));

        // Built-in unification: every object of this run must be present
        // and fully valid (container magic, target machine, sections,
        // symbols, relocations, flag set, source hash, globals-block
        // agreement) before the driver executes from the verified tokens.
        // Entries skipped above (no program, or out-of-tier with no
        // object emitted) are not unified: there is nothing to validate.
        for (int u = 0; u < this.notedKeys.length; u++) {
            if (!this.lowHasProgram || this.lowSkip.length > 0) { continue; }
            byte[] udata = [];
            if (this.hasStaged(this.notedKeys[u], int64(this.notedH[u]))) {
                udata = this.stagedBytes;
            } else {
                string upath = this.objectPath(this.notedKeys[u]);
                if (!file.exists(upath)) {
                    return "object cache: cannot read " + upath + ": file not found";
                }
                try {
                    udata = file.read(upath);
                } catch (int e) {
                    return "object cache: cannot read " + upath + ": file not found";
                }
                if (udata.length == 0) { return this.corruptEmpty(); }
            }
            ObjReader ur = new ObjReader(udata);
            ParsedObj parsed = new ParsedObj();
            string perr = objParseObject(ur, this.targetOs, parsed);
            if (perr.length > 0) { return perr; }
            if (parsed.flags != this.flags) {
                return "object cache: flag-set switch (object has '" + parsed.flags + "', build wants '" + this.flags + "') — re-emit required";
            }
            if (parsed.hash != int64(this.notedH[u])) {
                return "object cache: stale object (source hash changed) — re-emit required";
            }
            string gasErr = this.checkGas(parsed);
            if (gasErr.length > 0) { return gasErr; }
            // Validated: stage for the execution-path gate below, which then
            // consumes these bytes from RAM instead of re-reading the files.
            this.stageBytes(this.notedKeys[u], int64(this.notedH[u]), udata);
        }
        return "";
    }

    // Execution-path gate (called by the driver after finish()): validate
    // the entry's object fully (magic, machine, sections, symbols,
    // relocations, flag set, source hash, globals-block agreement),
    // consuming the RAM-staged bytes when a previous stage of this same run
    // already validated them. Returns "" when the object is verified —
    // execution then proceeds from the verified tokens — else the exact loud
    // error. Stale bytes are never executed.
    public string verifyObject(string absPath, int64 expectHash) {
        string key = icRelPath(this.root, absPath);
        if (key.length == 0) {
            return "object cache: cannot read " + absPath + ": file not found";
        }
        byte[] odata = [];
        if (this.hasStaged(key, expectHash)) {
            odata = this.stagedBytes;
        } else {
            string opath = this.objectPath(key);
            if (opath.length == 0 || !file.exists(opath)) {
                return "object cache: cannot read " + opath + ": file not found";
            }
            try {
                odata = file.read(opath);
            } catch (int e) {
                return "object cache: cannot read " + opath + ": file not found";
            }
            if (odata.length == 0) { return this.corruptEmpty(); }
        }
        ObjReader or = new ObjReader(odata);
        ParsedObj obj = new ParsedObj();
        string perr = objParseObject(or, this.targetOs, obj);
        if (perr.length > 0) { return perr; }
        if (obj.flags != this.flags) {
            return "object cache: flag-set switch (object has '" + obj.flags + "', build wants '" + this.flags + "') — re-emit required";
        }
        if (obj.hash != expectHash) {
            return "object cache: stale object (source hash changed) — re-emit required";
        }
        // Stub-era objects (seam UNDEF in the symbol table) carry no program
        // logic on any target: stale, never executed.
        for (int s = 0; s < obj.symNames.length; s++) {
            if (obj.symSects[s] == 0 && obj.symNames[s] == objInterpRunSym()) {
                return "object cache: stale object (source hash changed) — re-emit required";
            }
        }
        string gasErr = this.checkGas(obj);
        if (gasErr.length > 0) { return gasErr; }
        this.stageBytes(key, expectHash, odata);
        return "";
    }

    // Globals-block agreement check (the same rule the linkers enforce):
    // the interpreter always records gas 0 (no globals block; execution
    // stays on the AST/bytecode tiers for LINUX/MAC and runs natively only
    // for WINDOWS), while the self-host counts bytes and silverc-rs counts
    // slots — so mixed-toolchain objects disagree by construction.
    // disagree by construction. Any nonzero foreign gas fails LOUDLY here
    // instead of validating silently. Returns "" when the object agrees.
    private string checkGas(ParsedObj obj) {
        if (obj.gas != 0) {
            return "object cache: globals-block mismatch ('" + obj.filekey + "' vs 'interp') — re-emit required";
        }
        return "";
    }

    // In-process native execution of the entry's validated object (the
    // OVERHAUL.md fastest tier: .o execution). Call ONLY after verifyObject
    // passes on the same entry: the gate owns validation, this owns loading
    // and calling (it re-checks flags + hash on the bytes it executes, so a
    // file swapped between the two calls still cannot run stale).
    //
    // The entry runs its REAL program logic: user functions execute as
    // compiled, print output flows through the bound printf import, and the
    // divide trap prints through printf then exits the process — the same
    // observable behavior as the compiled binary. Returns "" when the
    // validated entry ran natively (lastNativeUs carries the call cost),
    // else the loud fallback reason — the driver prints it and continues
    // from the verified AST/bytecode tiers, never silently wrong. See the
    // NATIVE RUNNER notice at the top for the exact execution boundary.
    public string runNative(string absPath, int64 expectHash) {
        if (this.targetOs != "WINDOWS") {
            return "object runner: " + this.targetOs + " execution stays on the verified tiers (in-process runner is COFF/x86-64 only)";
        }
        string verr = this.verifyObject(absPath, expectHash);
        if (verr.length > 0) { return verr; }
        // verifyObject staged the validated bytes above: execute them from
        // RAM instead of re-reading the file (same run, same bytes — a file
        // swapped between the two calls still cannot run stale, because the
        // flags + hash below are re-checked on the staged bytes themselves).
        byte[] odata = this.stagedBytes;
        ObjReader or = new ObjReader(odata);
        ParsedObj obj = new ParsedObj();
        string perr = objParseObject(or, this.targetOs, obj);
        if (perr.length > 0) { return perr; }
        if (obj.flags != this.flags) {
            return "object cache: flag-set switch (object has '" + obj.flags + "', build wants '" + this.flags + "') — re-emit required";
        }
        if (obj.hash != expectHash) {
            return "object cache: stale object (source hash changed) — re-emit required";
        }
        string gasErr = this.checkGas(obj);
        if (gasErr.length > 0) { return gasErr; }
        if (obj.code.length == 0) { return "object runner: empty .text"; }
        // Resolve every note import to a live export address (msvcrt!printf,
        // kernel32!ExitProcess for lowered units). Anything else is
        // unresolvable in-process and falls back loudly below.
        int[] importAddrs = [];
        for (int k = 0; k < obj.impDlls.length; k++) {
            int addr = winResolveImport(obj.impDlls[k], obj.impNames[k]);
            if (addr == 0) {
                return "object runner: unresolvable import '" + obj.impDlls[k] + "!" + obj.impNames[k] + "'";
            }
            importAddrs.add(addr);
        }
        // Layout: code, then the .rdata coat, then one 12-byte absolute-jump
        // import thunk per note import (movabs rax,addr; jmp rax) the import
        // REL32 sites bind to — near by construction, whatever the export's
        // absolute address is.
        int total = obj.code.length + obj.data.length + importAddrs.length * 12;
        if (total > 67108864) { return "object runner: object too large (" + (string)total + " bytes)"; }
        // Entry offset: the file's own entry symbol by name, else the first
        // defined .text function. Anything else has no callable entry.
        int entryOff = -1;
        string wantEntry = objInterpEntrySym(obj.filekey, obj.hash);
        for (int s = 0; s < obj.symNames.length; s++) {
            if (obj.symSects[s] == 1 && obj.symIsFunc[s] == 1) {
                if (entryOff < 0) { entryOff = obj.symVals[s]; }
                if (obj.symNames[s] == wantEntry) { entryOff = obj.symVals[s]; }
            }
        }
        if (entryOff < 0 || entryOff >= obj.code.length) { return "object runner: no executable entry"; }
        int base = objNatAlloc(total);
        if (base == 0) { return "object runner: executable mapping failed"; }
        int rdataBase = base + obj.code.length;
        int thunkBase = rdataBase + obj.data.length;
        int[] image = [];
        for (int c = 0; c < obj.code.length; c++) { image.add(obj.code[c]); }
        string rerr = objApplyRelocs(obj, image, base, rdataBase, thunkBase, importAddrs);
        if (rerr.length > 0) {
            objNatFree(base);
            return rerr;
        }
        objNatBlit(base, image);
        objNatBlit(rdataBase, obj.data);
        for (int t = 0; t < importAddrs.length; t++) {
            int[] thunk = [72, 184, 0, 0, 0, 0, 0, 0, 0, 0, 255, 224];
            for (int q = 0; q < 8; q++) { thunk[2 + q] = int((int64(importAddrs[t]) >> (q * 8)) & 0xFF); }
            objNatBlit(thunkBase + t * 12, thunk);
        }
        int64 t0 = objNatTicks();
        objNatCall(base + entryOff);
        int64 t1 = objNatTicks();
        objNatFree(base);
        this.lastNativeUs = -1;
        int64 freq = objNatFreq();
        if (freq > 0 && t1 > t0) {
            this.lastNativeUs = int((t1 - t0) * 1000000 / freq);
        }
        return "";
    }

    // Target-appropriate "empty object" corruption error (mirrors the
    // reference read_unit spelling per target).
    private string corruptEmpty() {
        if (this.targetOs == "LINUX") { return "object cache: corrupt ELF object"; }
        if (this.targetOs == "MAC") { return "object cache: corrupt Mach-O object"; }
        return "object cache: corrupt COFF object";
    }

    // Deterministic record order: sorted by relative path (matches the
    // reference serializer).
    private void sortRecords() {
        for (int i = 1; i < this.keys.length; i++) {
            string k = this.keys[i];
            int c = this.cTimes[i];
            int m = this.mTimes[i];
            int h = this.hashes[i];
            int lc = this.cachedAt[i];
            int j = i - 1;
            while (j >= 0 && k < this.keys[j]) {
                this.keys[j + 1] = this.keys[j];
                this.cTimes[j + 1] = this.cTimes[j];
                this.mTimes[j + 1] = this.mTimes[j];
                this.hashes[j + 1] = this.hashes[j];
                this.cachedAt[j + 1] = this.cachedAt[j];
                j--;
            }
            this.keys[j + 1] = k;
            this.cTimes[j + 1] = c;
            this.mTimes[j + 1] = m;
            this.hashes[j + 1] = h;
            this.cachedAt[j + 1] = lc;
        }
    }

    private void sortNoted() {
        for (int i = 1; i < this.notedKeys.length; i++) {
            string k = this.notedKeys[i];
            int c = this.notedC[i];
            int m = this.notedM[i];
            int h = this.notedH[i];
            int lc = this.notedStamps[i];
            int t = this.notedTiers[i];
            int j = i - 1;
            while (j >= 0 && k < this.notedKeys[j]) {
                this.notedKeys[j + 1] = this.notedKeys[j];
                this.notedC[j + 1] = this.notedC[j];
                this.notedM[j + 1] = this.notedM[j];
                this.notedH[j + 1] = this.notedH[j];
                this.notedStamps[j + 1] = this.notedStamps[j];
                this.notedTiers[j + 1] = this.notedTiers[j];
                j--;
            }
            this.notedKeys[j + 1] = k;
            this.notedC[j + 1] = c;
            this.notedM[j + 1] = m;
            this.notedH[j + 1] = h;
            this.notedStamps[j + 1] = lc;
            this.notedTiers[j + 1] = t;
        }
    }

    // Record loading (the NUL-free text companion is authoritative).
    private void loadRecords() {
        string sbcriPath = this.dir + "\\project.sbcri";
        #on LINUX or MAC
        sbcriPath = this.dir + "/project.sbcri";
        #off
        string text = "";
        try {
            text = file.readString(sbcriPath);
        } catch (int e) {
            text = "";
        }
        if (text.length == 0) { return; }
        string storedFlags = this.flags;
        bool sawFlags = false;
        int pos = 0;
        while (pos < text.length) {
            int eol = pos;
            while (eol < text.length && text[eol] != '\n') { eol++; }
            string line = icSliceRange(text, pos, eol);
            pos = eol + 1;
            if (line.startsWith("flags ")) {
                storedFlags = icUnescapeText(icSliceRange(line, 6, line.length));
                sawFlags = true;
            } else if (line.startsWith("created ")) {
                string num = icSliceRange(line, 8, line.length);
                if (num.isDigits()) { this.createdStamp = (int)num; }
            } else if (line.startsWith("project ") || line == "SBCRI v2") {
                continue;
            } else if (line.length > 0) {
                // Entry: <rel> <created> <modified> <hexhash> <cached>.
                // The path may hold spaces, so the last four fields cut
                // from the right.
                int s1 = -1;
                int s2 = -1;
                int s3 = -1;
                int s4 = -1;
                int fieldCount = 0;
                for (int i = 0; i < line.length; i++) {
                    if (line[i] == ' ') {
                        s1 = s2;
                        s2 = s3;
                        s3 = s4;
                        s4 = i;
                        fieldCount++;
                    }
                }
                if (fieldCount < 4) { continue; }
                string rel = icUnescapeText(icSliceRange(line, 0, s1));
                string created = icSliceRange(line, s1 + 1, s2);
                string modified = icSliceRange(line, s2 + 1, s3);
                string hex = icSliceRange(line, s3 + 1, s4);
                string cached = icSliceRange(line, s4 + 1, line.length);
                if (!created.isDigits() || !modified.isDigits() || !cached.isDigits()) { continue; }
                if (!icIsHex(hex)) { continue; }
                this.keys.add(rel);
                this.cTimes.add((int)created);
                this.mTimes.add((int)modified);
                this.hashes.add(icParseHex(hex));
                this.cachedAt.add((int)cached);
            }
        }
        if (sawFlags && storedFlags != this.flags) {
            // A flag-set switch invalidates every object: start from an
            // empty record (keeping the original creation stamp) instead
            // of silently reusing objects emitted under different flags.
            while (this.keys.length > 0) { this.keys.pop(); }
            while (this.cTimes.length > 0) { this.cTimes.pop(); }
            while (this.mTimes.length > 0) { this.mTimes.pop(); }
            while (this.hashes.length > 0) { this.hashes.pop(); }
            while (this.cachedAt.length > 0) { this.cachedAt.pop(); }
        }
    }
}