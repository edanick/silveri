mod export objcache;

import * from cache;
import * from ast;

// Raw OS enablers for the native object runner below (kernel32 executable
// mapping + high-resolution timing, msvcrt copy) — file-top grant,
// mirroring the unified std fold shape (cache.sr, resource.sr).
#on WINDOWS
import * from win32.kernel32;
import * from win32.msvcrt;
#on LINUX
import * from linux.libc;
#on MAC
import * from mac.libsystem;
#off

// OVERHAUL.md --cache-object — persistent per-target object cache for the
// interpreter, plus the built-in object validation tier (the third execution
// tier beside .sr AST interpretation and .srbc bytecode interpretation).
//
// One entry per project per target OS + architecture, a tier above
// --cache-bytecode: object emission packs genuine machine code and falls
// back to nothing — the payload is always emittable, so passing both flags
// together is the fastest configuration, but --cache-object works on its
// own too. There is no --os in silveri: the target comes from host
// auto-detection (interpHostOs in main.sr), and the architecture follows
// the target — x86-64 for Windows/Linux, aarch64 for mac.
//
// Layout under the same per-host cache root as --cache-bytecode.
// Bytecode lives in <project>\bytecode\, objects live in
// <project>\<os>-<arch>\ (both under that root):
//
//   <project>\bytecode\project.sbcr              # record for the bytecode tier
//   <project>\bytecode\src\main.srbc             # bytecode mirrors the project tree
//   <project>\windows-x86-64\project.sbcr     # record for THIS target only
//   <project>\windows-x86-64\src\main.o       # objects mirror the project tree
//   <project>\linux-x86-64\project.sbcr       # separate record per target
//   <project>\mac-aarch64\project.sbcr        # separate record per target
//
// (On Linux/macOS the same tree applies with / separators.)
//
// Two-tier workflow: object emission packs the synced .srbc text (under
// bytecode\) when the bytecode tier hit, otherwise freshly lexed source.
//
// Object format (v5 — mirrors silverc-rs src/objcache.rs and
// silverc/compiler/objcache.sr byte-exactly):
//
// The extension is always .o (never .obj); the contents are the proper
// relocatable object format for the target, emitted by the built-in writers
// below — COFF (IMAGE_FILE_MACHINE_AMD64) on Windows, ELF relocatable
// (ET_REL, EM_X86_64) on Linux, Mach-O object (MH_OBJECT, ARM64) on mac.
// The Linux object carries 9 section headers (NULL, .text, .rdata, .slvnote,
// .shstrtab, .symtab, .strtab, .rela.text, and the empty-but-present
// .rela.data), exactly like the references; older 8-section objects (no
// .rela.data) still validate. The mac object carries LC_SEGMENT_64
// (__TEXT with __text, __rdata, __slvnote) + LC_SYMTAB + LC_DYSYMTAB,
// exactly like the references. No external linker, assembler, or object
// toolchain of any kind (FORBIDDEN.md): the containers are assembled here
// with plain byte pushes over int[] buffers so cached objects validate
// across the toolchain.
//
// Every object carries three real sections plus the container's symbol and
// relocation tables:
//
// - .text — GENUINE MACHINE CODE assembled by the interpreter's own Silver
//   emitter (interpBuildUnit below, following the silverc port's approach:
//   one entry stub per file, cross-tier references left as relocations).
//   Never source text, never a token stream. On x86-64 targets the stub is
//   real x86-64 (frame prologue, hash materialization, a REL32 call to the
//   runner seam, an ABS64 data reference, epilogue); on mac it is real
//   ARM64 (an adrp+add pair addressing the data anchor, a BRANCH26 bl to
//   the runner seam, hash materialization into x0, ret). v4 objects
//   (SLVOBJ2 note, including the relocation-less ARM64 stub era) fail the
//   v5 note parse and are treated as stale (re-emitted), never as a hard
//   error.
// - .rdata — the owning file's real data bytes (source hash, source length,
//   emission stamp, owner key). May be empty in principle; never text.
// - .slvnote — the Silver note (magic SLVOBJ3, emitting flag set, source
//   FNV-1 hash, emission stamp, globals-block size, the full import list,
//   and the owning file key). The planner reads this for freshness.
//
// Symbol tables hold, in the reference order (section anchors, defined
// functions, the data anchor, then undefined symbols): the section anchors,
// one FUNC symbol for the file's entry stub, one global data-anchor symbol
// (__slv_data_<file>_<hash>, offset 0 in .rdata, spelled by databName exactly
// like the references), and UNDEF entries for the referenced seam symbol
// (__slv_interp_run — the future native runner, see below).
//
// Relocations cover the position-dependent sites in .text: REL32 (the E8
// call to the runner seam) and ABS64 (the 8-byte absolute data address) on
// x86-64; BRANCH26 (the bl to the runner seam) and PAGE21/PAGEOFF12 (the
// adrp+add pair addressing the data anchor) on ARM64. Intra-stub relative
// flow is already final and carries no relocation, exactly like a
// conventional compiler's output. On Linux they ride .rela.text
// (R_X86_64_PC32 / R_X86_64_64) with .rela.data present but size-0 (.rdata
// carries no pointers by construction, so a data relocation has no meaning
// the linker could apply); a non-empty .rela.data is corruption (loud,
// never silently ignored), a missing one an older object that still
// validates. On mac they ride the __text section (extern, pc-relative,
// 4-byte length) against the datab anchor and the seam UNDEF.
//
// ///////////////////////////////////////////////////////////////////////////
// // NATIVE RUNNER — LANDED (in-process .o execution, OVERHAUL.md fastest  //
// // tier). Read this all: what runs natively, what still falls back, why. //
// ///////////////////////////////////////////////////////////////////////////
// //
// // After verifyObject passes, ObjSession.runNative loads the validated
// // entry object and EXECUTES its .text in-process: one RWX block from
// // VirtualAlloc (MEM_COMMIT zero-fill, PAGE_EXECUTE_READWRITE — the same
// // established file-top DLL-import pattern cache.sr/resource.sr use, no
// // new FFI shape), the object's own ABS64/REL32 relocations applied
// // against the loaded base, the UNDEF __slv_interp_run import bound
// // through an in-block import thunk (15 bytes after the .rdata coat —
// // silveri.exe's image address and VirtualAlloc's low arena routinely sit
// // more than ±2 GB apart, beyond REL32 reach, so the seam binds the way
// // linkers bind far imports: a near REL32 to the thunk, which calls the
// // compiled seam callback absolutely). The thunk preserves RAX across
// // the seam call (push rax ... pop rax): the stub materializes the
// // source hash into RAX BEFORE the call and returns it AFTER, so without
// // the save the seam's own return would clobber the proof value. Then a
// // call into the loaded entry marshals that RAX back into the
// // interpreter's int domain.
// //
// // Copying is NUL-safe by construction: Silver strings are C strings, so
// // .length stops at the first NUL and one memcpy cannot carry NUL bytes.
// // The RWX block arrives zero-filled, so NUL bytes need no copy at all —
// // objNatBlit copies only the NUL-free runs between them at their true
// // offsets (an all-NUL payload copies nothing and is still exact).
// //
// // The call itself rides the language's own indirect-call shape
// // (DOCS/259 G3): the entry address sits in an int[] slot and slots[0]()
// // evaluates to the callee's RAX, so no new call primitive was needed.
// //
// // PROOF the bytes ran (not the AST): the stub materializes the source
// // FNV-1 hash into RAX, so a native run must return RAX == note hash AND
// // reach the seam. Patching one hash byte in the cached .o (source
// // untouched) changes the returned RAX, which the runner reports loudly;
// // freshness still passes (the SLVOBJ3 note is untouched), so the patch
// // demonstrably flows through executed machine code, never the AST.
// //
// // EXACT BOUNDARY (loud fallback to the verified AST/bytecode tiers, never
// // silent wrong behavior — every case below returns a reason string the
// // driver prints):
// //
// // - Only WINDOWS/x86-64 executes (COFF objects). LINUX (ELF) and MAC
// //   (Mach-O/ARM64) validate identically but stay on the verified tiers:
// //   same loader math, unprobed host ceilings — the follow-up.
// // - Only the __slv_interp_run seam binds (to the compiled void()
// //   callback below). Any other UNDEF import, linker singleton, or
// //   extern/data target outside .text/.rdata is unresolvable in-process.
// // - The seam is void(): it observes no RCX anchor and returns no program
// //   value (Silver cannot spell richer native signatures), so it raises
// //   the hit flag and nothing more. The stub carries no program semantics
// //   by emitter design (hash + seam call, never compiled program logic),
// //   so program evaluation continues from the verified tokens; the runner
// //   proves the .o tier is genuine runnable machine code, not where
// //   program results come from. A real AST-to-machine-code backend is the
// //   follow-up beyond the runner.
// // - Oversize objects (>64 MiB), mapping failure, an unreachable seam, a
// //   RAX/note-hash mismatch (hand-patched or otherwise stale bytes the
// //   note cannot see), and out-of-range REL32 all fall back loudly.
// //
////////////////////////////////////////////////////////////////////////////////
//
// Freshness (mirrors the references exactly):
//
// The per-file FNV-1 hash + source length (the bytecode tier's size proxy in
// place of mtimes) is compared against the per-target project.sbcr record
// (v3 — unchanged fields, existing records are reused), which additionally
// keys on the emitting flag set, so a flag switch re-emits. Fresh means: the
// record matches (hash + size), the .o exists, AND its v5 note peeks with the
// expected flag set + hash (plan() in the references). Anything else —
// including a v4-era object or a compiler-emitted object whose flag set is
// not "interp" — is stale (re-emitted), never a hard error on the plan path
// and never silently reused. Unlike the compilers — which note every project
// file per run — the interpreter notes its single entry per run, so finish()
// never drops unnoted records (dropping would evict other entries' objects
// when alternating entry files).
//
// Cross-acceptance: a compiler-emitted object for ANY target parses with
// the readers below (same containers, same 9-section ELF / 3-section COFF /
// LC_SEGMENT_64+LC_SYMTAB+LC_DYSYMTAB Mach-O shape, same SLVOBJ3 note) and
// is then either fresh-planned (same flags + hash, which only an "interp"
// emitter can produce) or detected as a flag-set/hash mismatch and
// re-emitted — accepted structurally, never executed stale. The note's
// globals-block size agrees the same way: the
// interpreter always records gas 0 (no globals block; execution stays on
// the AST/bytecode tiers), while the self-host counts bytes and silverc-rs
// counts slots, so any nonzero foreign gas fails LOUDLY at the agreement
// check in finish() / verifyObject() instead of mislinking — the same rule
// the linkers enforce.
//
// - The record is the same .sbcr family (v3: v2 fields plus the emitting
//   flag-set string), with text companion project.sbcri. Each <os>-<arch>
//   directory carries its own record. The flag set is the constant "interp"
//   (the interpreter has no execution modes and no --optimize; the key
//   exists so the machinery — and cross-tool validation — matches the
//   compilers: a compiler-emitted object reports a flag-set switch instead
//   of being silently reused).
//
// Binary artifacts (the v3 record, the .o objects) ride file.writeBytes over
// int[] buffers, so NUL bytes survive on every target; file.read (byte[],
// exact) reads them back. The .sbcri text companion is NUL-free and is the
// authoritative read side for records.

// Target directory name for a host OS (OVERHAUL.md): the architecture
// follows the target — x86-64 for Windows/Linux, aarch64 for mac.
// `hostOs` is the canonical UPPERCASE name (interpHostOs); anything else
// falls back to the Windows target.
public string objTargetDirName(string hostOs) {
    if (hostOs == "LINUX") { return "linux-x86-64"; }
    if (hostOs == "MAC") { return "mac-aarch64"; }
    return "windows-x86-64";
}

// Flag-set key recorded in the per-target record (OVERHAUL.md): the record
// additionally keys on the emitting flag set so a flag switch invalidates
// the objects instead of silently reusing them. The interpreter carries no
// execution modes and no --optimize, so the key is the constant "interp".
public string objFlagKey() {
    return "interp";
}

// Linker-provided singleton symbols (writable blocks laid out once by the
// linker, referenced from any object). Spelled exactly like the references
// so cross-tool readers agree; the interpreter's own stub references only
// the runner seam below, but the names stay for cross-acceptance.
public string objSingletonExc() { return "__slv_exc_state"; }
public string objSingletonTray() { return "__slv_tray_state"; }
public string objSingletonGlobals() { return "__slv_globals"; }

// Prefix of the per-object data-anchor symbol (global, offset 0 in
// .rdata) and of undefined import symbols (the suffix is the decimal index
// into the note's import list: __slv_imp_3). Spelled exactly like the
// references.
public string objDatabPrefix() { return "__slv_data_"; }
public string objImportPrefix() { return "__slv_imp_"; }

// The seam symbol every interpreter stub calls (UNDEF FUNC in our objects):
// the future in-process native runner's entry point. Naming it here — in
// code AND in every emitted symbol table — is the loud marker of the
// native-runner boundary above.
public string objInterpRunSym() { return "__slv_interp_run"; }

// Per-file entry-stub symbol: sanitized owner key plus an FNV-1 suffix so
// distinct files can never collide after sanitizing. Deterministic per
// (key, content hash).
public string objInterpEntrySym(string filekey, int64 hash) {
    string[] parts = [];
    for (int i = 0; i < filekey.length; i++) {
        char c = filekey[i];
        bool ok = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9');
        if (ok) { parts.add((string)c); }
        else { parts.add("_"); }
    }
    int64 low = hash & 0xFFFFFFFF;
    return "__slv_interp_" + parts.join("") + "_" + objHex8(low);
}

// Global data-anchor symbol name for `filekey`: sanitized path plus an
// FNV-1 suffix so distinct files can never collide after sanitizing
// (a/b.sr vs a_b.sr). Mirrors the references byte-exactly (same sanitize,
// same {:08x} of the low 32 bits of FNV-1 over the key).
public string databName(string filekey) {
    string[] parts = [];
    for (int i = 0; i < filekey.length; i++) {
        char c = filekey[i];
        bool ok = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9');
        if (ok) { parts.add((string)c); }
        else { parts.add("_"); }
    }
    int64 h = icFnv1(filekey);
    int64 low = h & 0xFFFFFFFF;
    return objDatabPrefix() + parts.join("") + "_" + objHex8(low);
}

// 16 lowercase hex digits of a 64-bit value (the {:016x} shape the record
// companions use for FNV-1 hashes).
public string objHex16(int64 v) {
    string digits = "0123456789abcdef";
    string[] parts = [];
    for (int i = 0; i < 16; i++) {
        int nib = int((v >> ((15 - i) * 4)) & 0xF);
        parts.add(digits[nib..nib + 1]);
    }
    return parts.join("");
}

// 8 lowercase hex digits of the low 32 bits (the {:08x} shape of data
// anchors and entry symbols).
public string objHex8(int64 v) {
    string digits = "0123456789abcdef";
    string[] parts = [];
    for (int i = 0; i < 8; i++) {
        int nib = int((v >> ((7 - i) * 4)) & 0xF);
        parts.add(digits[nib..nib + 1]);
    }
    return parts.join("");
}

// Escape a text-companion field so the output never contains NUL bytes or
// line breaks (mirrors the reference escape_text).
public string objEscapeText(string s) {
    string[] parts = [];
    for (int i = 0; i < s.length; i++) {
        char c = s[i];
        if (c == '\\') { parts.add("\\\\"); }
        else if (c == char(0)) { parts.add("\\0"); }
        else if (c == '\n') { parts.add("\\n"); }
        else if (c == '\r') { parts.add("\\r"); }
        else { parts.add((string)c); }
    }
    return parts.join("");
}

public string objUnescapeText(string s) {
    string[] parts = [];
    for (int i = 0; i < s.length; i++) {
        char c = s[i];
        if (c == '\\' && i + 1 < s.length) {
            char d = s[i + 1];
            if (d == '\\') { parts.add("\\"); i++; }
            else if (d == 'n') { parts.add("\n"); i++; }
            else if (d == 'r') { parts.add("\r"); i++; }
            else if (d == '0') { parts.add((string)char(0)); i++; }
            else { parts.add((string)c); }
        } else {
            parts.add((string)c);
        }
    }
    return parts.join("");
}

private bool objIsHex(string s) {
    if (s.length == 0 || s.length > 16) { return false; }
    for (int i = 0; i < s.length; i++) {
        char c = s[i];
        bool digit = c >= '0' && c <= '9';
        bool lower = c >= 'a' && c <= 'f';
        bool upper = c >= 'A' && c <= 'F';
        if (!digit && !lower && !upper) { return false; }
    }
    return true;
}

private int64 objParseHex(string s) {
    int64 v = 0;
    for (int i = 0; i < s.length; i++) {
        char c = s[i];
        int d = c - '0';
        if (c >= 'a' && c <= 'f') { d = c - 'a' + 10; }
        else if (c >= 'A' && c <= 'F') { d = c - 'A' + 10; }
        v = v * 16 + int64(d);
    }
    return v;
}

// True (1) when a /-separated record key resolves inside the project root:
// absolute paths (leading /, drive letters) and parent escapes (..) are
// out-of-root and are never object-cached (they still run normally).
private int objIsLocalKey(string key) {
    if (key.length == 0) { return 0; }
    if (key[0] == '/') { return 0; }
    for (int i = 0; i < key.length; i++) {
        if (key[i] == ':') { return 0; }
    }
    if (key.length >= 2 && key[0] == '.' && key[1] == '.') {
        if (key.length == 2 || key[2] == '/') { return 0; }
    }
    return 1;
}

// In-memory byte sink for container emission. Methods grow the object's own
// buffer; callers take the finished buffer out once.
class ObjWriter {
    public prop int[] out;

    construct {
        this.out = [];
    }

    public void u8(int64 v) {
        this.out.add(v & 0xFF);
    }

    public void u16(int64 v) {
        this.u8(v);
        this.u8(v >> 8);
    }

    public void u32(int64 v) {
        for (int i = 0; i < 4; i++) { this.u8((v >> (i * 8)) & 0xFF); }
    }

    public void u64(int64 v) {
        for (int i = 0; i < 8; i++) { this.u8((v >> (i * 8)) & 0xFF); }
    }

    public void rawStr(string s) {
        for (int i = 0; i < s.length; i++) {
            this.u8(int64(s[i]) & 0xFF);
        }
    }

    // Fixed-width name field: the name bytes, then NULs up to `total`.
    public void rawName(string s, int total) {
        this.rawStr(s);
        int have = s.length;
        while (have < total) {
            this.u8(0);
            have++;
        }
    }

    public void rawBytes(int[] data) {
        for (int i = 0; i < data.length; i++) {
            this.u8(data[i] & 0xFF);
        }
    }

    // Raw data padded with NULs up to `padded` bytes.
    public void rawPad(int[] data, int padded) {
        this.rawBytes(data);
        int n = data.length;
        while (n < padded) {
            this.u8(0);
            n++;
        }
    }

    // Length-prefixed (u32 LE) string field for notes and records.
    public void strField(string s) {
        this.u32(s.length);
        this.rawStr(s);
    }

    // One ELF64 section header (64 bytes).
    public void sh(int64 name, int64 stype, int64 flags, int64 off, int64 size, int64 link, int64 info, int64 align, int64 entsize) {
        this.u32(name);
        this.u32(stype);
        this.u64(flags);
        this.u64(0);
        this.u64(off);
        this.u64(size);
        this.u32(link);
        this.u32(info);
        this.u64(align);
        this.u64(entsize);
    }
}

// One emitted object unit: the owning file's machine code + data with full
// symbol and relocation tables. Built by interpBuildUnit (the interpreter's
// own Silver emitter); serialized by emitObject. Mirrors the references'
// unit shape (defined/undefined/reloc tables sorted for determinism).
class ObjUnit {
    // Session-relative owner key (/-separated).
    public prop string filekey;
    // Machine code slice (.text).
    public prop int[] code;
    // Data slice (.rdata).
    public prop int[] data;
    // Defined function symbols (parallel arrays; offsets into code).
    public prop string[] defNames;
    public prop int[] defOffs;
    public prop int[] defSizes;
    // Global data-anchor name (databName of filekey).
    public prop string datab;
    // Referenced-but-elsewhere-defined Silver symbols (sorted, deduped).
    public prop string[] undefFuncs;
    // Referenced linker singletons (sorted; 0 = exc, 1 = tray, 2 = globals).
    public prop int[] undefSingles;
    // Referenced import-list indices (sorted).
    public prop int[] undefImports;
    // Relocations, sorted by site (parallel arrays).
    public prop int[] relSites;
    // 0 = Rel32 (x86-64 E8 call), 1 = Abs64 (x86-64 8-byte absolute
    // address), 2 = ArmBranch26 (ARM64 bl), 3 = ArmPage21 (ARM64 adrp),
    // 4 = ArmPageOff12 (ARM64 add). Absolute ABS64 has no ARM64 form:
    // Mach-O ARM64 defines no absolute code relocations, so ARM64
    // addresses are always PC-relative pairs.
    public prop int[] relKinds;
    // 0 = Defined, 1 = Extern, 2 = Data, 3 = Singleton, 4 = Import.
    public prop int[] relTargets;
    // Target index (defined idx / data offset / singleton id / import idx).
    public prop int[] relIdx;
    // Extern target name (only for target kind 1).
    public prop string[] relNames;
    // Full import list (parallel arrays; deterministic across runs).
    public prop string[] impDlls;
    public prop string[] impNames;
    // Whole-program globals-block size. The interpreter carries no globals
    // block (execution stays on the AST/bytecode tiers), so this is always
    // 0 — recorded so the note shape stays reference-exact.
    public prop int gas;

    construct {
        this.filekey = "";
        this.code = [];
        this.data = [];
        this.defNames = [];
        this.defOffs = [];
        this.defSizes = [];
        this.datab = "";
        this.undefFuncs = [];
        this.undefSingles = [];
        this.undefImports = [];
        this.relSites = [];
        this.relKinds = [];
        this.relTargets = [];
        this.relIdx = [];
        this.relNames = [];
        this.impDlls = [];
        this.impNames = [];
        this.gas = 0;
    }
}

// Native symbol tables for one emitted object (holder object, not raw
// array parameters: arrays received as function parameters silently stop
// growing past 8 entries in this toolchain, while prop arrays on a passed
// object keep growing — the writer's tables scale with the symbol count,
// so they live here). Mirrors the reference build_out_syms order.
class ObjSymTab {
    public prop string[] names;
    public prop int[] sects;
    public prop int[] vals;
    public prop int[] funcs;
    // ELF st_size per symbol (anchors, the datab, and undefined symbols
    // carry 0; defined FUNCs carry their code size) — mirrors the reference
    // build_out_syms order.
    public prop int[] sizes;

    construct {
        this.names = [];
        this.sects = [];
        this.vals = [];
        this.funcs = [];
        this.sizes = [];
    }
}

// A fully parsed object: note metadata plus code, data, symbols, and
// relocations. The unifier's validation input (there is no linker in the
// interpreter — see the NATIVE-RUNNER BOUNDARY above).
class ParsedObj {
    public prop string filekey;
    public prop string flags;
    public prop int64 hash;
    public prop int stamp;
    public prop int gas;
    public prop string[] impDlls;
    public prop string[] impNames;
    public prop int[] code;
    public prop int[] data;
    // Symbols (parallel arrays): section (0 = undef, 1 = .text, 2 = .rdata),
    // value (offset), isFunc (1 = function).
    public prop string[] symNames;
    public prop int[] symSects;
    public prop int[] symVals;
    public prop int[] symIsFunc;
    // Relocations (parallel arrays): site, symbol index, kind (0 = Rel32,
    // 1 = Abs64, 2 = ArmBranch26, 3 = ArmPage21, 4 = ArmPageOff12), addend
    // (COFF/ELF addends ride the site bytes; Mach-O ARM64 addends ride the
    // instruction immediates).
    public prop int[] relSites;
    public prop int[] relSyms;
    public prop int[] relKinds;
    public prop int64[] relAddends;

    construct {
        this.filekey = "";
        this.flags = "";
        this.hash = 0;
        this.stamp = 0;
        this.gas = 0;
        this.impDlls = [];
        this.impNames = [];
        this.code = [];
        this.data = [];
        this.symNames = [];
        this.symSects = [];
        this.symVals = [];
        this.symIsFunc = [];
        this.relSites = [];
        this.relSyms = [];
        this.relKinds = [];
        this.relAddends = [];
    }
}

// Decoded v5 note: emitting flag set, source hash, emission stamp,
// globals-block size, full import list, and owner file key.
class ObjNote {
    public prop string flags;
    public prop int64 hash;
    public prop int stamp;
    public prop int gas;
    public prop string[] impDlls;
    public prop string[] impNames;
    public prop string filekey;

    construct {
        this.flags = "";
        this.hash = 0;
        this.stamp = 0;
        this.gas = 0;
        this.impDlls = [];
        this.impNames = [];
        this.filekey = "";
    }
}

// Indexed byte reader over a file read back with file.read (exact bytes,
// truthful length — no NUL truncation anywhere in the path).
class ObjReader {
    public prop byte[] data;
    public prop int size;

    construct (byte[] d) {
        this.data = d;
        this.size = d.length;
    }

    public int64 u8At(int off) {
        if (off < 0 || off >= this.size) { return -1; }
        return int64(this.data[off] & 0xFF);
    }

    public int64 u16At(int off) {
        int64 lo = this.u8At(off);
        int64 hi = this.u8At(off + 1);
        if (lo < 0 || hi < 0) { return -1; }
        return lo | (hi << 8);
    }

    public int64 u32At(int off) {
        int64 b0 = this.u8At(off);
        int64 b1 = this.u8At(off + 1);
        int64 b2 = this.u8At(off + 2);
        int64 b3 = this.u8At(off + 3);
        if (b0 < 0 || b1 < 0 || b2 < 0 || b3 < 0) { return -1; }
        return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
    }

    public int64 u64At(int off) {
        int64 v = 0;
        for (int i = 0; i < 8; i++) {
            int64 b = this.u8At(off + i);
            if (b < 0) { return -1; }
            v = v | (b << (i * 8));
        }
        return v;
    }

    // Exact bytes as a string (callers only lift short ASCII ranges: magic
    // words, section names, symbol names, the flag set — never .text code).
    public string bytesAt(int off, int len) {
        if (off < 0 || len < 0 || off + len > this.size) { return ""; }
        string[] parts = [];
        for (int i = 0; i < len; i++) {
            int b = int(int64(this.data[off + i] & 0xFF));
            parts.add((string)char(b));
        }
        return parts.join("");
    }
}

// ---------------------------------------------------------------------------
// The interpreter's own Silver emitter (following the silverc port's
// approach: one entry stub per file, machine code + data + symbols +
// relocations assembled as bytes, no external assembler).
//
// The stub is genuine, disassemblable machine code for the session target,
// deterministic per (owner key, source hash). It is NOT the program
// compiled: program evaluation stays on the verified AST/bytecode tiers
// (see the NATIVE RUNNER notice at the top of this file). The stub's job
// is being a real code payload with real symbols/relocs so the object tier
// validates byte-identically across the toolchain AND executes natively
// under runNative (RAX == source hash, seam reached); its call to
// __slv_interp_run names the seam the runner binds at load time.
// ---------------------------------------------------------------------------

// 34 bytes of real x86-64 (Windows/Linux target):
//
//   push rbp; mov rbp,rsp
//   movabs rax,<source hash>        (proves content-derivation in bytes)
//   movabs rcx,<data anchor>        (ABS64 reloc site at 16)
//   call __slv_interp_run           (REL32 reloc site at 25 — the seam)
//   mov rsp,rbp; pop rbp; ret
public int[] interpBuildX86(int64 hash) {
    int[] code = [];
    code.add(85);
    code.add(72);
    code.add(137);
    code.add(229);
    code.add(72);
    code.add(184);
    for (int i = 0; i < 8; i++) { code.add((hash >> (i * 8)) & 0xFF); }
    code.add(72);
    code.add(185);
    for (int i = 0; i < 8; i++) { code.add(0); }
    code.add(232);
    for (int i = 0; i < 4; i++) { code.add(0); }
    code.add(72);
    code.add(137);
    code.add(236);
    code.add(93);
    code.add(195);
    return code;
}

// Fixed-width 32-bit ARM64 instruction encoders (mirrors silverc-rs
// src/arm64.rs and silverc/compiler/objcache.sr, which the Mach-O side
// also uses for dyld stubs). Every encoder takes plain ints and returns
// the word as an int (all words fit in 32 unsigned bits, so shifts stay
// logical). Bit layouts follow the ARM ARM for A-profile (DDI0487).
private int a64Adrp(int rd, int pageOff) {
    int64 u = int64(pageOff) & 0x1FFFFF;
    return int(0x90000000 | ((u & 0x3) << 29) | (((u >> 2) & 0x7FFFF) << 5) | (rd & 31));
}

// add Xd, Xn, #imm12 (64-bit, no shift — the only form the tier emits).
private int a64AddImm(int rd, int rn, int imm12) {
    return int(0x91000000 | ((imm12 & 0xFFF) << 10) | ((rn & 31) << 5) | (rd & 31));
}

// bl <label>: branch with link.
private int a64Bl(int off) {
    return int(0x94000000 | ((int64(off / 4) & 0x3FFFFFF)));
}

// movz Xd, #imm16, lsl #hw*16.
private int a64Movz(int rd, int imm16, int hw) {
    return int(0xD2800000 | ((hw & 3) << 21) | ((imm16 & 0xFFFF) << 5) | (rd & 31));
}

// movk Xd, #imm16, lsl #hw*16 (keeps the other halfwords).
private int a64Movk(int rd, int imm16, int hw) {
    return int(0xF2800000 | ((hw & 3) << 21) | ((imm16 & 0xFFFF) << 5) | (rd & 31));
}

// ret Xn: return (default X30).
private int a64Ret(int rn) {
    return int(0xD65F0000 | ((rn & 31) << 5));
}

// Decode the page offset of an adrp word (the object reader recovers
// data-reference addends with this).
private int a64DecodeAdrpPage(int word) {
    int64 raw = (((int64(word) >> 5) & 0x7FFFF) << 2) | ((int64(word) >> 29) & 0x3);
    if ((raw & 0x100000) != 0) { return int(raw - 0x200000); }
    return int(raw);
}

// Decode the imm12 of an add (immediate) word.
private int a64DecodeAddImm12(int word) {
    return int((int64(word) >> 10) & 0xFFF);
}

// Decode the 26-bit displacement of a bl word (in words, like the
// reference decode_bl_imm26).
private int a64DecodeBlImm26(int word) {
    int64 raw = int64(word) & 0x3FFFFFF;
    if ((raw & 0x2000000) != 0) { return int(raw - 0x4000000); }
    return int(raw);
}

private int macWordAt(int[] code, int pos) {
    int64 w = 0;
    for (int i = 0; i < 4; i++) { w = w | (int64(code[pos + i] & 0xFF) << (i * 8)); }
    return int(w);
}

// 28 bytes of real ARM64 (Mac target): an adrp+add pair addressing the
// data anchor at unit-relative offset 0 (PAGE21/PAGEOFF12 relocs), a bl to
// the runner seam (BRANCH26 reloc, zero placeholder per the Mach-O ARM64
// convention), the low 48 bits of the source hash materialized into x0
// (movz + 2x movk, proving content-derivation in bytes), and ret.
// Assembled with the encoders above — disassemblable, relocatable, and
// reader-validated exactly like compiler-emitted objects.
public int[] interpBuildArm(int64 hash) {
    int[] code = [];
    int64[] words = [];
    words.add(a64Adrp(9, 0));
    words.add(a64AddImm(9, 9, 0));
    words.add(a64Bl(0));
    int lo = int(hash & 65535);
    int mid = int((hash >> 16) & 65535);
    int hi = int((hash >> 32) & 65535);
    words.add(a64Movz(0, lo, 0));
    words.add(a64Movk(0, mid, 1));
    words.add(a64Movk(0, hi, 2));
    words.add(a64Ret(30));
    for (int i = 0; i < words.length; i++) {
        for (int b = 0; b < 4; b++) { code.add((words[i] >> (b * 8)) & 0xFF); }
    }
    return code;
}

// Real data bytes (never text): source hash + source length + emission
// stamp + owner key. The data anchor (__slv_data_..., offset 0) addresses
// this slice.
public int[] interpBuildData(string filekey, int64 hash, int srcLen, int stamp) {
    ObjWriter w = new ObjWriter();
    w.u64(hash);
    w.u32(srcLen);
    w.u32(stamp);
    w.rawStr(filekey);
    return w.out;
}

// Fill `unit` for one entry file: machine code + data + the defined entry
// FUNC + the data anchor + the UNDEF runner seam + the position-dependent
// relocations (REL32 + ABS64 on x86-64; PAGE21 + PAGEOFF12 + BRANCH26 on
// ARM64 — the adrp+add pair addresses the data anchor at unit-relative
// offset 0, the bl calls the seam). Sorted + deterministic.
public void interpBuildUnit(string filekey, int64 hash, int srcLen, int stamp, string targetOs, ObjUnit unit) {
    unit.filekey = filekey;
    unit.datab = databName(filekey);
    unit.gas = 0;
    unit.impDlls = [];
    unit.impNames = [];
    unit.undefSingles = [];
    unit.undefImports = [];
    if (targetOs == "MAC") {
        unit.code = interpBuildArm(hash);
    } else {
        unit.code = interpBuildX86(hash);
    }
    unit.data = interpBuildData(filekey, hash, srcLen, stamp);
    string entry = objInterpEntrySym(filekey, hash);
    unit.defNames = [];
    unit.defOffs = [];
    unit.defSizes = [];
    unit.defNames.add(entry);
    unit.defOffs.add(0);
    unit.defSizes.add(unit.code.length);
    unit.undefFuncs = [];
    unit.relSites = [];
    unit.relKinds = [];
    unit.relTargets = [];
    unit.relIdx = [];
    unit.relNames = [];
    if (targetOs == "MAC") {
        unit.undefFuncs.add(objInterpRunSym());
        unit.relSites.add(0);
        unit.relKinds.add(3);
        unit.relTargets.add(2);
        unit.relIdx.add(0);
        unit.relNames.add("");
        unit.relSites.add(4);
        unit.relKinds.add(4);
        unit.relTargets.add(2);
        unit.relIdx.add(0);
        unit.relNames.add("");
        unit.relSites.add(8);
        unit.relKinds.add(2);
        unit.relTargets.add(1);
        unit.relIdx.add(-1);
        unit.relNames.add(objInterpRunSym());
    } else {
        unit.undefFuncs.add(objInterpRunSym());
        unit.relSites.add(16);
        unit.relKinds.add(1);
        unit.relTargets.add(2);
        unit.relIdx.add(0);
        unit.relNames.add("");
        unit.relSites.add(25);
        unit.relKinds.add(0);
        unit.relTargets.add(1);
        unit.relIdx.add(-1);
        unit.relNames.add(objInterpRunSym());
    }
}

// Internal symbol order shared by every writer (mirrors the references):
// section anchors, defined functions, the data anchor, then undefined
// symbols (functions, singletons, imports). Sizes ride alongside for the
// ELF st_size field (anchors, the datab, and undefined symbols carry 0).
private void objBuildSyms(ObjUnit unit, ObjSymTab t) {
    t.names.add(".text");
    t.sects.add(1);
    t.vals.add(0);
    t.funcs.add(0);
    t.sizes.add(0);
    t.names.add(".rdata");
    t.sects.add(2);
    t.vals.add(0);
    t.funcs.add(0);
    t.sizes.add(0);
    for (int i = 0; i < unit.defNames.length; i++) {
        t.names.add(unit.defNames[i]);
        t.sects.add(1);
        t.vals.add(unit.defOffs[i]);
        t.funcs.add(1);
        t.sizes.add(unit.defSizes[i]);
    }
    t.names.add(unit.datab);
    t.sects.add(2);
    t.vals.add(0);
    t.funcs.add(0);
    t.sizes.add(0);
    for (int i = 0; i < unit.undefFuncs.length; i++) {
        t.names.add(unit.undefFuncs[i]);
        t.sects.add(0);
        t.vals.add(0);
        t.funcs.add(1);
        t.sizes.add(0);
    }
    for (int i = 0; i < unit.undefSingles.length; i++) {
        int s = unit.undefSingles[i];
        if (s == 0) { t.names.add(objSingletonExc()); }
        else if (s == 1) { t.names.add(objSingletonTray()); }
        else { t.names.add(objSingletonGlobals()); }
        t.sects.add(0);
        t.vals.add(0);
        t.funcs.add(0);
        t.sizes.add(0);
    }
    for (int i = 0; i < unit.undefImports.length; i++) {
        t.names.add(objImportPrefix() + (string)unit.undefImports[i]);
        t.sects.add(0);
        t.vals.add(0);
        t.funcs.add(0);
        t.sizes.add(0);
    }
}

// Native symbol index for one unit reloc (mirrors the writer order above:
// 2 anchors, then defined[i], the datab, then undef tables in order).
// Returns -1 when the target has no entry (caller reports it loudly).
private int objSymIndexFor(ObjUnit unit, int tkind, int idx, string name) {
    if (tkind == 0) { return 2 + idx; }
    if (tkind == 2) { return 2 + unit.defNames.length; }
    if (tkind == 1) {
        for (int i = 0; i < unit.undefFuncs.length; i++) {
            if (unit.undefFuncs[i] == name) { return 2 + unit.defNames.length + 1 + i; }
        }
        return -1;
    }
    if (tkind == 3) {
        int base = 2 + unit.defNames.length + 1 + unit.undefFuncs.length;
        for (int i = 0; i < unit.undefSingles.length; i++) {
            if (unit.undefSingles[i] == idx) { return base + i; }
        }
        return -1;
    }
    int base2 = 2 + unit.defNames.length + 1 + unit.undefFuncs.length + unit.undefSingles.length;
    for (int i = 0; i < unit.undefImports.length; i++) {
        if (unit.undefImports[i] == idx) { return base2 + i; }
    }
    return -1;
}

// Minimal COFF relocatable object (Windows target): IMAGE_FILE_HEADER
// (Machine = AMD64) + .text (genuine machine code) + .rdata (data) +
// .slvnote (Silver note) + section/function/undefined symbols + .text
// relocations. Mirrors the reference emit_coff byte-exactly (3 sections,
// TimeDateStamp, strtab dedup, symbol classes, REL32 = 20 / ADDR64 = 1).
// Built only with byte pushes.
public int[] emitCoff(ObjUnit unit, int[] note, int stamp) {
    ObjSymTab syms = new ObjSymTab();
    objBuildSyms(unit, syms);
    string[] symNames = syms.names;
    int[] symSects = syms.sects;
    int[] symVals = syms.vals;
    int[] symFuncs = syms.funcs;
    int textPad = (unit.code.length + 3) / 4 * 4;
    int rdataPad = (unit.data.length + 3) / 4 * 4;
    int notePad = (note.length + 3) / 4 * 4;
    int textOff = 20 + 3 * 40;
    int rdataOff = textOff + textPad;
    int noteOff = rdataOff + rdataPad;
    int relocOff = noteOff + notePad;
    int symtabOff = relocOff + unit.relSites.length * 10;
    // String table for names longer than 8 bytes (deduped, like the ref).
    int[] strLens = [];
    string[] strNames = [];
    int strSize = 4;
    for (int i = 0; i < symNames.length; i++) {
        string nm = symNames[i];
        if (nm.length > 8) {
            bool seen = false;
            for (int j = 0; j < strNames.length; j++) {
                if (strNames[j] == nm) { seen = true; break; }
            }
            if (!seen) {
                strNames.add(nm);
                strLens.add(strSize);
                strSize += nm.length + 1;
            }
        }
    }
    ObjWriter w = new ObjWriter();
    // IMAGE_FILE_HEADER (20 bytes).
    w.u16(34404);
    w.u16(3);
    w.u32(stamp);
    w.u32(symtabOff);
    w.u32(symNames.length);
    w.u16(0);
    w.u16(0);
    // Section headers: .text, .rdata, .slvnote (40 bytes each).
    w.rawName(".text", 8);
    w.u32(unit.code.length);
    w.u32(0);
    w.u32(textPad);
    w.u32(textOff);
    if (unit.relSites.length > 0) { w.u32(relocOff); }
    else { w.u32(0); }
    w.u32(0);
    int nrelHdr = unit.relSites.length;
    if (nrelHdr > 65535) { nrelHdr = 65535; }
    w.u16(nrelHdr);
    w.u16(0);
    w.u32(1615855648);
    w.rawName(".rdata", 8);
    w.u32(unit.data.length);
    w.u32(0);
    w.u32(rdataPad);
    w.u32(rdataOff);
    w.u32(0);
    w.u32(0);
    w.u16(0);
    w.u16(0);
    w.u32(1073741888);
    w.rawName(".slvnote", 8);
    w.u32(note.length);
    w.u32(0);
    w.u32(notePad);
    w.u32(noteOff);
    w.u32(0);
    w.u32(0);
    w.u16(0);
    w.u16(0);
    w.u32(1073741888);
    // Raw data.
    w.rawPad(unit.code, textPad);
    w.rawPad(unit.data, rdataPad);
    w.rawPad(note, notePad);
    // Relocations (sorted by site for determinism).
    for (int i = 0; i < unit.relSites.length; i++) {
        int symidx = objSymIndexFor(unit, unit.relTargets[i], unit.relIdx[i], unit.relNames[i]);
        int rtype = 20;
        if (unit.relKinds[i] == 1) { rtype = 1; }
        w.u32(unit.relSites[i]);
        w.u32(symidx);
        w.u16(rtype);
    }
    // Symbol table (18 bytes each, no aux symbols).
    for (int i = 0; i < symNames.length; i++) {
        string nm = symNames[i];
        if (nm.length > 8) {
            int off = 0;
            for (int j = 0; j < strNames.length; j++) {
                if (strNames[j] == nm) { off = strLens[j]; break; }
            }
            w.u32(0);
            w.u32(off);
        } else {
            w.rawName(nm, 8);
        }
        w.u32(symVals[i]);
        w.u16(symSects[i]);
        int stype = 0;
        if (i >= 2) {
            if (symSects[i] == 0) {
                if (symFuncs[i] == 1) { stype = 32; }
            } else if (symFuncs[i] == 1) {
                stype = 32;
            }
        }
        w.u16(stype);
        if (i < 2) { w.u8(3); }
        else { w.u8(2); }
        w.u8(0);
    }
    w.u32(strSize);
    for (int i = 0; i < strNames.length; i++) {
        w.rawStr(strNames[i]);
        w.u8(0);
    }
    return w.out;
}

// Minimal ELF relocatable object (Linux target): ELF64 header (ET_REL,
// EM_X86_64) + .text (genuine machine code) + .rdata (data) + .slvnote
// (Silver note) + .shstrtab + .symtab + .strtab + .rela.text + .rela.data.
// Mirrors the reference emit_elf_rel byte-exactly (9 section headers, null +
// SECTION + GLOBAL syms, R_X86_64_64 = 1 / R_X86_64_PC32 = 2 relas with the
// written symbol index shifted by one for the leading null entry). Built
// only with byte pushes.
//
// .rela.data is always size-0: .rdata carries no pointers by construction,
// so no data-section relocation can exist. The section is still emitted
// (with the .symtab link, the .rdata info, alignment, and entry size) so
// every object carries the full relocation-section pair; the reader treats
// a non-empty .rela.data as corruption (loud, never silently ignored).
public int[] emitElf(ObjUnit unit, int[] note) {
    ObjSymTab syms = new ObjSymTab();
    objBuildSyms(unit, syms);
    // Section names and their offsets in .shstrtab.
    string[] secNames = [".text", ".rdata", ".slvnote", ".shstrtab", ".symtab", ".strtab", ".rela.text", ".rela.data"];
    ObjWriter sw = new ObjWriter();
    sw.u8(0);
    int[] nameOff = [];
    for (int i = 0; i < secNames.length; i++) {
        nameOff.add(sw.out.length);
        sw.rawStr(secNames[i]);
        sw.u8(0);
    }
    int[] shstr = sw.out;
    // Symbol names into .strtab (the null entry and section symbols use
    // st_name 0). Written order: null, SECTION .text, SECTION .rdata,
    // datab (GLOBAL OBJECT), defined FUNCs, undefined symbols.
    ObjWriter tw = new ObjWriter();
    tw.u8(0);
    int[] symNameOff = [];
    symNameOff.add(0);
    for (int i = 0; i < syms.names.length; i++) {
        if (i < 2) {
            symNameOff.add(0);
        } else {
            symNameOff.add(tw.out.length);
            tw.rawStr(syms.names[i]);
            tw.u8(0);
        }
    }
    int[] strtab = tw.out;
    int nsymsWritten = syms.names.length + 1;
    int textOff = 64;
    int rdataOff = textOff + unit.code.length;
    int noteOff = rdataOff + unit.data.length;
    int shstrOff = noteOff + note.length;
    int symOff = shstrOff + shstr.length;
    while (symOff % 8 != 0) { symOff++; }
    int strOff = symOff + nsymsWritten * 24;
    int relaOff = strOff + strtab.length;
    int relaLen = unit.relSites.length * 24;
    int shoff = relaOff + relaLen;
    while (shoff % 8 != 0) { shoff++; }
    ObjWriter w = new ObjWriter();
    // ELF header (64 bytes).
    w.u8(127);
    w.rawStr("ELF");
    w.u8(2);
    w.u8(1);
    w.u8(1);
    w.u8(0);
    for (int pi = 0; pi < 8; pi++) { w.u8(0); }
    w.u16(1);
    w.u16(62);
    w.u32(1);
    w.u64(0);
    w.u64(0);
    w.u64(shoff);
    w.u32(0);
    w.u16(64);
    w.u16(0);
    w.u16(0);
    w.u16(64);
    w.u16(9);
    w.u16(4);
    w.rawBytes(unit.code);
    w.rawBytes(unit.data);
    w.rawBytes(note);
    w.rawBytes(shstr);
    while (w.out.length < symOff) { w.u8(0); }
    // .symtab (24 bytes each): null, SECTION .text, SECTION .rdata, the
    // datab (GLOBAL OBJECT), defined FUNCs, undefined symbols.
    for (int zi = 0; zi < 24; zi++) { w.u8(0); }
    for (int i = 0; i < syms.names.length; i++) {
        int sect = syms.sects[i];
        int isFunc = syms.funcs[i];
        int bind = 0;
        int typ = 3;
        if (i >= 2) {
            if (sect == 0) {
                bind = 1;
                if (isFunc == 1) { typ = 2; }
                else { typ = 0; }
            } else if (isFunc == 1) {
                bind = 1;
                typ = 2;
            } else {
                bind = 1;
                typ = 1;
            }
        }
        int shndx = 0;
        if (sect == 1) { shndx = 1; }
        else if (sect == 2) { shndx = 2; }
        w.u32(symNameOff[i + 1]);
        w.u8(bind * 16 + typ);
        w.u8(0);
        w.u16(shndx);
        w.u64(syms.vals[i]);
        w.u64(syms.sizes[i]);
    }
    w.rawBytes(strtab);
    // .rela.text (24 bytes each, sorted by site): Rel32 calls become
    // R_X86_64_PC32, Abs64 addresses R_X86_64_64. Written symbol indices
    // shift by one for the leading null entry. The ABS64 addend rides the
    // entry read back out of the site bytes the emitter wrote (data offsets;
    // zero everywhere else), so raw inspection and RELA agree.
    for (int i = 0; i < unit.relSites.length; i++) {
        int symidx = objSymIndexFor(unit, unit.relTargets[i], unit.relIdx[i], unit.relNames[i]);
        int rtype = 2;
        int64 addend = 0;
        if (unit.relKinds[i] == 1) {
            rtype = 1;
            for (int b = 0; b < 8; b++) {
                addend = addend | (int64(unit.code[unit.relSites[i] + b] & 0xFF) << (b * 8));
            }
        }
        w.u64(unit.relSites[i]);
        w.u64((int64(symidx + 1) << 32) | int64(rtype));
        w.u64(addend);
    }
    while (w.out.length < shoff) { w.u8(0); }
    // Section headers (64 bytes each): NULL, .text, .rdata, .slvnote,
    // .shstrtab, .symtab, .strtab, .rela.text, .rela.data.
    w.sh(0, 0, 0, 0, 0, 0, 0, 0, 0);
    w.sh(nameOff[0], 1, 6, textOff, unit.code.length, 0, 0, 16, 0);
    w.sh(nameOff[1], 1, 2, rdataOff, unit.data.length, 0, 0, 1, 0);
    w.sh(nameOff[2], 1, 0, noteOff, note.length, 0, 0, 1, 0);
    w.sh(nameOff[3], 3, 0, shstrOff, shstr.length, 0, 0, 1, 0);
    w.sh(nameOff[4], 2, 0, symOff, nsymsWritten * 24, 6, 3, 8, 24);
    w.sh(nameOff[5], 3, 0, strOff, strtab.length, 0, 0, 1, 0);
    w.sh(nameOff[6], 4, 0, relaOff, relaLen, 5, 1, 8, 24);
    // .rela.data is size-0 by construction (see above); sh_info still names
    // .rdata (index 2) and sh_link the .symtab (index 5).
    w.sh(nameOff[7], 4, 0, relaOff + relaLen, 0, 5, 2, 8, 24);
    return w.out;
}

// Minimal Mach-O object (Mac target): mach_header_64 (ARM64, MH_OBJECT) +
// LC_SEGMENT_64 (__TEXT with __text, __rdata and __slvnote sections) +
// LC_SYMTAB + LC_DYSYMTAB + section relocations. Byte-compatible with the
// reference emit_macho_object (same order, same values), so objects
// interoperate across compilers. Built only with byte pushes.
//
// The symbol table is genuine: two non-extern section anchors (__text,
// __rdata), one defined FUNC symbol per function owned by the file (the
// entry stub — the interpreter's emitter owns one function per file), the
// global data-anchor symbol (offset 0 in __rdata), and UNDEF entries for
// every cross-unit reference (the runner seam). Relocations cover the bl
// call (ARM64_RELOC_BRANCH26) and the adrp+add data pair
// (ARM64_RELOC_PAGE21 / ARM64_RELOC_PAGEOFF12).
public int[] emitMacho(ObjUnit unit, int[] note) {
    // ARM64 reloc types (mach-o/reloc.h): BRANCH26=2, PAGE21=3, PAGEOFF12=4.
    ObjSymTab syms = new ObjSymTab();
    objBuildSyms(unit, syms);
    int segCmdSize = 72 + 3 * 80;
    int sizeOfCmds = segCmdSize + 24 + 80;
    int textOff = 32 + sizeOfCmds;
    int rdataOff = textOff + unit.code.length;
    int noteOff = rdataOff + unit.data.length;
    int relOff = noteOff + note.length;
    int relLen = unit.relSites.length * 8;
    int symOff = relOff + relLen;
    // nlist order: the two section anchors, the data anchor, defined
    // funcs, then undefined functions, singletons, and imports. The
    // string table lives in a holder object, not a raw array parameter:
    // arrays received as parameters silently stop growing past 8 entries
    // in this toolchain, while prop arrays on a passed object keep
    // growing (see ObjSymTab above).
    MacStrtab stab = new MacStrtab();
    int[] nStrx = [];
    int[] nType = [];
    int[] nSect = [];
    int64[] nValue = [];
    // Map internal sym index -> nlist index (section anchors ARE entries
    // here, so every internal index maps).
    int[] nlistOf = [];
    for (int i = 0; i < syms.names.length; i++) { nlistOf.add(0); }
    nlistOf[0] = 0;
    nStrx.add(stab.add("__text"));
    nType.add(14);
    nSect.add(1);
    nValue.add(0);
    nlistOf[1] = 1;
    nStrx.add(stab.add("__rdata"));
    nType.add(14);
    nSect.add(2);
    nValue.add(0);
    nlistOf[symsDatabIdx(unit)] = nStrx.length;
    nStrx.add(stab.add(unit.datab));
    nType.add(15);
    nSect.add(2);
    nValue.add(0);
    for (int d = 0; d < unit.defNames.length; d++) {
        int symIdx = 2 + d;
        nlistOf[symIdx] = nStrx.length;
        string dnm = unit.defNames[d];
        nStrx.add(stab.add(dnm));
        nType.add(15);
        nSect.add(1);
        int doff = unit.defOffs[d];
        nValue.add(doff);
    }
    for (int f = 0; f < unit.undefFuncs.length; f++) {
        int symIdx = 2 + unit.defNames.length + 1 + f;
        nlistOf[symIdx] = nStrx.length;
        string ufnm = unit.undefFuncs[f];
        nStrx.add(stab.add(ufnm));
        nType.add(1);
        nSect.add(0);
        nValue.add(0);
    }
    for (int q = 0; q < unit.undefSingles.length; q++) {
        int symIdx = 2 + unit.defNames.length + 1 + unit.undefFuncs.length + q;
        nlistOf[symIdx] = nStrx.length;
        string snm = objSingletonGlobals();
        if (unit.undefSingles[q] == 0) { snm = objSingletonExc(); }
        else if (unit.undefSingles[q] == 1) { snm = objSingletonTray(); }
        nStrx.add(stab.add(snm));
        nType.add(1);
        nSect.add(0);
        nValue.add(0);
    }
    for (int v = 0; v < unit.undefImports.length; v++) {
        int symIdx = 2 + unit.defNames.length + 1 + unit.undefFuncs.length + unit.undefSingles.length + v;
        nlistOf[symIdx] = nStrx.length;
        nStrx.add(stab.add(objImportPrefix() + (string)unit.undefImports[v]));
        nType.add(1);
        nSect.add(0);
        nValue.add(0);
    }
    int strOff = symOff + nStrx.length * 16;
    // Dysymtab ranges over the table above: 2 local anchors, then
    // 1 + defined external definitions (datab + funcs), then undefineds.
    int nlocal = 2;
    int nextdef = 1 + unit.defNames.length;
    int nundef = unit.undefFuncs.length + unit.undefSingles.length + unit.undefImports.length;
    ObjWriter w = new ObjWriter();
    // mach_header_64 (32 bytes).
    // MH_MAGIC_64 0xFEEDFACF.
    w.u32(int(4277009103));
    w.u32(int(0x0100000C));
    w.u32(0);
    w.u32(1);
    w.u32(3);
    w.u32(sizeOfCmds);
    w.u32(0);
    w.u32(0);
    // LC_SEGMENT_64 + 3 sections.
    w.u32(int(0x19));
    w.u32(segCmdSize);
    w.rawName("__TEXT", 16);
    w.u64(0);
    w.u64(unit.code.length + unit.data.length + note.length);
    w.u64(textOff);
    w.u64(unit.code.length + unit.data.length + note.length);
    w.u32(7);
    w.u32(5);
    w.u32(3);
    w.u32(0);
    // Section 1: __text.
    w.rawName("__text", 16);
    w.rawName("__TEXT", 16);
    w.u64(0);
    w.u64(unit.code.length);
    w.u32(textOff);
    w.u32(2);
    if (unit.relSites.length > 0) { w.u32(relOff); }
    else { w.u32(0); }
    w.u32(unit.relSites.length);
    w.u32(int(0x80000400));
    w.u32(0);
    w.u32(0);
    w.u32(0);
    // Section 2: __rdata.
    w.rawName("__rdata", 16);
    w.rawName("__TEXT", 16);
    w.u64(0);
    w.u64(unit.data.length);
    w.u32(rdataOff);
    w.u32(0);
    w.u32(0);
    w.u32(0);
    w.u32(0);
    w.u32(0);
    w.u32(0);
    w.u32(0);
    // Section 3: __slvnote.
    w.rawName("__slvnote", 16);
    w.rawName("__TEXT", 16);
    w.u64(0);
    w.u64(note.length);
    w.u32(noteOff);
    w.u32(0);
    w.u32(0);
    w.u32(0);
    w.u32(0);
    w.u32(0);
    w.u32(0);
    w.u32(0);
    // LC_SYMTAB.
    w.u32(2);
    w.u32(24);
    w.u32(symOff);
    w.u32(nStrx.length);
    w.u32(strOff);
    w.u32(stab.buf.length);
    // LC_DYSYMTAB (local anchors, external definitions, undefineds).
    w.u32(int(0xB));
    w.u32(80);
    w.u32(0);
    w.u32(nlocal);
    w.u32(nlocal);
    w.u32(nextdef);
    w.u32(nlocal + nextdef);
    w.u32(nundef);
    for (int z = 0; z < 12; z++) { w.u32(0); }
    w.rawBytes(unit.code);
    w.rawBytes(unit.data);
    w.rawBytes(note);
    // Relocation entries (8 bytes): r_address + packed
    // (symbolnum[24] | pcrel[1] | length[2] | extern[1] | type[4]).
    for (int i = 0; i < unit.relSites.length; i++) {
        int rsite = unit.relSites[i];
        int rkind = unit.relKinds[i];
        int rtarget = unit.relTargets[i];
        int ridx = unit.relIdx[i];
        string rname = unit.relNames[i];
        int symidx = objSymIndexFor(unit, rtarget, ridx, rname);
        int rtype = 2;
        if (rkind == 3) { rtype = 3; }
        else if (rkind == 4) { rtype = 4; }
        else if (rkind != 2) {
            printline("object cache: x86 relocation in a Mach-O object");
            exit(1);
        }
        int ni = nlistOf[symidx];
        int packed = ni | (1 << 24) | (2 << 25) | (1 << 27) | (rtype << 28);
        w.u32(rsite);
        w.u32(packed);
    }
    // nlist_64 entries (16 bytes).
    for (int i = 0; i < nStrx.length; i++) {
        int sx = nStrx[i];
        int nt = nType[i];
        int ns = nSect[i];
        int64 nv = nValue[i];
        w.u32(sx);
        w.u8(nt);
        w.u8(ns);
        w.u16(0);
        w.u64(nv);
    }
    w.rawBytes(stab.buf);
    return w.out;
}

// String-table builder on a holder object (see the note at the stab site:
// raw array parameters stop growing past 8 entries; prop arrays keep
// growing).
class MacStrtab {
    public prop int[] buf;

    construct {
        this.buf = [];
        this.buf.add(0);
    }

    // Append a NUL-terminated name, returning its offset.
    public int add(string name) {
        int off = this.buf.length;
        for (int i = 0; i < name.length; i++) {
            int c = name[i];
            this.buf.add(c);
        }
        this.buf.add(0);
        return off;
    }
}

// Internal symbol index of the data anchor (see objBuildSyms order:
// 2 anchors, then defined funcs, then the datab).
private int symsDatabIdx(ObjUnit unit) {
    return 2 + unit.defNames.length;
}

// Serialize one interpreter-built unit for the session target: the proper
// relocatable container per target with genuine .text machine code,
// .rdata, .slvnote, symbol table, and relocations.
public int[] emitObject(ObjUnit unit, string flags, int64 hash, int stamp, string targetOs) {
    int[] note = objEncodeNote(unit, flags, hash, stamp);
    if (targetOs == "LINUX") { return emitElf(unit, note); }
    if (targetOs == "MAC") { return emitMacho(unit, note); }
    return emitCoff(unit, note, stamp);
}

// True when the unit exceeds the v1 boundary (COFF section limit): the
// session skips emission and the driver keeps running from the verified
// AST/bytecode tiers (loud fallback, never a silent mislink). The
// interpreter stub carries 2 relocations, so this is defensive only.
public bool objTooManyRelocs(ObjUnit unit) {
    return unit.relSites.length >= 65535;
}

// Silver object note (v5): SLVOBJ3 + flag-set string + source FNV-1 hash +
// emission stamp + globals-block size + import list + owner file key.
// Mirrors the reference encode_note byte-exactly (the interpreter always
// records gas 0 and an empty import list — the shape stays exact).
public int[] objEncodeNote(ObjUnit unit, string flags, int64 srcHash, int stamp) {
    ObjWriter w = new ObjWriter();
    w.rawStr("SLVOBJ3");
    w.strField(flags);
    w.u64(srcHash);
    w.u64(stamp);
    w.u64(unit.gas);
    w.u32(unit.impDlls.length);
    for (int i = 0; i < unit.impDlls.length; i++) {
        w.strField(unit.impDlls[i]);
        w.strField(unit.impNames[i]);
    }
    w.strField(unit.filekey);
    return w.out;
}

// Decode one note span into note. Returns "" when valid, else the exact
// reference error. A v4-era (SLVOBJ2) note fails here and the planner
// treats the object as stale — never a hard error.
private string objDecodeNote(ObjReader r, int noteOff, int noteLen, ObjNote note) {
    string badNote = "object cache: corrupt Silver note section";
    if (noteOff < 0 || noteLen <= 0 || noteOff + noteLen > r.size) { return badNote; }
    if (r.bytesAt(noteOff, 7) != "SLVOBJ3") { return badNote; }
    int pos = noteOff + 7;
    int flagLen = int(r.u32At(pos));
    pos += 4;
    if (flagLen < 0 || pos + flagLen + 8 + 8 + 8 + 4 > noteOff + noteLen) { return badNote; }
    note.flags = r.bytesAt(pos, flagLen);
    pos += flagLen;
    note.hash = r.u64At(pos);
    pos += 8;
    note.stamp = int(r.u64At(pos));
    pos += 8;
    note.gas = int(r.u64At(pos));
    pos += 8;
    int importCount = int(r.u32At(pos));
    pos += 4;
    if (importCount < 0 || importCount > 1000000) { return badNote; }
    note.impDlls = [];
    note.impNames = [];
    for (int i = 0; i < importCount; i++) {
        int dllLen = int(r.u32At(pos));
        pos += 4;
        if (dllLen < 0 || pos + dllLen > noteOff + noteLen) { return badNote; }
        string dll = r.bytesAt(pos, dllLen);
        pos += dllLen;
        int nameLen = int(r.u32At(pos));
        pos += 4;
        if (nameLen < 0 || pos + nameLen > noteOff + noteLen) { return badNote; }
        string nm = r.bytesAt(pos, nameLen);
        pos += nameLen;
        note.impDlls.add(dll);
        note.impNames.add(nm);
    }
    int keyLen = int(r.u32At(pos));
    pos += 4;
    if (keyLen < 0 || pos + keyLen > noteOff + noteLen) { return badNote; }
    note.filekey = r.bytesAt(pos, keyLen);
    return "";
}

// NUL-terminated name inside a string-table span.
private string objCStr(ObjReader r, int strOff, int strSize, int nameOff) {
    string[] parts = [];
    int p = strOff + nameOff;
    while (p < strOff + strSize) {
        int64 b = r.u8At(p);
        if (b < 0) { return ""; }
        if (b == 0) { break; }
        parts.add((string)char(int(b)));
        p++;
    }
    return parts.join("");
}

// Split a COFF object into its section spans: out holds
// [textOff, textLen, rdataOff, rdataLen, noteOff, noteLen].
// Returns "" on success, else the exact reference error. Sections match by
// name (like the reference split_coff): Machine must be AMD64 with exactly
// 3 sections and no optional header; VirtualSize is the exact data length
// while SizeOfRawData includes up-to-4 alignment padding.
private string objSplitCoff(ObjReader r, int[] out) {
    string bad = "object cache: corrupt COFF object";
    if (r.size < 20) { return bad; }
    if (int(r.u16At(0)) != 34404) { return bad; }
    if (int(r.u16At(2)) != 3 || int(r.u16At(16)) != 0) { return bad; }
    int textOff = -1;
    int textLen = 0;
    int rdataOff = -1;
    int rdataLen = 0;
    int noteOff = -1;
    int noteLen = 0;
    for (int i = 0; i < 3; i++) {
        int base = 20 + i * 40;
        string sname = r.bytesAt(base, 8);
        int vsize = int(r.u32At(base + 8));
        int rawsize = int(r.u32At(base + 16));
        int raw = int(r.u32At(base + 20));
        if (vsize < 0 || rawsize < 0 || raw < 0 || vsize > rawsize || raw + vsize > r.size) { return bad; }
        if (sname.startsWith(".text")) { textOff = raw; textLen = vsize; }
        else if (sname.startsWith(".rdata")) { rdataOff = raw; rdataLen = vsize; }
        else if (sname.startsWith(".slvnote")) { noteOff = raw; noteLen = vsize; }
    }
    if (textOff < 0 || rdataOff < 0 || noteOff < 0) { return bad; }
    out.add(textOff);
    out.add(textLen);
    out.add(rdataOff);
    out.add(rdataLen);
    out.add(noteOff);
    out.add(noteLen);
    return "";
}

// Split an ELF relocatable object into its section spans: out holds
// [textOff, textLen, rdataOff, rdataLen, noteOff, noteLen].
// Returns "" on success, else the exact reference error.
private string objSplitElf(ObjReader r, int[] out) {
    string bad = "object cache: corrupt ELF object";
    if (r.size < 64) { return bad; }
    if (int(r.u8At(0)) != 127 || int(r.u8At(1)) != 69 || int(r.u8At(2)) != 76 || int(r.u8At(3)) != 70) { return bad; }
    if (int(r.u8At(4)) != 2 || int(r.u8At(5)) != 1) { return bad; }
    if (int(r.u16At(16)) != 1 || int(r.u16At(18)) != 62) { return bad; }
    int shoff = int(r.u64At(40));
    int shnum = int(r.u16At(60));
    int shstrndx = int(r.u16At(62));
    if (shoff < 0 || shnum <= 0 || shstrndx < 0 || shstrndx >= shnum) { return bad; }
    if (shoff + shnum * 64 > r.size) { return bad; }
    int sbase = shoff + shstrndx * 64;
    int strOff = int(r.u64At(sbase + 24));
    int strSize = int(r.u64At(sbase + 32));
    if (strOff < 0 || strSize < 0 || strOff + strSize > r.size) { return bad; }
    int textOff = -1;
    int textLen = 0;
    int rdataOff = -1;
    int rdataLen = 0;
    int noteOff = -1;
    int noteLen = 0;
    for (int i = 0; i < shnum; i++) {
        int base = shoff + i * 64;
        int noff = int(r.u32At(base));
        int off = int(r.u64At(base + 24));
        int size = int(r.u64At(base + 32));
        if (noff < 0 || off < 0 || size < 0 || off + size > r.size) { return bad; }
        string sname = "";
        if (i > 0) { sname = objCStr(r, strOff, strSize, noff); }
        if (sname == ".text") { textOff = off; textLen = size; }
        else if (sname == ".rdata") { rdataOff = off; rdataLen = size; }
        else if (sname == ".slvnote") { noteOff = off; noteLen = size; }
    }
    if (textOff < 0 || rdataOff < 0 || noteOff < 0) { return bad; }
    out.add(textOff);
    out.add(textLen);
    out.add(rdataOff);
    out.add(rdataLen);
    out.add(noteOff);
    out.add(noteLen);
    return "";
}

// Split a Mach-O object into its section spans: out holds
// [textOff, textLen, rdataOff, rdataLen, noteOff, noteLen].
// Returns "" on success, else the exact reference error.
private string objSplitMacho(ObjReader r, int[] out) {
    string bad = "object cache: corrupt Mach-O object";
    if (r.size < 32) { return bad; }
    // MH_MAGIC_64 0xFEEDFACF.
    if (r.u32At(0) != int(4277009103)) { return bad; }
    if (r.u32At(4) != int(0x0100000C)) { return bad; }
    if (r.u32At(12) != 1) { return bad; }
    int ncmds = int(r.u32At(16));
    int off = 32;
    int textOff = -1;
    int textLen = 0;
    int rdataOff = -1;
    int rdataLen = 0;
    int noteOff = -1;
    int noteLen = 0;
    for (int i = 0; i < ncmds; i++) {
        int cmd = int(r.u32At(off));
        int cmdsize = int(r.u32At(off + 4));
        if (cmdsize < 8 || off + cmdsize > r.size) { return bad; }
        if (cmd == int(0x19)) {
            int nsects = int(r.u32At(off + 64));
            if (nsects < 0 || nsects > 100) { return bad; }
            for (int q = 0; q < nsects; q++) {
                int base = off + 72 + q * 80;
                if (base + 80 > r.size) { return bad; }
                int size = int(r.u64At(base + 40));
                int fileoff = int(r.u32At(base + 48));
                if (size < 0 || fileoff < 0 || fileoff + size > r.size) { return bad; }
                if (r.bytesAt(base, 6) == "__text") { textOff = fileoff; textLen = size; }
                else if (r.bytesAt(base, 7) == "__rdata") { rdataOff = fileoff; rdataLen = size; }
                else if (r.bytesAt(base, 9) == "__slvnote") { noteOff = fileoff; noteLen = size; }
            }
        }
        off += cmdsize;
    }
    if (textOff < 0 || rdataOff < 0 || noteOff < 0) { return bad; }
    out.add(textOff);
    out.add(textLen);
    out.add(rdataOff);
    out.add(rdataLen);
    out.add(noteOff);
    out.add(noteLen);
    return "";
}

// Parse just the Silver note (cheap freshness probe, mirrors the reference
// peek_note): split the container for the session target, decode the v5
// note into note. Returns true when the container and note are valid v5 —
// v4-era and foreign objects fail here and the planner treats them as
// stale, never a hard error.
public bool objPeekNote(ObjReader r, string targetOs, ObjNote note) {
    int[] spans = [];
    string serr = "";
    if (targetOs == "LINUX") { serr = objSplitElf(r, spans); }
    else if (targetOs == "MAC") { serr = objSplitMacho(r, spans); }
    else { serr = objSplitCoff(r, spans); }
    if (serr.length > 0) { return false; }
    string nerr = objDecodeNote(r, spans[4], spans[5], note);
    return nerr.length == 0;
}

// Fully parse one COFF object into obj (mirrors the reference parse_coff:
// code + data + note + symbol table with class/section checks + .text
// relocations with type checks, REL32 = 20 / ADDR64 = 1, ABS64 sites
// bounds-checked against the code length). Hard errors on any corruption.
public string objParseCoff(ObjReader r, ParsedObj obj) {
    string bad = "object cache: corrupt COFF object";
    int[] spans = [];
    string serr = objSplitCoff(r, spans);
    if (serr.length > 0) { return serr; }
    int textOff = spans[0];
    int textLen = spans[1];
    int rdataOff = spans[2];
    int rdataLen = spans[3];
    int noteOff = spans[4];
    int noteLen = spans[5];
    obj.code = [];
    for (int i = 0; i < textLen; i++) { obj.code.add(int(r.u8At(textOff + i))); }
    obj.data = [];
    for (int i = 0; i < rdataLen; i++) { obj.data.add(int(r.u8At(rdataOff + i))); }
    ObjNote note = new ObjNote();
    string nerr = objDecodeNote(r, noteOff, noteLen, note);
    if (nerr.length > 0) { return nerr; }
    obj.flags = note.flags;
    obj.hash = note.hash;
    obj.stamp = note.stamp;
    obj.gas = note.gas;
    obj.impDlls = note.impDlls;
    obj.impNames = note.impNames;
    obj.filekey = note.filekey;
    int symOff = int(r.u32At(8));
    int nsyms = int(r.u32At(12));
    if (symOff < 0 || nsyms < 2) { return bad; }
    // String table follows the symbol table.
    int strtabOff = symOff + nsyms * 18;
    int strtabLen = int(r.u32At(strtabOff));
    if (strtabLen < 4 || strtabOff + strtabLen > r.size) { return bad; }
    obj.symNames = [];
    obj.symSects = [];
    obj.symVals = [];
    obj.symIsFunc = [];
    for (int i = 0; i < nsyms; i++) {
        int base = symOff + i * 18;
        if (base + 18 > r.size) { return bad; }
        string name = "";
        if (r.u8At(base) == 0 && r.u8At(base + 1) == 0 && r.u8At(base + 2) == 0 && r.u8At(base + 3) == 0) {
            int strRef = int(r.u32At(base + 4));
            name = objCStr(r, strtabOff, strtabLen, strRef);
            if (name.length == 0) { return bad; }
        } else {
            string[] parts = [];
            for (int b = 0; b < 8; b++) {
                int64 c = r.u8At(base + b);
                if (c < 0) { return bad; }
                if (c == 0) { break; }
                parts.add((string)char(int(c)));
            }
            name = parts.join("");
        }
        int value = int(r.u32At(base + 8));
        int sect = int(r.u16At(base + 12));
        int stype = int(r.u16At(base + 14));
        int sclass = int(r.u8At(base + 16));
        if (value < 0 || sect < 0 || sect > 3) { return bad; }
        if (sclass != 2 && sclass != 3) { return bad; }
        obj.symNames.add(name);
        obj.symSects.add(sect);
        obj.symVals.add(value);
        if (stype == 32) { obj.symIsFunc.add(1); }
        else { obj.symIsFunc.add(0); }
    }
    // Relocations from the .text header (relptr at +24, count at +32).
    int relPtr = int(r.u32At(20 + 24));
    int nrel = int(r.u16At(20 + 32));
    if (relPtr < 0 || nrel < 0 || (nrel > 0 && relPtr + nrel * 10 > r.size)) { return bad; }
    obj.relSites = [];
    obj.relSyms = [];
    obj.relKinds = [];
    obj.relAddends = [];
    for (int i = 0; i < nrel; i++) {
        int base = relPtr + i * 10;
        int site = int(r.u32At(base));
        int sni = int(r.u32At(base + 4));
        int rtype = int(r.u16At(base + 8));
        if (site < 0 || sni < 0 || sni >= obj.symNames.length) { return bad; }
        int kind = -1;
        if (rtype == 20) { kind = 0; }
        else if (rtype == 1) { kind = 1; }
        else { return bad; }
        // COFF addends live in the site bytes.
        int64 addend = 0;
        if (kind == 1) {
            if (site + 8 > obj.code.length) { return bad; }
            addend = 0;
            for (int b = 0; b < 8; b++) {
                addend = addend | (int64(obj.code[site + b] & 0xFF) << (b * 8));
            }
        } else {
            if (site + 4 > obj.code.length) { return bad; }
        }
        obj.relSites.add(site);
        obj.relSyms.add(sni);
        obj.relKinds.add(kind);
        obj.relAddends.add(addend);
    }
    return "";
}

// Fully parse one ELF relocatable object into obj (mirrors the reference
// parse_elf_rel: sections by name, symbols from .symtab/.strtab,
// relocations from .rela.text; a non-empty .rela.data is corruption — a
// missing one is an older object and still validates).
// Hard errors on any corruption.
public string objParseElf(ObjReader r, ParsedObj obj) {
    string bad = "object cache: corrupt ELF object";
    int[] spans = [];
    string serr = objSplitElf(r, spans);
    if (serr.length > 0) { return serr; }
    int textOff = spans[0];
    int textLen = spans[1];
    int rdataOff = spans[2];
    int rdataLen = spans[3];
    int noteOff = spans[4];
    int noteLen = spans[5];
    obj.code = [];
    for (int i = 0; i < textLen; i++) { obj.code.add(int(r.u8At(textOff + i))); }
    obj.data = [];
    for (int i = 0; i < rdataLen; i++) { obj.data.add(int(r.u8At(rdataOff + i))); }
    ObjNote note = new ObjNote();
    string nerr = objDecodeNote(r, noteOff, noteLen, note);
    if (nerr.length > 0) { return nerr; }
    obj.flags = note.flags;
    obj.hash = note.hash;
    obj.stamp = note.stamp;
    obj.gas = note.gas;
    obj.impDlls = note.impDlls;
    obj.impNames = note.impNames;
    obj.filekey = note.filekey;
    int shoff = int(r.u64At(40));
    int shnum = int(r.u16At(60));
    int shstrndx = int(r.u16At(62));
    int sbase = shoff + shstrndx * 64;
    int strOff = int(r.u64At(sbase + 24));
    int strSize = int(r.u64At(sbase + 32));
    // Section index -> name (for STT_SECTION symbols).
    string[] secNames = [];
    for (int i = 0; i < shnum; i++) {
        int base = shoff + i * 64;
        int noff = int(r.u32At(base));
        if (i == 0) { secNames.add(""); }
        else { secNames.add(objCStr(r, strOff, strSize, noff)); }
    }
    // Locate .symtab, .strtab, .rela.text, .rela.data by name.
    int symOff = -1;
    int symSize = 0;
    int stabOff = -1;
    int stabSize = 0;
    int relaOff = -1;
    int relaSize = 0;
    bool hasRelaData = false;
    int relaDataSize = 0;
    for (int i = 1; i < shnum; i++) {
        int base = shoff + i * 64;
        int stype = int(r.u32At(base + 4));
        int off = int(r.u64At(base + 24));
        int size = int(r.u64At(base + 32));
        if (secNames[i] == ".symtab") {
            if (stype != 2) { return bad; }
            symOff = off;
            symSize = size;
        } else if (secNames[i] == ".strtab") {
            stabOff = off;
            stabSize = size;
        } else if (secNames[i] == ".rela.text") {
            relaOff = off;
            relaSize = size;
        } else if (secNames[i] == ".rela.data") {
            hasRelaData = true;
            relaDataSize = size;
        }
    }
    if (symOff < 0 || stabOff < 0) { return bad; }
    // .rela.data must be empty when present: .rdata carries no pointers by
    // construction, so a data relocation has no meaning the linker could
    // apply. A missing section is an older object and still validates.
    if (hasRelaData && relaDataSize != 0) { return bad; }
    int nsyms = symSize / 24;
    if (symOff + symSize > r.size || stabOff + stabSize > r.size) { return bad; }
    obj.symNames = [];
    obj.symSects = [];
    obj.symVals = [];
    obj.symIsFunc = [];
    for (int i = 0; i < nsyms; i++) {
        int base = symOff + i * 24;
        if (base + 24 > r.size) { return bad; }
        int nameOff = int(r.u32At(base));
        int info = int(r.u8At(base + 4));
        int shndx = int(r.u16At(base + 6));
        int64 value = r.u64At(base + 8);
        int64 size = r.u64At(base + 16);
        int typ = info & 0x0F;
        string name = "";
        if (i == 0) {
            name = "";
        } else if (typ == 3) {
            if (shndx < 0 || shndx >= secNames.length) { return bad; }
            name = secNames[shndx];
        } else {
            // String-table reference: the offset must land inside .strtab
            // with a terminator past it (an immediate NUL decodes to the
            // empty name, exactly like the reference).
            if (nameOff < 0 || nameOff >= stabSize) { return bad; }
            bool term = false;
            for (int t = stabOff + nameOff; t < stabOff + stabSize; t++) {
                if (r.u8At(t) == 0) { term = true; break; }
            }
            if (!term) { return bad; }
            name = objCStr(r, stabOff, stabSize, nameOff);
        }
        int sect = -1;
        if (shndx == 0) { sect = 0; }
        else if (shndx == 1) { sect = 1; }
        else if (shndx == 2) { sect = 2; }
        else { return bad; }
        if (value < 0 || value > 4294967295 || size < 0 || size > 4294967295) { return bad; }
        obj.symNames.add(name);
        obj.symSects.add(sect);
        obj.symVals.add(int(value));
        if (typ == 2) { obj.symIsFunc.add(1); }
        else { obj.symIsFunc.add(0); }
    }
    obj.relSites = [];
    obj.relSyms = [];
    obj.relKinds = [];
    obj.relAddends = [];
    if (relaOff >= 0) {
        if (relaSize % 24 != 0) { return bad; }
        if (relaOff + relaSize > r.size) { return bad; }
        int nrel = relaSize / 24;
        for (int i = 0; i < nrel; i++) {
            int base = relaOff + i * 24;
            int64 site = r.u64At(base);
            int64 rinfo = r.u64At(base + 8);
            int64 addend = r.u64At(base + 16);
            int sni = int(rinfo >> 32);
            int rtype = int(rinfo & 0xFFFFFFFF);
            if (site < 0 || site > 4294967295 || sni < 0 || sni >= obj.symNames.length) { return bad; }
            int kind = -1;
            if (rtype == 2) { kind = 0; }
            else if (rtype == 1) { kind = 1; }
            else { return bad; }
            obj.relSites.add(int(site));
            obj.relSyms.add(sni);
            obj.relKinds.add(kind);
            obj.relAddends.add(addend);
        }
    }
    return "";
}

// Fully parse one Mach-O object into obj (hard errors on any corruption).
// Relocation addends ride in the instruction immediates (Mach-O ARM64
// convention): bl placeholders must be zero; adrp/add immediates carry the
// unit-relative data offset, which the linker pairs by site adjacency (add
// at adrp + 4, same symbol).
public string objParseMacho(ObjReader r, ParsedObj obj) {
    string bad = "object cache: corrupt Mach-O object";
    int[] spans = [];
    string serr = objSplitMacho(r, spans);
    if (serr.length > 0) { return serr; }
    int textOff = spans[0];
    int textLen = spans[1];
    int rdataOff = spans[2];
    int rdataLen = spans[3];
    int noteOff = spans[4];
    int noteLen = spans[5];
    obj.code = [];
    for (int i = 0; i < textLen; i++) { obj.code.add(int(r.u8At(textOff + i))); }
    obj.data = [];
    for (int i = 0; i < rdataLen; i++) { obj.data.add(int(r.u8At(rdataOff + i))); }
    ObjNote note = new ObjNote();
    string nerr = objDecodeNote(r, noteOff, noteLen, note);
    if (nerr.length > 0) { return nerr; }
    obj.flags = note.flags;
    obj.hash = note.hash;
    obj.stamp = note.stamp;
    obj.gas = note.gas;
    obj.impDlls = note.impDlls;
    obj.impNames = note.impNames;
    obj.filekey = note.filekey;
    int ncmds = int(r.u32At(16));
    // Locate the LC_SYMTAB string table and the __text relocations. Spans
    // ride a holder object (raw array parameters stop growing past 8
    // entries; a foreign object could name many __text sections).
    int symoff = -1;
    int nsyms = 0;
    int stroff = -1;
    MacRelSpans relSpans = new MacRelSpans();
    int off = 32;
    for (int i = 0; i < ncmds; i++) {
        int cmd = int(r.u32At(off));
        int cmdsize = int(r.u32At(off + 4));
        if (cmdsize < 8 || off + cmdsize > r.size) { return bad; }
        if (cmd == int(0x19)) {
            int nsects = int(r.u32At(off + 64));
            for (int q = 0; q < nsects; q++) {
                int base = off + 72 + q * 80;
                if (base + 80 > r.size) { return bad; }
                if (r.bytesAt(base, 6) == "__text") {
                    int reloff = int(r.u32At(base + 56));
                    int nreloc = int(r.u32At(base + 60));
                    if (nreloc < 0) { return bad; }
                    if (nreloc > 0) {
                        relSpans.offs.add(reloff);
                        relSpans.counts.add(nreloc);
                    }
                }
            }
        } else if (cmd == 2) {
            symoff = int(r.u32At(off + 8));
            nsyms = int(r.u32At(off + 12));
            stroff = int(r.u32At(off + 16));
        }
        off += cmdsize;
    }
    if (symoff < 0 || nsyms <= 0 || stroff < 0) { return bad; }
    if (symoff + nsyms * 16 > r.size) { return bad; }
    obj.symNames = [];
    obj.symSects = [];
    obj.symVals = [];
    obj.symIsFunc = [];
    for (int i = 0; i < nsyms; i++) {
        int base = symoff + i * 16;
        if (base + 16 > r.size) { return bad; }
        int strx = int(r.u32At(base));
        int ntype = int(r.u8At(base + 4));
        int nsect = int(r.u8At(base + 5));
        int64 nvalue = r.u64At(base + 8);
        string[] nm = [];
        if (!macStrtabName(r, stroff, strx, nm)) { return bad; }
        string name = nm[0];
        if (nvalue < 0 || nvalue > 4294967295) { return bad; }
        if ((ntype & 224) != 0) { return bad; }
        int sect = -1;
        int isFunc = 0;
        if ((ntype & 14) == 14) {
            if (nsect != 1 && nsect != 2) { return bad; }
            sect = nsect;
            if (nsect == 1 && (ntype & 1) != 0) { isFunc = 1; }
        } else if ((ntype & 14) == 0) {
            if ((ntype & 1) == 0) { return bad; }
            sect = 0;
        } else {
            return bad;
        }
        obj.symNames.add(name);
        obj.symSects.add(sect);
        obj.symVals.add(int(nvalue));
        obj.symIsFunc.add(isFunc);
    }
    obj.relSites = [];
    obj.relSyms = [];
    obj.relKinds = [];
    obj.relAddends = [];
    for (int t = 0; t < relSpans.offs.length; t++) {
        for (int i = 0; i < relSpans.counts[t]; i++) {
            int base = relSpans.offs[t] + i * 8;
            if (base + 8 > r.size) { return bad; }
            int address = int(r.u32At(base));
            int packed = int(r.u32At(base + 4));
            int symnum = packed & 16777215;
            int pcrel = (packed >> 24) & 1;
            int length = (packed >> 25) & 3;
            int ext = (packed >> 27) & 1;
            int rtype = int((int64(packed) >> 28) & 15);
            if (ext != 1 || pcrel != 1 || length != 2 || symnum < 0 || symnum >= obj.symNames.length) { return bad; }
            if (address < 0 || address + 4 > obj.code.length) { return bad; }
            int word = macWordAt(obj.code, address);
            int kind = -1;
            int64 addend = 0;
            if (rtype == 2) {
                if (a64DecodeBlImm26(word) != 0 || (word >> 26) != 37) { return bad; }
                kind = 2;
            } else if (rtype == 3) {
                if ((word & int(0x9F000000)) != int(0x90000000)) { return bad; }
                kind = 3;
                addend = int64(a64DecodeAdrpPage(word)) << 12;
            } else if (rtype == 4) {
                if ((word & int(0xFF000000)) != int(0x91000000)) { return bad; }
                kind = 4;
                addend = a64DecodeAddImm12(word);
            } else {
                return bad;
            }
            obj.relSites.add(address);
            obj.relSyms.add(symnum);
            obj.relKinds.add(kind);
            obj.relAddends.add(addend);
        }
    }
    return "";
}

// __text relocation spans on a holder object (see the note at the spans
// site: raw array parameters stop growing past 8 entries).
class MacRelSpans {
    public prop int[] offs;
    public prop int[] counts;

    construct {
        this.offs = [];
        this.counts = [];
    }
}

// NUL-terminated name at strOff + strx (an immediate NUL decodes to the
// empty name, exactly like the reference). Returns false when the offset
// lands outside the file or no terminator follows.
private bool macStrtabName(ObjReader r, int strOff, int strx, string[] out) {
    if (strx < 0 || strOff + strx >= r.size) { return false; }
    string[] parts = [];
    int p = strOff + strx;
    bool term = false;
    while (p < r.size) {
        int64 b = r.u8At(p);
        if (b < 0) { return false; }
        if (b == 0) { term = true; break; }
        parts.add((string)char(int(b)));
        p++;
    }
    if (!term) { return false; }
    out.add(parts.join(""));
    return true;
}

// Fully parse one cached object for the session target (hard errors: a
// fresh-planned file whose object is corrupt fails loudly instead of being
// reused silently). Fills obj, returns "" or the exact reference error.
public string objParseObject(ObjReader r, string targetOs, ParsedObj obj) {
    if (targetOs == "LINUX") { return objParseElf(r, obj); }
    if (targetOs == "MAC") { return objParseMacho(r, obj); }
    return objParseCoff(r, obj);
}

// Fully parse one cached object for the session target (hard errors: a
// fresh-planned file whose object is corrupt fails loudly instead of being
// reused silently). Fills obj, returns "" or the exact reference error.
public string objParseObject(ObjReader r, string targetOs, ParsedObj obj) {
    if (targetOs == "LINUX") { return objParseElf(r, obj); }
    if (targetOs == "MAC") { return objParseMacho(r, obj); }
    return objParseCoff(r, obj);
}

// ---------------------------------------------------------------------------
// mac-aarch64 object-tier boundary predicate (mirrors silverc-rs
// mac_tier_fallback_reason and silverc/compiler/objcache.sr macTierReason
// exactly: same boundary, same reason strings).
//
// A program is in-tier when ALL of these hold:
//
// - Items are only free functions, const integer/bool/char items with
//   literal values, and import items. No structs, classes, enums, modules,
//   type aliases, globals, or any other item kind.
// - Exactly one main with no parameters and void return.
// - Every other function is free-standing (no overloads — duplicate names
//   fall back), takes at most 8 parameters, has no default values, and uses
//   only int/bool/char parameter and return types (void return allowed).
// - No user function is named print, printline, printf, or exit (those
//   names are the tier's builtins/imports).
// - Statements: local int/bool/char declarations with an initializer,
//   plain/compound (+=, -=, *=, and the << move form) assignment to locals,
//   if/else, while, break/continue inside while, return, calls, and
//   print/printline with exactly one argument. No for/foreach,
//   match/switch, exceptions, or destructuring. (This AST desugars ++/--
//   into +=/-= 1, so they ride the assignment arm with identical strings.)
// - Expressions: integer/bool/char literals, const reads, local and
//   parameter reads, +/-/* (no division or modulo), unary -, !,
//   comparisons, short-circuit &&/||, parentheses, calls to program-defined
//   functions with exact arity, and string literals ONLY as the direct
//   argument of print/printline.
// - Total frame (parameters + locals + operand slots) fits in 500 8-byte
//   slots.
//
// Kind/operator numbers below are this interpreter's ND_*/OP_* constants
// (ast.sr); the port's raw numbers ride in comments (Pnn) so the mapping
// stays reviewable. Reason strings are byte-identical to the references.
//
// The driver consults this on the mac path after parsing: an out-of-tier
// entry prints the loud fallback (reference reason + the interpreter's
// verified-tier continuation) and runs from the verified AST/bytecode
// tiers. The interpreter's mac objects carry the entry stub only — never
// lowered program semantics — so the predicate never gates emission, only
// the loudness of the boundary.
// ---------------------------------------------------------------------------

// Whole-program tier context: function signatures, const values, and
// whether any print needs the printf import. Parameter and return kinds
// are single letters (i = int, b = bool, c = char, v = void) mirroring the
// reference TierCtx.
class MacCtx {
    public prop string[] sigNames;
    public prop string[] sigParams;
    public prop string[] sigRets;
    public prop string[] constNames;
    public prop string[] constKinds;
    public prop int64[] constVals;
    public prop bool usesPrintf;

    construct {
        this.sigNames = [];
        this.sigParams = [];
        this.sigRets = [];
        this.constNames = [];
        this.constKinds = [];
        this.constVals = [];
        this.usesPrintf = false;
    }
}

// Per-function layout: variable slots plus operand-stack depth.
class MacLayout {
    public prop string[] varNames;
    public prop string[] varKinds;
    public prop int[] varSlots;
    public prop int totalSlots;
    public prop int maxDepth;
    public prop int frameBytes;

    construct {
        this.varNames = [];
        this.varKinds = [];
        this.varSlots = [];
        this.totalSlots = 0;
        this.maxDepth = 0;
        this.frameBytes = 0;
    }
}

// Checked-expression value: scalar kind (0 = int, 1 = bool, 2 = char,
// 3 = bare string literal) plus the operand-stack slots it needs.
class MacVal {
    public prop int kind;
    public prop int depth;

    construct {
        this.kind = 0;
        this.depth = 0;
    }
}

// Walker state for the boundary check (mirrors the reference Walker:
// locals accumulate slots, maxDepth tracks the operand area, loopDepth
// gates break/continue).
class MacWalk {
    public prop MacCtx ctx;
    public prop string fname;
    public prop bool voidFn;
    public prop string[] varNames;
    public prop string[] varKinds;
    public prop int nextSlot;
    public prop int maxDepth;
    public prop int loopDepth;

    construct (MacCtx c) {
        this.ctx = c;
        this.fname = "";
        this.voidFn = false;
        this.varNames = [];
        this.varKinds = [];
        this.nextSlot = 0;
        this.maxDepth = 0;
        this.loopDepth = 0;
    }
}

// Tier scalar letter for a declared type spelling, or "" when the type is
// outside the tier (only int/bool/char lower as 64-bit values).
private string macScalarOf(string t) {
    if (t == "int") { return "i"; }
    if (t == "bool") { return "b"; }
    if (t == "char") { return "c"; }
    return "";
}

private int macMax(int a, int b) {
    if (a > b) { return a; }
    return b;
}

private int macFindSig(MacCtx ctx, string name) {
    for (int i = 0; i < ctx.sigNames.length; i++) {
        if (ctx.sigNames[i] == name) { return i; }
    }
    return -1;
}

private int macFindConst(MacCtx ctx, string name) {
    for (int i = 0; i < ctx.constNames.length; i++) {
        if (ctx.constNames[i] == name) { return i; }
    }
    return -1;
}

private int macFindVar(MacWalk w, string name) {
    for (int i = 0; i < w.varNames.length; i++) {
        if (w.varNames[i] == name) { return i; }
    }
    return -1;
}

// Why a program is outside the mac object tier ("" = in-tier). Reason
// strings mirror the reference mac_tier_fallback_reason exactly.
public string macTierReason(Node[] program) {
    MacCtx ctx = new MacCtx();
    // Pass 1: items and signatures.
    for (int i = 0; i < program.length; i++) {
        Node item = program[i];
        if (item.kind == ND_FUNC) {
            if (item.name == "print" || item.name == "printline" || item.name == "printf" || item.name == "exit") {
                return "user function '" + item.name + "' collides with a tier builtin";
            }
            if (macFindSig(ctx, item.name) >= 0) {
                return "overloaded function '" + item.name + "' (duplicate name)";
            }
            if (item.childCount() < 2) {
                return "function '" + item.name + "' has no body";
            }
            Node params = item.child(0);
            if (params.childCount() > 8) {
                return "function '" + item.name + "' takes " + (string)params.childCount() + " parameters (tier limit 8)";
            }
            string kinds = "";
            for (int pi = 0; pi < params.childCount(); pi++) {
                Node p = params.child(pi);
                string pk = macScalarOf(p.typeHint);
                if (pk.length == 0) {
                    return "parameter '" + p.name + "' of '" + item.name + "' has non-tier type";
                }
                if (p.childCount() > 0) {
                    return "default value on parameter '" + p.name + "' of '" + item.name + "'";
                }
                // No isVariadic field exists in this AST (only the `void ()`
                // fn-typed shape survives parsing as a non-scalar); either
                // way the reference string names both spellings.
                if (p.typeHint == "void ()") {
                    return "parameter '" + p.name + "' of '" + item.name + "' is variadic or function-typed";
                }
                kinds += pk;
            }
            string ret = "v";
            if (item.typeHint != "" && item.typeHint != "void") {
                ret = macScalarOf(item.typeHint);
                if (ret.length == 0) {
                    return "function '" + item.name + "' has non-tier return type";
                }
            }
            ctx.sigNames.add(item.name);
            ctx.sigParams.add(kinds);
            ctx.sigRets.add(ret);
        } else if (item.kind == ND_CONST) {
            string ck = macScalarOf(item.typeHint);
            if (ck.length == 0) {
                return "const '" + item.name + "' has non-tier type";
            }
            if (item.childCount() == 0) {
                return "const '" + item.name + "' needs a literal value";
            }
            Node v = item.child(0);
            if (v.kind == ND_INT_LIT) {
                ctx.constNames.add(item.name);
                ctx.constKinds.add(ck);
                ctx.constVals.add(v.intVal);
            } else if (v.kind == ND_BOOL_LIT) {
                ctx.constNames.add(item.name);
                ctx.constKinds.add(ck);
                if (v.boolVal) { ctx.constVals.add(1); }
                else { ctx.constVals.add(0); }
            } else if (v.kind == ND_CHAR_LIT) {
                ctx.constNames.add(item.name);
                ctx.constKinds.add(ck);
                int cv = v.charVal;
                ctx.constVals.add(int64(cv));
            } else {
                return "const '" + item.name + "' needs a literal value";
            }
        } else if (item.kind == ND_IMPORT) {
            // Import items carry no code.
        } else if (item.kind == ND_STRUCT_DEF) {
            return "struct definitions";
        } else if (item.kind == ND_CLASS_DEF) {
            return "class definitions";
        } else if (item.kind == ND_ENUM_DEF) {
            return "enum definitions";
        } else if (item.kind == ND_MODULE) {
            return "inline module blocks";
        } else if (item.kind == ND_TYPE_ALIAS) {
            return "type aliases";
        } else if (item.kind == ND_FOUND) {
            return "found items";
        } else if (item.kind == ND_COLLECT) {
            return "collect items";
        } else if (item.kind == ND_DEF_UNIT) {
            return "defunit items";
        } else if (item.kind == ND_ANNOTATION) {
            return "annotations";
        } else {
            return "top-level statements";
        }
    }
    // The entry contract: exactly one void main() with no parameters.
    int mi = macFindSig(ctx, "main");
    if (mi < 0) {
        return "no main function";
    }
    string mainParams = ctx.sigParams[mi];
    if (mainParams.length > 0) {
        return "main takes parameters";
    }
    string mainRet = ctx.sigRets[mi];
    if (mainRet != "v") {
        return "main returns a value";
    }
    // Pass 2: every function body (also flags printf use).
    for (int i = 0; i < program.length; i++) {
        Node item = program[i];
        if (item.kind == ND_FUNC) {
            MacLayout layout = new MacLayout();
            string err = macCheckFunc(ctx, item, layout);
            if (err.length > 0) { return err; }
        }
    }
    return "";
}

// Check one function body and compute its layout. Shared by the predicate
// and any future lowering, so they can never disagree about the boundary.
private string macCheckFunc(MacCtx ctx, Node func, MacLayout layout) {
    int si = macFindSig(ctx, func.name);
    if (si < 0) { return "missing signature in '" + func.name + "'"; }
    if (func.childCount() < 2) { return "missing body in '" + func.name + "'"; }
    MacWalk w = new MacWalk(ctx);
    w.fname = func.name;
    w.voidFn = ctx.sigRets[si] == "v";
    string pks = ctx.sigParams[si];
    Node params = func.child(0);
    for (int i = 0; i < params.childCount(); i++) {
        Node p = params.child(i);
        w.varNames.add(p.name);
        w.varKinds.add(pks[i..i + 1]);
    }
    w.nextSlot = params.childCount();
    Node body = func.child(1);
    string err = macWalkBlock(w, body, 0);
    if (err.length > 0) { return err; }
    if (w.nextSlot + w.maxDepth > 500) {
        return "frame too large in '" + func.name + "'";
    }
    layout.varNames = w.varNames;
    layout.varKinds = w.varKinds;
    layout.varSlots = [];
    for (int i = 0; i < w.varNames.length; i++) { layout.varSlots.add(i); }
    layout.totalSlots = w.nextSlot + w.maxDepth;
    layout.maxDepth = w.maxDepth;
    layout.frameBytes = (layout.totalSlots * 8 + 15) / 16 * 16;
    return "";
}

private string macWalkBlock(MacWalk w, Node block, int base) {
    if (block.kind == ND_BLOCK) {
        for (int i = 0; i < block.childCount(); i++) {
            string err = macWalkStmt(w, block.child(i), base);
            if (err.length > 0) { return err; }
        }
        return "";
    }
    return macWalkStmt(w, block, base);
}

private string macWalkStmt(MacWalk w, Node s, int base) {
    if (s.kind == ND_EXPR_STMT) {
        if (s.childCount() == 0) { return ""; }
        MacVal v = new MacVal();
        string err = macWalkExpr(w, s.child(0), true, base, v);
        if (err.length > 0) { return err; }
        w.maxDepth = macMax(w.maxDepth, base + v.depth);
        return "";
    }
    if (s.kind == ND_VAR_DECL) {
        if (s.childCount() == 0) {
            return "uninitialized local '" + s.name + "' in '" + w.fname + "'";
        }
        MacVal v = new MacVal();
        string err = macWalkExpr(w, s.child(0), false, base, v);
        if (err.length > 0) { return err; }
        if (v.kind == 3) {
            return "string values in '" + w.fname + "'";
        }
        string vk = "";
        if (v.kind == 0) { vk = "i"; }
        else if (v.kind == 1) { vk = "b"; }
        else { vk = "c"; }
        if (s.typeHint != "" && s.typeHint != "var") {
            vk = macScalarOf(s.typeHint);
            if (vk.length == 0) {
                return "local '" + s.name + "' has non-tier type in '" + w.fname + "'";
            }
        }
        if (w.nextSlot >= 500) {
            return "frame too large in '" + w.fname + "'";
        }
        w.varNames.add(s.name);
        w.varKinds.add(vk);
        w.nextSlot++;
        w.maxDepth = macMax(w.maxDepth, base + v.depth);
        return "";
    }
    if (s.kind == ND_RETURN) {
        if (s.childCount() == 0) {
            if (!w.voidFn) {
                return "empty return in '" + w.fname + "'";
            }
            return "";
        }
        if (w.voidFn) {
            return "return with a value in '" + w.fname + "'";
        }
        MacVal v = new MacVal();
        string err = macWalkExpr(w, s.child(0), false, base, v);
        if (err.length > 0) { return err; }
        if (v.kind == 3) {
            return "string values in '" + w.fname + "'";
        }
        w.maxDepth = macMax(w.maxDepth, base + v.depth);
        return "";
    }
    if (s.kind == ND_IF_STMT) {
        if (s.childCount() < 2) {
            return "unsupported statement in '" + w.fname + "'";
        }
        MacVal v = new MacVal();
        string err = macWalkExpr(w, s.child(0), false, base, v);
        if (err.length > 0) { return err; }
        if (v.kind == 3) {
            return "string values in '" + w.fname + "'";
        }
        w.maxDepth = macMax(w.maxDepth, base + v.depth);
        err = macWalkBlock(w, s.child(1), base);
        if (err.length > 0) { return err; }
        if (s.childCount() > 2) {
            err = macWalkBlock(w, s.child(2), base);
            if (err.length > 0) { return err; }
        }
        return "";
    }
    if (s.kind == ND_WHILE) {
        if (s.childCount() < 2) {
            return "unsupported statement in '" + w.fname + "'";
        }
        MacVal v = new MacVal();
        string err = macWalkExpr(w, s.child(0), false, base, v);
        if (err.length > 0) { return err; }
        if (v.kind == 3) {
            return "string values in '" + w.fname + "'";
        }
        w.maxDepth = macMax(w.maxDepth, base + v.depth);
        w.loopDepth++;
        err = macWalkBlock(w, s.child(1), base);
        w.loopDepth--;
        if (err.length > 0) { return err; }
        return "";
    }
    // Port kinds 62/63 are break/continue; this AST numbers them 63/64
    // (62 is switch) — same strings.
    if (s.kind == ND_BREAK || s.kind == ND_CONTINUE) {
        if (w.loopDepth == 0) {
            return "break/continue outside a loop in '" + w.fname + "'";
        }
        return "";
    }
    // Port kind 55 is the C for loop; this AST splits range-for (56) out —
    // same string for both.
    if (s.kind == ND_FOR_C || s.kind == ND_FOR_RANGE) {
        return "for loops in '" + w.fname + "'";
    }
    // Port kind 64 is foreach; here it is 57 — same string.
    if (s.kind == ND_FOREACH) {
        return "foreach loops in '" + w.fname + "'";
    }
    // Port kind 76 is switch; here it is 62 — same string.
    if (s.kind == ND_SWITCH) {
        return "switch statements in '" + w.fname + "'";
    }
    if (s.kind == ND_TRY_CATCH) {
        return "try/catch in '" + w.fname + "'";
    }
    // Port kind 68 is throw; here it is 65 — same string.
    if (s.kind == ND_THROW) {
        return "throw in '" + w.fname + "'";
    }
    if (s.kind == ND_DESTRUCT) {
        return "tuple destructuring in '" + w.fname + "'";
    }
    // Port kind 73 is the alias declaration; here it is 66 — same string.
    if (s.kind == ND_ALIAS_DECL) {
        return "alias declarations in '" + w.fname + "'";
    }
    return "unsupported statement in '" + w.fname + "'";
}

// Check an expression, filling out with its scalar kind and the
// operand-stack slots it needs above base. inStmt allows the print
// builtins (void calls are statement-only).
private string macWalkExpr(MacWalk w, Node e, bool inStmt, int base, MacVal out) {
    if (e.kind == ND_INT_LIT) {
        out.kind = 0;
        out.depth = 1;
        return "";
    }
    if (e.kind == ND_BOOL_LIT) {
        out.kind = 1;
        out.depth = 1;
        return "";
    }
    if (e.kind == ND_CHAR_LIT) {
        out.kind = 2;
        out.depth = 1;
        return "";
    }
    if (e.kind == ND_FLOAT_LIT) {
        return "float literals in '" + w.fname + "'";
    }
    if (e.kind == ND_STRING_LIT) {
        out.kind = 3;
        out.depth = 0;
        return "";
    }
    if (e.kind == ND_IDENT) {
        int ci = macFindConst(w.ctx, e.name);
        if (ci >= 0) {
            string ck = w.ctx.constKinds[ci];
            if (ck == "i") { out.kind = 0; }
            else if (ck == "b") { out.kind = 1; }
            else { out.kind = 2; }
            out.depth = 1;
            return "";
        }
        int vi = macFindVar(w, e.name);
        if (vi < 0) {
            return "unknown variable '" + e.name + "' in '" + w.fname + "'";
        }
        string vk = w.varKinds[vi];
        if (vk == "i") { out.kind = 0; }
        else if (vk == "b") { out.kind = 1; }
        else { out.kind = 2; }
        out.depth = 1;
        return "";
    }
    if (e.kind == ND_PAREN) {
        if (e.childCount() == 0) {
            return "unsupported expression in '" + w.fname + "'";
        }
        return macWalkExpr(w, e.child(0), false, base, out);
    }
    if (e.kind == ND_UNARY) {
        if (e.childCount() == 0) {
            return "unsupported expression in '" + w.fname + "'";
        }
        if (e.op == UOP_NEG) {
            MacVal v = new MacVal();
            string err = macWalkExpr(w, e.child(0), false, base, v);
            if (err.length > 0) { return err; }
            if (v.kind == 3) {
                return "string values in '" + w.fname + "'";
            }
            out.kind = 0;
            out.depth = v.depth;
            return "";
        }
        if (e.op == UOP_NOT) {
            MacVal v = new MacVal();
            string err = macWalkExpr(w, e.child(0), false, base, v);
            if (err.length > 0) { return err; }
            if (v.kind == 3) {
                return "string values in '" + w.fname + "'";
            }
            out.kind = 1;
            out.depth = v.depth;
            return "";
        }
        return "unsupported unary operator in '" + w.fname + "'";
    }
    if (e.kind == ND_BINARY) {
        return macWalkBinary(w, e, inStmt, base, out);
    }
    // Port kind 10 is the call with an isMember flag; this AST splits plain
    // calls (9) from method calls (10) — same strings.
    if (e.kind == ND_CALL) {
        return macWalkCall(w, e, inStmt, base, out);
    }
    if (e.kind == ND_METHOD_CALL) {
        return "method calls in '" + w.fname + "'";
    }
    if (e.kind == ND_MEMBER) {
        return "member access in '" + w.fname + "'";
    }
    // Port kinds 24/67 are index forms; here they are 11/12 — same string.
    if (e.kind == ND_INDEX || e.kind == ND_SLICE) {
        return "indexing in '" + w.fname + "'";
    }
    // Port kind 65 is ternary; here it is 20 — same string.
    if (e.kind == ND_TERNARY) {
        return "ternary expressions in '" + w.fname + "'";
    }
    // Port kind 66 is the dictionary literal; here it is 24 — same string.
    if (e.kind == ND_DICT_LIT) {
        return "dictionaries in '" + w.fname + "'";
    }
    // Port kind 69 is string interpolation; here it is 22 — same string.
    if (e.kind == ND_INTERP) {
        return "string interpolation in '" + w.fname + "'";
    }
    // Port kind 70 is the tuple literal; here it is 18 — same string.
    if (e.kind == ND_TUPLE_LIT) {
        return "tuple literals in '" + w.fname + "'";
    }
    if (e.kind == ND_ARRAY_LIT) {
        return "array literals in '" + w.fname + "'";
    }
    // Port kind 74 is the struct literal; here it is 17 — same string.
    if (e.kind == ND_STRUCT_LIT) {
        return "struct literals in '" + w.fname + "'";
    }
    // Port kind 80 is the lambda; here it is 85 — same string.
    if (e.kind == ND_ANON_FN) {
        return "lambdas in '" + w.fname + "'";
    }
    // Port kind 86 is the cast; here it is 29 — same string.
    if (e.kind == ND_CAST) {
        return "casts in '" + w.fname + "'";
    }
    if (e.kind == ND_INDIRECT_CALL) {
        return "indirect calls in '" + w.fname + "'";
    }
    return "unsupported expression in '" + w.fname + "'";
}

private string macWalkBinary(MacWalk w, Node e, bool inStmt, int base, MacVal out) {
    int op = e.op;
    // Port ops 1/2/3 are add/sub/mul; here they are 0/1/2 — same string.
    if (op == OP_ADD || op == OP_SUB || op == OP_MUL) {
        if (e.childCount() < 2) {
            return "unsupported expression in '" + w.fname + "'";
        }
        MacVal l = new MacVal();
        MacVal r = new MacVal();
        string err = macWalkExpr(w, e.child(0), false, base, l);
        if (err.length > 0) { return err; }
        err = macWalkExpr(w, e.child(1), false, base + 1, r);
        if (err.length > 0) { return err; }
        if (l.kind == 3 || r.kind == 3) {
            return "string values in '" + w.fname + "'";
        }
        out.kind = 0;
        out.depth = macMax(l.depth, 1 + r.depth);
        return "";
    }
    // Port op 4 is division; here it is 3 — same string.
    if (op == OP_DIV) {
        return "division in '" + w.fname + "'";
    }
    // Port op 13 is modulo; here it is 4 — same string.
    if (op == OP_MOD) {
        return "modulo in '" + w.fname + "'";
    }
    if (op == OP_EQ || op == OP_NEQ || op == OP_LT || op == OP_LEQ || op == OP_GT || op == OP_GEQ) {
        if (e.childCount() < 2) {
            return "unsupported expression in '" + w.fname + "'";
        }
        MacVal l = new MacVal();
        MacVal r = new MacVal();
        string err = macWalkExpr(w, e.child(0), false, base, l);
        if (err.length > 0) { return err; }
        err = macWalkExpr(w, e.child(1), false, base + 1, r);
        if (err.length > 0) { return err; }
        if (l.kind == 3 || r.kind == 3) {
            return "string values in '" + w.fname + "'";
        }
        out.kind = 1;
        out.depth = macMax(l.depth, 1 + r.depth);
        return "";
    }
    if (op == OP_AND || op == OP_OR) {
        if (e.childCount() < 2) {
            return "unsupported expression in '" + w.fname + "'";
        }
        MacVal l = new MacVal();
        MacVal r = new MacVal();
        string err = macWalkExpr(w, e.child(0), false, base, l);
        if (err.length > 0) { return err; }
        err = macWalkExpr(w, e.child(1), false, base, r);
        if (err.length > 0) { return err; }
        if (l.kind == 3 || r.kind == 3) {
            return "string values in '" + w.fname + "'";
        }
        out.kind = 1;
        out.depth = macMax(l.depth, r.depth);
        return "";
    }
    // Port ops 20/14/15/16/28 are the assign family (plain, +=, -=, *=,
    // and the << move form); here they are 13/14/15/16/21 — same strings.
    if (op == OP_ASSIGN || op == OP_ADD_ASSIGN || op == OP_SUB_ASSIGN || op == OP_MUL_ASSIGN || op == OP_MOVE) {
        if (e.childCount() < 2) {
            return "unsupported expression in '" + w.fname + "'";
        }
        Node t = e.child(0);
        if (t.kind != ND_IDENT) {
            return "complex assignment targets in '" + w.fname + "'";
        }
        if (macFindVar(w, t.name) < 0) {
            return "unknown variable '" + t.name + "' in '" + w.fname + "'";
        }
        MacVal v = new MacVal();
        string err = macWalkExpr(w, e.child(1), false, base, v);
        if (err.length > 0) { return err; }
        if (v.kind == 3) {
            return "string values in '" + w.fname + "'";
        }
        out.kind = 0;
        out.depth = v.depth;
        return "";
    }
    // Port op 17 is /=
    if (op == OP_DIV_ASSIGN) {
        return "division in '" + w.fname + "'";
    }
    // Port op 29 is %=
    if (op == OP_MOD_ASSIGN) {
        return "modulo in '" + w.fname + "'";
    }
    // No inc/dec operator survives parsing in this AST (++ / -- desugar
    // to += / -= 1, which ride the assign arm above with identical
    // strings to the reference PostInc/PreInc handling).
    if (op == OP_COALESCE) {
        return "null coalescing in '" + w.fname + "'";
    }
    return "unsupported binary operator in '" + w.fname + "'";
}

private string macWalkCall(MacWalk w, Node e, bool inStmt, int base, MacVal out) {
    if (e.name == "print" || e.name == "printline") {
        if (!inStmt) {
            return "print used as a value in '" + w.fname + "'";
        }
        if (e.childCount() != 1) {
            return "multi-argument print in '" + w.fname + "'";
        }
        Node arg = e.child(0);
        if (arg.kind == ND_STRING_LIT) {
            w.ctx.usesPrintf = true;
            out.kind = 0;
            out.depth = 0;
            return "";
        }
        MacVal v = new MacVal();
        string err = macWalkExpr(w, arg, false, base, v);
        if (err.length > 0) { return err; }
        if (v.kind == 3) {
            return "string values in '" + w.fname + "'";
        }
        w.ctx.usesPrintf = true;
        out.kind = 0;
        out.depth = v.depth;
        return "";
    }
    if (e.name == "exit" || e.name == "printf") {
        return "explicit '" + e.name + "' calls in '" + w.fname + "'";
    }
    int si = macFindSig(w.ctx, e.name);
    if (si < 0) {
        return "call to unknown function '" + e.name + "' in '" + w.fname + "'";
    }
    string pks = w.ctx.sigParams[si];
    if (e.childCount() != pks.length) {
        return "arity mismatch calling '" + e.name + "' (takes " + (string)pks.length + ", given " + (string)e.childCount() + ") in '" + w.fname + "'";
    }
    int depth = 0;
    for (int i = 0; i < e.childCount(); i++) {
        MacVal v = new MacVal();
        string err = macWalkExpr(w, e.child(i), false, base + i, v);
        if (err.length > 0) { return err; }
        if (v.kind == 3) {
            return "string values in '" + w.fname + "'";
        }
        depth = macMax(depth, i + v.depth);
    }
    string ret = w.ctx.sigRets[si];
    if (ret == "v") {
        if (!inStmt) {
            return "void call used as a value in '" + w.fname + "'";
        }
        out.kind = 0;
        out.depth = depth;
        return "";
    }
    if (ret == "i") { out.kind = 0; }
    else if (ret == "b") { out.kind = 1; }
    else { out.kind = 2; }
    out.depth = macMax(depth, 1);
    return "";
}

// ---------------------------------------------------------------------------
// Native object runner helpers (see the NATIVE RUNNER notice at the top).
// Raw OS calls live each in their own single chained region; everything
// else is shared portable code. Non-Windows bodies report absence (0) so
// callers fall back loudly without ever transferring control.
// ---------------------------------------------------------------------------

// Hit flag the compiled seam callback raises. A one-slot module-global
// array: bare globals are not valid assignment targets (the type checker
// rejects them), but array-element stores are, and the seam is a
// standalone void() function that captures no runner locals.
int[] objRunSeam = [0];

// Address of the seam callback implementing the __slv_interp_run import: a
// compiled void() lambda reified to int (fn-typed values ARE code
// addresses, so the round trip compiles on every backend). The lambda
// raises the hit flag through the setter below and nothing more — void()
// observes no RCX anchor and returns no program value (see the boundary
// notice). The body calls instead of assigning: assignment targets inside
// a lambda body are restricted to the lambda's own scope.
private void objNoteSeam() {
    objRunSeam[0] = 1;
}

private int objSeamAddr() {
    void () seamFn = (void () { objNoteSeam(); });
    int addr = seamFn;
    return addr;
}

// One RWX block of `size` bytes (MEM_COMMIT zero-fill,
// PAGE_EXECUTE_READWRITE): 12288 = MEM_COMMIT|MEM_RESERVE, 64 = PAGE_XRW.
// 0 when the mapping fails (caller falls back loudly).
private int objNatAlloc(int size) {
    #on WINDOWS
    return VirtualAlloc(null, size, 12288, 64);
    #else
    return 0;
    #off
}

// Raw copy of `n` bytes from the Silver string `src` to address `dst`.
// Callers only pass NUL-free chunks (see objNatBlit).
private void objNatCopy(int dst, string src, int n) {
    #on WINDOWS
    memcpy(dst, src, n);
    #else
    return;
    #off
}

// Call the machine code at `addr` with no arguments and marshal RAX back
// (the DOCS/259 G3 indirect-call shape: the address rides an int[] slot).
private int objNatCall(int addr) {
    #on WINDOWS
    int[] slots = [];
    slots.add(addr);
    return slots[0]();
    #else
    return 0;
    #off
}

// Release one block mapped by objNatAlloc (32768 = MEM_RELEASE).
private void objNatFree(int addr) {
    #on WINDOWS
    VirtualFree(addr, 0, 32768);
    #else
    return;
    #off
}

// High-resolution tick counter for the native-call timing below.
private int64 objNatTicks() {
    #on WINDOWS
    int64 c = 0;
    QueryPerformanceCounter(&c);
    return c;
    #else
    return 0;
    #off
}

// Tick frequency matching objNatTicks (0 when unavailable: no timing).
private int64 objNatFreq() {
    #on WINDOWS
    int64 f = 0;
    QueryPerformanceFrequency(&f);
    return f;
    #else
    return 0;
    #off
}

// Copy `bytes` (low-byte int[] values, NULs included) onto the RWX block at
// `base`: Silver strings are C strings, so .length stops at the first NUL
// and one memcpy cannot carry NUL bytes. The block arrives zero-filled, so
// NUL positions need no copy — only the NUL-free runs between them move,
// at their true offsets. Exact for every payload, including all-NUL ones.
private void objNatBlit(int base, int[] bytes) {
    int start = 0;
    while (start < bytes.length) {
        while (start < bytes.length && bytes[start] == 0) { start++; }
        if (start >= bytes.length) { break; }
        int end = start;
        while (end < bytes.length && bytes[end] != 0) { end++; }
        string chunk = "";
        for (int i = start; i < end; i++) {
            chunk = chunk + char(bytes[i]);
        }
        objNatCopy(base + start, chunk, chunk.length);
        start = end;
    }
}

// Apply the parsed relocations onto the mutable `code` image for a block
// laid out as code@[base, base+len) with the .rdata coat at `rdataBase`:
// ABS64 sites take the datab (or other defined) address, REL32 sites take
// target-(site+4), and the __slv_interp_run import binds `seamTarget` (the
// caller's in-block import thunk — always near by construction, so the
// range check below guards genuinely foreign shapes only). Any other
// undefined target is unresolvable in-process. Returns "" or the loud
// fallback reason (never a silent mislink).
private string objApplyRelocs(ParsedObj obj, int[] code, int base, int rdataBase, int seamTarget) {
    for (int i = 0; i < obj.relSites.length; i++) {
        int site = obj.relSites[i];
        int sni = obj.relSyms[i];
        int kind = obj.relKinds[i];
        if (sni < 0 || sni >= obj.symNames.length) { return "object runner: relocation targets a missing symbol"; }
        string sym = obj.symNames[sni];
        int sect = obj.symSects[sni];
        int val = obj.symVals[sni];
        if (kind == 1) {
            if (site < 0 || site + 8 > code.length) { return "object runner: ABS64 site out of range"; }
            int64 target = 0;
            if (sect == 1) { target = int64(base + val); }
            else if (sect == 2) { target = int64(rdataBase + val); }
            else { return "object runner: unresolvable relocation target '" + sym + "'"; }
            target += obj.relAddends[i];
            for (int b = 0; b < 8; b++) { code[site + b] = int((target >> (b * 8)) & 0xFF); }
        } else {
            if (site < 0 || site + 4 > code.length) { return "object runner: REL32 site out of range"; }
            int64 target = 0;
            if (sect == 0) {
                if (sym == objInterpRunSym()) { target = int64(seamTarget); }
                else { return "object runner: unresolvable import '" + sym + "'"; }
            } else if (sect == 1) { target = int64(base + val); }
            else if (sect == 2) { target = int64(rdataBase + val); }
            else { return "object runner: unresolvable relocation target '" + sym + "'"; }
            int64 rel = target - int64(base + site + 4);
            if (rel < -2147483648 || rel > 2147483647) { return "object runner: REL32 relocation out of range"; }
            for (int b2 = 0; b2 < 4; b2++) { code[site + b2] = int((rel >> (b2 * 8)) & 0xFF); }
        }
    }
    return "";
}

// An open object-cache session for one project and one host target.
class ObjSession {
    public prop bool ok;
    public prop string dir;
    public prop string root;
    public prop string projectName;
    public prop string targetOs;
    public prop string flags;
    public prop int createdStamp;
    // Native-call cost of the last runNative success, in microseconds (-1
    // when the host clock was unavailable). Read by the driver for --diag.
    public prop int lastNativeUs;
    // Record arrays keyed by /-separated relative path.
    public prop string[] keys;
    public prop int[] cTimes;
    public prop int[] mTimes;
    public prop int[] hashes;
    public prop int[] cachedAt;
    // Files observed this run: the source FNV-1 hash plus the source length
    // (the bytecode tier's size proxy in place of mtimes), and which tier
    // fed the driver's tokens (1 = synced .srbc text, 0 = fresh source).
    public prop string[] notedKeys;
    public prop int[] notedC;
    public prop int[] notedM;
    public prop int[] notedH;
    public prop int[] notedStamps;
    public prop int[] notedTiers;

    // Open (or prepare) the object cache for `projName` rooted at `rootDir`,
    // targeting the auto-detected host (`hostOsName`, interpHostOs). When
    // the per-host cache root cannot be determined the session reports
    // !ok and callers fall back to the uncached tiers.
    //
    // Cross-target use: constructing with "LINUX" opens the linux-x86-64
    // directory under the same per-host cache root (the #on regions below
    // pick the ROOT by build host, objTargetDirName picks the SUBDIR by
    // this parameter) — the same trigger rule as the compilers' --os linux,
    // with per-target freshness from that directory's own project.sbcr —
    // and constructing with "MAC" opens mac-aarch64 the same way (the
    // Mach-O writer/validators serve that directory, on a Mac host and for
    // cross-target caches alike).
    // The driver always passes the auto-detected host (there is no --os
    // flag); the LINUX and MAC writers/validators are the implementation
    // that serves those directories, on their native hosts and for
    // cross-target caches alike.
    construct (string rootDir, string projName, string hostOsName) {
        this.ok = false;
        this.root = rootDir;
        this.projectName = projName;
        this.targetOs = hostOsName;
        this.flags = objFlagKey();
        this.createdStamp = icNowMillis();
        this.keys = [];
        this.cTimes = [];
        this.mTimes = [];
        this.hashes = [];
        this.cachedAt = [];
        this.notedKeys = [];
        this.notedC = [];
        this.notedM = [];
        this.notedH = [];
        this.notedStamps = [];
        this.notedTiers = [];
        this.lastNativeUs = -1;
        string guarded = icSanitize(projName);
        string sub = objTargetDirName(hostOsName);
        #on WINDOWS
        string appdata = fs.getenv("APPDATA");
        if (appdata.length == 0) { return; }
        this.dir = appdata + "\\silver cache\\" + guarded + "\\" + sub;
        #on LINUX
        this.dir = "/var/cache/silver/" + guarded + "/" + sub;
        #on MAC
        this.dir = "/Library/Caches/Silver/" + guarded + "/" + sub;
        #off
        icEnsureDirTree(this.dir);
        this.loadRecords();
        this.ok = true;
    }

    public int findRecord(string key) {
        for (int i = 0; i < this.keys.length; i++) {
            if (this.keys[i] == key) { return i; }
        }
        return -1;
    }

    private int findNoted(string key) {
        for (int i = 0; i < this.notedKeys.length; i++) {
            if (this.notedKeys[i] == key) { return i; }
        }
        return -1;
    }

    // Observe the entry source. Freshness keys on the source FNV-1 hash plus
    // the source length (the bytecode tier's size proxy in place of mtimes —
    // the same hash the driver lexed, whether its tokens came from synced
    // .srbc text or fresh source). Out-of-root entries are skipped: they
    // still run normally, they just are not object-cached.
    public void noteFile(string absPath, string source, bool fromBytecode) {
        if (!this.ok) { return; }
        string key = icRelPath(this.root, absPath);
        if (key.length == 0) { return; }
        if (objIsLocalKey(key) == 0) { return; }
        int64 srcHash = icFnv1(source);
        int srcLen = source.length;
        int stamp = icNowMillis();
        int tier = 0;
        if (fromBytecode) { tier = 1; }
        int idx = this.findNoted(key);
        if (idx >= 0) {
            this.notedC[idx] = stamp;
            this.notedM[idx] = srcLen;
            this.notedH[idx] = srcHash;
            this.notedStamps[idx] = stamp;
            this.notedTiers[idx] = tier;
            return;
        }
        this.notedKeys.add(key);
        this.notedC.add(stamp);
        this.notedM.add(srcLen);
        this.notedH.add(srcHash);
        this.notedStamps.add(stamp);
        this.notedTiers.add(tier);
    }

    // Absolute path of the .o for a record key (mirrors the project tree,
    // always with the .o extension — never .obj).
    private string objectPath(string key) {
        int slash = -1;
        int dot = -1;
        for (int i = 0; i < key.length; i++) {
            if (key[i] == '/') { slash = i; }
            if (key[i] == '.') { dot = i; }
        }
        string base = key;
        if (dot > slash) { base = icSliceRange(key, 0, dot); }
        #on LINUX or MAC
        return this.dir + "/" + base + ".o";
        #off
        return this.dir + "\\" + base.replaceAll("/", "\\") + ".o";
    }

    // Freshness probe for one noted entry (mirrors the reference plan()):
    // the record matches (hash + size), the .o exists, and its v5 note
    // peeks with the expected flag set + hash. Anything else - a changed
    // source, a missing file, a v4-era object, a foreign object, a
    // compiler-emitted object under another flag set - is stale (re-emit),
    // never a hard error here and never silently reused.
    private bool isFresh(int n) {
        int idx = this.findRecord(this.notedKeys[n]);
        if (idx < 0) { return false; }
        if (this.hashes[idx] != this.notedH[n]) { return false; }
        if (this.mTimes[idx] != this.notedM[n]) { return false; }
        string probe = this.objectPath(this.notedKeys[n]);
        if (probe.length == 0 || !file.exists(probe)) { return false; }
        byte[] raw = [];
        try {
            raw = file.read(probe);
        } catch (int e) {
            return false;
        }
        if (raw.length == 0) { return false; }
        ObjReader r = new ObjReader(raw);
        ObjNote note = new ObjNote();
        if (!objPeekNote(r, this.targetOs, note)) { return false; }
        if (note.flags != this.flags) { return false; }
        if (note.hash != int64(this.notedH[n])) { return false; }
        return true;
    }

    // Re-emit changed objects, merge the per-target record (+ .sbcri text
    // companion), then unify: fully parse the cached + refreshed objects
    // with the built-in readers before the driver runs from the verified
    // tokens. Returns "" on success, else the exact reference error — fails
    // loudly (never silently) when an object is missing or corrupt.
    public string finish() {
        this.sortNoted();
        for (int n = 0; n < this.notedKeys.length; n++) {
            if (!this.isFresh(n)) {
                ObjUnit unit = new ObjUnit();
                interpBuildUnit(this.notedKeys[n], int64(this.notedH[n]), this.notedM[n], this.notedStamps[n], this.targetOs, unit);
                if (objTooManyRelocs(unit)) {
                    return "object cache: too many relocations in '" + this.notedKeys[n] + "' for one COFF section (v1 boundary)";
                }
                string objPath = this.objectPath(this.notedKeys[n]);
                if (objPath.length == 0) {
                    return "object cache: cannot place object for '" + this.notedKeys[n] + "'";
                }
                icEnsureDirTree(icDirname(objPath));
                int[] bytes = emitObject(unit, this.flags, int64(this.notedH[n]), this.notedStamps[n], this.targetOs);
                file.writeBytes(objPath, bytes);
                if (!file.exists(objPath) || file.getSize(objPath) != bytes.length) {
                    return "object cache: cannot write " + objPath + ": verification failed";
                }
                int idx = this.findRecord(this.notedKeys[n]);
                if (idx >= 0) {
                    this.mTimes[idx] = this.notedM[n];
                    this.hashes[idx] = this.notedH[n];
                    this.cachedAt[idx] = this.notedStamps[n];
                } else {
                    this.keys.add(this.notedKeys[n]);
                    this.cTimes.add(this.notedC[n]);
                    this.mTimes.add(this.notedM[n]);
                    this.hashes.add(this.notedH[n]);
                    this.cachedAt.add(this.notedStamps[n]);
                }
            }
        }

        this.sortRecords();

        // Reference-format binary record (v3: SBCR magic, version, creation
        // stamp, project name, emitting flag set, then per-file entries),
        // little-endian, byte-exact for other toolchains.
        ObjWriter w = new ObjWriter();
        w.rawStr("SBCR");
        w.u16(3);
        w.u64(this.createdStamp);
        w.strField(this.projectName);
        w.strField(this.flags);
        w.u32(this.keys.length);
        for (int rb = 0; rb < this.keys.length; rb++) {
            w.strField(this.keys[rb]);
            w.u64(this.cTimes[rb]);
            w.u64(this.mTimes[rb]);
            w.u64(this.hashes[rb]);
            w.u64(this.cachedAt[rb]);
        }
        string sbcrPath = "";
        string sbcriPath = "";
        #on WINDOWS
        sbcrPath = this.dir + "\\project.sbcr";
        sbcriPath = this.dir + "\\project.sbcri";
        #else
        sbcrPath = this.dir + "/project.sbcr";
        sbcriPath = this.dir + "/project.sbcri";
        #off
        icEnsureDirTree(this.dir);
        file.writeBytes(sbcrPath, w.out);

        // NUL-free text companion (authoritative read side): the SBCRI v2
        // shape plus the flag-set line the object record keys on.
        string[] lines = [];
        lines.add("SBCRI v2\n");
        lines.add("project " + objEscapeText(this.projectName) + "\n");
        lines.add("flags " + objEscapeText(this.flags) + "\n");
        lines.add("created " + (string)this.createdStamp + "\n");
        for (int re = 0; re < this.keys.length; re++) {
            lines.add(objEscapeText(this.keys[re]) + " " + (string)this.cTimes[re] + " " + (string)this.mTimes[re] + " " + objHex16(int64(this.hashes[re])) + " " + (string)this.cachedAt[re] + "\n");
        }
        file.writeString(sbcriPath, lines.join(""));

        // Built-in unification: every object of this run must be present
        // and fully valid (container magic, target machine, sections,
        // symbols, relocations, flag set, source hash, globals-block
        // agreement) before the driver executes from the verified tokens.
        for (int u = 0; u < this.notedKeys.length; u++) {
            string upath = this.objectPath(this.notedKeys[u]);
            if (!file.exists(upath)) {
                return "object cache: cannot read " + upath + ": file not found";
            }
            byte[] udata = [];
            try {
                udata = file.read(upath);
            } catch (int e) {
                return "object cache: cannot read " + upath + ": file not found";
            }
            if (udata.length == 0) { return this.corruptEmpty(); }
            ObjReader ur = new ObjReader(udata);
            ParsedObj parsed = new ParsedObj();
            string perr = objParseObject(ur, this.targetOs, parsed);
            if (perr.length > 0) { return perr; }
            if (parsed.flags != this.flags) {
                return "object cache: flag-set switch (object has '" + parsed.flags + "', build wants '" + this.flags + "') — re-emit required";
            }
            if (parsed.hash != int64(this.notedH[u])) {
                return "object cache: stale object (source hash changed) — re-emit required";
            }
            string gasErr = this.checkGas(parsed);
            if (gasErr.length > 0) { return gasErr; }
        }
        return "";
    }

    // Execution-path gate (called by the driver after finish()): re-read
    // the entry's object and fully validate it (magic, machine, sections,
    // symbols, relocations, flag set, source hash, globals-block agreement).
    // Returns "" when the object is verified — execution then proceeds from
    // the verified tokens — else the exact loud error. Stale bytes are never
    // executed.
    public string verifyObject(string absPath, int64 expectHash) {
        string key = icRelPath(this.root, absPath);
        if (key.length == 0) {
            return "object cache: cannot read " + absPath + ": file not found";
        }
        string opath = this.objectPath(key);
        if (opath.length == 0 || !file.exists(opath)) {
            return "object cache: cannot read " + opath + ": file not found";
        }
        byte[] odata = [];
        try {
            odata = file.read(opath);
        } catch (int e) {
            return "object cache: cannot read " + opath + ": file not found";
        }
        if (odata.length == 0) { return this.corruptEmpty(); }
        ObjReader or = new ObjReader(odata);
        ParsedObj obj = new ParsedObj();
        string perr = objParseObject(or, this.targetOs, obj);
        if (perr.length > 0) { return perr; }
        if (obj.flags != this.flags) {
            return "object cache: flag-set switch (object has '" + obj.flags + "', build wants '" + this.flags + "') — re-emit required";
        }
        if (obj.hash != expectHash) {
            return "object cache: stale object (source hash changed) — re-emit required";
        }
        return this.checkGas(obj);
    }

    // Globals-block agreement check (the same rule the linkers enforce):
    // the interpreter always records gas 0 (interpBuildUnit sets no globals
    // block; execution stays on the AST/bytecode tiers), while the self-host
    // counts bytes and silverc-rs counts slots — so mixed-toolchain objects
    // disagree by construction. Any nonzero foreign gas fails LOUDLY here
    // instead of validating silently. Returns "" when the object agrees.
    private string checkGas(ParsedObj obj) {
        if (obj.gas != 0) {
            return "object cache: globals-block mismatch ('" + obj.filekey + "' vs 'interp') — re-emit required";
        }
        return "";
    }

    // In-process native execution of the entry's validated object (the
    // OVERHAUL.md fastest tier: .o execution). Call ONLY after verifyObject
    // passes on the same entry: the gate owns validation, this owns loading
    // and calling (it re-checks flags + hash on the bytes it executes, so a
    // file swapped between the two calls still cannot run stale).
    //
    // Returns "" when the validated .text ran natively (RAX == note hash,
    // seam reached; lastNativeUs carries the call cost), else the loud
    // fallback reason — the driver prints it and continues from the
    // verified AST/bytecode tiers, never silently wrong. See the NATIVE
    // RUNNER notice at the top for the exact execution boundary.
    public string runNative(string absPath, int64 expectHash) {
        if (this.targetOs != "WINDOWS") {
            return "object runner: " + this.targetOs + " execution stays on the verified tiers (in-process runner is COFF/x86-64 only)";
        }
        string verr = this.verifyObject(absPath, expectHash);
        if (verr.length > 0) { return verr; }
        string key = icRelPath(this.root, absPath);
        string opath = this.objectPath(key);
        byte[] odata = [];
        try {
            odata = file.read(opath);
        } catch (int e) {
            return "object cache: cannot read " + opath + ": file not found";
        }
        ObjReader or = new ObjReader(odata);
        ParsedObj obj = new ParsedObj();
        string perr = objParseObject(or, this.targetOs, obj);
        if (perr.length > 0) { return perr; }
        if (obj.flags != this.flags) {
            return "object cache: flag-set switch (object has '" + obj.flags + "', build wants '" + this.flags + "') — re-emit required";
        }
        if (obj.hash != expectHash) {
            return "object cache: stale object (source hash changed) — re-emit required";
        }
        string gasErr = this.checkGas(obj);
        if (gasErr.length > 0) { return gasErr; }
        if (obj.code.length == 0) { return "object runner: empty .text"; }
        // Layout: code, then the .rdata coat, then the 15-byte import thunk
        // (push rax; movabs rax,seam; call rax; pop rax; ret) the seam
        // REL32 binds to — near by construction, whatever the seam's
        // absolute address is. The push/pop preserves the stub's RAX hash
        // across the seam call (see the NATIVE RUNNER notice).
        int total = obj.code.length + obj.data.length + 15;
        if (total > 67108864) { return "object runner: object too large (" + (string)total + " bytes)"; }
        // Entry offset: the file's own entry stub by name, else the first
        // defined .text function. Anything else has no callable entry.
        int entryOff = -1;
        string wantEntry = objInterpEntrySym(obj.filekey, obj.hash);
        for (int s = 0; s < obj.symNames.length; s++) {
            if (obj.symSects[s] == 1 && obj.symIsFunc[s] == 1) {
                if (entryOff < 0) { entryOff = obj.symVals[s]; }
                if (obj.symNames[s] == wantEntry) { entryOff = obj.symVals[s]; }
            }
        }
        if (entryOff < 0 || entryOff >= obj.code.length) { return "object runner: no executable entry"; }
        int seam = objSeamAddr();
        if (seam == 0) { return "object runner: seam address unavailable"; }
        int base = objNatAlloc(total);
        if (base == 0) { return "object runner: executable mapping failed"; }
        int rdataBase = base + obj.code.length;
        int thunkBase = rdataBase + obj.data.length;
        int[] image = [];
        for (int c = 0; c < obj.code.length; c++) { image.add(obj.code[c]); }
        string rerr = objApplyRelocs(obj, image, base, rdataBase, thunkBase);
        if (rerr.length > 0) {
            objNatFree(base);
            return rerr;
        }
        objRunSeam[0] = 0;
        objNatBlit(base, image);
        objNatBlit(rdataBase, obj.data);
        int[] thunk = [80, 72, 184, 0, 0, 0, 0, 0, 0, 0, 0, 255, 208, 88, 195];
        for (int t = 0; t < 8; t++) { thunk[3 + t] = int((int64(seam) >> (t * 8)) & 0xFF); }
        objNatBlit(thunkBase, thunk);
        int64 t0 = objNatTicks();
        int rax = objNatCall(base + entryOff);
        int64 t1 = objNatTicks();
        objNatFree(base);
        if (objRunSeam[0] == 0) { return "object runner: entry did not reach the __slv_interp_run seam"; }
        if (int64(rax) != obj.hash) {
            return "object runner: native result mismatch (RAX " + (string)rax + ", note hash " + (string)obj.hash + ")";
        }
        this.lastNativeUs = -1;
        int64 freq = objNatFreq();
        if (freq > 0 && t1 > t0) {
            this.lastNativeUs = int((t1 - t0) * 1000000 / freq);
        }
        return "";
    }

    // Target-appropriate "empty object" corruption error (mirrors the
    // reference read_unit spelling per target).
    private string corruptEmpty() {
        if (this.targetOs == "LINUX") { return "object cache: corrupt ELF object"; }
        if (this.targetOs == "MAC") { return "object cache: corrupt Mach-O object"; }
        return "object cache: corrupt COFF object";
    }

    // Deterministic record order: sorted by relative path (matches the
    // reference serializer).
    private void sortRecords() {
        for (int i = 1; i < this.keys.length; i++) {
            string k = this.keys[i];
            int c = this.cTimes[i];
            int m = this.mTimes[i];
            int h = this.hashes[i];
            int lc = this.cachedAt[i];
            int j = i - 1;
            while (j >= 0 && k < this.keys[j]) {
                this.keys[j + 1] = this.keys[j];
                this.cTimes[j + 1] = this.cTimes[j];
                this.mTimes[j + 1] = this.mTimes[j];
                this.hashes[j + 1] = this.hashes[j];
                this.cachedAt[j + 1] = this.cachedAt[j];
                j--;
            }
            this.keys[j + 1] = k;
            this.cTimes[j + 1] = c;
            this.mTimes[j + 1] = m;
            this.hashes[j + 1] = h;
            this.cachedAt[j + 1] = lc;
        }
    }

    private void sortNoted() {
        for (int i = 1; i < this.notedKeys.length; i++) {
            string k = this.notedKeys[i];
            int c = this.notedC[i];
            int m = this.notedM[i];
            int h = this.notedH[i];
            int lc = this.notedStamps[i];
            int t = this.notedTiers[i];
            int j = i - 1;
            while (j >= 0 && k < this.notedKeys[j]) {
                this.notedKeys[j + 1] = this.notedKeys[j];
                this.notedC[j + 1] = this.notedC[j];
                this.notedM[j + 1] = this.notedM[j];
                this.notedH[j + 1] = this.notedH[j];
                this.notedStamps[j + 1] = this.notedStamps[j];
                this.notedTiers[j + 1] = this.notedTiers[j];
                j--;
            }
            this.notedKeys[j + 1] = k;
            this.notedC[j + 1] = c;
            this.notedM[j + 1] = m;
            this.notedH[j + 1] = h;
            this.notedStamps[j + 1] = lc;
            this.notedTiers[j + 1] = t;
        }
    }

    // Record loading (the NUL-free text companion is authoritative).
    private void loadRecords() {
        string sbcriPath = this.dir + "\\project.sbcri";
        #on LINUX or MAC
        sbcriPath = this.dir + "/project.sbcri";
        #off
        string text = "";
        try {
            text = file.readString(sbcriPath);
        } catch (int e) {
            text = "";
        }
        if (text.length == 0) { return; }
        string storedFlags = this.flags;
        bool sawFlags = false;
        int pos = 0;
        while (pos < text.length) {
            int eol = pos;
            while (eol < text.length && text[eol] != '\n') { eol++; }
            string line = icSliceRange(text, pos, eol);
            pos = eol + 1;
            if (line.startsWith("flags ")) {
                storedFlags = objUnescapeText(icSliceRange(line, 6, line.length));
                sawFlags = true;
            } else if (line.startsWith("created ")) {
                string num = icSliceRange(line, 8, line.length);
                if (num.isDigits()) { this.createdStamp = (int)num; }
            } else if (line.startsWith("project ") || line == "SBCRI v2") {
                continue;
            } else if (line.length > 0) {
                // Entry: <rel> <created> <modified> <hexhash> <cached>.
                // The path may hold spaces, so the last four fields cut
                // from the right.
                int s1 = -1;
                int s2 = -1;
                int s3 = -1;
                int s4 = -1;
                int fieldCount = 0;
                for (int i = 0; i < line.length; i++) {
                    if (line[i] == ' ') {
                        s1 = s2;
                        s2 = s3;
                        s3 = s4;
                        s4 = i;
                        fieldCount++;
                    }
                }
                if (fieldCount < 4) { continue; }
                string rel = objUnescapeText(icSliceRange(line, 0, s1));
                string created = icSliceRange(line, s1 + 1, s2);
                string modified = icSliceRange(line, s2 + 1, s3);
                string hex = icSliceRange(line, s3 + 1, s4);
                string cached = icSliceRange(line, s4 + 1, line.length);
                if (!created.isDigits() || !modified.isDigits() || !cached.isDigits()) { continue; }
                if (!objIsHex(hex)) { continue; }
                this.keys.add(rel);
                this.cTimes.add((int)created);
                this.mTimes.add((int)modified);
                this.hashes.add(objParseHex(hex));
                this.cachedAt.add((int)cached);
            }
        }
        if (sawFlags && storedFlags != this.flags) {
            // A flag-set switch invalidates every object: start from an
            // empty record (keeping the original creation stamp) instead
            // of silently reusing objects emitted under different flags.
            while (this.keys.length > 0) { this.keys.pop(); }
            while (this.cTimes.length > 0) { this.cTimes.pop(); }
            while (this.mTimes.length > 0) { this.mTimes.pop(); }
            while (this.hashes.length > 0) { this.hashes.pop(); }
            while (this.cachedAt.length > 0) { this.cachedAt.pop(); }
        }
    }
}