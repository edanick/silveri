    // then pop hundreds-first. Exponents stay below 1000 on tier inputs.
    fn.e.movRegImm32(1, 10);
    for (int de = 0; de < 3; de++) {
        fn.e.xorEdxEdx();
        fn.e.divRcx();
        fn.e.pushRdx();
    }
    for (int dg = 0; dg < 3; dg++) {
        fn.e.popRax();
        fn.e.addAxImm32(48);
        fn.e.stoAlRdi();
        fn.e.incRdi();
