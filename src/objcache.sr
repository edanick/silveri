    fn.e.jcc(132, noFrac);
    fn.e.movAlImm(46);
    fn.e.stoAlRdi();
    fn.e.incRdi();
    fn.e.movAxRdx();
    fn.e.movRegImm32(1, 10);
    for (int dj = 0; dj < 5; dj++) {
        fn.e.xorEdxEdx();
        fn.e.divRcx();
        fn.e.pushRdx();
    }
    fn.e.movRegImm32(1, 5);
    fn.e.movRegImm32(8, 0);
    winEmitDigitRun(fn);
    fn.e.bind(noFrac);
    fn.e.movAlImm(101);
    fn.e.stoAlRdi();
    fn.e.incRdi();
    // Reload the decimal exponent from its frame slot (never pushed:
    // digit traffic cannot disturb it, and any carry increment is seen).
    fn.e.fillReg(0, -16);
    fn.e.testAxAx();
    int expPosM = fn.e.lab();
    int expMag = fn.e.lab();
    fn.e.jcc(137, expPosM);
    fn.e.movAlImm(45);
    fn.e.stoAlRdi();
    fn.e.incRdi();
    // The '-' byte above rode AL: reload the exponent before negating
    // (negating the clobbered value renders every negative exponent
    // as "211").
    fn.e.fillReg(0, -16);
    fn.e.negAx();
    fn.e.jmp(expMag);
    fn.e.bind(expPosM);
    fn.e.movAlImm(43);
    fn.e.stoAlRdi();
    fn.e.incRdi();
    // Same AL clobber on the '+' path (every positive exponent rendered
    // as "043"): reload before the digit loop below.
    fn.e.fillReg(0, -16);
    fn.e.bind(expMag);
