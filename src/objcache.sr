    // renderers below (reloaded where needed): it never rides the data
    // stack, so digit push/pop imbalance cannot corrupt it, and the
    // carry increment above stays visible to every later reader.
    fn.e.movRegImm32(0, 5);
    fn.e.subAxSlot(-16);
    fn.e.sarAx1();
    fn.e.spillReg(0, -32);
    fn.e.movRegImm32(0, 5);
    fn.e.subAxSlot(-16);
    fn.e.subAxSlot(-32);
    // Powers of ten through the proven rcx loader (movAbsAny + movqXmm1Cx):
    // rsi is reloaded right after, so no live value is disturbed.
    fn.e.movAbsAny(1, icFloatBitsOf("1.0"));
    fn.e.movqXmm1Cx();
    fn.e.fillReg(1, -32);
    fn.e.testRcxRcx();
    int s1done = fn.e.lab();
    int s1neg = fn.e.lab();
    int s1pos = fn.e.lab();
    fn.e.jcc(132, s1done);
    fn.e.jcc(136, s1neg);
    fn.e.bind(s1pos);
    fn.e.mulXmm1Xmm2();
    fn.e.decRcx();
    fn.e.testRcxRcx();
    fn.e.jcc(133, s1pos);
    fn.e.jmp(s1done);
    fn.e.bind(s1neg);
    fn.e.divXmm1Xmm2();
    fn.e.incRcx();
    fn.e.testRcxRcx();
    fn.e.jcc(133, s1neg);
    fn.e.bind(s1done);
    fn.e.mulXmm0Xmm1();
    fn.e.movAbsAny(1, icFloatBitsOf("1.0"));
    fn.e.movqXmm1Cx();
    fn.e.movRcxRax();
    fn.e.testRcxRcx();
    int s2done = fn.e.lab();
    int s2neg = fn.e.lab();
    int s2pos = fn.e.lab();
    fn.e.jcc(132, s2done);
    fn.e.jcc(136, s2neg);
    fn.e.bind(s2pos);
    fn.e.mulXmm1Xmm2();
    fn.e.decRcx();
    fn.e.testRcxRcx();
    fn.e.jcc(133, s2pos);
    fn.e.jmp(s2done);
    fn.e.bind(s2neg);
    fn.e.divXmm1Xmm2();
    fn.e.incRcx();
    fn.e.testRcxRcx();
    fn.e.jcc(133, s2neg);
    fn.e.bind(s2done);
    fn.e.mulXmm0Xmm1();
    // Round-half-away via the proven addXmm0Xmm1 form (xmm1 = 0.5): the
    // dedicated C2 emitter is byte-identical in intent, but this path reuses
    // only emitters already proven by native arithmetic.
    fn.e.movAbsAny(1, icFloatBitsOf("0.5"));
    fn.e.movqXmm1Cx();
    fn.e.addXmm0Xmm1();
    fn.e.cvttXmm0ToAx();
    // Digits ride r8 from here (not a frame slot): rax stays live through
    // the carry/range checks, r8 backs it up across the exp++ scratch and
    // the push loop for the isExp reload below.
    fn.e.movR8Ax();
    fn.e.cmpAxImm32(1000000);
    int noCarry = fn.e.lab();
    fn.e.jcc(140, noCarry);
    fn.e.movRegImm32(0, 100000);
    fn.e.movR8Ax();
    fn.e.fillReg(0, -16);
    fn.e.incAx();
    fn.e.spillReg(0, -16);
    fn.e.movAxR8();
    fn.e.bind(noCarry);
    fn.e.fillReg(0, -16);
    fn.e.cmpAxImm32(-4);
    int isExp = fn.e.lab();
    int fmtDone = fn.e.lab();
    fn.e.jcc(140, isExp);
    fn.e.cmpAxImm32(6);
    fn.e.jcc(141, isExp);
    fn.e.movAxR8();
    fn.e.movRegImm32(1, 10);
    for (int di = 0; di < 6; di++) {
        fn.e.xorEdxEdx();
        fn.e.divRcx();
        fn.e.pushRdx();
    }
    fn.e.fillReg(0, -16);
    fn.e.cmpAxImm32(0);
    int fixedPos = fn.e.lab();
    int fixedDone = fn.e.lab();
    fn.e.jcc(141, fixedPos);
    fn.e.movAlImm(48);
    fn.e.stoAlRdi();
    fn.e.incRdi();
    fn.e.movAlImm(46);
    fn.e.stoAlRdi();
    fn.e.incRdi();
    fn.e.fillReg(0, -16);
    fn.e.incAx();
    fn.e.negAx();
    fn.e.movRcxRax();
    int zLoop = fn.e.lab();
    int zDone = fn.e.lab();
    fn.e.bind(zLoop);
    fn.e.testRcxRcx();
    fn.e.jcc(132, zDone);
    fn.e.movAlImm(48);
    fn.e.stoAlRdi();
    fn.e.incRdi();
    fn.e.decRcx();
    fn.e.jmp(zLoop);
    fn.e.bind(zDone);
    fn.e.movRegImm32(1, 6);
    fn.e.movRegImm32(8, 0);
    winEmitDigitRun(fn);
    fn.e.jmp(fixedDone);
    fn.e.bind(fixedPos);
    fn.e.fillReg(1, -16);
    fn.e.incRcx();
    fn.e.movRegImm32(0, 6);
    fn.e.subAxRcx();
    fn.e.spillReg(0, -32);
    int intLoop = fn.e.lab();
    int intDone = fn.e.lab();
    fn.e.bind(intLoop);
    fn.e.testRcxRcx();
    fn.e.jcc(132, intDone);
    fn.e.popRax();
    fn.e.addAxImm32(48);
    fn.e.stoAlRdi();
    fn.e.incRdi();
    fn.e.decRcx();
    fn.e.jmp(intLoop);
    fn.e.bind(intDone);
    // %g omits the point when the fraction is all zeros ("100000", not
    // "100000."): scan the frac digits (pop, test, push back — the stack is
    // restored exactly) recording any nonzero in r8, then branch.
    fn.e.fillReg(1, -32);
    fn.e.movRegImm32(8, 0);
    int fracScan = fn.e.lab();
    int fracScanDone = fn.e.lab();
    int fracSeen = fn.e.lab();
    fn.e.bind(fracScan);
    fn.e.testRcxRcx();
    fn.e.jcc(132, fracScanDone);
    fn.e.popRax();
    fn.e.decRcx();
    fn.e.testAxAx();
    fn.e.jcc(133, fracSeen);
    fn.e.pushAx();
    fn.e.jmp(fracScan);
    fn.e.bind(fracSeen);
    fn.e.movRegImm32(8, 1);
    fn.e.pushAx();
    fn.e.jmp(fracScan);
    fn.e.bind(fracScanDone);
    fn.e.testR8R8();
    int fracEmpty = fn.e.lab();
    fn.e.jcc(132, fracEmpty);
    fn.e.movAlImm(46);
    fn.e.stoAlRdi();
    fn.e.incRdi();
    fn.e.fillReg(1, -32);
    fn.e.movRegImm32(8, 0);
    winEmitDigitRun(fn);
    fn.e.jmp(fixedDone);
    fn.e.bind(fracEmpty);
    // All-zero fraction: discard the digits without emitting.
    fn.e.fillReg(1, -32);
    int fracDrop = fn.e.lab();
    int fracDropDone = fn.e.lab();
    fn.e.bind(fracDrop);
    fn.e.testRcxRcx();
    fn.e.jcc(132, fracDropDone);
    fn.e.popRax();
    fn.e.decRcx();
    fn.e.jmp(fracDrop);
    fn.e.bind(fracDropDone);
    fn.e.bind(fixedDone);
    fn.e.jmp(fmtDone);
    fn.e.bind(isExp);
    fn.e.movAxR8();
    fn.e.movRegImm32(1, 100000);
    fn.e.xorEdxEdx();
    fn.e.divRcx();
    fn.e.addAxImm32(48);
    fn.e.stoAlRdi();
