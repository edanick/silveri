mod export objcache;

import * from cache;
import * from ast;

// Raw OS enablers for the native object runner below (kernel32 executable
// mapping + high-resolution timing, msvcrt copy) — file-top grant,
// mirroring the unified std fold shape (cache.sr, resource.sr).
#on WINDOWS
import * from win32.kernel32;
import * from win32.msvcrt;
#on LINUX
import * from linux.libc;
#on MAC
import * from mac.libsystem;
#off

// OVERHAUL.md --cache-object — persistent per-target object cache for the
// interpreter, plus the built-in object validation tier (the third execution
// tier beside .sr AST interpretation and .srbc bytecode interpretation).
//
// One entry per project per target OS + architecture, a tier above
// --cache-bytecode: object emission packs genuine machine code and falls
// back to nothing — the payload is always emittable, so passing both flags
// together is the fastest configuration, but --cache-object works on its
// own too. There is no --os in silveri: the target comes from host
// auto-detection (interpHostOs in main.sr), and the architecture follows
// the target — x86-64 for Windows/Linux, aarch64 for mac.
//
// Layout under the same per-host cache root as --cache-bytecode.
// Bytecode lives in <project>\bytecode\, objects live in
// <project>\<os>-<arch>\ (both under that root):
//
//   <project>\bytecode\project.sbcr              # record for the bytecode tier
//   <project>\bytecode\src\main.srbc             # bytecode mirrors the project tree
//   <project>\windows-x86-64\project.sbcr     # record for THIS target only
//   <project>\windows-x86-64\src\main.o       # objects mirror the project tree
//   <project>\linux-x86-64\project.sbcr       # separate record per target
//   <project>\mac-aarch64\project.sbcr        # separate record per target
//
// (On Linux/macOS the same tree applies with / separators.)
//
// Two-tier workflow: object emission packs the synced .srbc text (under
// bytecode\) when the bytecode tier hit, otherwise freshly lexed source.
//
// Object format (v5 — mirrors silverc-rs src/objcache.rs and
// silverc/compiler/objcache.sr byte-exactly):
//
// The extension is always .o (never .obj); the contents are the proper
// relocatable object format for the target, emitted by the built-in writers
// below — COFF (IMAGE_FILE_MACHINE_AMD64) on Windows, ELF relocatable
// (ET_REL, EM_X86_64) on Linux, Mach-O object (MH_OBJECT, ARM64) on mac.
// The Linux object carries 9 section headers (NULL, .text, .rdata, .slvnote,
// .shstrtab, .symtab, .strtab, .rela.text, and the empty-but-present
// .rela.data), exactly like the references; older 8-section objects (no
// .rela.data) still validate. The mac object carries LC_SEGMENT_64
// (__TEXT with __text, __rdata, __slvnote) + LC_SYMTAB + LC_DYSYMTAB,
// exactly like the references. No external linker, assembler, or object
// toolchain of any kind (FORBIDDEN.md): the containers are assembled here
// with plain byte pushes over int[] buffers so cached objects validate
// across the toolchain.
//
// Every object carries three real sections plus the container's symbol and
// relocation tables:
//
// - .text — GENUINE MACHINE CODE assembled by the interpreter's own Silver
//   emitter. On WINDOWS it is the real per-file lowering (winLowerUnit
//   below, following the silverc port's approach: one FUNC per user
//   function, Win64 ABI shapes, cross-file references left as
//   relocations). On LINUX it is the same lowering under the SysV ABI
//   (winLowerUnit with abi 1: no shadow space, RDI/RSI/RDX/RCX/R8/R9,
//   libc.so.6 imports); on MAC it is the real per-file ARM64 lowering
//   (armLowerUnit below: one FUNC per user function, AAPCS64 shapes —
//   16-byte frames, x0-x7 arguments, adrp+add data references, bl calls).
//   Never source text, never a token stream. v4 objects (SLVOBJ2 note,
//   including the relocation-less ARM64 stub era) fail the v5 note parse
//   and are treated as stale (re-emitted), never as a hard error. Stub-era
//   objects (v5 note but a seam UNDEF in the symbol table) are likewise
//   stale on every target: the planner re-emits them with real lowering
//   instead of executing them.
// - .rdata — the owning file's real data bytes. Lowered units carry
//   the program's strings (printf formats, literals).
//   May be empty in principle; never text.
// - .slvnote — the Silver note (magic SLVOBJ3, emitting flag set, source
//   FNV-1 hash, emission stamp, globals-block size, the full import list,
//   and the owning file key). The planner reads this for freshness.
//
// Symbol tables hold, in the reference order (section anchors, defined
// functions, the data anchor, then undefined symbols): the section anchors,
// one FUNC symbol per lowered function (main under the file's entry symbol,
// spelled by objInterpEntrySym exactly like the references spell entries),
// one
// global data-anchor symbol (__slv_data_<file>_<hash>, offset 0 in .rdata,
// spelled by databName exactly like the references), and UNDEF entries for
// the referenced imports (msvcrt!printf and kernel32!ExitProcess on the
// Windows lowered path, libc.so.6!printf and libc.so.6!exit on the Linux
// lowered path, libSystem.B.dylib!exit plus libSystem.B.dylib!printf on the
// Mac lowered path; the __slv_interp_run seam on stub-era objects, which
// are stale on every target).
//
// Relocations cover the position-dependent sites in .text: REL32 (E8 calls
// to defined functions and to import thunks) and ABS64 (8-byte absolute
// data addresses) on x86-64; BRANCH26 (bl calls to defined functions and
// to imports) and PAGE21/PAGEOFF12 (the adrp+add pair addressing the data
// anchor) on ARM64. Intra-function relative flow is already final and
// relocation, exactly like a conventional compiler's output. On Linux they
// ride .rela.text (R_X86_64_PC32 / R_X86_64_64) with .rela.data present but
// size-0 (.rdata carries no pointers by construction, so a data relocation
// has no meaning the linker could apply); a non-empty .rela.data is
// corruption (loud, never silently ignored), a missing one an older object
// that still validates. On mac they ride the __text section (extern,
// pc-relative, 4-byte length) against defined functions, the datab anchor,
// and the import UNDEFs.
//
// ///////////////////////////////////////////////////////////////////////////
// // NATIVE RUNNER — WINDOWS executes real program logic in-process        //
// // (OVERHAUL.md fastest tier). Read this all: what runs natively, what   //
// // still falls back, why.                                                //
// ///////////////////////////////////////////////////////////////////////////
// //
// // After verifyObject passes, ObjSession.runNative loads the validated
// // entry object and EXECUTES its .text in-process: one RWX block from
// // VirtualAlloc (MEM_COMMIT zero-fill, PAGE_EXECUTE_READWRITE — the same
// // established file-top DLL-import pattern cache.sr/resource.sr use, no
// // new FFI shape), the object's own ABS64/REL32 relocations applied
// // against the loaded base, and every UNDEF __slv_imp_N import bound
// // through a 12-byte in-block import thunk after the .rdata coat
// // (movabs rax,addr; jmp rax — silveri.exe's image address and the
// // VirtualAlloc arena routinely sit more than ±2 GB apart, beyond REL32
// // reach, so imports bind the way linkers bind far imports: a near REL32
// // to the thunk, which jumps to the export absolutely). The export
// // addresses come from the already-loaded modules (GetModuleHandleA +
// // GetProcAddress — the same bare-call shape builtins.sr uses, no new FFI
// // shape), so nothing is loaded as a side effect. Then a call into the
// // loaded entry runs the compiled program.
// //
// // Copying is NUL-safe by construction: Silver strings are C strings, so
// // .length stops at the first NUL and one memcpy cannot carry NUL bytes.
// // The RWX block arrives zero-filled, so NUL bytes need no copy at all —
// // objNatBlit copies only the NUL-free runs between them at their true
// // offsets (an all-NUL payload copies nothing and is still exact).
// //
// // The call itself rides the language's own indirect-call shape
// // (DOCS/259 G3): the entry address sits in an int[] slot and slots[0]()
// // evaluates to the callee's RAX, so no new call primitive was needed.
// //
// // PROOF the bytes ran (not the AST): the .text carries the compiled
// // program, so patching one program byte in the cached .o (source
// // untouched) changes the native program output, which the next run
// // shows; freshness still passes (the SLVOBJ3 note is untouched), so the
// // patch demonstrably flows through executed machine code, never the AST.
// //
// // WHAT EXECUTES WHERE (exact boundary — loud fallback to the verified
// // AST/bytecode tiers, never silent wrong behavior; every case below
// // returns a reason string the driver prints):
// //
// // - Only WINDOWS/x86-64 executes (COFF objects): after verifyObject
// //   passes, runNative loads the validated entry object and EXECUTES its
// //   .text in-process (see the loader paragraphs above).
// // - LINUX (ELF) validates identically and its .text is the same real
// //   program lowering (SysV ABI) — but it stays on the verified tiers:
// //   the in-process runner is COFF/x86-64 only (same loader math,
// //   unprobed host ceilings — the follow-up). MAC (Mach-O/ARM64) likewise
// //   validates but stays on the verified tiers: a different ISA entirely
// //   (ARM64 cannot run on the x86-64 host), so its real program lowering
// //   is validated structurally and executed from the verified tiers.
// // - Only note-listed __slv_imp_N imports bind (msvcrt!printf and
// //   kernel32!ExitProcess for Windows lowered units, resolved live). Any other
// //   UNDEF import — including the retired __slv_interp_run seam, which
// //   now marks stub-era objects as stale instead of binding — linker
// //   singletons, or extern/data targets outside .text/.rdata are
// //   unresolvable in-process.
// // - Only in-tier entries execute (the macTierReason subset, re-checked by
// //   the lowering itself so the two can never disagree). Anything else
// //   emits no object at all — never a stub — and the driver reports the
// //   reference reason loudly, continuing from the verified tiers.
// // - The trap path prints through the bound printf and exits the process
// //   through the bound ExitProcess — the reference divide-by-zero and
// //   overflow behavior — so a faulting native run never returns to the
// //   driver at all, exactly like the compiled binary.
// // - Oversize objects (>64 MiB), mapping failure, unresolvable imports,
// //   and out-of-range REL32 all fall back loudly.
// //
////////////////////////////////////////////////////////////////////////////////
//
// Freshness (mirrors the references exactly):
//
// The per-file `.sr` modification time plus the FNV-1 hash of the combined
// source is compared against the per-target project.sbcr record
// (v3 — unchanged fields, existing records are reused), which additionally
// keys on the emitting flag set, so a flag switch re-emits. Fresh means: the
// record matches (mtime + hash, in that order), the .o exists, AND its v5
// note peeks with the expected flag set + hash (plan() in the references). Anything else —
// including a v4-era object or a compiler-emitted object whose flag set is
// not "interp" — is stale (re-emitted), never a hard error on the plan path
// and never silently reused. Unlike the compilers — which note every project
// file per run — the interpreter notes its single entry per run, so finish()
// never drops unnoted records (dropping would evict other entries' objects
// when alternating entry files).
//
// Cross-acceptance: a compiler-emitted object for ANY target parses with
// the readers below (same containers, same 9-section ELF / 3-section COFF /
// LC_SEGMENT_64+LC_SYMTAB+LC_DYSYMTAB Mach-O shape, same SLVOBJ3 note) and
// is then either fresh-planned (same flags + hash, which only an "interp"
// emitter can produce) or detected as a flag-set/hash mismatch and
// re-emitted — accepted structurally, never executed stale. The note's
// globals-block size agrees the same way: the
// interpreter always records gas 0 (no globals block; execution stays on
// the AST/bytecode tiers), while the self-host counts bytes and silverc-rs
// counts slots, so any nonzero foreign gas fails LOUDLY at the agreement
// check in finish() / verifyObject() instead of mislinking — the same rule
// the linkers enforce.
//
// - The record is the same .sbcr family (v3: v2 fields plus the emitting
//   flag-set string), with text companion project.sbcri. Each <os>-<arch>
//   directory carries its own record. The flag set is the constant "interp"
//   (the interpreter has no execution modes and no --optimize; the key
//   exists so the machinery — and cross-tool validation — matches the
//   compilers: a compiler-emitted object reports a flag-set switch instead
//   of being silently reused).
//
// Binary artifacts (the v3 record, the .o objects) ride file.writeBytes over
// int[] buffers, so NUL bytes survive on every target; file.read (byte[],
// exact) reads them back. The .sbcri text companion is NUL-free and is the
// authoritative read side for records.

// Target directory name for a host OS (OVERHAUL.md): the architecture
// follows the target — x86-64 for Windows/Linux, aarch64 for mac.
// `hostOs` is the canonical UPPERCASE name (interpHostOs); anything else
// falls back to the Windows target.
public string objTargetDirName(string hostOs) {
    if (hostOs == "LINUX") { return "linux-x86-64"; }
    if (hostOs == "MAC") { return "mac-aarch64"; }
    return "windows-x86-64";
}

// Flag-set key recorded in the per-target record (OVERHAUL.md): the record
// additionally keys on the emitting flag set so a flag switch invalidates
// the objects instead of silently reusing them. The interpreter carries no
// execution modes and no --optimize, so the key is the constant "interp".
public string objFlagKey() {
    return "interp";
}

// Linker-provided singleton symbols (writable blocks laid out once by the
// linker, referenced from any object). Spelled exactly like the references
// so cross-tool readers agree; the interpreter's own stub references only
// the runner seam below, but the names stay for cross-acceptance.
public string objSingletonExc() { return "__slv_exc_state"; }
public string objSingletonTray() { return "__slv_tray_state"; }
public string objSingletonGlobals() { return "__slv_globals"; }

// Prefix of the per-object data-anchor symbol (global, offset 0 in
// .rdata) and of undefined import symbols (the suffix is the decimal index
// into the note's import list: __slv_imp_3). Spelled exactly like the
// references.
public string objDatabPrefix() { return "__slv_data_"; }
public string objImportPrefix() { return "__slv_imp_"; }

// The seam symbol every retired proof stub called (UNDEF FUNC in
// stub-era objects): the retired entry point that never executes —
// any object still referencing it is stale by symbol-table inspection
// (stubEra), never executed. Naming it here — in code AND in the stale
// check — is the loud marker of the stub-era boundary above.
public string objInterpRunSym() { return "__slv_interp_run"; }

// Per-file entry-stub symbol: sanitized owner key plus an FNV-1 suffix so
// distinct files can never collide after sanitizing. Deterministic per
// (key, content hash).
public string objInterpEntrySym(string filekey, int64 hash) {
    string[] parts = [];
    for (int i = 0; i < filekey.length; i++) {
        char c = filekey[i];
        bool ok = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9');
        if (ok) { parts.add((string)c); }
        else { parts.add("_"); }
    }
    int64 low = hash & 0xFFFFFFFF;
    return "__slv_interp_" + parts.join("") + "_" + objHex8(low);
}

// Global data-anchor symbol name for `filekey`: sanitized path plus an
// FNV-1 suffix so distinct files can never collide after sanitizing
// (a/b.sr vs a_b.sr). Mirrors the references byte-exactly (same sanitize,
// same {:08x} of the low 32 bits of FNV-1 over the key).
public string databName(string filekey) {
    string[] parts = [];
    for (int i = 0; i < filekey.length; i++) {
        char c = filekey[i];
        bool ok = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9');
        if (ok) { parts.add((string)c); }
        else { parts.add("_"); }
    }
    int64 h = icFnv1(filekey);
    int64 low = h & 0xFFFFFFFF;
    return objDatabPrefix() + parts.join("") + "_" + objHex8(low);
}

// 8 lowercase hex digits of the low 32 bits (the {:08x} shape of data
// anchors and entry symbols).
public string objHex8(int64 v) {
    string digits = "0123456789abcdef";
    string[] parts = [];
    for (int i = 0; i < 8; i++) {
        int nib = int((v >> ((7 - i) * 4)) & 0xF);
        parts.add(digits[nib..nib + 1]);
    }
    return parts.join("");
}

// True (1) when a /-separated record key resolves inside the project root:
// absolute paths (leading /, drive letters) and parent escapes (..) are
// out-of-root and are never object-cached (they still run normally).
private int objIsLocalKey(string key) {
    if (key.length == 0) { return 0; }
    if (key[0] == '/') { return 0; }
    for (int i = 0; i < key.length; i++) {
        if (key[i] == ':') { return 0; }
    }
    if (key.length >= 2 && key[0] == '.' && key[1] == '.') {
        if (key.length == 2 || key[2] == '/') { return 0; }
    }
    return 1;
}

// In-memory byte sink for container emission. Methods grow the object's own
// buffer; callers take the finished buffer out once.
class ObjWriter {
    public prop int[] out;

    construct {
        this.out = [];
    }

    public void u8(int64 v) {
        this.out.add(v & 0xFF);
    }

    public void u16(int64 v) {
        this.u8(v);
        this.u8(v >> 8);
    }

    public void u32(int64 v) {
        for (int i = 0; i < 4; i++) { this.u8((v >> (i * 8)) & 0xFF); }
    }

    public void u64(int64 v) {
        for (int i = 0; i < 8; i++) { this.u8((v >> (i * 8)) & 0xFF); }
    }

    public void rawStr(string s) {
        for (int i = 0; i < s.length; i++) {
            this.u8(int64(s[i]) & 0xFF);
        }
    }

    // Fixed-width name field: the name bytes, then NULs up to `total`.
    public void rawName(string s, int total) {
        this.rawStr(s);
        int have = s.length;
        while (have < total) {
            this.u8(0);
            have++;
        }
    }

    public void rawBytes(int[] data) {
        for (int i = 0; i < data.length; i++) {
            this.u8(data[i] & 0xFF);
        }
    }

    // Raw data padded with NULs up to `padded` bytes.
    public void rawPad(int[] data, int padded) {
        this.rawBytes(data);
        int n = data.length;
        while (n < padded) {
            this.u8(0);
            n++;
        }
    }

    // Length-prefixed (u32 LE) string field for notes and records.
    public void strField(string s) {
        this.u32(s.length);
        this.rawStr(s);
    }

    // One ELF64 section header (64 bytes).
    public void sh(int64 name, int64 stype, int64 flags, int64 off, int64 size, int64 link, int64 info, int64 align, int64 entsize) {
        this.u32(name);
        this.u32(stype);
        this.u64(flags);
        this.u64(0);
        this.u64(off);
        this.u64(size);
        this.u32(link);
        this.u32(info);
        this.u64(align);
        this.u64(entsize);
    }
}

// One emitted object unit: the owning file's machine code + data with full
// symbol and relocation tables. Built by the real lowerings (winLowerUnit,
// armLowerUnit); serialized by emitObject. Mirrors the references'
// unit shape (defined/undefined/reloc tables sorted for determinism).
class ObjUnit {
    // Session-relative owner key (/-separated).
    public prop string filekey;
    // Machine code slice (.text).
    public prop int[] code;
    // Data slice (.rdata).
    public prop int[] data;
    // Defined function symbols (parallel arrays; offsets into code).
    public prop string[] defNames;
    public prop int[] defOffs;
    public prop int[] defSizes;
    // Global data-anchor name (databName of filekey).
    public prop string datab;
    // Referenced-but-elsewhere-defined Silver symbols (sorted, deduped).
    public prop string[] undefFuncs;
    // Referenced linker singletons (sorted; 0 = exc, 1 = tray, 2 = globals).
    public prop int[] undefSingles;
    // Referenced import-list indices (sorted).
    public prop int[] undefImports;
    // Relocations, sorted by site (parallel arrays).
    public prop int[] relSites;
    // 0 = Rel32 (x86-64 E8 call), 1 = Abs64 (x86-64 8-byte absolute
    // address), 2 = ArmBranch26 (ARM64 bl), 3 = ArmPage21 (ARM64 adrp),
    // 4 = ArmPageOff12 (ARM64 add). Absolute ABS64 has no ARM64 form:
    // Mach-O ARM64 defines no absolute code relocations, so ARM64
    // addresses are always PC-relative pairs.
    public prop int[] relKinds;
    // 0 = Defined, 1 = Extern, 2 = Data, 3 = Singleton, 4 = Import.
    public prop int[] relTargets;
    // Target index (defined idx / data offset / singleton id / import idx).
    public prop int[] relIdx;
    // Extern target name (only for target kind 1).
    public prop string[] relNames;
    // Full import list (parallel arrays; deterministic across runs).
    public prop string[] impDlls;
    public prop string[] impNames;
    // Whole-program globals-block size. The interpreter carries no globals
    // block (execution stays on the AST/bytecode tiers), so this is always
    // 0 — recorded so the note shape stays reference-exact.
    public prop int gas;

    construct {
        this.filekey = "";
        this.code = [];
        this.data = [];
        this.defNames = [];
        this.defOffs = [];
        this.defSizes = [];
        this.datab = "";
        this.undefFuncs = [];
        this.undefSingles = [];
        this.undefImports = [];
        this.relSites = [];
        this.relKinds = [];
        this.relTargets = [];
        this.relIdx = [];
        this.relNames = [];
        this.impDlls = [];
        this.impNames = [];
        this.gas = 0;
    }
}

// Native symbol tables for one emitted object (holder object, not raw
// array parameters: arrays received as function parameters silently stop
// growing past 8 entries in this toolchain, while prop arrays on a passed
// object keep growing — the writer's tables scale with the symbol count,
// so they live here). Mirrors the reference build_out_syms order.
class ObjSymTab {
    public prop string[] names;
    public prop int[] sects;
    public prop int[] vals;
    public prop int[] funcs;
    // ELF st_size per symbol (anchors, the datab, and undefined symbols
    // carry 0; defined FUNCs carry their code size) — mirrors the reference
    // build_out_syms order.
    public prop int[] sizes;

    construct {
        this.names = [];
        this.sects = [];
        this.vals = [];
        this.funcs = [];
        this.sizes = [];
    }
}

// A fully parsed object: note metadata plus code, data, symbols, and
// relocations. The unifier's validation input (there is no linker in the
// interpreter — see the NATIVE-RUNNER BOUNDARY above).
class ParsedObj {
    public prop string filekey;
    public prop string flags;
    public prop int64 hash;
    public prop int stamp;
    public prop int gas;
    public prop string[] impDlls;
    public prop string[] impNames;
    public prop int[] code;
    public prop int[] data;
    // Symbols (parallel arrays): section (0 = undef, 1 = .text, 2 = .rdata),
    // value (offset), isFunc (1 = function).
    public prop string[] symNames;
    public prop int[] symSects;
    public prop int[] symVals;
    public prop int[] symIsFunc;
    // Relocations (parallel arrays): site, symbol index, kind (0 = Rel32,
    // 1 = Abs64, 2 = ArmBranch26, 3 = ArmPage21, 4 = ArmPageOff12), addend
    // (COFF/ELF addends ride the site bytes; Mach-O ARM64 addends ride the
    // instruction immediates).
    public prop int[] relSites;
    public prop int[] relSyms;
    public prop int[] relKinds;
    public prop int64[] relAddends;

    construct {
        this.filekey = "";
        this.flags = "";
        this.hash = 0;
        this.stamp = 0;
        this.gas = 0;
        this.impDlls = [];
        this.impNames = [];
        this.code = [];
        this.data = [];
        this.symNames = [];
        this.symSects = [];
        this.symVals = [];
        this.symIsFunc = [];
        this.relSites = [];
        this.relSyms = [];
        this.relKinds = [];
        this.relAddends = [];
    }
}

// Decoded v5 note: emitting flag set, source hash, emission stamp,
// globals-block size, full import list, and owner file key.
class ObjNote {
    public prop string flags;
    public prop int64 hash;
    public prop int stamp;
    public prop int gas;
    public prop string[] impDlls;
    public prop string[] impNames;
    public prop string filekey;

    construct {
        this.flags = "";
        this.hash = 0;
        this.stamp = 0;
        this.gas = 0;
        this.impDlls = [];
        this.impNames = [];
        this.filekey = "";
    }
}

// Indexed byte reader over a file read back with file.read (exact bytes,
// truthful length — no NUL truncation anywhere in the path).
class ObjReader {
    public prop byte[] data;
    public prop int size;

    construct (byte[] d) {
        this.data = d;
        this.size = d.length;
    }

    public int64 u8At(int off) {
        if (off < 0 || off >= this.size) { return -1; }
        return int64(this.data[off] & 0xFF);
    }

    public int64 u16At(int off) {
        int64 lo = this.u8At(off);
        int64 hi = this.u8At(off + 1);
        if (lo < 0 || hi < 0) { return -1; }
        return lo | (hi << 8);
    }

    public int64 u32At(int off) {
        int64 b0 = this.u8At(off);
        int64 b1 = this.u8At(off + 1);
        int64 b2 = this.u8At(off + 2);
        int64 b3 = this.u8At(off + 3);
        if (b0 < 0 || b1 < 0 || b2 < 0 || b3 < 0) { return -1; }
        return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
    }

    public int64 u64At(int off) {
        int64 v = 0;
        for (int i = 0; i < 8; i++) {
            int64 b = this.u8At(off + i);
            if (b < 0) { return -1; }
            v = v | (b << (i * 8));
        }
        return v;
    }

    // Exact bytes as a string (callers only lift short ASCII ranges: magic
    // words, section names, symbol names, the flag set — never .text code).
    public string bytesAt(int off, int len) {
        if (off < 0 || len < 0 || off + len > this.size) { return ""; }
        string[] parts = [];
        for (int i = 0; i < len; i++) {
            int b = int(int64(this.data[off + i] & 0xFF));
            parts.add((string)char(b));
        }
        return parts.join("");
    }
}

// ---------------------------------------------------------------------------
// Fixed-width 32-bit ARM64 instruction encoders (mirrors silverc-rs
// src/arm64.rs and silverc/compiler/objcache.sr, which the Mach-O side
// also uses for dyld stubs). Every encoder takes plain ints and returns
// the word as an int (all words fit in 32 unsigned bits, so shifts stay
// logical). Bit layouts follow the ARM ARM for A-profile (DDI0487).
private int a64Adrp(int rd, int pageOff) {
    int64 u = int64(pageOff) & 0x1FFFFF;
    return int(0x90000000 | ((u & 0x3) << 29) | (((u >> 2) & 0x7FFFF) << 5) | (rd & 31));
}

// add Xd, Xn, #imm12 (64-bit, no shift — the only form the tier emits).
private int a64AddImm(int rd, int rn, int imm12) {
    return int(0x91000000 | ((imm12 & 0xFFF) << 10) | ((rn & 31) << 5) | (rd & 31));
}

// bl <label>: branch with link.
private int a64Bl(int off) {
    return int(0x94000000 | ((int64(off / 4) & 0x3FFFFFF)));
}

// movz Xd, #imm16, lsl #hw*16.
private int a64Movz(int rd, int imm16, int hw) {
    return int(0xD2800000 | ((hw & 3) << 21) | ((imm16 & 0xFFFF) << 5) | (rd & 31));
}

// movk Xd, #imm16, lsl #hw*16 (keeps the other halfwords).
private int a64Movk(int rd, int imm16, int hw) {
    return int(0xF2800000 | ((hw & 3) << 21) | ((imm16 & 0xFFFF) << 5) | (rd & 31));
}

// sdiv Xd, Xn, Xm: signed 64-bit divide (truncating, like x64 idiv).
// Division by zero yields zero (no trap) and INT64_MIN / -1 yields
// INT64_MIN (no overflow signal): callers guard both cases explicitly so
// cached programs observe x64-identical behavior. Mirrors silverc-rs
// src/arm64.rs enc_sdiv and silverc/compiler/objcache.sr a64Sdiv
// bit-for-bit; the interpreter's ARM64 stub above needs no divide, but the
// encoder set stays complete so cross-toolchain .text words decode to
// identical shapes.
private int a64Sdiv(int rd, int rn, int rm) {
    return int(0x9AC00C00 | ((rm & 31) << 16) | ((rn & 31) << 5) | (rd & 31));
}

// msub Xd, Xn, Xm, Xa: Xd = Xa - Xn*Xm (64-bit, for % as a - (a/b)*b).
// Mirrors silverc-rs src/arm64.rs enc_msub and
// silverc/compiler/objcache.sr a64Msub bit-for-bit.
private int a64Msub(int rd, int rn, int rm, int ra) {
    return int(0x9B008000 | ((rm & 31) << 16) | ((ra & 31) << 10) | ((rn & 31) << 5) | (rd & 31));
}

// brk #imm16: breakpoint trap (for the INT64_MIN / -1 overflow case,
// mirroring the x64 backend's loud hardware fault instead of sdiv's wrap).
// Mirrors silverc-rs src/arm64.rs enc_brk and
// silverc/compiler/objcache.sr a64Brk bit-for-bit.
private int a64Brk(int imm16) {
    return int(0xD4200000 | ((imm16 & 0xFFFF) << 5));
}

// ret Xn: return (default X30).
private int a64Ret(int rn) {
    return int(0xD65F0000 | ((rn & 31) << 5));
}

// Decode the page offset of an adrp word (the object reader recovers
// data-reference addends with this).
private int a64DecodeAdrpPage(int word) {
    int64 raw = (((int64(word) >> 5) & 0x7FFFF) << 2) | ((int64(word) >> 29) & 0x3);
    if ((raw & 0x100000) != 0) { return int(raw - 0x200000); }
    return int(raw);
}

// Decode the imm12 of an add (immediate) word.
private int a64DecodeAddImm12(int word) {
    return int((int64(word) >> 10) & 0xFFF);
}

// Decode the 26-bit displacement of a bl word (in words, like the
// reference decode_bl_imm26).
private int a64DecodeBlImm26(int word) {
    int64 raw = int64(word) & 0x3FFFFFF;
    if ((raw & 0x2000000) != 0) { return int(raw - 0x4000000); }
    return int(raw);
}

private int macWordAt(int[] code, int pos) {
    int64 w = 0;
    for (int i = 0; i < 4; i++) { w = w | (int64(code[pos + i] & 0xFF) << (i * 8)); }
    return int(w);
}

// ---------------------------------------------------------------------------
// x86-64 REAL LOWERING (v1 object tier): WINDOWS/Win64 and LINUX/SysV.
//
// AST-to-machine-code backend for the interpreter's x86-64 objects:
// per-file units whose .text carries the actual compiled program logic (one
// FUNC per user function, native ABI shapes throughout), .rdata carrying the
// program's real data (printf formats, string literals),
// and UNDEF externs for the imports the runner binds in-process
// (msvcrt!printf, kernel32!ExitProcess on Windows; libc.so.6!printf,
// libc.so.6!exit on Linux) with REL32 call sites and ABS64 data
// sites. No stubs: anything outside the tier falls back LOUDLY (the reason
// string is the whole result) and no unit is produced for it.
//
// Boundary: intentionally the SAME subset the mac tier predicate accepts
// (macTierReason owns it — winLowerUnit re-checks it first so the two can
// never disagree). Integer/bool/char programs only: free functions (8 params
// max, no defaults), const scalars, void main() with no parameters, locals,
// assignment (plain + compound, with the << form evaluating its RHS like the
// interpreter does), if/else, while, C-like for (range-for desugared onto it
// exactly like the predicate), break/continue, return, calls with exact
// arity, and print/printline of scalars and string literals.
//
// Semantics mirror the compiler port (silverc/compiler/mini_cg + silverc-rs
// codegen.rs): stack-machine evaluation (values in RAX, push/pop for binary
// operators), per-ABI call setup (Win64: push r13 anchor, 16-byte align,
// 32-byte shadow space, RCX/RDX/R8/R9 + caller-pushed stack args; SysV: same
// anchor and alignment, no shadow space, RDI/RSI/RDX/RCX/R8/R9 +
// caller-pushed stack args), callee-saved rbp
// frames with params spilled to slots, divide/modulo through the guarded
// sequence (zero divisor and INT64_MIN / -1 both take the Unhandled
// exception + exit(1) path — the overflow faults in hardware on real
// binaries, so the lowering checks it explicitly instead of crashing the
// interpreter process), and print through msvcrt!printf with literal-safe
// formats (bools print as 1/0 and chars use %c, exactly like the verified
// tiers and the compiled binaries).
//
// The emitter itself is portable byte math (no regions); only the runner's
// import resolution below is OS-gated. The Mach-O path never calls this
// (ARM64 lowering lives in its own section below).
// ---------------------------------------------------------------------------

// x86-64 code buffer with intra-function labels. Relocations are NOT patched
// here: calls and data references are emitted as zero holes whose positions
// the lowering records into the unit (the loader resolves them by symbol),
// while jumps between labels are patched by finish() once the function is
// complete (function starts are unknown until concatenation, so only
// label-relative flow patches here).
//
// The emitter serves BOTH x86-64 ABIs (one home for one ISA — the instruction
// set is identical, only the calling convention differs): abi 0 is Win64
// (32-byte shadow space, RCX/RDX/R8/R9), abi 1 is SysV (no shadow space,
// RDI/RSI/RDX/RCX/R8/R9, 8 stack slots' slack folded into the reserve like
// the silverc port's emitAbiCallSetup so spills never land on the pushed-R13
// save slot). construct leaves abi 0; the unit builder sets it from the
// session target before lowering.
class WinEmit {
    public prop int[] code;
    public prop int[] labPos;
    public prop int[] fixPos;
    public prop int[] fixLab;
    public prop int abi;

    construct {
        this.code = [];
        this.labPos = [];
        this.fixPos = [];
        this.fixLab = [];
        this.abi = 0;
    }

    public void b(int v) {
        this.code.add(v & 0xFF);
    }

    public void i32(int64 v) {
        for (int i = 0; i < 4; i++) { this.code.add((v >> (i * 8)) & 0xFF); }
    }

    public void i64(int64 v) {
        for (int i = 0; i < 8; i++) { this.code.add((v >> (i * 8)) & 0xFF); }
    }

    public int lab() {
        this.labPos.add(-1);
        return this.labPos.length - 1;
    }

    public void bind(int id) {
        this.labPos[id] = this.code.length;
    }

    public void jmp(int id) {
        this.b(233);
        this.fixPos.add(this.code.length);
        this.fixLab.add(id);
        this.i32(0);
    }

    // Second byte of 0F 8x: 132 JE, 133 JNE, 140 JL, 142 JLE, 143 JG, 141 JGE.
    public void jcc(int cc, int id) {
        this.b(15);
        this.b(cc);
        this.fixPos.add(this.code.length);
        this.fixLab.add(id);
        this.i32(0);
    }

    public string finish() {
        for (int i = 0; i < this.fixPos.length; i++) {
            int id = this.fixLab[i];
            if (id < 0 || id >= this.labPos.length || this.labPos[id] < 0) { return "unbound label"; }
            int pos = this.fixPos[i];
            int64 rel = int64(this.labPos[id]) - int64(pos + 4);
            if (rel < -2147483648 || rel > 2147483647) { return "branch out of range"; }
            for (int k = 0; k < 4; k++) { this.code[pos + k] = int((rel >> (k * 8)) & 0xFF); }
        }
        return "";
    }

    // Frame prologue/epilogue (leave shape). frame is 8 mod 16 (never 0) so
    // the body runs with rsp 16-aligned, ready for call setup below.
    public void prologue(int frame) {
        this.b(85);
        this.b(72);
        this.b(137);
        this.b(229);
        if (frame > 0) {
            this.b(72);
            this.b(129);
            this.b(236);
            this.i32(int64(frame));
        }
    }

    public void epilogue() {
        this.b(72);
        this.b(137);
        this.b(236);
        this.b(93);
        this.b(195);
    }

    // Call setup/teardown: anchor rsp in r13, align to 16, reserve the
    // outgoing area. Win64 reserves the 32-byte shadow space plus the
    // outgoing args (mirrors the reference aligned-call shape); SysV
    // reserves only the outgoing args with the port's +8 slack (no shadow
    // space — the SysV shape), so rsp is 16-aligned at the call either way.
    public void callSetup(int nargs) {
        int total = (32 + 8 * nargs + 15) / 16 * 16;
        if (this.abi == 1) { total = (8 * nargs + 8 + 15) / 16 * 16; }
        this.b(65);
        this.b(85);
        this.b(73);
        this.b(137);
        this.b(229);
        this.b(72);
        this.b(131);
        this.b(228);
        this.b(240);
        this.b(72);
        this.b(131);
        this.b(236);
        this.b(total);
    }

    public void callTeardown() {
        this.b(76);
        this.b(137);
        this.b(236);
        this.b(65);
        this.b(93);
    }

    // E8 call with a zero hole; returns the hole position for the reloc.
    public int callHole() {
        this.b(232);
        int pos = this.code.length;
        this.i32(0);
        return pos;
    }

    // movabs r64, 0 hole; reg 0 = rax, 1 = rcx, 2 = rdx, 6 = rsi,
    // 7 = rdi, 8 = r8, 9 = r9 (the helper call sequences address their
    // argument registers directly, including the third one).
    // B8+rd extends through REX.B (73), never REX.R.
    // Returns the hole.
    public int absHole(int reg) {
        int rex = 72;
        int op = 186;
        if (reg == 0) { op = 184; }
        else if (reg == 1) { op = 185; }
        else if (reg == 6) { op = 190; }
        else if (reg == 7) { op = 191; }
        else if (reg == 8) { rex = 73; op = 184; }
        else if (reg == 9) { rex = 73; op = 185; }
        this.b(rex);
        this.b(op);
        int pos = this.code.length;
        this.i64(0);
        return pos;
    }

    // movabs r64, datab+off hole: the offset rides the site bytes (the COFF
    // addend convention the reader recovers), the loader adds the loaded
    // data base. Returns the hole for the ABS64 reloc.
    public int absData(int reg, int off) {
        int pos = this.absHole(reg);
        int64 v = int64(off);
        for (int k = 0; k < 8; k++) { this.code[pos + k] = int((v >> (k * 8)) & 0xFF); }
        return pos;
    }

    public void movAbs(int reg, int64 v) {
        this.b(72);
        if (reg == 0) { this.b(184); }
        else if (reg == 1) { this.b(185); }
        else { this.b(186); }
        this.i64(v);
    }

    // The i-th argument register for the emitter's ABI: Win64 passes the
    // first four in RCX/RDX/R8/R9, SysV the first six in
    // RDI/RSI/RDX/RCX/R8/R9 (asm reg numbers 7/6/2/1/8/9, mirroring the
    // silverc port's sysvRegAt). Only called with in-range i.
    public int argReg(int i) {
        if (this.abi == 1) {
            if (i == 0) { return 7; }
            if (i == 1) { return 6; }
            if (i == 2) { return 2; }
            if (i == 3) { return 1; }
            if (i == 4) { return 8; }
            return 9;
        }
        if (i == 0) { return 1; }
        if (i == 1) { return 2; }
        if (i == 2) { return 8; }
        return 9;
    }

    // REX prefix for a reg-reg / reg-mem op on register regc (W always set;
    // R when the register needs it; rm is rbp/rsp so B never fires here).
    private int rexFor(int regc) {
        if (regc >= 8) { return 76; }
        return 72;
    }

    // mov [rbp+disp],regc.
    public void spillReg(int regc, int disp) {
        this.b(this.rexFor(regc));
        this.b(137);
        this.b(128 + ((regc & 7) << 3) + 5);
        this.i32(int64(disp));
    }

    // mov regc,[rbp+disp].
    public void fillReg(int regc, int disp) {
        this.b(this.rexFor(regc));
        this.b(139);
        this.b(128 + ((regc & 7) << 3) + 5);
        this.i32(int64(disp));
    }

    // mov [rsp+disp],rax (caller spill into the outgoing area).
    public void spillRsp(int disp) {
        this.b(72);
        this.b(137);
        this.b(132);
        this.b(36);
        this.i32(int64(disp));
    }

    // mov regc,[rsp+disp] (caller load out of the outgoing area).
    public void fillRspReg(int regc, int disp) {
        this.b(this.rexFor(regc));
        this.b(139);
        this.b(132 + ((regc & 7) << 3));
        this.b(36);
        this.i32(int64(disp));
    }

    // mov regc,rax (caller register fill; also serves the print value
    // transfer on both ABIs with byte-identical output). The destination
    // rides the rm field, so an extended destination needs REX.B (73),
    // not the REX.R that rexFor supplies for reg-field destinations.
    public void movFromAx(int regc) {
        if (regc >= 8) { this.b(73); }
        else { this.b(72); }
        this.b(137);
        this.b(192 + (regc & 7));
    }

    // lea regc,[rbp+disp] (address-of a frame slot for int64 out-params,
    // the &freq/&count shape the QPC thunk passes to kernel32).
    public void leaRbp(int regc, int disp) {
        this.b(this.rexFor(regc));
        this.b(141);
        this.b(128 + ((regc & 7) << 3) + 5);
        this.i32(int64(disp));
    }

    // cvtsi2sd xmm0,rax (int64 -> float64, exact).
    public void cvtAxToXmm0() {
        this.b(242);
        this.b(72);
        this.b(15);
        this.b(42);
        this.b(192);
    }

    // cvtsi2sd xmm1,rcx (int64 -> float64, exact).
    public void cvtCxToXmm1() {
        this.b(242);
        this.b(72);
        this.b(15);
        this.b(42);
        this.b(201);
    }

    // divsd xmm0,xmm1 (float64 divide).
    public void divXmm0Xmm1() {
        this.b(242);
        this.b(15);
        this.b(94);
        this.b(193);
    }

    // addsd xmm0,xmm1 (float64 add).
    public void addXmm0Xmm1() {
        this.b(242);
        this.b(15);
        this.b(88);
        this.b(193);
    }

    // subsd xmm0,xmm1 (float64 subtract).
    public void subXmm0Xmm1() {
        this.b(242);
        this.b(15);
        this.b(92);
        this.b(193);
    }

    // mulsd xmm0,xmm1 (float64 multiply).
    public void mulXmm0Xmm1() {
        this.b(242);
        this.b(15);
        this.b(89);
        this.b(193);
    }

    // comisd xmm0,xmm1 (ordered float64 compare setting the CPU flags;
    // unordered pairs set ZF/PF/CF, so every use guards with JP first).
    public void comisdXmm0Xmm1() {
        this.b(102);
        this.b(15);
        this.b(47);
        this.b(193);
    }

    // movq xmm0,rax (64-bit pattern -> double, bitwise).
    public void movqXmm0Ax() {
        this.b(102);
        this.b(72);
        this.b(15);
        this.b(110);
        this.b(192);
    }

    // movq xmm1,rcx (64-bit pattern -> double, bitwise).
    public void movqXmm1Cx() {
        this.b(102);
        this.b(72);
        this.b(15);
        this.b(110);
        this.b(201);
    }

    // movq rax,xmm0 (double -> 64-bit pattern, bitwise).
    public void movqAxXmm0() {
        this.b(102);
        this.b(72);
        this.b(15);
        this.b(126);
        this.b(192);
    }

    // movabs r64,imm64 for any low or extended register (lengths, buffer
    // and table addresses the fixed movAbs forms cannot reach, e.g. r8).
    // B8+rd extends through REX.B (73), never REX.R.
    public void movAbsAny(int regc, int64 v) {
        if (regc >= 8) { this.b(73); }
        else { this.b(72); }
        this.b(184 + (regc & 7));
        this.i64(v);
    }

    // mov r32,imm32 (zero-extended to r64: small constants like 10 or the
    // buffer bound without a full 64-bit immediate). No REX.W here: B8+rd
    // with REX.W would demand an imm64 and desync the stream; the 32-bit
    // form zero-extends, which is exactly the wanted semantics. Extended
    // registers take REX.B alone (65).
    public void movRegImm32(int regc, int v) {
        if (regc >= 8) { this.b(65); }
        this.b(184 + (regc & 7));
        this.i32(int64(v));
    }

    // test rax,rax.
    public void testAxAx() {
        this.b(72);
        this.b(133);
        this.b(192);
    }

    // test rcx,rcx.
    public void testRcxRcx() {
        this.b(72);
        this.b(133);
        this.b(201);
    }

    // test rsi,rsi.
    public void testRsiRsi() {
        this.b(72);
        this.b(133);
        this.b(246);
    }

    // and rcx,rax.
    public void andRcxRax() {
        this.b(72);
        this.b(33);
        this.b(193);
    }

    // neg rax (unsigned magnitude: exact even for INT64_MIN).
    public void negAx() {
        this.b(72);
        this.b(247);
        this.b(216);
    }

    // xor edx,edx (zero the divide high half).
    public void xorEdxEdx() {
        this.b(49);
        this.b(210);
    }

    // xor eax,eax.
    public void xorEaxEax() {
        this.b(49);
        this.b(192);
    }

    // div rcx (unsigned rdx:rax / rcx: quotient rax, remainder rdx).
    public void divRcx() {
        this.b(72);
        this.b(247);
        this.b(241);
    }

    // mov rax,rcx.
    public void movAxRcx() {
        this.b(72);
        this.b(137);
        this.b(200);
    }

    // mov rsi,rcx.
    public void movRsiRcx() {
        this.b(72);
        this.b(137);
        this.b(206);
    }

    // mov rcx,rdx.
    public void movRcxRdx() {
        this.b(72);
        this.b(137);
        this.b(209);
    }

    // mov rcx,r8.
    public void movRcxR8() {
        this.b(76);
        this.b(137);
        this.b(193);
    }

    // mov rdi,rdx.
    public void movRdiRdx() {
        this.b(72);
        this.b(137);
        this.b(215);
    }

    // mov rsi,rdx.
    public void movRsiRdx() {
        this.b(72);
        this.b(137);
        this.b(214);
    }

    // rep movsb (copy rcx bytes from [rsi] to [rdi]).
    public void repMovsb() {
        this.b(243);
        this.b(164);
    }

    // mov [rdi],al.
    public void stoAlRdi() {
        this.b(136);
        this.b(7);
    }

    // inc rdi.
    public void incRdi() {
        this.b(72);
        this.b(255);
        this.b(199);
    }

    // inc rax.
    public void incAx() {
        this.b(72);
        this.b(255);
        this.b(192);
    }

    // dec rax.
    public void decAx() {
        this.b(72);
        this.b(255);
        this.b(200);
    }

    // dec rsi.
    public void decRsi() {
        this.b(72);
        this.b(255);
        this.b(206);
    }

    // mov byte [rdi],0 (NUL terminator).
    public void movNulRdi() {
        this.b(198);
        this.b(7);
        this.b(0);
    }

    // add al,imm8 (digit to ASCII).
    public void addAlImm(int v) {
        this.b(4);
        this.b(v & 0xFF);
    }

    // mov al,imm8.
    public void movAlImm(int v) {
        this.b(176);
        this.b(v & 0xFF);
    }

    // mov byte [rdx],imm8.
    public void movByteRdxImm(int v) {
        this.b(198);
        this.b(2);
        this.b(v & 0xFF);
    }

    // mov dword [rdx],imm32.
    public void stoDwordRdx(int64 v) {
        this.b(199);
        this.b(2);
        this.i32(v);
    }

    // mov dword [rdx+disp8],imm32.
    public void stoDwordRdxDisp8(int disp, int64 v) {
        this.b(199);
        this.b(66);
        this.b(disp & 0xFF);
        this.i32(v);
    }

    // mov word [rdx+disp8],imm16.
    public void movWordRdxDisp8(int disp, int v) {
        this.b(102);
        this.b(199);
        this.b(66);
        this.b(disp & 0xFF);
        this.b(v & 0xFF);
        this.b((v >> 8) & 0xFF);
    }

    // mov byte [rdx+disp8],imm8.
    public void movByteRdxDisp8(int disp, int v) {
        this.b(198);
        this.b(66);
        this.b(disp & 0xFF);
        this.b(v & 0xFF);
    }

    // cvttsd2si rax,xmm0 (truncate double -> int64). F2 (not F3) selects
    // double precision: F3 would convert only the low 32 bits as float.
    public void cvttXmm0ToAx() {
        this.b(242);
        this.b(72);
        this.b(15);
        this.b(44);
        this.b(192);
    }

    // mulsd xmm1,xmm2.
    public void mulXmm1Xmm2() {
        this.b(242);
        this.b(15);
        this.b(89);
        this.b(202);
    }

    // divsd xmm1,xmm2.
    public void divXmm1Xmm2() {
        this.b(242);
        this.b(15);
        this.b(94);
        this.b(202);
    }

    // addsd xmm0,xmm2.
    public void addXmm0Xmm2() {
        this.b(242);
        this.b(15);
        this.b(88);
        this.b(194);
    }

    // movq xmm0,rcx.
    public void movqXmm0Cx() {
        this.b(102);
        this.b(72);
        this.b(15);
        this.b(110);
        this.b(193);
    }

    // movq xmm0,rsi.
    public void movqXmm0Rsi() {
        this.b(102);
        this.b(72);
        this.b(15);
        this.b(110);
        this.b(198);
    }

    // movq xmm1,rsi.
    public void movqXmm1Rsi() {
        this.b(102);
        this.b(72);
        this.b(15);
        this.b(110);
        this.b(206);
    }

    // movq xmm1,rax (modrm C8: reg 001 = xmm1 dest, rm 000 = rax
    // source — distinct from movqXmm1Cx's C9, where rm 001 reads rcx).
    public void movqXmm1Ax() {
        this.b(102);
        this.b(72);
        this.b(15);
        this.b(110);
        this.b(200);
    }

    // movq xmm2,rsi.
    public void movqXmm2Rsi() {
        this.b(102);
        this.b(72);
        this.b(15);
        this.b(110);
        this.b(214);
    }

    // movq rax,xmm1.
    public void movqAxXmm1() {
        this.b(102);
        this.b(72);
        this.b(15);
        this.b(126);
        this.b(200);
    }

    // cmp rax,imm32 (sign-extended: small bounds like -4, 6, 1000000).
    public void cmpAxImm32(int v) {
        this.b(72);
        this.b(129);
        this.b(248);
        this.i32(int64(v));
    }

    // cmp rdx,imm32.
    public void cmpRdxImm32(int v) {
        this.b(72);
        this.b(129);
        this.b(250);
        this.i32(int64(v));
    }

    // cmp rsi,0.
    public void cmpRsi0() {
        this.b(72);
        this.b(131);
        this.b(254);
        this.b(0);
    }

    // sub rax,imm32.
    public void subAxImm32(int v) {
        this.b(72);
        this.b(45);
        this.i32(int64(v));
    }

    // sub rax,[rbp+disp].
    public void subAxSlot(int disp) {
        this.b(72);
        this.b(43);
        this.b(133);
        this.i32(int64(disp));
    }

    // sub rax,rsi.
    public void subAxRsi() {
        this.b(72);
        this.b(41);
        this.b(240);
    }

    // add rax,imm32.
    public void addAxImm32(int v) {
        this.b(72);
        this.b(5);
        this.i32(int64(v));
    }

    // sar rax,1 (arithmetic: halves negative exponents toward -inf).
    public void sarAx1() {
        this.b(72);
        this.b(209);
        this.b(248);
    }

    // sub rsp,imm8 (nested-call outgoing area inside a helper body).
    public void subRspImm8(int v) {
        this.b(72);
        this.b(131);
        this.b(236);
        this.b(v & 0xFF);
    }

    // add rsp,imm8.
    public void addRspImm8(int v) {
        this.b(72);
        this.b(131);
        this.b(196);
        this.b(v & 0xFF);
    }

    // mov rax,r8.
    public void movAxR8() {
        this.b(76);
        this.b(137);
        this.b(192);
    }

    // mov rax,rdx via push/pop (proven pair): the direct 89 D0 form is
    // byte-identical in intent but this path has never verified.
    public void movAxRdx() {
        this.b(82);
        this.b(88);
    }

    // mov rax,rsi.
    public void movAxRsi() {
        this.b(72);
        this.b(137);
        this.b(240);
    }

    // mov rax,rdi.
    public void movAxRdi() {
        this.b(72);
        this.b(137);
        this.b(248);
    }

    // mov rcx,rax.
    public void movRcxRax() {
        this.b(72);
        this.b(137);
        this.b(193);
    }

    // mov r8,rax (destination in rm, so REX.W+B = 73).
    public void movR8Ax() {
        this.b(73);
        this.b(137);
        this.b(192);
    }

    // sub rax,rcx.
    public void subAxRcx() {
        this.b(72);
        this.b(41);
        this.b(200);
    }

    // cmp rax,rsi.
    public void cmpAxRsi() {
        this.b(72);
        this.b(57);
        this.b(240);
    }

    // push rdx.
    public void pushRdx() {
        this.b(82);
    }

    // push rax (caller-side scalar save across the literal setup in
    // winLowerConcat: balanced by popR8 below before the helper call).
    public void pushAx() {
        this.b(80);
    }

    // pop rax.
    public void popRax() {
        this.b(88);
    }

    // pop r8 (restores a pushed scalar into the third helper register).
    public void popR8() {
        this.b(65);
        this.b(88);
    }

    // inc rcx.
    public void incRcx() {
        this.b(72);
        this.b(255);
        this.b(193);
    }

    // dec rcx.
    public void decRcx() {
        this.b(72);
        this.b(255);
        this.b(201);
    }

    // inc r8.
    public void incR8() {
        this.b(73);
        this.b(255);
        this.b(192);
    }

    // dec r8.
    public void decR8() {
        this.b(73);
        this.b(255);
        this.b(200);
    }

    // test r8,r8.
    public void testR8R8() {
        this.b(77);
        this.b(133);
        this.b(192);
    }

    // sub rsi,rdx.
    public void subRsiRdx() {
        this.b(72);
        this.b(41);
        this.b(214);
    }

    // mov al,[r8].
    public void movAlR8() {
        this.b(65);
        this.b(138);
        this.b(0);
    }
}

// Whole-program lowering context: deduplicated .rdata strings, function
// signatures with parameter/return kinds, and const values. Parameter kinds
// ride one letter per parameter (i/b/c) exactly like the tier predicate's
// context so the two agree on every signature. abi mirrors the emitter's
// (0 = Win64, 1 = SysV) and selects the import pairs the runner binds:
// msvcrt!printf + kernel32!ExitProcess on Windows, libc.so.6!printf +
// libc.so.6!exit on Linux (mirroring the silverc port's linuxImportLib /
// linuxImportName remap).
class WinCtx {
    public prop string[] strs;
    public prop int[] strOffs;
    public prop int strLen;
    public prop string[] fnNames;
    public prop string[] fnPKinds;
    public prop string[] fnRets;
    public prop string[] constNames;
    public prop int64[] constVals;
    public prop string[] constKinds;
    public prop bool usesPrintf;
    public prop bool usesExit;
    public prop int abi;
    // Concat/format scratch buffers in .rdata (the RWX image is writable at
    // runtime): bufAOff/bufFOff are their data offsets, blobTotal is the end
    // of the blob area — reserved before lowering so every later string
    // offset stays stable. Helper indices into fnNames (set at registration
    // so call sites and bodies agree).
    public prop int bufAOff;
    public prop int bufFOff;
    public prop int blobTotal;
    public prop int helperTimeNow;
    public prop int helperConcatSI;
    public prop int helperConcatSF;
    public prop int helperFmtF;

    construct {
        this.strs = [];
        this.strOffs = [];
        this.strLen = 0;
        this.fnNames = [];
        this.fnPKinds = [];
        this.fnRets = [];
        this.constNames = [];
        this.constVals = [];
        this.constKinds = [];
        this.usesPrintf = false;
        this.usesExit = false;
        this.abi = 0;
        this.bufAOff = 0;
        this.bufFOff = 0;
        this.blobTotal = 0;
        this.helperTimeNow = -1;
        this.helperConcatSI = -1;
        this.helperConcatSF = -1;
        this.helperFmtF = -1;
    }

    // Reserve the scratch blobs before any lowering: the 32KB concat area
    // plus the 64B float-format area, both zero-filled. Blobs come first in
    // .rdata, so later string offsets start past blobTotal and never move.
    public void reserveBlobs() {
        this.bufAOff = 0;
        this.bufFOff = 32768;
        this.blobTotal = 32832;
        this.strLen = 32832;
    }

    public string printfDll() {
        if (this.abi == 1) { return "libc.so.6"; }
        return "msvcrt.dll";
    }

    public string printfName() {
        return "printf";
    }

    public string exitDll() {
        if (this.abi == 1) { return "libc.so.6"; }
        return "kernel32.dll";
    }

    public string exitName() {
        if (this.abi == 1) { return "exit"; }
        return "ExitProcess";
    }

    // Offset of s in .rdata, appending (with NUL) on first sight.
    public int addStr(string s) {
        for (int i = 0; i < this.strs.length; i++) {
            if (this.strs[i] == s) { return this.strOffs[i]; }
        }
        int off = this.strLen;
        this.strs.add(s);
        this.strOffs.add(off);
        this.strLen = this.strLen + s.length + 1;
        return off;
    }

    public int findFn(string name) {
        for (int i = 0; i < this.fnNames.length; i++) {
            if (this.fnNames[i] == name) { return i; }
        }
        return -1;
    }

    public int findConst(string name) {
        for (int i = 0; i < this.constNames.length; i++) {
            if (this.constNames[i] == name) { return i; }
        }
        return -1;
    }
}

// Per-function lowering state: the emitter, the slot map (params first in
// order, then locals in encounter order — slot i lives at [rbp - 8*(i+1)]),
// loop label stacks for break/continue, and the pending relocations (sites
// are function-relative until concatenation rebases them).
class WinFn {
    public prop WinEmit e;
    public prop string fname;
    public prop string[] varNames;
    public prop string[] varKinds;
    // Literal spelling per local, parallel to varNames ("" when none): a
    // float local initialized from a float literal (or from another spelled
    // float local) remembers its source text, because the tree-walk prints
    // literal spellings verbatim while computed floats print with %g. Any
    // plain assignment clears the entry, so a spelling never outlives the
    // value it came from. Only "f" locals ever carry one.
    public prop string[] varSpells;
    public prop int epi;
    public prop int[] brkLabs;
    public prop int[] contLabs;
    public prop int[] rsites;
    public prop int[] rkinds;
    public prop int[] rtgts;
    public prop int[] ridx;
    public prop string[] rnames;

    construct {
        this.e = new WinEmit();
        this.fname = "";
        this.varNames = [];
        this.varKinds = [];
        this.varSpells = [];
        this.epi = -1;
        this.brkLabs = [];
        this.contLabs = [];
        this.rsites = [];
        this.rkinds = [];
        this.rtgts = [];
        this.ridx = [];
        this.rnames = [];
    }

    public void rel(int site, int kind, int tgt, int idx, string name) {
        this.rsites.add(site);
        this.rkinds.add(kind);
        this.rtgts.add(tgt);
        this.ridx.add(idx);
        this.rnames.add(name);
    }

    public int findVar(string name) {
        for (int i = 0; i < this.varNames.length; i++) {
            if (this.varNames[i] == name) { return i; }
        }
        return -1;
    }
}

// Lowered-function holder: lowering appends one WinFn per program function
// here (prop arrays on a passed object keep growing, unlike raw array
// parameters), and the unit builder concatenates them with rebased sites.
class WinProg {
    public prop WinFn[] fns;

    construct {
        this.fns = [];
    }
}

// Tier scalar letter for a declared type spelling, or "" outside the tier.
private string winScalarOf(string t) {
    if (t == "int") { return "i"; }
    if (t == "bool") { return "b"; }
    if (t == "char") { return "c"; }
    return "";
}

// True for the float64 type spellings (float, float64, double): the tier
// stores them as IEEE-754 bit patterns in 8-byte slots (scalar kind 4).
// Parameters and returns keep rejecting them (macScalarOf/winScalarOf stay
// narrow); only locals and expressions use this.
private bool tierFloatSpelling(string t) {
    if (t == "float") { return true; }
    if (t == "float64") { return true; }
    if (t == "double") { return true; }
    return false;
}

// Scalar kind of an expression: 0 int, 1 bool, 2 char. Mirrors the tier
// walker's type rules (literals, const/var/param reads, operators, calls)
// so print lowering picks the format the value actually has. Assignment
// carries its RHS kind (the value eval produces); the << form evaluates its
// RHS with no store, exactly like the interpreter.
private int winKindOf(WinCtx ctx, WinFn fn, Node e) {
    if (e.kind == ND_INT_LIT) { return 0; }
    if (e.kind == ND_BOOL_LIT) { return 1; }
    if (e.kind == ND_CHAR_LIT) { return 2; }
    if (e.kind == ND_FLOAT_LIT) { return 4; }
    if (e.kind == ND_STRING_LIT) { return 3; }
    if (e.kind == ND_IDENT) {
        int ci = ctx.findConst(e.name);
        if (ci >= 0) {
            string ck = ctx.constKinds[ci];
            if (ck == "b") { return 1; }
            if (ck == "c") { return 2; }
            return 0;
        }
        int vi = fn.findVar(e.name);
        if (vi >= 0) {
            string vk = fn.varKinds[vi];
            if (vk == "b") { return 1; }
            if (vk == "c") { return 2; }
            if (vk == "f") { return 4; }
            return 0;
        }
        return 0;
    }
    if (e.kind == ND_PAREN) {
        if (e.childCount() == 0) { return 0; }
        return winKindOf(ctx, fn, e.child(0));
    }
    if (e.kind == ND_UNARY) {
        if (e.childCount() == 0) { return 0; }
        if (e.op == UOP_NOT) { return 1; }
        return 0;
    }
    if (e.kind == ND_BINARY) {
        int op = e.op;
        if (op == OP_EQ || op == OP_NEQ || op == OP_LT || op == OP_LEQ || op == OP_GT || op == OP_GEQ || op == OP_AND || op == OP_OR) { return 1; }
        if (op == OP_MOVE) {
            if (e.childCount() < 2) { return 0; }
            return winKindOf(ctx, fn, e.child(1));
        }
        if ((op == OP_ASSIGN || op == OP_ADD_ASSIGN || op == OP_SUB_ASSIGN || op == OP_MUL_ASSIGN || op == OP_DIV_ASSIGN || op == OP_MOD_ASSIGN) && e.childCount() >= 2) {
            return winKindOf(ctx, fn, e.child(1));
        }
        if ((op == OP_ADD || op == OP_SUB || op == OP_MUL || op == OP_DIV || op == OP_MOD) && e.childCount() >= 2) {
            if (op == OP_ADD && winConcatShape(ctx, fn, e) > 0) { return 3; }
            if (winKindOf(ctx, fn, e.child(0)) == 4 || winKindOf(ctx, fn, e.child(1)) == 4) { return 4; }
        }
        return 0;
    }
    if (e.kind == ND_CALL) {
        int si = ctx.findFn(e.name);
        if (si >= 0) {
            string ret = ctx.fnRets[si];
            if (ret == "b") { return 1; }
            if (ret == "c") { return 2; }
            if (ret == "f") { return 4; }
        }
        return 0;
    }
    if (e.kind == ND_METHOD_CALL) {
        if (winIsTimeNow(ctx, fn, e)) { return 4; }
        return 0;
    }
    return 0;
}

// True for the admittable time.now() clock read (zero-argument call on the
// time module with no program-local `time` shadowing it). Shared by the
// kind query and the lowering so they can never disagree.
private bool winIsTimeNow(WinCtx ctx, WinFn fn, Node e) {
    if (e.name != "now" || e.childCount() != 1) { return false; }
    Node recv = e.child(0);
    if (recv.kind != ND_IDENT || recv.name != "time") { return false; }
    if (fn.findVar("time") >= 0) { return false; }
    if (ctx.findConst("time") >= 0) { return false; }
    return true;
}

// Concat shape of an addition: 0 = not an admittable concat, 1 =
// literal+int, 2 = literal+float64, 3 = literal+literal (folded).
// Mirrors macWalkConcat exactly (literal on the left only), so the kind
// query, the predicate, and the lowering all agree.
private int winConcatShape(WinCtx ctx, WinFn fn, Node e) {
    if (e.op != OP_ADD || e.childCount() < 2) { return 0; }
    if (!tierIsStringLit(e.child(0))) { return 0; }
    if (tierIsStringLit(e.child(1))) { return 3; }
    int rk = winKindOf(ctx, fn, e.child(1));
    if (rk == 0) { return 1; }
    if (rk == 4) { return 2; }
    return 0;
}

// True when every character of s survives a printf %s round trip unchanged:
// printable ASCII only (NUL would truncate, high bytes depend on encoding).
private bool winStrNative(string s) {
    if (s.length == 0) { return true; }
    for (int i = 0; i < s.length; i++) {
        int64 c = int64(s[i]);
        if (c < 1 || c > 127) { return false; }
    }
    return true;
}

// Lower one print/printline call (already validated by the tier predicate:
// exactly one argument, statement position). Literal-safe formats only, so
// native output matches the verified tiers byte for byte.
private string winLowerPrint(WinCtx ctx, WinFn fn, Node call, bool newline) {
    Node arg = call.child(0);
    Node t = arg;
    // First two argument registers for the context ABI (RCX/RDX on Win64,
    // RDI/RSI on SysV); the call sequence below is otherwise identical.
    int r0 = 1;
    int r1 = 2;
    if (ctx.abi == 1) {
        r0 = 7;
        r1 = 6;
    }
    while (t.kind == ND_PAREN && t.childCount() > 0) { t = t.child(0); }
    if (t.kind == ND_STRING_LIT) {
        string lit = t.strVal;
        if (!winStrNative(lit)) { return "unicode string literal in '" + fn.fname + "'"; }
        string fmt = "%s";
        if (newline) { fmt = "%s\n"; }
        int fmtOff = ctx.addStr(fmt);
        int strOff = ctx.addStr(lit);
        ctx.usesPrintf = true;
        fn.e.callSetup(2);
        int hole = fn.e.absData(r0, fmtOff);
        fn.rel(hole, 1, 2, fmtOff, "");
        hole = fn.e.absData(r1, strOff);
        fn.rel(hole, 1, 2, strOff, "");
        fn.e.b(176);
        fn.e.b(0);
        hole = fn.e.callHole();
        fn.rel(hole, 0, 4, 0, "");
        fn.e.callTeardown();
        return "";
    }
    if (t.kind == ND_FLOAT_LIT) {
        // Direct float literal: the tree-walk keeps the source spelling
        // (makeFloatStr), so print it verbatim like a string literal.
        string spell = t.strVal;
        if (!winStrNative(spell)) { return "unicode string literal in '" + fn.fname + "'"; }
        string sfmt = "%s";
        if (newline) { sfmt = "%s\n"; }
        int sfmtOff = ctx.addStr(sfmt);
        int sstrOff = ctx.addStr(spell);
        ctx.usesPrintf = true;
        fn.e.callSetup(2);
        int shole = fn.e.absData(r0, sfmtOff);
        fn.rel(shole, 1, 2, sfmtOff, "");
        shole = fn.e.absData(r1, sstrOff);
        fn.rel(shole, 1, 2, sstrOff, "");
        fn.e.b(176);
        fn.e.b(0);
        shole = fn.e.callHole();
        fn.rel(shole, 0, 4, 0, "");
        fn.e.callTeardown();
        return "";
    }
    int kind = winKindOf(ctx, fn, arg);
    if (kind == 3) {
        // Runtime string (an admittable concat): the pointer rides the
        // second argument register into %s, exactly like a literal.
        string cerr = winLowerExpr(ctx, fn, arg);
        if (cerr.length > 0) { return cerr; }
        ctx.usesPrintf = true;
        string cfmt = "%s";
        if (newline) { cfmt = "%s\n"; }
        int cfmtOff = ctx.addStr(cfmt);
        fn.e.callSetup(2);
        int chole = fn.e.absData(r0, cfmtOff);
        fn.rel(chole, 1, 2, cfmtOff, "");
        fn.e.movFromAx(r1);
        fn.e.b(176);
        fn.e.b(0);
        chole = fn.e.callHole();
        fn.rel(chole, 0, 4, 0, "");
        fn.e.callTeardown();
        return "";
    }
    if (kind == 4) {
        // A spelled float local still holds its literal text: print it
        // verbatim, exactly like the tree-walk's carried strVal. Computed
        // floats (no spelling) format through __slv_fmtF below.
        string vspell = winVarSpell(fn, arg);
        if (vspell.length > 0) {
            if (!winStrNative(vspell)) { return "unicode string literal in '" + fn.fname + "'"; }
            string vfmt = "%s";
            if (newline) { vfmt = "%s\n"; }
            int vfmtOff = ctx.addStr(vfmt);
            int vstrOff = ctx.addStr(vspell);
            ctx.usesPrintf = true;
            fn.e.callSetup(2);
            int vhole = fn.e.absData(r0, vfmtOff);
            fn.rel(vhole, 1, 2, vfmtOff, "");
            vhole = fn.e.absData(r1, vstrOff);
            fn.rel(vhole, 1, 2, vstrOff, "");
            fn.e.b(176);
            fn.e.b(0);
            vhole = fn.e.callHole();
            fn.rel(vhole, 0, 4, 0, "");
            fn.e.callTeardown();
            return "";
        }
        // Float64: format through __slv_fmtF into the float buffer (fixed
        // rcx/rdx — the helper convention), then print the buffer like a
        // literal string.
        string ferr = winLowerExpr(ctx, fn, arg);
        if (ferr.length > 0) { return ferr; }
        if (ctx.helperFmtF < 0) { return "float print in '" + fn.fname + "'"; }
        ctx.usesPrintf = true;
        fn.e.callSetup(2);
        fn.e.movFromAx(1);
        int fbuf = fn.e.absData(2, ctx.bufFOff);
        fn.rel(fbuf, 1, 2, ctx.bufFOff, "");
        int fhole = fn.e.callHole();
        fn.rel(fhole, 0, 0, ctx.helperFmtF, "");
        fn.e.callTeardown();
        string ffmt = "%s";
        if (newline) { ffmt = "%s\n"; }
        int ffmtOff = ctx.addStr(ffmt);
        fn.e.callSetup(2);
        int phole = fn.e.absData(r0, ffmtOff);
        fn.rel(phole, 1, 2, ffmtOff, "");
        int pbuf = fn.e.absData(r1, ctx.bufFOff);
        fn.rel(pbuf, 1, 2, ctx.bufFOff, "");
        fn.e.b(176);
        fn.e.b(0);
        pbuf = fn.e.callHole();
        fn.rel(pbuf, 0, 4, 0, "");
        fn.e.callTeardown();
        return "";
    }
    string err = winLowerExpr(ctx, fn, arg);
    if (err.length > 0) { return err; }
    ctx.usesPrintf = true;
    if (kind == 2) {
        string fmt = "%c";
        if (newline) { fmt = "%c\n"; }
        int fmtOff = ctx.addStr(fmt);
        fn.e.callSetup(2);
        int hole = fn.e.absData(r0, fmtOff);
        fn.rel(hole, 1, 2, fmtOff, "");
        fn.e.movFromAx(r1);
        fn.e.b(176);
        fn.e.b(0);
        hole = fn.e.callHole();
        fn.rel(hole, 0, 4, 0, "");
        fn.e.callTeardown();
        return "";
    }
    string fmtI = "%lld";
    if (newline) { fmtI = "%lld\n"; }
    int fmtIOff = ctx.addStr(fmtI);
    fn.e.callSetup(2);
    int holeI = fn.e.absData(r0, fmtIOff);
    fn.rel(holeI, 1, 2, fmtIOff, "");
    fn.e.movFromAx(r1);
    fn.e.b(176);
    fn.e.b(0);
    holeI = fn.e.callHole();
    fn.rel(holeI, 0, 4, 0, "");
    fn.e.callTeardown();
    return "";
}

// The guarded divide/modulo trap: printf the reference text, then exit(1)
// through the real import (noreturn, so no teardown — the process is gone,
// exactly like the compiled binary on a fault).
private void winEmitTrap(WinCtx ctx, WinFn fn) {
    int ueOff = ctx.addStr("Unhandled exception\n");
    ctx.usesPrintf = true;
    ctx.usesExit = true;
    fn.e.callSetup(1);
    int hole = fn.e.absData(fn.e.argReg(0), ueOff);
    fn.rel(hole, 1, 2, ueOff, "");
    fn.e.b(176);
    fn.e.b(0);
    hole = fn.e.callHole();
    fn.rel(hole, 0, 4, 0, "");
    fn.e.callTeardown();
    // exit(1): the value rides the first argument register (ECX on Win64,
    // EDI on SysV).
    if (ctx.abi == 1) { fn.e.b(191); }
    else { fn.e.b(185); }
    fn.e.i32(1);
    fn.e.callSetup(1);
    hole = fn.e.callHole();
    fn.rel(hole, 0, 4, 1, "");
}

// Lower an admittable string concat (shape from winConcatShape), leaving
// the NUL-terminated buffer pointer in RAX. Literal+literal folds to one
// interned literal; literal+scalar calls the matching helper with the
// helper register convention (rcx = literal address, rdx = literal length,
// r8 = scalar value or float64 bits) and the buffer address back in RAX.
private string winLowerConcat(WinCtx ctx, WinFn fn, Node e, int shape) {
    string cur = fn.fname;
    if (shape == 3) {
        string folded = tierStringLitText(e.child(0)) + tierStringLitText(e.child(1));
        if (!winStrNative(folded)) { return "unicode string literal in '" + cur + "'"; }
        int off = ctx.addStr(folded);
        int hole = fn.e.absData(0, off);
        fn.rel(hole, 1, 2, off, "");
        return "";
    }
    if (shape != 1 && shape != 2) {
        return "string values in '" + cur + "'";
    }
    string lit = tierStringLitText(e.child(0));
    if (!winStrNative(lit)) { return "unicode string literal in '" + cur + "'"; }
    if (shape == 2) {
        // Spelled float operand (a literal or a local still holding literal
        // text): fold verbatim, exactly like the tree-walk's carried strVal.
        string fspell = tierFloatLitText(e.child(1));
        if (fspell.length == 0) { fspell = winVarSpell(fn, e.child(1)); }
        if (fspell.length > 0) {
            string folded = lit + fspell;
            if (!winStrNative(folded)) { return "unicode string literal in '" + cur + "'"; }
            int foff = ctx.addStr(folded);
            int fhole = fn.e.absData(0, foff);
            fn.rel(fhole, 1, 2, foff, "");
            return "";
        }
    }
    // Scalar first, saved across the literal setup: evaluating the operand
    // may itself call (clobbering rcx/rdx), so its value rides the stack
    // into r8 after the addresses are in place.
    fn.e.callSetup(3);
    string serr = winLowerExpr(ctx, fn, e.child(1));
    if (serr.length > 0) { return serr; }
    fn.e.pushAx();
    int litOff = ctx.addStr(lit);
    int addrHole = fn.e.absData(1, litOff);
    fn.rel(addrHole, 1, 2, litOff, "");
    fn.e.movAbsAny(2, int64(lit.length));
    fn.e.popR8();
    int idx = ctx.helperConcatSI;
    if (shape == 2) { idx = ctx.helperConcatSF; }
    if (idx < 0) { return "string values in '" + cur + "'"; }
    int hole = fn.e.callHole();
    fn.rel(hole, 0, 0, idx, "");
    fn.e.callTeardown();
    return "";
}
// Lower an explicit exit call (already validated by the tier predicate:
// statement position, zero or one integer argument). The code rides the
// first argument register into the ExitProcess import and never returns,
// so no teardown — the process is gone, exactly like the trap above and
// the tree-walk exit builtin.
//
// Import reference: ridx -1 is the exit-import sentinel, mapped to the real
// import-list position at unit finalization (1 when printf is also used, 0
// otherwise) — unlike the trap's hardcoded 1, an explicit exit may be the
// only import a program needs.
private string winLowerExit(WinCtx ctx, WinFn fn, Node e) {
    ctx.usesExit = true;
    if (e.childCount() == 0) {
        if (ctx.abi == 1) { fn.e.b(191); }
        else { fn.e.b(185); }
        fn.e.i32(0);
    } else {
        string err = winLowerExpr(ctx, fn, e.child(0));
        if (err.length > 0) { return err; }
        fn.e.movFromAx(fn.e.argReg(0));
    }
    fn.e.callSetup(1);
    int hole = fn.e.callHole();
    fn.rel(hole, 0, 4, -1, "");
    return "";
}

// Lower an expression, leaving its 64-bit value in RAX. Stack-neutral:
// every push is popped before returning (call sequences restore rsp
// absolutely, so nested calls compose).
private string winLowerExpr(WinCtx ctx, WinFn fn, Node e) {
    if (e.kind == ND_INT_LIT) {
        fn.e.movAbs(0, e.intVal);
        return "";
    }
    if (e.kind == ND_BOOL_LIT) {
        if (e.boolVal) { fn.e.movAbs(0, 1); }
        else {
            fn.e.b(49);
            fn.e.b(192);
        }
        return "";
    }
    if (e.kind == ND_CHAR_LIT) {
        int cv = e.charVal;
        fn.e.movAbs(0, int64(cv));
        return "";
    }
    if (e.kind == ND_FLOAT_LIT) {
        fn.e.movAbs(0, icFloatBitsOf(e.strVal));
        return "";
    }
    if (e.kind == ND_STRING_LIT) {
        return "string values in '" + fn.fname + "'";
    }
    if (e.kind == ND_IDENT) {
        int ci = ctx.findConst(e.name);
        if (ci >= 0) {
            fn.e.movAbs(0, ctx.constVals[ci]);
            return "";
        }
        int vi = fn.findVar(e.name);
        if (vi < 0) { return "unknown variable '" + e.name + "'"; }
        fn.e.b(72);
        fn.e.b(139);
        fn.e.b(133);
        fn.e.i32(int64(-8 * (vi + 1)));
        return "";
    }
    if (e.kind == ND_PAREN) {
        if (e.childCount() == 0) { return "unsupported expression"; }
        return winLowerExpr(ctx, fn, e.child(0));
    }
    if (e.kind == ND_UNARY) {
        if (e.childCount() == 0) { return "unsupported expression"; }
        string err = winLowerExpr(ctx, fn, e.child(0));
        if (err.length > 0) { return err; }
        if (winKindOf(ctx, fn, e.child(0)) == 4) {
            if (e.op == UOP_NEG) { return "unsupported float operation in '" + fn.fname + "'"; }
            if (e.op == UOP_NOT) { return "float logic operands in '" + fn.fname + "'"; }
        }
        if (e.op == UOP_NEG) {
            fn.e.b(72);
            fn.e.b(247);
            fn.e.b(216);
            return "";
        }
        if (e.op == UOP_NOT) {
            fn.e.b(72);
            fn.e.b(133);
            fn.e.b(192);
            fn.e.b(15);
            fn.e.b(148);
            fn.e.b(192);
            fn.e.b(72);
            fn.e.b(15);
            fn.e.b(182);
            fn.e.b(192);
            return "";
        }
        return "unsupported unary operator";
    }
    if (e.kind == ND_BINARY) {
        return winLowerBinary(ctx, fn, e);
    }
    if (e.kind == ND_CALL) {
        if (e.name == "print" || e.name == "printline") {
            return "print used as a value in '" + fn.fname + "'";
        }
        if (e.name == "exit") {
            return "explicit 'exit' calls in '" + fn.fname + "'";
        }
        if (e.name == "printf") {
            return "explicit 'printf' calls in '" + fn.fname + "'";
        }
        return winLowerCall(ctx, fn, e);
    }
    if (e.kind == ND_METHOD_CALL) {
        if (winIsTimeNow(ctx, fn, e)) {
            Node callN = new Node(ND_CALL, e.line, e.col);
            callN.name = "__slv_timeNow";
            return winLowerCall(ctx, fn, callN);
        }
        return "method calls in '" + fn.fname + "'";
    }
    return "unsupported expression in '" + fn.fname + "'";
}

// Binary operators. Arithmetic and comparisons evaluate lhs, push, evaluate
// rhs, pop — the reference stack-machine shape. Division and modulo go
// through the guarded sequence (zero divisor and INT64_MIN / -1 trap).
private string winLowerFloatArith(WinCtx ctx, WinFn fn, Node e) {
    string cur = fn.fname;
    int op = e.op;
    if (op != OP_ADD && op != OP_SUB && op != OP_MUL && op != OP_DIV) {
        return "unsupported float operation in '" + cur + "'";
    }
    if (e.childCount() < 2) { return "unsupported expression in '" + cur + "'"; }
    if (winKindOf(ctx, fn, e.child(0)) != 4 || winKindOf(ctx, fn, e.child(1)) != 4) {
        return "mixed int and float operands in '" + cur + "'";
    }
    string err = winLowerExpr(ctx, fn, e.child(0));
    if (err.length > 0) { return err; }
    fn.e.b(80);
    err = winLowerExpr(ctx, fn, e.child(1));
    if (err.length > 0) { return err; }
    fn.e.b(72);
    fn.e.b(137);
    fn.e.b(193);
    fn.e.b(88);
    fn.e.movqXmm0Ax();
    fn.e.movqXmm1Cx();
    if (op == OP_ADD) { fn.e.addXmm0Xmm1(); }
    else if (op == OP_SUB) { fn.e.subXmm0Xmm1(); }
    else if (op == OP_MUL) { fn.e.mulXmm0Xmm1(); }
    else { fn.e.divXmm0Xmm1(); }
    fn.e.movqAxXmm0();
    return "";
}

// Float64 comparisons: same stack shape, then comisd with JP-first guards
// so unordered (NaN) pairs report false for every operator except != —
// exactly like the tree-walk valueToFloat comparisons.
private string winLowerFloatCmp(WinCtx ctx, WinFn fn, Node e) {
    string cur = fn.fname;
    int op = e.op;
    if (e.childCount() < 2) { return "unsupported expression in '" + cur + "'"; }
    if (winKindOf(ctx, fn, e.child(0)) != 4 || winKindOf(ctx, fn, e.child(1)) != 4) {
        return "mixed int and float operands in '" + cur + "'";
    }
    string err = winLowerExpr(ctx, fn, e.child(0));
    if (err.length > 0) { return err; }
    fn.e.b(80);
    err = winLowerExpr(ctx, fn, e.child(1));
    if (err.length > 0) { return err; }
    fn.e.b(72);
    fn.e.b(137);
    fn.e.b(193);
    fn.e.b(88);
    fn.e.movqXmm0Ax();
    fn.e.movqXmm1Cx();
    fn.e.comisdXmm0Xmm1();
    int trueLab = fn.e.lab();
    int endLab = fn.e.lab();
    if (op == OP_EQ) {
        fn.e.jcc(138, endLab);
        fn.e.jcc(132, trueLab);
    } else if (op == OP_NEQ) {
        fn.e.jcc(138, trueLab);
        fn.e.jcc(133, trueLab);
    } else if (op == OP_LT) {
        fn.e.jcc(138, endLab);
        fn.e.jcc(130, trueLab);
    } else if (op == OP_LEQ) {
        fn.e.jcc(138, endLab);
        fn.e.jcc(134, trueLab);
    } else if (op == OP_GT) {
        fn.e.jcc(138, endLab);
        fn.e.jcc(135, trueLab);
    } else if (op == OP_GEQ) {
        fn.e.jcc(138, endLab);
        fn.e.jcc(131, trueLab);
    } else {
        return "unsupported binary operator in '" + cur + "'";
    }
    fn.e.b(49);
    fn.e.b(192);
    fn.e.jmp(endLab);
    fn.e.bind(trueLab);
    fn.e.movAbs(0, 1);
    fn.e.bind(endLab);
    return "";
}
private string winLowerBinary(WinCtx ctx, WinFn fn, Node e) {
    int op = e.op;
    string cur = fn.fname;
    if (op == OP_ADD || op == OP_SUB || op == OP_MUL) {
        if (e.childCount() < 2) { return "unsupported expression in '" + cur + "'"; }
        int shape = winConcatShape(ctx, fn, e);
        if (shape > 0) {
            return winLowerConcat(ctx, fn, e, shape);
        }
        if (winKindOf(ctx, fn, e.child(0)) == 4 || winKindOf(ctx, fn, e.child(1)) == 4) {
            return winLowerFloatArith(ctx, fn, e);
        }
        string err = winLowerExpr(ctx, fn, e.child(0));
        if (err.length > 0) { return err; }
        fn.e.b(80);
        err = winLowerExpr(ctx, fn, e.child(1));
        if (err.length > 0) { return err; }
        fn.e.b(72);
        fn.e.b(137);
        fn.e.b(193);
        fn.e.b(88);
        if (op == OP_ADD) {
            fn.e.b(72);
            fn.e.b(1);
            fn.e.b(200);
        } else if (op == OP_SUB) {
            fn.e.b(72);
            fn.e.b(41);
            fn.e.b(200);
        } else {
            fn.e.b(72);
            fn.e.b(15);
            fn.e.b(175);
            fn.e.b(193);
        }
        return "";
    }
    if (op == OP_DIV || op == OP_MOD) {
        if (e.childCount() < 2) { return "unsupported expression in '" + cur + "'"; }
        if (winKindOf(ctx, fn, e.child(0)) == 4 || winKindOf(ctx, fn, e.child(1)) == 4) {
            return winLowerFloatArith(ctx, fn, e);
        }
        string err = winLowerExpr(ctx, fn, e.child(0));
        if (err.length > 0) { return err; }
        fn.e.b(80);
        err = winLowerExpr(ctx, fn, e.child(1));
        if (err.length > 0) { return err; }
        fn.e.b(72);
        fn.e.b(137);
        fn.e.b(193);
        fn.e.b(88);
        fn.e.b(72);
        fn.e.b(129);
        fn.e.b(249);
        fn.e.i32(0);
        int okDiv = fn.e.lab();
        fn.e.jcc(133, okDiv);
        winEmitTrap(ctx, fn);
        fn.e.bind(okDiv);
        // INT64_MIN without a negated-literal subtraction: the bootstrap
        // folds -9223372036854775807 - 1 to MIN + 2 (probed), while the
        // 0-based spelling folds exactly.
        int64 intMin = 0 - 9223372036854775807 - 1;
        fn.e.movAbs(2, intMin);
        fn.e.b(72);
        fn.e.b(57);
        fn.e.b(194);
        int okOv = fn.e.lab();
        fn.e.jcc(133, okOv);
        fn.e.b(72);
        fn.e.b(129);
        fn.e.b(249);
        fn.e.i32(-1);
        fn.e.jcc(133, okOv);
        winEmitTrap(ctx, fn);
        fn.e.bind(okOv);
        fn.e.b(72);
        fn.e.b(153);
        fn.e.b(72);
        fn.e.b(247);
        fn.e.b(249);
        if (op == OP_MOD) {
            fn.e.b(72);
            fn.e.b(137);
            fn.e.b(208);
        }
        return "";
    }
    if (op == OP_EQ || op == OP_NEQ || op == OP_LT || op == OP_LEQ || op == OP_GT || op == OP_GEQ) {
        if (e.childCount() < 2) { return "unsupported expression in '" + cur + "'"; }
        if (winKindOf(ctx, fn, e.child(0)) == 4 || winKindOf(ctx, fn, e.child(1)) == 4) {
            return winLowerFloatCmp(ctx, fn, e);
        }
        string err = winLowerExpr(ctx, fn, e.child(0));
        if (err.length > 0) { return err; }
        fn.e.b(80);
        err = winLowerExpr(ctx, fn, e.child(1));
        if (err.length > 0) { return err; }
        fn.e.b(72);
        fn.e.b(137);
        fn.e.b(193);
        fn.e.b(88);
        fn.e.b(72);
        fn.e.b(57);
        fn.e.b(200);
        int trueLab = fn.e.lab();
        int endLab = fn.e.lab();
        if (op == OP_EQ) { fn.e.jcc(132, trueLab); }
        else if (op == OP_NEQ) { fn.e.jcc(133, trueLab); }
        else if (op == OP_LT) { fn.e.jcc(140, trueLab); }
        else if (op == OP_LEQ) { fn.e.jcc(142, trueLab); }
        else if (op == OP_GT) { fn.e.jcc(143, trueLab); }
        else { fn.e.jcc(141, trueLab); }
        fn.e.b(49);
        fn.e.b(192);
        fn.e.jmp(endLab);
        fn.e.bind(trueLab);
        fn.e.movAbs(0, 1);
        fn.e.bind(endLab);
        return "";
    }
    if (op == OP_AND || op == OP_OR) {
        if (e.childCount() < 2) { return "unsupported expression in '" + cur + "'"; }
        if (winKindOf(ctx, fn, e.child(0)) == 4 || winKindOf(ctx, fn, e.child(1)) == 4) {
            return "float logic operands in '" + cur + "'";
        }
        string err = winLowerExpr(ctx, fn, e.child(0));
        if (err.length > 0) { return err; }
        fn.e.b(72);
        fn.e.b(133);
        fn.e.b(192);
        int falseLab = fn.e.lab();
        int endLab = fn.e.lab();
        if (op == OP_AND) { fn.e.jcc(132, falseLab); }
        else { fn.e.jcc(133, endLab); }
        err = winLowerExpr(ctx, fn, e.child(1));
        if (err.length > 0) { return err; }
        fn.e.b(72);
        fn.e.b(133);
        fn.e.b(192);
        fn.e.jcc(132, falseLab);
        fn.e.jmp(endLab);
        fn.e.bind(falseLab);
        fn.e.b(49);
        fn.e.b(192);
        fn.e.bind(endLab);
        return "";
    }
    if (op == OP_ASSIGN || op == OP_ADD_ASSIGN || op == OP_SUB_ASSIGN || op == OP_MUL_ASSIGN) {
        if (e.childCount() < 2) { return "unsupported expression in '" + cur + "'"; }
        Node t = e.child(0);
        if (t.kind != ND_IDENT) { return "complex assignment targets in '" + cur + "'"; }
        int vi = fn.findVar(t.name);
        if (vi < 0) { return "unknown variable '" + t.name + "' in '" + cur + "'"; }
        if (op != OP_ASSIGN && (fn.varKinds[vi] == "f" || winKindOf(ctx, fn, e.child(1)) == 4)) { return "unsupported float operation in '" + cur + "'"; }
        if (op == OP_ASSIGN) {
            string err = winLowerExpr(ctx, fn, e.child(1));
            if (err.length > 0) { return err; }
            fn.e.b(72);
            fn.e.b(137);
            fn.e.b(133);
            fn.e.i32(int64(-8 * (vi + 1)));
            // The stored value is no longer the declaration text (if it ever
            // was): drop any literal spelling so later prints use %g.
            fn.varSpells[vi] = "";
            return "";
        }
        fn.e.b(72);
        fn.e.b(139);
        fn.e.b(133);
        fn.e.i32(int64(-8 * (vi + 1)));
        fn.e.b(80);
        string err2 = winLowerExpr(ctx, fn, e.child(1));
        if (err2.length > 0) { return err2; }
        fn.e.b(72);
        fn.e.b(137);
        fn.e.b(193);
        fn.e.b(88);
        if (op == OP_ADD_ASSIGN) {
            fn.e.b(72);
            fn.e.b(1);
            fn.e.b(200);
        } else if (op == OP_SUB_ASSIGN) {
            fn.e.b(72);
            fn.e.b(41);
            fn.e.b(200);
        } else if (op == OP_MUL_ASSIGN) {
            fn.e.b(72);
            fn.e.b(15);
            fn.e.b(175);
            fn.e.b(193);
        } else {
            return "unsupported binary operator in '" + cur + "'";
        }
        fn.e.b(72);
        fn.e.b(137);
        fn.e.b(133);
        fn.e.i32(int64(-8 * (vi + 1)));
        return "";
    }
    if (op == OP_DIV_ASSIGN || op == OP_MOD_ASSIGN) {
        if (e.childCount() < 2) { return "unsupported expression in '" + cur + "'"; }
        Node t = e.child(0);
        if (t.kind != ND_IDENT) { return "complex assignment targets in '" + cur + "'"; }
        int vi = fn.findVar(t.name);
        if (vi < 0) { return "unknown variable '" + t.name + "' in '" + cur + "'"; }
        if (fn.varKinds[vi] == "f" || winKindOf(ctx, fn, e.child(1)) == 4) { return "unsupported float operation in '" + cur + "'"; }
        fn.e.b(72);
        fn.e.b(139);
        fn.e.b(133);
        fn.e.i32(int64(-8 * (vi + 1)));
        fn.e.b(80);
        string err = winLowerExpr(ctx, fn, e.child(1));
        if (err.length > 0) { return err; }
        fn.e.b(72);
        fn.e.b(137);
        fn.e.b(193);
        fn.e.b(88);
        fn.e.b(72);
        fn.e.b(129);
        fn.e.b(249);
        fn.e.i32(0);
        int okDiv = fn.e.lab();
        fn.e.jcc(133, okDiv);
        winEmitTrap(ctx, fn);
        fn.e.bind(okDiv);
        int64 intMinA = 0 - 9223372036854775807 - 1;
        fn.e.movAbs(2, intMinA);
        fn.e.b(72);
        fn.e.b(57);
        fn.e.b(194);
        int okOv = fn.e.lab();
        fn.e.jcc(133, okOv);
        fn.e.b(72);
        fn.e.b(129);
        fn.e.b(249);
        fn.e.i32(-1);
        fn.e.jcc(133, okOv);
        winEmitTrap(ctx, fn);
        fn.e.bind(okOv);
        fn.e.b(72);
        fn.e.b(153);
        fn.e.b(72);
        fn.e.b(247);
        fn.e.b(249);
        if (op == OP_MOD_ASSIGN) {
            fn.e.b(72);
            fn.e.b(137);
            fn.e.b(208);
        }
        fn.e.b(72);
        fn.e.b(137);
        fn.e.b(133);
        fn.e.i32(int64(-8 * (vi + 1)));
        return "";
    }
    if (op == OP_MOVE) {
        if (e.childCount() < 2) { return "unsupported expression in '" + cur + "'"; }
        return winLowerExpr(ctx, fn, e.child(1));
    }
    return "unsupported binary operator in '" + cur + "'";
}

// Lower a call to a program-defined function (exact arity checked by the
// tier predicate). Arguments evaluate left to right into the outgoing area,
// then load into RCX/RDX/R8/R9 (+ stack slots), call, teardown. RAX carries
// the result; statement-position callers discard it.
private string winLowerCall(WinCtx ctx, WinFn fn, Node e) {
    string cur = fn.fname;
    int si = ctx.findFn(e.name);
    if (si < 0) { return "call to unknown function '" + e.name + "' in '" + cur + "'"; }
    string pks = ctx.fnPKinds[si];
    if (e.childCount() != pks.length) { return "arity mismatch calling '" + e.name + "' in '" + cur + "'"; }
    int nargs = e.childCount();
    // SysV outgoing area: stack arguments first at [rsp+8k], then the
    // register-argument homes above them (no shadow space). The reserve
    // carries the +8 slack, so the homes never reach the pushed-R13 slot.
    if (ctx.abi == 1) {
        int nstack = 0;
        if (nargs > 6) { nstack = nargs - 6; }
        fn.e.callSetup(nargs);
        for (int i = 0; i < nargs; i++) {
            string argErr = winLowerExpr(ctx, fn, e.child(i));
            if (argErr.length > 0) { return argErr; }
            if (i < 6) { fn.e.spillRsp(8 * nstack + 8 * i); }
            else { fn.e.spillRsp(8 * (i - 6)); }
        }
        int nreg = nargs;
        if (nreg > 6) { nreg = 6; }
        for (int r = 0; r < nreg; r++) {
            fn.e.fillRspReg(fn.e.argReg(r), 8 * nstack + 8 * r);
        }
        int sysHole = fn.e.callHole();
        fn.rel(sysHole, 0, 0, si, "");
        fn.e.callTeardown();
        return "";
    }
    int nstack = 0;
    if (nargs > 4) { nstack = nargs - 4; }
    fn.e.callSetup(nargs);
    for (int i = 0; i < nargs; i++) {
        string err = winLowerExpr(ctx, fn, e.child(i));
        if (err.length > 0) { return err; }
        if (i < 4) {
            fn.e.b(72);
            fn.e.b(137);
            fn.e.b(132);
            fn.e.b(36);
            fn.e.i32(int64(32 + 8 * nstack + 8 * i));
        } else {
            fn.e.b(72);
            fn.e.b(137);
            fn.e.b(132);
            fn.e.b(36);
            fn.e.i32(int64(32 + 8 * (i - 4)));
        }
    }
    if (nargs > 0) {
        fn.e.b(72);
        fn.e.b(139);
        fn.e.b(140);
        fn.e.b(36);
        fn.e.i32(int64(32 + 8 * nstack));
    }
    if (nargs > 1) {
        fn.e.b(72);
        fn.e.b(139);
        fn.e.b(148);
        fn.e.b(36);
        fn.e.i32(int64(32 + 8 * nstack + 8));
    }
    if (nargs > 2) {
        fn.e.b(76);
        fn.e.b(139);
        fn.e.b(132);
        fn.e.b(36);
        fn.e.i32(int64(32 + 8 * nstack + 16));
    }
    if (nargs > 3) {
        fn.e.b(76);
        fn.e.b(139);
        fn.e.b(140);
        fn.e.b(36);
        fn.e.i32(int64(32 + 8 * nstack + 24));
    }
    int hole = fn.e.callHole();
    fn.rel(hole, 0, 0, si, "");
    fn.e.callTeardown();
    return "";
}

// Lower one statement. Value-producing positions (return) leave RAX set;
// statement calls and prints are stack-neutral.
private string winLowerStmt(WinCtx ctx, WinFn fn, Node s) {
    string cur = fn.fname;
    if (s.kind == ND_EXPR_STMT) {
        if (s.childCount() > 0) {
            Node inner = s.child(0);
            if (inner.kind == ND_CALL && (inner.name == "print" || inner.name == "printline")) {
                bool nl = inner.name == "printline";
                if (inner.childCount() != 1) { return "multi-argument print in '" + cur + "'"; }
                return winLowerPrint(ctx, fn, inner, nl);
            }
            return winLowerExprAsStmt(ctx, fn, inner);
        }
        return "";
    }
    if (s.kind == ND_VAR_DECL) {
        return winLowerLocalDecl(ctx, fn, s);
    }
    if (s.kind == ND_RETURN) {
        if (s.childCount() == 0) {
            fn.e.jmp(fn.epi);
            return "";
        }
        if (winKindOf(ctx, fn, s.child(0)) == 4) { return "float return values in '" + cur + "'"; }
        string err = winLowerExpr(ctx, fn, s.child(0));
        if (err.length > 0) { return err; }
        fn.e.jmp(fn.epi);
        return "";
    }
    if (s.kind == ND_IF_STMT) {
        if (s.childCount() < 2) { return "unsupported statement in '" + cur + "'"; }
        if (winKindOf(ctx, fn, s.child(0)) == 4) { return "float conditions in '" + cur + "'"; }
        string err = winLowerExpr(ctx, fn, s.child(0));
        if (err.length > 0) { return err; }
        fn.e.b(72);
        fn.e.b(133);
        fn.e.b(192);
        int elseLab = fn.e.lab();
        int endLab = fn.e.lab();
        fn.e.jcc(132, elseLab);
        err = winLowerBlock(ctx, fn, s.child(1));
        if (err.length > 0) { return err; }
        fn.e.jmp(endLab);
        fn.e.bind(elseLab);
        if (s.childCount() > 2) {
            err = winLowerBlock(ctx, fn, s.child(2));
            if (err.length > 0) { return err; }
        }
        fn.e.bind(endLab);
        return "";
    }
    if (s.kind == ND_WHILE) {
        if (s.childCount() < 2) { return "unsupported statement in '" + cur + "'"; }
        if (winKindOf(ctx, fn, s.child(0)) == 4) { return "float conditions in '" + cur + "'"; }
        int condLab = fn.e.lab();
        int endLab = fn.e.lab();
        fn.e.bind(condLab);
        string err = winLowerExpr(ctx, fn, s.child(0));
        if (err.length > 0) { return err; }
        fn.e.b(72);
        fn.e.b(133);
        fn.e.b(192);
        fn.e.jcc(132, endLab);
        fn.brkLabs.add(endLab);
        fn.contLabs.add(condLab);
        err = winLowerBlock(ctx, fn, s.child(1));
        if (err.length > 0) { return err; }
        fn.brkLabs.pop();
        fn.contLabs.pop();
        fn.e.jmp(condLab);
        fn.e.bind(endLab);
        return "";
    }
    if (s.kind == ND_BREAK) {
        if (fn.brkLabs.length == 0) { return "break/continue outside a loop in '" + cur + "'"; }
        fn.e.jmp(fn.brkLabs[fn.brkLabs.length - 1]);
        return "";
    }
    if (s.kind == ND_CONTINUE) {
        if (fn.contLabs.length == 0) { return "break/continue outside a loop in '" + cur + "'"; }
        fn.e.jmp(fn.contLabs[fn.contLabs.length - 1]);
        return "";
    }
    if (s.kind == ND_FOR_RANGE) {
        Node desugared = winDesugarRange(s);
        return winLowerStmt(ctx, fn, desugared);
    }
    if (s.kind == ND_FOR_C) {
        return winLowerForC(ctx, fn, s);
    }
    return "unsupported statement in '" + cur + "'";
}

// An expression in statement position: calls to program functions run for
// effect, assignments store, everything else evaluates and discards.
private string winLowerExprAsStmt(WinCtx ctx, WinFn fn, Node inner) {
    string cur = fn.fname;
    if (inner.kind == ND_CALL) {
        if (inner.name == "print" || inner.name == "printline") {
            return "print used as a value in '" + cur + "'";
        }
        if (inner.name == "printf") {
            return "explicit 'printf' calls in '" + cur + "'";
        }
        if (inner.name == "exit") {
            return winLowerExit(ctx, fn, inner);
        }
        return winLowerCall(ctx, fn, inner);
    }
    return winLowerExpr(ctx, fn, inner);
}

private string winLowerLocalDecl(WinCtx ctx, WinFn fn, Node s) {
    string cur = fn.fname;
    if (s.childCount() == 0) { return "uninitialized local '" + s.name + "' in '" + cur + "'"; }
    int kind = winKindOf(ctx, fn, s.child(0));
    string vk = "i";
    if (kind == 1) { vk = "b"; }
    else if (kind == 2) { vk = "c"; }
    else if (kind == 4) { vk = "f"; }
    if (s.typeHint != "" && s.typeHint != "var") {
        if (tierFloatSpelling(s.typeHint)) { vk = "f"; }
        else {
            vk = winScalarOf(s.typeHint);
            if (vk.length == 0) { return "local '" + s.name + "' has non-tier type in '" + cur + "'"; }
        }
    }
    string err = winLowerExpr(ctx, fn, s.child(0));
    if (err.length > 0) { return err; }
    fn.varNames.add(s.name);
    fn.varKinds.add(vk);
    // A float local from a float literal (or a spelled float local) keeps
    // the source text for exact literal-verbatim printing; anything else
    // (calls, arithmetic, idents without spellings) prints with %g.
    string spell = "";
    if (vk == "f") {
        spell = tierFloatLitText(s.child(0));
        if (spell.length == 0) { spell = winVarSpell(fn, s.child(0)); }
    }
    fn.varSpells.add(spell);
    int vi = fn.varNames.length - 1;
    fn.e.b(72);
    fn.e.b(137);
    fn.e.b(133);
    fn.e.i32(int64(-8 * (vi + 1)));
    return "";
}

private string winLowerBlock(WinCtx ctx, WinFn fn, Node block) {
    if (block.kind == ND_BLOCK) {
        for (int i = 0; i < block.childCount(); i++) {
            string err = winLowerStmt(ctx, fn, block.child(i));
            if (err.length > 0) { return err; }
        }
        return "";
    }
    return winLowerStmt(ctx, fn, block);
}

// Range-for desugared onto the C-for shape exactly like the tier predicate:
// init `var = start`, cond `var < end`, update `var = var + 1`.
private Node winDesugarRange(Node s) {
    Node forN = new Node(ND_FOR_C, s.line, s.col);
    Node initN = new Node(ND_VAR_DECL, s.line, s.col);
    initN.name = s.name;
    initN.typeHint = s.typeHint;
    initN.addChild(s.child(0));
    Node lhsN = new Node(ND_IDENT, s.line, s.col);
    lhsN.name = s.name;
    Node condN = new Node(ND_BINARY, s.line, s.col);
    condN.op = OP_LT;
    condN.addChild(lhsN);
    condN.addChild(s.child(1));
    Node uLhsN = new Node(ND_IDENT, s.line, s.col);
    uLhsN.name = s.name;
    Node aLhsN = new Node(ND_IDENT, s.line, s.col);
    aLhsN.name = s.name;
    Node oneN = new Node(ND_INT_LIT, s.line, s.col);
    oneN.intVal = 1;
    Node addN = new Node(ND_BINARY, s.line, s.col);
    addN.op = OP_ADD;
    addN.addChild(aLhsN);
    addN.addChild(oneN);
    Node updN = new Node(ND_BINARY, s.line, s.col);
    updN.op = OP_ASSIGN;
    updN.addChild(uLhsN);
    updN.addChild(addN);
    forN.addChild(initN);
    forN.addChild(condN);
    forN.addChild(updN);
    forN.addChild(s.child(2));
    return forN;
}

// C-like for: init once, then cond-check / body / update; continue runs the
// update, break leaves. Mirrors the predicate's desugar onto while.
private string winLowerForC(WinCtx ctx, WinFn fn, Node s) {
    string cur = fn.fname;
    if (s.childCount() < 4) { return "unsupported statement in '" + cur + "'"; }
    Node init = s.child(0);
    if (init.kind == ND_VAR_DECL) {
        string err = winLowerLocalDecl(ctx, fn, init);
        if (err.length > 0) { return err; }
    } else if (init.kind == ND_EXPR_STMT) {
        if (init.childCount() > 0) {
            string err = winLowerExprAsStmt(ctx, fn, init.child(0));
            if (err.length > 0) { return err; }
        }
    } else if (init.kind == ND_BINARY) {
        string err = winLowerExpr(ctx, fn, init);
        if (err.length > 0) { return err; }
    } else {
        return "unsupported for initializer in '" + cur + "'";
    }
    int condLab = fn.e.lab();
    int updLab = fn.e.lab();
    int endLab = fn.e.lab();
    fn.e.bind(condLab);
    if (winKindOf(ctx, fn, s.child(1)) == 4) { return "float conditions in '" + cur + "'"; }
    string cerr = winLowerExpr(ctx, fn, s.child(1));
    if (cerr.length > 0) { return cerr; }
    fn.e.b(72);
    fn.e.b(133);
    fn.e.b(192);
    fn.e.jcc(132, endLab);
    fn.brkLabs.add(endLab);
    fn.contLabs.add(updLab);
    string berr = winLowerBlock(ctx, fn, s.child(3));
    if (berr.length > 0) { return berr; }
    fn.brkLabs.pop();
    fn.contLabs.pop();
    fn.e.bind(updLab);
    string uerr = winLowerExprAsStmt(ctx, fn, s.child(2));
    if (uerr.length > 0) { return uerr; }
    fn.e.jmp(condLab);
    fn.e.bind(endLab);
    return "";
}

// Lower one function into prog: params spilled to slots, body, then the
// shared epilogue. Frame reserves params + all body locals up front.
private string winLowerFuncInto(WinCtx ctx, WinProg prog, Node func, int fnIdx) {
    WinFn fn = new WinFn();
    fn.fname = func.name;
    fn.e.abi = ctx.abi;
    Node params = func.child(0);
    Node body = func.child(1);
    string pks = ctx.fnPKinds[fnIdx];
    for (int i = 0; i < params.childCount(); i++) {
        fn.varNames.add(params.child(i).name);
        fn.varKinds.add(pks[i..i + 1]);
        fn.varSpells.add("");
    }
    int nvars = params.childCount() + winCountLocals(body);
    int frame = (nvars * 8 + 8 + 15) / 16 * 16 - 8;
    fn.e.prologue(frame);
    // Parameter homes: Win64 spills RCX/RDX/R8/R9 with stack arguments
    // above the shadow space at [rbp+48+8k]; SysV spills
    // RDI/RSI/RDX/RCX/R8/R9 with stack arguments at [rbp+16+8k] (no shadow
    // space — the SysV shape).
    if (ctx.abi == 1) {
        for (int p = 0; p < params.childCount(); p++) {
            if (p < 6) {
                fn.e.spillReg(fn.e.argReg(p), -8 * (p + 1));
            } else {
                fn.e.fillReg(0, 16 + 8 * (p - 6));
                fn.e.spillReg(0, -8 * (p + 1));
            }
        }
    } else {
    if (params.childCount() > 0) {
        fn.e.b(72);
        fn.e.b(137);
        fn.e.b(141);
        fn.e.i32(-8);
    }
    if (params.childCount() > 1) {
        fn.e.b(72);
        fn.e.b(137);
        fn.e.b(149);
        fn.e.i32(-16);
    }
    if (params.childCount() > 2) {
        fn.e.b(76);
        fn.e.b(137);
        fn.e.b(133);
        fn.e.i32(-24);
    }
    if (params.childCount() > 3) {
        fn.e.b(76);
        fn.e.b(137);
        fn.e.b(141);
        fn.e.i32(-32);
    }
    for (int p = 4; p < params.childCount(); p++) {
        fn.e.b(72);
        fn.e.b(139);
        fn.e.b(133);
        fn.e.i32(int64(48 + 8 * (p - 4)));
        fn.e.b(72);
        fn.e.b(137);
        fn.e.b(133);
        fn.e.i32(int64(-8 * (p + 1)));
    }
    }
    fn.epi = fn.e.lab();
    string err = winLowerBlock(ctx, fn, body);
    if (err.length > 0) { return err; }
    fn.e.bind(fn.epi);
    fn.e.epilogue();
    err = fn.e.finish();
    if (err.length > 0) { return err; }
    prog.fns.add(fn);
    return "";
}

// Emit the __slv_timeNow helper: the native time.now() clock read. Two
// int64 frame slots (freq at [rbp-8], count at [rbp-16]) feed the QPC pair
// by address (the &freq/&count out-param shape), then the result derives
// exactly like silverc/std/time.sr now(): float64(count) / float64(freq) *
// 1000.0 in IEEE-754 double precision, with the bit pattern returned in
// RAX (the tier's float64 value shape). A zero frequency divides to
// infinity exactly like the tree-walk module body.
private string winEmitTimeNow(WinCtx ctx, WinProg prog) {
    WinFn fn = new WinFn();
    fn.fname = "__slv_timeNow";
    fn.e.abi = ctx.abi;
    fn.e.prologue(24);
    fn.e.callSetup(1);
    fn.e.leaRbp(fn.e.argReg(0), -8);
    int holeF = fn.e.callHole();
    fn.rel(holeF, 0, 4, -2, "");
    fn.e.callTeardown();
    fn.e.callSetup(1);
    fn.e.leaRbp(fn.e.argReg(0), -16);
    int holeC = fn.e.callHole();
    fn.rel(holeC, 0, 4, -3, "");
    fn.e.callTeardown();
    fn.e.fillReg(0, -16);
    fn.e.cvtAxToXmm0();
    fn.e.fillReg(1, -8);
    fn.e.cvtCxToXmm1();
    fn.e.divXmm0Xmm1();
    fn.e.movAbs(1, icFloatBitsOf("1000.0"));
    fn.e.movqXmm1Cx();
    fn.e.mulXmm0Xmm1();
    fn.e.movqAxXmm0();
    fn.e.epilogue();
    string err = fn.e.finish();
    if (err.length > 0) { return err; }
    prog.fns.add(fn);
    return "";
}

// Pop-and-emit helper for the %g renderer below: rcx = remaining pops,
// r8 = pending zeros (0 on entry). Pops most-first digits, suppressing
// trailing zeros through the pending count (no lookahead, no indexing).
private void winEmitDigitRun(WinFn fn) {
    int runLoop = fn.e.lab();
    int runDone = fn.e.lab();
    int runEmit = fn.e.lab();
    int flushLoop = fn.e.lab();
    int flushDone = fn.e.lab();
    int runNext = fn.e.lab();
    fn.e.bind(runLoop);
    fn.e.testRcxRcx();
    fn.e.jcc(132, runDone);
    fn.e.popRax();
    fn.e.decRcx();
    fn.e.testAxAx();
    fn.e.jcc(133, runEmit);
    fn.e.incR8();
    fn.e.jmp(runNext);
    fn.e.bind(runEmit);
    fn.e.bind(flushLoop);
    fn.e.testR8R8();
    fn.e.jcc(132, flushDone);
    fn.e.movAlImm(48);
    fn.e.stoAlRdi();
    fn.e.incRdi();
    fn.e.decR8();
    fn.e.jmp(flushLoop);
    fn.e.bind(flushDone);
    fn.e.addAxImm32(48);
    fn.e.stoAlRdi();
    fn.e.incRdi();
    fn.e.bind(runNext);
    fn.e.jmp(runLoop);
    fn.e.bind(runDone);
}

// Emit the __slv_fmtF helper: (rcx = float64 bits, rdx = 64-byte buffer)
// -> rax = content length, buffer NUL-terminated. Renders the C99 %g shape
// with 6 significant digits and MSVC-style 3-digit exponents — the exact
// observable convention of the tree-walk float64.toString(): finite values
// in fixed or exponential form (exponential iff decimal exponent < -4 or
// >= 6), "+inf" as "1.#INF", "-inf" as "-1.#INF", nan as "-1.#IND", and
// negative zero as "-0".
//
// Method: decimal exponent by scaling 10^e against the value (bounded
// loops, overflow/underflow-proof by comparison), then 6 digits by
// split-half power scaling (intermediates provably finite, so no inf/zero
// can leak in), half-away rounding, and positional rendering with
// pending-zero suppression. Correct rounding at 6-figure boundaries can
// differ in the last digit in measure-zero cases (documented tier bound);
// every probed value matches the tree-walk byte for byte.
private string winEmitFmtF(WinCtx ctx, WinProg prog) {
    WinFn fn = new WinFn();
    fn.fname = "__slv_fmtF";
    fn.e.abi = ctx.abi;
    fn.e.prologue(40);
    fn.e.spillReg(1, -8);
    // Load the value through the proven slot+rax path (fill + movqXmm0Ax)
    // rather than direct movqXmm0Cx: identical semantics, proven emitters.
    fn.e.fillReg(0, -8);
    fn.e.movqXmm0Ax();
    fn.e.movAbsAny(6, icFloatBitsOf("1.7976931348623157e308"));
    fn.e.movqXmm1Rsi();
    fn.e.comisdXmm0Xmm1();
    int isNan = fn.e.lab();
    int isInf = fn.e.lab();
    int negInf = fn.e.lab();
    fn.e.jcc(138, isNan);
    fn.e.jcc(135, isInf);
    // Negative infinity sits below every finite double: compare against an
    // exact -DBL_MAX so only -inf takes the branch. The bits are built with
    // integers (sign + 2046-biased exponent + all-ones mantissa), never the
    // decimal parser, so the boundary is slop-free.
    int64 negMaxBits = 9223372036854775807 + 1 + 2046 * 4503599627370496 + 4503599627370495;
    fn.e.movAbsAny(6, negMaxBits);
    fn.e.movqXmm1Rsi();
    fn.e.comisdXmm0Xmm1();
    fn.e.jcc(130, negInf);
    fn.e.movAbsAny(6, 0);
    fn.e.movqXmm1Rsi();
    fn.e.comisdXmm0Xmm1();
    int notZero = fn.e.lab();
    fn.e.jcc(133, notZero);
    fn.e.fillReg(0, -8);
    fn.e.testAxAx();
    int negZero = fn.e.lab();
    fn.e.jcc(136, negZero);
    fn.e.movByteRdxImm(48);
    fn.e.movByteRdxDisp8(1, 0);
    fn.e.movRegImm32(0, 1);
    fn.e.epilogue();
    fn.e.bind(negZero);
    fn.e.movByteRdxImm(45);
    fn.e.movByteRdxDisp8(1, 48);
    fn.e.movByteRdxDisp8(2, 0);
    fn.e.movRegImm32(0, 2);
    fn.e.epilogue();
    fn.e.bind(isNan);
    fn.e.stoDwordRdx(0x232E312D);
    fn.e.stoDwordRdxDisp8(4, 0x00444E49);
    fn.e.movRegImm32(0, 7);
    fn.e.epilogue();
    fn.e.bind(isInf);
    fn.e.fillReg(0, -8);
    fn.e.testAxAx();
    fn.e.jcc(136, negInf);
    fn.e.stoDwordRdx(0x49232E31);
    fn.e.movWordRdxDisp8(4, 0x464E);
    fn.e.movByteRdxDisp8(6, 0);
    fn.e.movRegImm32(0, 6);
    fn.e.epilogue();
    fn.e.bind(negInf);
    fn.e.stoDwordRdx(0x232E312D);
    fn.e.stoDwordRdxDisp8(4, 0x00464E49);
    fn.e.movRegImm32(0, 7);
    fn.e.epilogue();
    fn.e.bind(notZero);
    fn.e.fillReg(0, -8);
    fn.e.testAxAx();
    int posFin = fn.e.lab();
    int haveCursor = fn.e.lab();
    fn.e.jcc(137, posFin);
    fn.e.movByteRdxImm(45);
    fn.e.movAbsAny(0, 9223372036854775807);
    fn.e.andRcxRax();
    fn.e.movqXmm0Cx();
    fn.e.movRdiRdx();
    fn.e.incRdi();
    fn.e.jmp(haveCursor);
    fn.e.bind(posFin);
    fn.e.movRdiRdx();
    fn.e.bind(haveCursor);
    fn.e.movRsiRdx();
    fn.e.spillReg(6, -40);
    fn.e.movAbsAny(6, icFloatBitsOf("10.0"));
    fn.e.movqXmm2Rsi();
    fn.e.movRegImm32(0, 0);
    fn.e.spillReg(0, -16);
    fn.e.movAbsAny(0, icFloatBitsOf("1.0"));
    fn.e.spillReg(0, -32);
    fn.e.movRegImm32(1, 320);
    int upLoop = fn.e.lab();
    int upDone = fn.e.lab();
    fn.e.bind(upLoop);
    fn.e.fillReg(0, -32);
    fn.e.movqXmm1Ax();
    fn.e.mulXmm1Xmm2();
    fn.e.comisdXmm0Xmm1();
    fn.e.jcc(138, upDone);
    fn.e.jcc(130, upDone);
    fn.e.movqAxXmm1();
    fn.e.spillReg(0, -32);
    fn.e.fillReg(0, -16);
    fn.e.incAx();
    fn.e.spillReg(0, -16);
    fn.e.decRcx();
    fn.e.testRcxRcx();
    fn.e.jcc(133, upLoop);
    fn.e.bind(upDone);
    fn.e.movRegImm32(1, 320);
    int dnLoop = fn.e.lab();
    int dnDone = fn.e.lab();
    fn.e.bind(dnLoop);
    fn.e.fillReg(0, -32);
    fn.e.movqXmm1Ax();
    // Compare against the scale itself (not scale/10): the loop shrinks
    // while the value sits below the scale, stopping with
    // scale <= value < 10*scale. Comparing against scale/10 stops one
    // power early (exact powers of ten land a full decade high).
    fn.e.comisdXmm0Xmm1();
    fn.e.jcc(138, dnDone);
    fn.e.jcc(131, dnDone);
    fn.e.divXmm1Xmm2();
    fn.e.movqAxXmm1();
    fn.e.spillReg(0, -32);
    fn.e.fillReg(0, -16);
    fn.e.decAx();
    fn.e.spillReg(0, -16);
    fn.e.decRcx();
    fn.e.testRcxRcx();
    fn.e.jcc(133, dnLoop);
    fn.e.bind(dnDone);
