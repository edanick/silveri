mod export pipeline;

import token;
import lexer;
import parser;
import ast;
import eval;

// OVERHAUL.md "The unified generation pipeline (one factory line)",
// adapted to interpretation: units flow into ONE evaluation line.
//
// Code evaluation runs as ONE pipeline regardless of input shape or flags
// — one file or many, single `.sr` or `.srp` project, small or big, cached
// or not. Many units enter, they are mapped into one unified order, and one
// program result leaves.
//
// This module is the single home of the line's shared pieces:
// - pipeKind* / pipeKindName / PipeUnit — the one normalized per-file unit
//   record (origin + content hash + kind). Every unit enters as exactly one
//   of three kinds: a cached `.o` (object-tier hit — already native, the
//   runner path), a synced `.srbc` (bytecode-tier hit — skipped re-lexing),
//   or an `.sr` source file (no cache — lexed and parsed directly). A unit
//   is never two kinds at once and never processed twice.
// - pipeLexUnit — the exactly-one lex entry. Every fresh lex in the line
//   funnels through it (the cache tier computes through it, the driver
//   calls it directly on a miss, the embedded preludes lex through it).
// - pipeParseUnit — the exactly-one parse entry. Every token stream in the
//   line funnels through it (the entry program, the object-tier lowering
//   probe, the embedded preludes).
// - pipeRunProgram — the exactly-one evaluation entry. The object-tier
//   native runner is a backend variant inside the same stage (like mode
//   selects variants, not parallel lines): it runs first when its object
//   validated, otherwise this entry evaluates the verified program.
// - pipeCanonicalOrder / pipeJoinBuffers — the one deterministic unit order
//   (entry first, then import-discovery/manifest order) plus the ordered
//   join: each unit is mapped into its OWN separate buffer, and the buffers
//   join back in canonical order before the single downstream evaluation
//   continues, so results never depend on file count or tier mix.
// - pipeDescribeUnit — the one `[pipe]`-style per-unit kind log shape
//   (mirrors the compilers' `[pipe] <origin> <kind>` strings exactly).
//
// Flags never duplicate a stage — they only select, per unit and per stage,
// whether to read from cache or compute fresh. There is no `--os` in
// silveri: the host auto-detect (interpHostOs in main.sr) selects the
// region-filter target and the `--cache-object` `<os>-<arch>` directory
// alike, and every stage below honors it without a flag.

// One input kind per unit (mirrors the reference UnitKind): a cached `.o`
// (object-tier hit), a synced `.srbc` (bytecode-tier hit), or `.sr` source.
int pipeKindCachedObject = 0;
int pipeKindSyncedBytecode = 1;
int pipeKindSource = 2;

// Stable lowercase name for `[pipe]` diagnostics (mirrors UnitKind::name).
public string pipeKindName(int kind) {
    if (kind == pipeKindCachedObject) { return "cached-object"; }
    if (kind == pipeKindSyncedBytecode) { return "synced-bytecode"; }
    return "source";
}

// One unit's final input kind: an object-tier hit goes to the runner,
// otherwise the unit keeps the frontend tier (synced `.srbc` when it
// decoded, `.sr` source otherwise). Object wins over bytecode — a unit is
// never two kinds at once.
public int pipeClassifyUnit(bool objectFresh, bool bytecodeHit) {
    if (objectFresh) { return pipeKindCachedObject; }
    if (bytecodeHit) { return pipeKindSyncedBytecode; }
    return pipeKindSource;
}

// One normalized per-file unit record: canonical origin key plus the FNV-1
// content hash of the exact source text observed, and the unit's single
// input kind (finalized to cached-object by the object-tier plan for
// reusable units).
class PipeUnit {
    public prop string origin;
    public prop int64 hash;
    public prop int kind;

    construct (string origin, int64 hash, int kind) {
        this.origin = origin;
        this.hash = hash;
        this.kind = kind;
    }

    public string kindName() {
        return pipeKindName(this.kind);
    }
}

// Program + diagnostics from the single parse entry.
class PipeParseOut {
    public prop Node[] program;
    public prop string[] errors;

    construct {
        this.program = [];
        this.errors = [];
    }
}

// THE lex entry of the unified line: lex one source text into its token
// stream, collecting lexical diagnostic bodies into lexErrs and the
// per-line character lengths into lineLensOut (mirrors the Lexer counting
// the parser's bracket diagnostics need). Every fresh lex — driver misses,
// the cache tier's own compute, the embedded preludes — funnels through
// here, so there is exactly one place that turns source text into tokens.
public Token[] pipeLexUnit(string source, string[] lexErrs, int[] lineLensOut) {
    Lexer lx = new Lexer(source);
    Token[] toks = lx.tokenize();
    string[] msgs = lx.messages();
    for (int i = 0; i < msgs.length; i++) { lexErrs.add(msgs[i]); }
    int[] lens = lx.lineLengths();
    for (int j = 0; j < lens.length; j++) { lineLensOut.add(lens[j]); }
    lx.release();
    return toks;
}

// THE parse entry of the unified line: parse one token stream into its
// program, collecting recoverable diagnostics into out.errors (callers that
// fail on any diagnostic report them and drop the program). lineLens
// carries the per-line character lengths of the lexed source so
// diagnostics stay exact (pass useLens=false on paths that never computed
// them); target is the host auto-detected OS; checkCalls runs the
// post-parse call diagnostics over the program (driver path); prelude and
// lowering-probe parses skip it, exactly as before.
public void pipeParseUnit(Token[] tokens, int[] lineLens, bool useLens, string target, bool checkCalls, PipeParseOut out) {
    Parser p = new Parser(tokens);
    if (useLens) { p.setLineLengths(lineLens); }
    p.setCustomTarget(target);
    out.program = p.parseProgram();
    // Copy indices (not the live array): messages() hands out the parser's
    // own buffer, so later walks would otherwise show up twice.
    string[] first = p.messages();
    int n0 = first.length;
    for (int i = 0; i < n0; i++) { out.errors.add(first[i]); }
    // Two-step driver semantics preserved inside the single entry: the
    // post-parse call walk runs only on a clean parse (historically the
    // driver printed parse errors and exited before it), and only its new
    // diagnostics (indices past n0) join out.errors.
    if (checkCalls && out.errors.length == 0) {
        p.checkCallDiagnostics(out.program);
        string[] rest = p.messages();
        for (int j = n0; j < rest.length; j++) { out.errors.add(rest[j]); }
    }
    p.release();
}

// THE evaluation entry of the unified line: evaluate one parsed program to
// its single program result. The object-tier native runner is a backend
// variant of this same stage, not a second line: it runs first when its
// object validated and falls back LOUDLY here otherwise.
public void pipeRunProgram(Evaluator ev, Node[] program) {
    ev.run(program);
}

// THE canonical unit order of the unified line: the entry first, then
// import-discovery/manifest order, deduplicated. Deterministic regardless
// of tier mix or file count — identical results for any tier mix.
public string[] pipeCanonicalOrder(string entry, string[] discovered) {
    string[] order = [];
    order.add(entry);
    for (int i = 0; i < discovered.length; i++) {
        if (discovered[i] == entry) { continue; }
        bool seen = false;
        for (int j = 0; j < order.length; j++) {
            if (order[j] == discovered[i]) { seen = true; break; }
        }
        if (!seen) { order.add(discovered[i]); }
    }
    return order;
}

// THE ordered join of the unified line: per-unit buffers (each unit mapped
// into its OWN separate buffer, no shared mutable state between units)
// joined back in canonical order before the single downstream evaluation
// continues. Order in = order out for every tier mix.
public string pipeJoinBuffers(string[] buffers) {
    string[] parts = [];
    for (int i = 0; i < buffers.length; i++) { parts.add(buffers[i]); }
    return parts.join("");
}

// THE per-unit kind log shape of the unified line: `[pipe] <origin> <kind>`
// (mirrors the compilers' strings exactly). Each unit logs exactly once,
// proving no unit is two kinds at once and none is processed twice. Gated
// by the driver on --diag so quiet runs stay byte-identical to the
// uncached tiers.
public string pipeDescribeUnit(PipeUnit u) {
    return "[pipe] " + u.origin + " " + u.kindName();
}
