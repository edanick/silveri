mod export lexer;

import token;

class Lexer {
    private prop string src;
    private prop int pos;
    private prop int line;
    private prop int col;
    // Per-line character lengths (1-based indexing via line-1), used to
    // point at the last character of a line for unterminated strings and
    // just past the end of a line for missing-bracket diagnostics.
    private prop int[] lineLens;
    // Recoverable lex diagnostics count (SYNTAX_EXCEPTIONS.md).
    private prop int lexErrors;
    // Buffered diagnostic bodies in source order. The driver prints them
    // grouped under a single `[file]` header (mirroring silverc-rs 861d2e7
    // and the self-host 3291b66 unmarked path); bodies stay byte-identical.
    private prop string[] lexMessages;

    construct (string source) {
        this.src = source;
        this.pos = 0;
        this.line = 1;
        this.col = 1;
        this.lineLens = [];
        this.lexErrors = 0;
        this.lexMessages = [];
        int current = 0;
        for (int i = 0; i < source.length; i++) {
            char c = source[i];
            if (c == '\n') {
                this.lineLens.add(current);
                current = 0;
            } else if (c != '\r') {
                current++;
            }
        }
        this.lineLens.add(current);
    }

    public int[] lineLengths() {
        return this.lineLens;
    }

    public int errorCount() {
        return this.lexErrors;
    }

    // Buffered diagnostic bodies, in the order they were recorded. The
    // driver flushes them under the `[file]` header; lexing itself prints
    // nothing so headers print exactly once per file.
    public string[] messages() {
        return this.lexMessages;
    }

    // Character length of the given 1-based line (0 when out of range).
    private int lineCharLen(int ln) {
        if (ln >= 1 && ln <= this.lineLens.length) { return this.lineLens[ln - 1]; }
        return 0;
    }

    private void recordLexError(string msg) {
        this.lexErrors++;
        this.lexMessages.add(msg);
    }

    private char? peek() {
        if (this.pos < this.src.length) {
            return this.src[this.pos];
        }
        return null;
    }

    private char? advance() {
        if (this.pos >= this.src.length) { return null; }
        char c = this.src[this.pos];
        this.pos++;
        if (c == '\n') {
            this.line++;
            this.col = 1;
        } else {
            this.col++;
        }
        return c;
    }

    private void skipWhitespace() {
        while (this.pos < this.src.length) {
            char c = this.src[this.pos];
            if (c == ' ' || c == '\t' || c == '\n' || c == '\r') {
                this.advance();
            } else {
                break;
            }
        }
    }

    private void skipLineComment() {
        while (this.pos < this.src.length) {
            char c = this.src[this.pos];
            if (c == '\n') { break; }
            this.advance();
        }
    }

    private bool skipBlockComment() {
        int depth = 1;
        while (this.pos < this.src.length && depth > 0) {
            char c = this.src[this.pos];
            if (c == '/' && this.pos + 1 < this.src.length && this.src[this.pos + 1] == '*') {
                depth++;
                this.advance();
                this.advance();
            } else if (c == '*' && this.pos + 1 < this.src.length && this.src[this.pos + 1] == '/') {
                depth--;
                this.advance();
                this.advance();
            } else {
                this.advance();
            }
        }
        return depth == 0;
    }

    private Token readString(int ln, int c) {
        string s = "";
        bool closed = false;
        while (this.pos < this.src.length) {
            char ch = this.src[this.pos];
            this.advance();
            if (ch == '"') { closed = true; break; }
            if (ch == '\\') {
                if (this.pos < this.src.length) {
                    char esc = this.src[this.pos];
                    this.advance();
                    if (esc == 'n') { s += "\n"; }
                    else if (esc == 't') { s += "\t"; }
                    else if (esc == 'r') { s += "\r"; }
                    else if (esc == '\\') { s += "\\"; }
                    else if (esc == '"') { s += "\""; }
                    else if (esc == '$') { s += "$"; }
                    else if (esc == '0') { s += char(0); }
                    else if (esc == 'x') {
                        // Hex escape \xHH: decode 1-2 hex digits into a raw
                        // byte (matches the compiler's lexer). With no hex
                        // digit following, keep the literal `\x`.
                        int hv = 0;
                        int nd = 0;
                        while (nd < 2 && this.pos < this.src.length) {
                            char hc = this.src[this.pos];
                            int dv = -1;
                            if (hc >= '0' && hc <= '9') { dv = hc - '0'; }
                            else if (hc >= 'a' && hc <= 'f') { dv = hc - 'a' + 10; }
                            else if (hc >= 'A' && hc <= 'F') { dv = hc - 'A' + 10; }
                            if (dv < 0) { break; }
                            this.advance();
                            hv = hv * 16 + dv;
                            nd++;
                        }
                        if (nd > 0) {
                            char xc = char(hv);
                            s += (string)xc;
                        } else {
                            s += "\\x";
                        }
                    }
                    else { s += (string)esc; }
                }
            } else {
                s += (string)ch;
            }
        }
        // SYNTAX_EXCEPTIONS.md — an unterminated literal reports the opening
        // line with the column of its last character.
        if (!closed) {
            int endCol = this.lineCharLen(ln);
            if (endCol <= 0) { endCol = c; }
            this.recordLexError("you forgot to close your string quotes at line " + (string)ln + ", column " + (string)endCol);
        }
        Token tok = new Token(TK_STRING_LIT, s, ln, c);
        tok.strVal = s;
        return tok;
    }

    // SPEC 12.2 / DOCS 102: brace/quote-aware scan of a `$"..."` interpolation
    // string (the opening `"` has already been consumed). Literal runs decode
    // escapes exactly like readString; each `{...}` hole is captured verbatim
    // -- its nested string/char literals, nested `$"..."` and backslash escapes
    // copied raw -- so an inner quote never ends the outer string and the
    // parser can re-lex the hole text and apply the value-vs-parenthesized-
    // expression rule. `{{` and `}}` are literal braces. The outer string
    // terminates only at a `"` seen at brace-depth zero. Mirrors silverc's
    // Lexer::readInterpStringToken.
    private Token readInterpStringToken(int ln, int cl) {
        Token tok = new Token(TK_INTERP_STRING, "$", ln, cl);
        string text = "";
        bool closed = false;
        while (this.pos < this.src.length) {
            char ch = this.src[this.pos];
            this.advance();
            if (ch == '"') { closed = true; break; }
            if (ch == '\\') {
                if (this.pos < this.src.length) {
                    char esc = this.src[this.pos];
                    this.advance();
                    if (esc == 'n') { text += "\n"; }
                    else if (esc == 't') { text += "\t"; }
                    else if (esc == 'r') { text += "\r"; }
                    else if (esc == '\\') { text += "\\"; }
                    else if (esc == '"') { text += "\""; }
                    else if (esc == '$') { text += "$"; }
                    else if (esc == '0') { text += char(0); }
                    else if (esc == 'x') {
                        int hv = 0;
                        int nd = 0;
                        while (nd < 2 && this.pos < this.src.length) {
                            char hc = this.src[this.pos];
                            int dv = -1;
                            if (hc >= '0' && hc <= '9') { dv = hc - '0'; }
                            else if (hc >= 'a' && hc <= 'f') { dv = hc - 'a' + 10; }
                            else if (hc >= 'A' && hc <= 'F') { dv = hc - 'A' + 10; }
                            if (dv < 0) { break; }
                            this.advance();
                            hv = hv * 16 + dv;
                            nd++;
                        }
                        if (nd > 0) {
                            char xh = char(hv);
                            text += (string)xh;
                        }
                        else { text += "\\x"; }
                    }
                    else { text += (string)esc; }
                }
                continue;
            }
            if (ch == '{') {
                if (this.peek() == '{') { this.advance(); text += "{"; continue; }
                if (text.length > 0) {
                    tok.ipKinds.add(0); tok.ipTexts.add(text); tok.ipLines.add(0); tok.ipCols.add(0);
                    text = "";
                }
                int hLine = this.line;
                int hCol = this.col - 1;
                string hole = "";
                int depth = 1;
                bool holeClosed = false;
                while (this.pos < this.src.length) {
                    char c2 = this.src[this.pos];
                    this.advance();
                    if (c2 == '}') {
                        if (depth == 1) { holeClosed = true; break; }
                        depth--;
                        hole += "}";
                    } else if (c2 == '{') {
                        depth++;
                        hole += "{";
                    } else if (c2 == '"' || c2 == '\'') {
                        hole += (string)c2;
                        hole = this.ipCopyQuoted(c2, hole);
                    } else if (c2 == '$' && this.peek() == '"') {
                        hole += "$";
                        this.advance();
                        hole += "\"";
                        hole = this.ipCopyQuoted('"', hole);
                    } else if (c2 == '\\' && this.pos < this.src.length) {
                        hole += "\\";
                        char nx = this.src[this.pos];
                        hole += (string)nx;
                        this.advance();
                    } else {
                        hole += (string)c2;
                    }
                }
                if (!holeClosed) { closed = false; break; }
                tok.ipKinds.add(1); tok.ipTexts.add(hole); tok.ipLines.add(hLine); tok.ipCols.add(hCol);
                continue;
            }
            if (ch == '}') {
                if (this.peek() == '}') { this.advance(); text += "}"; continue; }
                text += "}";
                continue;
            }
            text += (string)ch;
        }
        if (text.length > 0) {
            tok.ipKinds.add(0); tok.ipTexts.add(text); tok.ipLines.add(0); tok.ipCols.add(0);
        }
        if (!closed) {
            int endCol = this.lineCharLen(ln);
            if (endCol <= 0) { endCol = cl; }
            this.recordLexError("you forgot to close your string quotes at line " + (string)ln + ", column " + (string)endCol);
        }
        return tok;
    }

    // Copy a nested string/char literal from inside an interpolation hole into
    // `acc` verbatim (the opening quote is already appended): consume until the
    // matching unescaped `q`, treating `\X` pairs as opaque so an escaped quote
    // never closes the literal. Mirrors silverc's Lexer::ipCopyQuoted.
    private string ipCopyQuoted(char q, string acc) {
        while (this.pos < this.src.length) {
            char c = this.src[this.pos];
            this.advance();
            if (c == '\\') {
                acc += "\\";
                if (this.pos < this.src.length) {
                    char nx = this.src[this.pos];
                    acc += (string)nx;
                    this.advance();
                }
                continue;
            }
            acc += (string)c;
            if (c == q) { return acc; }
        }
        return acc;
    }

    private Token readChar(int ln, int c) {
        char ch = ' ';
        if (this.pos < this.src.length) {
            ch = this.src[this.pos];
            this.advance();
            if (ch == '\\') {
                if (this.pos < this.src.length) {
                    char esc = this.src[this.pos];
                    this.advance();
                    if (esc == 'n') { ch = '\n'; }
                    else if (esc == 't') { ch = '\t'; }
                    else if (esc == 'r') { ch = '\r'; }
                    else if (esc == '\\') { ch = '\\'; }
                    else if (esc == '\'') { ch = '\''; }
                    else if (esc == '0') { ch = char(0); }
                    else if (esc == 'x') {
                        // Hex escape \xHH: decode 1-2 hex digits into a raw
                        // byte (matches the compiler's lexer). With no hex
                        // digit following, the char is a literal 'x'.
                        int hv = 0;
                        int nd = 0;
                        while (nd < 2 && this.pos < this.src.length) {
                            char hc = this.src[this.pos];
                            int dv = -1;
                            if (hc >= '0' && hc <= '9') { dv = hc - '0'; }
                            else if (hc >= 'a' && hc <= 'f') { dv = hc - 'a' + 10; }
                            else if (hc >= 'A' && hc <= 'F') { dv = hc - 'A' + 10; }
                            if (dv < 0) { break; }
                            this.advance();
                            hv = hv * 16 + dv;
                            nd++;
                        }
                        if (nd > 0) { ch = char(hv); } else { ch = esc; }
                    }
                    else { ch = esc; }
                }
            }
        }
        if (this.pos < this.src.length && this.src[this.pos] == '\'') {
            this.advance();
        }
        Token tok = new Token(TK_CHAR_LIT, (string)ch, ln, c);
        tok.charVal = ch;
        return tok;
    }

    private Token readNumber(char first, int ln, int c) {
        string s = (string)first;
        bool isFloat = false;
        if (first == '0' && this.pos < this.src.length) {
            char next = this.src[this.pos];
            if (next == 'x' || next == 'X') {
                s += (string)next;
                this.advance();
                while (this.pos < this.src.length) {
                    char ch = this.src[this.pos];
                    if (isHexDigit(ch)) {
                        s += (string)ch;
                        this.advance();
                    } else {
                        break;
                    }
                }
                return this.makeIntToken(s, 16, ln, c);
            }
            if (next == 'b' || next == 'B') {
                s += (string)next;
                this.advance();
                while (this.pos < this.src.length) {
                    char ch = this.src[this.pos];
                    if (ch == '0' || ch == '1') {
                        s += (string)ch;
                        this.advance();
                    } else {
                        break;
                    }
                }
                return this.makeIntToken(s, 2, ln, c);
            }
        }
        while (this.pos < this.src.length) {
            char ch = this.src[this.pos];
            if (ch.isDigit() || ch == '_') {
                s += (string)ch;
                this.advance();
            } else if (ch == '.' && !isFloat) {
                if (this.pos + 1 < this.src.length && this.src[this.pos + 1] == '.') {
                    break;
                }
                isFloat = true;
                s += (string)ch;
                this.advance();
            } else if (ch == 'e' || ch == 'E') {
                isFloat = true;
                s += (string)ch;
                this.advance();
                if (this.pos < this.src.length) {
                    char sign = this.src[this.pos];
                    if (sign == '+' || sign == '-') {
                        s += (string)sign;
                        this.advance();
                    }
                }
            } else {
                break;
            }
        }
        string clean = s.replaceAll("_", "");
        if (isFloat) {
            Token tok = new Token(TK_FLOAT_LIT, clean, ln, c);
            tok.strVal = clean;
            return tok;
        }
        Token tok = new Token(TK_INT_LIT, clean, ln, c);
        tok.intVal = clean.toInt64();
        return tok;
    }

    private Token makeIntToken(string s, int base, int ln, int c) {
        string clean = s.replaceAll("_", "");
        Token tok = new Token(TK_INT_LIT, clean, ln, c);
        if (base == 16) {
            string hex = clean.substr(2);
            // Parse the digit string manually: toLongFromBase/toInt64FromBase
            // are not dispatched by every backend, so compute the value with
            // arithmetic that all stages support (matches the compiler's lexer).
            int64 val = 0;
            for (int i = 0; i < hex.length; i++) {
                char ch = hex[i];
                int d = -1;
                if (ch >= '0' && ch <= '9') { d = ch - '0'; }
                else if (ch >= 'a' && ch <= 'f') { d = ch - 'a' + 10; }
                else if (ch >= 'A' && ch <= 'F') { d = ch - 'A' + 10; }
                if (d >= 0) { val = val * 16 + d; }
            }
            tok.intVal = val;
        } else if (base == 2) {
            string bin = clean.substr(2);
            int64 val = 0;
            for (int i = 0; i < bin.length; i++) {
                char ch = bin[i];
                if (ch == '1') { val = val * 2 + 1; }
                else if (ch == '0') { val = val * 2; }
            }
            tok.intVal = val;
        } else {
            tok.intVal = clean.toInt64();
        }
        return tok;
    }

    private Token readIdentifierOrKeyword(char first, int ln, int c) {
        string s = (string)first;
        while (this.pos < this.src.length) {
            char ch = this.src[this.pos];
            if (ch.isAlphaNum() || ch == '_') {
                s += (string)ch;
                this.advance();
            } else {
                break;
            }
        }
        int kind = keywordKind(s);
        Token tok = new Token(kind, s, ln, c);
        if (kind == TK_IDENT) {
            tok.strVal = s;
        }
        return tok;
    }

    public Token[] tokenize() {
        file.writeBytes("build/diag/TL0_lex_start.txt", [49]);
        Token[] tokens = [];
        while (true) {
            this.skipWhitespace();
            if (this.pos >= this.src.length) {
                tokens.add(new Token(TK_EOF, "", this.line, this.col));
                break;
            }
            Token? tok = this.nextToken();
            if (tok != null) {
                tokens.add(tok);
            }
        }
        file.writeBytes("build/diag/TL1_lex_end.txt", [49]);
        return tokens;
    }

    private Token? nextToken() {
        char c = this.src[this.pos];
        int ln = this.line;
        int cl = this.col;

        if (c == '/' && this.pos + 1 < this.src.length) {
            char next = this.src[this.pos + 1];
            if (next == '/') {
                this.skipLineComment();
                return null;
            }
            if (next == '*') {
                this.advance();
                this.advance();
                this.skipBlockComment();
                return null;
            }
        }

        if (c == '"') {
            this.advance();
            return this.readString(ln, cl);
        }
        if (c == '\'') {
            this.advance();
            return this.readChar(ln, cl);
        }
        if (c.isDigit()) {
            this.advance();
            return this.readNumber(c, ln, cl);
        }
        if (c.isAlpha() || c == '_') {
            this.advance();
            return this.readIdentifierOrKeyword(c, ln, cl);
        }

        this.advance();

        if (c == '(') { return new Token(TK_LPAREN, "(", ln, cl); }
        if (c == ')') { return new Token(TK_RPAREN, ")", ln, cl); }
        if (c == '{') { return new Token(TK_LBRACE, "{", ln, cl); }
        if (c == '}') { return new Token(TK_RBRACE, "}", ln, cl); }
        if (c == '[') { return new Token(TK_LBRACKET, "[", ln, cl); }
        if (c == ']') { return new Token(TK_RBRACKET, "]", ln, cl); }
        if (c == ';') { return new Token(TK_SEMI, ";", ln, cl); }
        if (c == ',') { return new Token(TK_COMMA, ",", ln, cl); }
        if (c == '~') { return new Token(TK_TILDE, "~", ln, cl); }
        if (c == '^') {
            if (this.peek() == '=') { this.advance(); return new Token(TK_CARET_EQ, "^=", ln, cl); }
            return new Token(TK_CARET, "^", ln, cl);
        }
        if (c == '?') {
            if (this.peek() == '?') {
                this.advance();
                return new Token(TK_QUESTIONQUESTION, "??", ln, cl);
            }
            return new Token(TK_QUESTION, "?", ln, cl);
        }
        if (c == '$') {
            // SPEC 12.2 / DOCS 102: an adjacent `$"..."` lexes as ONE
            // brace/quote-aware interpolation-string token, so a nested string
            // literal inside a `{...}` hole never ends the outer string. A lone
            // `$` (or `$ ` not followed by a quote) stays a Dollar token,
            // exactly like the finished backends.
            if (this.peek() == '"') {
                this.advance();
                return this.readInterpStringToken(ln, cl);
            }
            return new Token(TK_DOLLAR, "$", ln, cl);
        }

        if (c == '.') {
            if (this.pos < this.src.length && this.src[this.pos] == '.' && this.pos + 1 < this.src.length && this.src[this.pos + 1] == '.') {
                this.advance();
                this.advance();
                return new Token(TK_SPREAD, "...", ln, cl);
            }
            if (this.pos < this.src.length && this.src[this.pos] == '.') {
                this.advance();
                return new Token(TK_RANGE, "..", ln, cl);
            }
            return new Token(TK_DOT, ".", ln, cl);
        }

        if (c == ':') { return new Token(TK_COLON, ":", ln, cl); }

        if (c == '+') {
            if (this.peek() == '+') { this.advance(); return new Token(TK_INC, "++", ln, cl); }
            if (this.peek() == '=') { this.advance(); return new Token(TK_PLUS_EQ, "+=", ln, cl); }
            return new Token(TK_PLUS, "+", ln, cl);
        }
        if (c == '-') {
            if (this.peek() == '-') { this.advance(); return new Token(TK_DEC, "--", ln, cl); }
            if (this.peek() == '=') { this.advance(); return new Token(TK_MINUS_EQ, "-=", ln, cl); }
            if (this.peek() == '>') { this.advance(); return new Token(TK_ARROW, "->", ln, cl); }
            return new Token(TK_MINUS, "-", ln, cl);
        }
        if (c == '*') {
            if (this.peek() == '=') { this.advance(); return new Token(TK_STAR_EQ, "*=", ln, cl); }
            return new Token(TK_STAR, "*", ln, cl);
        }
        if (c == '/') {
            if (this.peek() == '=') { this.advance(); return new Token(TK_SLASH_EQ, "/=", ln, cl); }
            return new Token(TK_SLASH, "/", ln, cl);
        }
        if (c == '%') {
            if (this.peek() == '=') { this.advance(); return new Token(TK_PERCENT_EQ, "%=", ln, cl); }
            return new Token(TK_PERCENT, "%", ln, cl);
        }
        if (c == '&') {
            if (this.peek() == '&') { this.advance(); return new Token(TK_AND, "&&", ln, cl); }
            if (this.peek() == '=') { this.advance(); return new Token(TK_AMP_EQ, "&=", ln, cl); }
            return new Token(TK_AMP, "&", ln, cl);
        }
        if (c == '|') {
            if (this.peek() == '|') { this.advance(); return new Token(TK_OR, "||", ln, cl); }
            if (this.peek() == '=') { this.advance(); return new Token(TK_PIPE_EQ, "|=", ln, cl); }
            return new Token(TK_PIPE, "|", ln, cl);
        }
        if (c == '<') {
            if (this.peek() == '<') {
                this.advance();
                if (this.peek() == '=') { this.advance(); return new Token(TK_SHL_EQ, "<<=", ln, cl); }
                return new Token(TK_SHL, "<<", ln, cl);
            }
            if (this.peek() == '=') { this.advance(); return new Token(TK_LEQ, "<=", ln, cl); }
            return new Token(TK_LESS, "<", ln, cl);
        }
        if (c == '>') {
            if (this.peek() == '>') {
                this.advance();
                if (this.peek() == '=') { this.advance(); return new Token(TK_SHR_EQ, ">>=", ln, cl); }
                return new Token(TK_SHR, ">>", ln, cl);
            }
            if (this.peek() == '=') { this.advance(); return new Token(TK_GEQ, ">=", ln, cl); }
            return new Token(TK_GREATER, ">", ln, cl);
        }
        if (c == '=') {
            if (this.peek() == '=') { this.advance(); return new Token(TK_EQ, "==", ln, cl); }
            if (this.peek() == '>') { this.advance(); return new Token(TK_FAT_ARROW, "=>", ln, cl); }
            return new Token(TK_ASSIGN, "=", ln, cl);
        }
        if (c == '!') {
            if (this.peek() == '=') { this.advance(); return new Token(TK_NEQ, "!=", ln, cl); }
            return new Token(TK_BANG, "!", ln, cl);
        }
        if (c == '#') { return new Token(TK_HASH, "#", ln, cl); }
        if (c == '@') { return new Token(TK_AT, "@", ln, cl); }
        if (c == '_') { return new Token(TK_UNDERSCORE, "_", ln, cl); }

        printline("Warning: unexpected character '" + (string)c + "' at " + (string)ln + ":" + (string)cl);
        return null;
    }
}

int keywordKind(string s) {
    if (s == "if") { return TK_IF; }
    if (s == "else") { return TK_ELSE; }
    if (s == "while") { return TK_WHILE; }
    if (s == "for") { return TK_FOR; }
    if (s == "foreach") { return TK_FOREACH; }
    if (s == "return") { return TK_RETURN; }
    if (s == "match") { return TK_MATCH; }
    if (s == "void") { return TK_VOID; }
    if (s == "int") { return TK_INT; }
    if (s == "int32") { return TK_INT32; }
    if (s == "int64") { return TK_INT64; }
    if (s == "uint") { return TK_UINT; }
    if (s == "uint64") { return TK_UINT64; }
    if (s == "float") { return TK_FLOAT; }
    if (s == "float64") { return TK_FLOAT64; }
    if (s == "double") { return TK_DOUBLE; }
    if (s == "bool") { return TK_BOOL; }
    if (s == "char") { return TK_CHAR; }
    if (s == "string") { return TK_STRING; }
    if (s == "var") { return TK_VAR; }
    if (s == "struct") { return TK_STRUCT; }
    if (s == "class") { return TK_CLASS; }
    if (s == "enum") { return TK_ENUM; }
    if (s == "def") { return TK_DEF; }
    if (s == "found") { return TK_FOUND; }
    if (s == "collect") { return TK_COLLECT; }
    if (s == "mod") { return TK_MOD; }
    if (s == "import") { return TK_IMPORT; }
    if (s == "from") { return TK_FROM; }
    if (s == "as") { return TK_AS; }
    if (s == "new") { return TK_NEW; }
    if (s == "const") { return TK_CONST; }
    if (s == "true" || s == "false") { return TK_BOOL_LIT; }
    if (s == "null") { return TK_NULL_LIT; }
    if (s == "public") { return TK_PUBLIC; }
    if (s == "private") { return TK_PRIVATE; }
    if (s == "static") { return TK_STATIC; }
    if (s == "internal") { return TK_INTERNAL; }
    if (s == "prop") { return TK_PROP; }
    if (s == "construct") { return TK_CONSTRUCT; }
    if (s == "unset") { return TK_UNSET; }
    if (s == "mut") { return TK_MUT; }
    if (s == "ref") { return TK_REF; }
    if (s == "try") { return TK_TRY; }
    if (s == "catch") { return TK_CATCH; }
    if (s == "throw") { return TK_THROW; }
    if (s == "finally") { return TK_FINALLY; }
    if (s == "extends") { return TK_EXTENDS; }
    if (s == "in") { return TK_IN; }
    if (s == "to") { return TK_TO; }
    if (s == "switch") { return TK_SWITCH; }
    if (s == "case") { return TK_CASE; }
    if (s == "assert") { return TK_ASSERT; }
    if (s == "await") { return TK_AWAIT; }
    if (s == "fun") { return TK_FUN; }
    if (s == "elif") { return TK_ELIF; }
    if (s == "break") { return TK_BREAK; }
    if (s == "continue") { return TK_CONTINUE; }
    if (s == "local") { return TK_LOCAL; }
    if (s == "alias") { return TK_ALIAS; }
    if (s == "fixed") { return TK_FIXED; }
    if (s == "live") { return TK_LIVE; }
    if (s == "once") { return TK_ONCE; }
    if (s == "shared") { return TK_SHARED; }
    if (s == "loop") { return TK_LOOP; }
    if (s == "typealias") { return TK_TYPEALIAS; }
    return TK_IDENT;
}

bool isHexDigit(char c) {
    return c.isDigit() || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F');
}
