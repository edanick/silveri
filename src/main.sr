mod export main;

import token;
import lexer;
import parser;
import ast;
import eval;
import fs;
import cli;
import llmai_std;
import exception_std;
import project;
import guard;
import cache;

// Nested module resolution (flat-first), mirroring silverc-rs
// push_module_candidates (c7744ac) and the self-host drvDottedPath port:
// per base directory `<name>.sr` first, then dotted `a.b` -> `a/b.sr`,
// then the `<name>/<name>.sr` package convention. Flat hits always win;
// the nested layouts are pure fallbacks.

// Map dots in `name` to `sep` (`mylib.sub` -> `mylib/sub.sr` with sep "/").
string dottedModulePath(string name, string sep) {
    string out = "";
    for (int i = 0; i < name.length; i++) {
        if (name[i] == '.') { out += sep; }
        else { out += name[i]; }
    }
    return out;
}

// True when `name` is `root` itself or a dotted child of it
// (`fs.extra` under `fs`), case-insensitively. Dotted children of
// baked-in modules behave like their parents (never from disk).
bool dottedChildOrSelf(string name, string root) {
    string n = name.lower();
    string r = root.lower();
    return n == r || n.startsWith(r + ".");
}

// Native modules the interpreter provides without needing a source file.
bool nativeModule(string name) {
    string n = name.lower();
    // process is a native stdlib module on silverc-rs (stdlib::process
    // emits getFocusedProcess natively); the interpreter mirrors that:
    // std/process.sr is NOT prepended, Process.getFocusedProcess lands
    // in the builtins.sr native dispatch. Prepending the wrapper would
    // also drag in process_win, whose aliased win32 grants the parser
    // cannot spell (`X as Y`), so the source path is not viable.
    // Dotted children of native singletons behave like their parents:
    // `fs.extra` never resolves from disk, exactly like `fs`.
    return n == "fs" || n == "json" || n == "yaml"
        || n == "env" || n == "url" || n == "hash"
        || n == "path" || n == "bom" || n == "console"
        || n == "math" || n == "llmai" || n == "os"
        || n == "keyboard" || n == "mouse"
        || n == "process"
        || dottedChildOrSelf(name, "fs") || dottedChildOrSelf(name, "json")
        || dottedChildOrSelf(name, "yaml") || dottedChildOrSelf(name, "env")
        || dottedChildOrSelf(name, "url") || dottedChildOrSelf(name, "hash")
        || dottedChildOrSelf(name, "path") || dottedChildOrSelf(name, "bom")
        || dottedChildOrSelf(name, "console") || dottedChildOrSelf(name, "math")
        || dottedChildOrSelf(name, "llmai") || dottedChildOrSelf(name, "os")
        || dottedChildOrSelf(name, "keyboard") || dottedChildOrSelf(name, "mouse")
        || dottedChildOrSelf(name, "process");
}

// Case-insensitive substring search.
int findCI(string text, string needle, int start) {
    string t = text.lower();
    string n = needle.lower();
    if (start < 0) { start = 0; }
    if (n.length == 0) { return -1; }
    int lastStart = t.length - n.length;
    int result = -1;
    for (int i = start; i <= lastStart; i++) {
        bool ok = true;
        int j = 0;
        while (j < n.length) {
            if (t[i + j] != n[j]) { ok = false; }
            j++;
        }
        if (ok) { result = i; break; }
    }
    return result;
}

// The interpreter's host OS default, resolved at silveri's own compile
// time (mirrors preprocess.sr ppTargetOs): a LINUX-built silveri reports
// LINUX, a WINDOWS-built one WINDOWS, a MAC-built one MAC. An explicit
// `--os` override wins via interpTargetOsFor below.
string interpHostOs() {
    #on WINDOWS
    return "WINDOWS";
    #on LINUX
    return "LINUX";
    #on MAC
    // MAC host default (MAC.md section 3b.8). UNVALIDATED code-only
    // (MAC.md section 10): the default path cannot execution-test without
    // Mac hardware; the explicit `--os mac` override path is what the
    // code-only phase executes here.
    return "MAC";
    #off
}

// Explicit `--os` override (lowercase windows/linux/mac is the documented
// form; WINDOWS/LINUX/MAC and mixed-case also accepted, mirroring
// silverc/compiler/cli_flags.sr); "" or anything else falls back to the
// host default (never fatal).
string interpTargetOsFor(string overrideOs) {
    if (overrideOs.toLower() == "windows") { return "WINDOWS"; }
    if (overrideOs.toLower() == "linux") { return "LINUX"; }
    if (overrideOs.toLower() == "mac") { return "MAC"; }
    return interpHostOs();
}

// True when `name` is a build-mode `#on` name (`DEBUG` / `RELEASE`,
// case-sensitive, DOCS/253). Build-mode names test the build mode, not
// the target OS (mirrors silverc/compiler/preprocess.sr ppIsBuildModeName).
bool stdRegionIsBuildModeName(string name) {
    return name == "DEBUG" || name == "RELEASE";
}

// True when a single `#on` name feeds for the given target OS. OS names
// test `target`; build-mode names test the build mode, which is always
// RELEASE in the interpreter (no `--debug` flag): `RELEASE` feeds by
// default, `DEBUG` is blanked (mirrors silverc ppNameMatches with
// debugBuild=false, per DOCS/253).
bool stdRegionNameMatches(string name, string target) {
    if (stdRegionIsBuildModeName(name)) {
        return name == "RELEASE";
    }
    return name == target;
}

// A `#on` branch's match: the first name plus every ` or <name>` entry
// that follows it on the same directive line (lowercase `or` separator,
// UPPERCASE-only names, mirroring the compilers' OR-lists in DOCS/253).
// The branch feeds when ANY listed name matches its own axis (OS names
// test the target, DEBUG/RELEASE test the build mode). Lenient like the
// rest of this filter: a missing name or non-`or` tail just ends the
// list, and unknown names never match (their body stays stripped).
bool stdRegionBranchMatches(string src, int nameStart, int contentEnd, string target) {
    int nameEnd = nameStart;
    while (nameEnd < contentEnd && src[nameEnd] != ' ' && src[nameEnd] != '\t') { nameEnd++; }
    bool feeds = stdRegionNameMatches(projSlice(src, nameStart, nameEnd), target);
    int cursor = nameEnd;
    while (cursor < contentEnd) {
        int sepSkip = cursor;
        while (sepSkip < contentEnd && (src[sepSkip] == ' ' || src[sepSkip] == '\t')) { sepSkip++; }
        if (sepSkip >= contentEnd) { break; }
        int sepEnd = sepSkip;
        while (sepEnd < contentEnd && src[sepEnd] != ' ' && src[sepEnd] != '\t') { sepEnd++; }
        if (projSlice(src, sepSkip, sepEnd) != "or") { break; }
        int nextSkip = sepEnd;
        while (nextSkip < contentEnd && (src[nextSkip] == ' ' || src[nextSkip] == '\t')) { nextSkip++; }
        int nextEnd = nextSkip;
        while (nextEnd < contentEnd && src[nextEnd] != ' ' && src[nextEnd] != '\t') { nextEnd++; }
        if (nextEnd <= nextSkip) { break; }
        if (stdRegionNameMatches(projSlice(src, nextSkip, nextEnd), target)) { feeds = true; }
        cursor = nextEnd;
    }
    return feeds;
}

// DOCS/260 — the preprocessor filter for prepended std module sources,
// reduced for the interpreter. The interpreter deliberately does NOT
// implement the preprocessor as a language feature, but the v2 unified core
// library folds OS code into `#on WINDOWS ... #off` regions inside
// silverc\std\*.sr, and those raw directive lines must never reach the
// parser. This filter runs on std module text BEFORE it is prepended into
// the aggregate:
//   - `#on <target>` region bodies are kept, where target is the host OS
//     default (interpHostOs) unless `--os windows|linux|mac` overrides it.
//     Build-mode names test their own axis (DOCS/253): `RELEASE` feeds by
//     default (no flag; the interpreter has no `--debug` flag) while
//     `DEBUG` bodies stay blanked. Each name is tested against its own
//     axis, so `#on LINUX or DEBUG`-style OR-lists (lowercase `or`,
//     UPPERCASE-only names) feed when ANY listed name matches.
//   - A `#on` inside an open region does NOT nest: it closes the previous
//     branch and opens the next branch of the SAME region (chained-branch
//     rule, mirroring the compilers). First-match-wins: a branch body feeds
//     iff its OS equals the target AND no earlier branch of the same region
//     matched (`active = eq(osName, target) && !matchedAny`, then
//     `matchedAny ||= eq(osName, target)` — the same `matchedAny` rule
//     `#else` already uses).
//   - Other `#on` bodies are stripped; an `#else` body is kept only when
//     no preceding `#on` of the region matched (compiler semantics).
//   - Directive lines themselves are blank-replaced (CRLF shape preserved)
//     so line numbers stay stable, mirroring preprocess.sr's line mapping.
// Directive names stay `#on`-UPPERCASE-only (like the compilers); only the
// `--os` flag values accept lowercase. Lenient by design (this is not the
// compiler's strict validator): the filter NEVER errors. An `#else`/`#off`
// without an open region, an unknown or missing OS or build-mode name, an unclosed region
// at EOF, or a `#on` after `#else` just drops the directive line and the
// scan continues — with one deliberate leniency gap vs the compilers (which
// error on `#on` after `#else`, since `#else` must be last): here the same
// branch-switch math applies without erroring, and `sawElse` (set by `#else`,
 // reset on region open and on `#off`) is tracked but never fatal.
string filterStdRegions(string src, string target) {
    if (src.length == 0) { return src; }
    // Files without a single `#` cannot carry directives: return untouched.
    bool anyHash = false;
    for (int h = 0; h < src.length; h++) {
        if (src[h] == '#') { anyHash = true; break; }
    }
    if (!anyHash) { return src; }

    // Pass 1: pure state-machine scan recording the char offsets of every
    // line to blank (no string building), exactly like preprocess.sr.
    int[] dropAt = [];
    int[] dropNl = [];
    int[] dropCr = [];

    // mode: 0 = outside regions, 1 = inside a region.
    int mode = 0;
    bool active = false;
    bool matchedAny = false;
    // Set by `#else`, reset on region open and on `#off`. Tracked only:
    // the filter never errors, so a `#on` after `#else` still applies the
    // chained branch-switch math below (the compilers reject that shape).
    bool sawElse = false;
    int i = 0;
    while (i < src.length) {
        int nl = -1;
        for (int si = i; si < src.length; si++) {
            if (src[si] == '\n') { nl = si; break; }
        }
        int end = src.length;
        if (nl >= 0) { end = nl; }
        // Content excludes a trailing CR of CRLF terminators.
        int contentEnd = end;
        if (contentEnd > i && src[contentEnd - 1] == '\r') { contentEnd--; }

        bool drop = false;
        // Own-line rule: first non-whitespace token decides (DOCS/260), so
        // comments mentioning `#on` in prose pass through untouched.
        int p = i;
        while (p < contentEnd && (src[p] == ' ' || src[p] == '\t')) { p++; }
        if (p < contentEnd && src[p] == '#') {
            int wordEnd = p + 1;
            while (wordEnd < contentEnd && src[wordEnd] >= 'a' && src[wordEnd] <= 'z') { wordEnd++; }
            string word = projSlice(src, p + 1, wordEnd);
            if (word == "on") {
                drop = true;
                int nameStart = wordEnd;
                while (nameStart < contentEnd && (src[nameStart] == ' ' || src[nameStart] == '\t')) { nameStart++; }
                // OR-list aware (DOCS/253): the branch feeds when ANY listed
                // name matches its own axis — OS names test the target,
                // RELEASE feeds by default while DEBUG stays blanked (the
                // build mode defaults to RELEASE with no flag).
                bool matchesTarget = stdRegionBranchMatches(src, nameStart, contentEnd, target);
                if (mode == 0) {
                    mode = 1;
                    // Unknown or missing OS/build-mode names strip their body
                    // too (match stays false); only matching regions survive
                    // (directive names are UPPERCASE-only).
                    active = matchesTarget;
                    matchedAny = active;
                    sawElse = false;
                } else {
                    // Chained branch: a `#on` inside an open region closes
                    // the previous branch and opens the next one of the SAME
                    // region (never nests). First-match-wins — the same
                    // `matchedAny` math `#else` uses — so only the first
                    // matching branch feeds. Unknown or missing OS/build-mode
                    // names keep stripping (the match stays false), exactly
                    // like a top-level `#on`.
                    active = matchesTarget && !matchedAny;
                    matchedAny = matchedAny || matchesTarget;
                }
            } else if (word == "else") {
                drop = true;
                // Lenient: `#else` outside a region just drops the line.
                // Inside a region the `#else` body is kept only when no
                // preceding `#on` matched (compiler semantics).
                if (mode == 1) {
                    active = !matchedAny;
                    sawElse = true;
                }
            } else if (word == "off") {
                drop = true;
                // Lenient: `#off` outside a region just drops the line.
                mode = 0;
                sawElse = false;
            }
            // Any other line-leading `#word` is not a directive: pass
            // through unchanged (normal lexer diagnostics apply).
        } else if (mode == 1 && !active) {
            drop = true;
        }

        if (drop) {
            dropAt.add(i);
            dropNl.add(nl);
            if (contentEnd != end) { dropCr.add(1); } else { dropCr.add(0); }
        }

        if (nl < 0) { break; }
        i = nl + 1;
    }
    // Lenient: an unclosed region at EOF is not an error — whatever was
    // recorded above is simply how the text was filtered.

    if (dropAt.length == 0) { return src; }

    // Pass 2: splice — kept runs between dropped lines, one terminator per
    // blanked line, so the filtered text has exactly as many lines as the
    // original (diagnostic line numbers stay on the original file).
    string result = "";
    int copyStart = 0;
    for (int d = 0; d < dropAt.length; d++) {
        if (dropAt[d] > copyStart) {
            result += projSlice(src, copyStart, dropAt[d]);
        }
        if (dropNl[d] >= 0) {
            if (dropCr[d] == 1) { result += "\r\n"; }
            else { result += "\n"; }
        }
        if (dropNl[d] >= 0) { copyStart = dropNl[d] + 1; }
        else { copyStart = src.length; }
    }
    if (copyStart < src.length) {
        result += projSlice(src, copyStart, src.length);
    }
    return result;
}

// Read std/<module>.sr from the standard checkout locations, returning empty
// string when the file is not found at any candidate path. Candidates that
// are the input file itself are skipped -- by path spelling and by content --
// so `import * from <thisfile>` never resolves to the consuming script.
// Loaded text is passed through filterStdRegions first: the v2 unified std
// carries `#on WINDOWS ... #off` regions that the interpreter's parser must
// never see (DOCS/260).
string readStdModule(string name, string inputFile, string selfSource, string target) {    string lower = name.lower();
    // Flat-first nested layouts: dotted `a.b` -> `a/b.sr` is probed only
    // when the flat `<name>.sr` misses, and `<name>/<name>.sr` last, so
    // every existing import resolves byte-identically.
    bool hasDot = findCI(lower, ".", 0) >= 0;
    string dottedSlash = dottedModulePath(lower, "/");
    string dottedBack = dottedModulePath(lower, "\\");
    string[] paths = [];
    // Resolve user modules beside the script before probing the standard
    // library.  `silveri tests/main.sr` must be able to load tests/helper.sr,
    // not just std/helper.sr.
    int lastSep = -1;
    for (int i = 0; i < inputFile.length; i++) {
        if (inputFile[i] == '\\' || inputFile[i] == '/') { lastSep = i; }
    }
    if (lastSep >= 0) {
        string prefix = "";
        for (int pi = 0; pi <= lastSep; pi++) {
            prefix += inputFile[pi];
        }
        // The sibling prefix carries the input file's own separator, so
        // both flavors are probed for the nested layouts; flat stays first.
        paths.add(prefix + lower + ".sr");
        if (hasDot) {
            paths.add(prefix + dottedBack + ".sr");
            paths.add(prefix + dottedSlash + ".sr");
        }
        paths.add(prefix + lower + "\\" + lower + ".sr");
        paths.add(prefix + lower + "/" + lower + ".sr");
    }
    paths.add(lower + ".sr");
    if (hasDot) {
        paths.add(dottedBack + ".sr");
        paths.add(dottedSlash + ".sr");
    }
    paths.add(lower + "\\" + lower + ".sr");
    paths.add(lower + "/" + lower + ".sr");
    paths.add("std\\" + lower + ".sr");
    if (hasDot) { paths.add("std\\" + dottedBack + ".sr"); }
    paths.add("std\\" + lower + "\\" + lower + ".sr");
    paths.add("silverc\\std\\" + lower + ".sr");
    if (hasDot) { paths.add("silverc\\std\\" + dottedBack + ".sr"); }
    paths.add("silverc\\std\\" + lower + "\\" + lower + ".sr");
    paths.add("..\\std\\" + lower + ".sr");
    if (hasDot) { paths.add("..\\std\\" + dottedBack + ".sr"); }
    paths.add("..\\std\\" + lower + "\\" + lower + ".sr");
    paths.add("..\\silverc\\std\\" + lower + ".sr");
    if (hasDot) { paths.add("..\\silverc\\std\\" + dottedBack + ".sr"); }
    paths.add("..\\silverc\\std\\" + lower + "\\" + lower + ".sr");
    paths.add("..\\silveri\\src\\" + lower + ".sr");
    if (hasDot) { paths.add("..\\silveri\\src\\" + dottedBack + ".sr"); }
    paths.add("..\\silveri\\src\\" + lower + "\\" + lower + ".sr");
    paths.add("silveri\\src\\" + lower + ".sr");
    if (hasDot) { paths.add("silveri\\src\\" + dottedBack + ".sr"); }
    paths.add("silveri\\src\\" + lower + "\\" + lower + ".sr");
    // Linux spellings beside the Windows ones (mirrors
    // silverc/compiler_driver.sr): the backslash candidates never hit on
    // Linux (backslash is a filename character, not a separator), so the
    // slash forms are probed too. Additive: WINDOWS builds never see them.
    // MAC (additive): macOS uses `/` separators like Linux, so a Mac-built
    // silveri probes the same slash forms (one shared body; the WINDOWS
    // backslash candidates above are untouched).
    #on LINUX or MAC
    paths.add("std/" + lower + ".sr");
    if (hasDot) { paths.add("std/" + dottedSlash + ".sr"); }
    paths.add("std/" + lower + "/" + lower + ".sr");
    paths.add("silverc/std/" + lower + ".sr");
    if (hasDot) { paths.add("silverc/std/" + dottedSlash + ".sr"); }
    paths.add("silverc/std/" + lower + "/" + lower + ".sr");
    paths.add("../std/" + lower + ".sr");
    if (hasDot) { paths.add("../std/" + dottedSlash + ".sr"); }
    paths.add("../std/" + lower + "/" + lower + ".sr");
    paths.add("../silverc/std/" + lower + ".sr");
    if (hasDot) { paths.add("../silverc/std/" + dottedSlash + ".sr"); }
    paths.add("../silverc/std/" + lower + "/" + lower + ".sr");
    paths.add("../silveri/src/" + lower + ".sr");
    if (hasDot) { paths.add("../silveri/src/" + dottedSlash + ".sr"); }
    paths.add("../silveri/src/" + lower + "/" + lower + ".sr");
    paths.add("silveri/src/" + lower + ".sr");
    if (hasDot) { paths.add("silveri/src/" + dottedSlash + ".sr"); }
    paths.add("silveri/src/" + lower + "/" + lower + ".sr");
    #off
    for (int i = 0; i < paths.length; i++) {
        // Skip the input file itself (same path spelling).
        if (paths[i].lower() == inputFile.lower()) { continue; }
        string src = "";
        try {
            src = fs.readFile(paths[i]);
        } catch (int e) {
            src = "";
        }
        // Skip the input file itself (same content reached through a
        // different path spelling, e.g. bare-name vs absolute).
        if (src.length > 0 && src == selfSource) { continue; }
        if (src.length > 0) { return filterStdRegions(src, target); }
    }
    return "";
}

// Module names that always resolve without a source probe: the native
// modules the interpreter implements plus the ones it embeds/prepends
// itself (mirrors the compiler driver's always-resolvable list).
bool moduleAlwaysResolvable(string name) {
    string n = name.lower();
    // Dotted children of the embedded/fixed modules behave like their
    // parents (`win32.anything` needs no source, exactly like `win32`;
    // `llmai`/`os` children are already covered by nativeModule above).
    // validateNativeImports still owns the precise win32/linux/custom
    // diagnostics for these names; this only skips the disk probe.
    return nativeModule(name) || n == "exception" || n == "llmai"
        || n == "win32" || n == "http" || n == "os"
        || n == "project" || name == "LLMAI"
        || dottedChildOrSelf(name, "exception") || dottedChildOrSelf(name, "win32")
        || dottedChildOrSelf(name, "http") || dottedChildOrSelf(name, "project");
}

// DOCS/261 -- fixed native module tables (mirrors
// Evaluator.win32ModuleDll / linuxModuleLib and their parser twins): a
// prefixed source naming one of these stays on the fixed path even when a
// custom entry collides with the short name.
bool fixedWin32Module(string source) {
    if (!source.startsWith("win32.")) { return source == "win32"; }
    string n = source.substr(6);
    return n == "kernel32" || n == "ws2_32" || n == "winhttp"
        || n == "wininet" || n == "shell32" || n == "msvcrt"
        || n == "user32" || n == "registry" || n == "advapi32"
        || n == "version";
}

bool fixedLinuxModule(string source) {
    if (!source.startsWith("linux.")) { return source == "linux"; }
    string n = source.substr(6);
    return n == "libc" || n == "x11" || n == "xtst";
}

// MAC (additive, mirrors silverc-rs/src/macos.rs module_to_lib): a
// prefixed source naming one of these stays on the fixed path even when a
// custom entry collides with the short name. `mac` itself grants the fixed
// modules only; custom modules are never pulled in implicitly.
bool fixedMacModule(string source) {
    if (!source.startsWith("mac.")) { return source == "mac"; }
    string n = source.substr(4);
    return n == "libsystem" || n == "objc" || n == "appkit"
        || n == "quartz";
}

bool isNatWordChar(char c) {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_';
}

// Index of the `from` keyword separating import names and source, or -1.
// Word-boundary guarded so an export literally named `fromage` never hits.
int natFromWord(string t) {
    string lo = t.lower();
    int i = 0;
    while (i + 4 <= lo.length) {
        bool hit = lo[i] == 'f' && lo[i + 1] == 'r' && lo[i + 2] == 'o' && lo[i + 3] == 'm';
        if (hit) {
            bool preOk = i == 0 || !isNatWordChar(t[i - 1]);
            int e = i + 4;
            bool postOk = e >= lo.length || !isNatWordChar(t[e]);
            if (preOk && postOk) { return i; }
        }
        i++;
    }
    return -1;
}

// Read a dotted module path at/after pos (leading spaces skipped).
string natReadDottedFrom(string t, int pos) {
    int s = pos;
    while (s < t.length && (t[s] == ' ' || t[s] == '\t')) { s++; }
    int e = s;
    while (e < t.length && (isNatWordChar(t[e]) || t[e] == '.')) { e++; }
    string r = "";
    for (int i = s; i < e; i++) { r += t[i]; }
    return r;
}

// The import source of one statement inner (between `import` and `;`):
// "" for plain module lists (`import a, b;`) and sourceless shapes.
string natImportSource(string inner) {
    string t = inner.trim();
    if (t.startsWith("*")) {
        int f = natFromWord(t);
        if (f < 0) { return ""; }
        return natReadDottedFrom(t, f + 4);
    }
    if (t.startsWith("{")) {
        int close = -1;
        for (int i = 0; i < t.length; i++) {
            if (t[i] == '}') { close = i; break; }
        }
        if (close < 0) { return ""; }
        int f = natFromWord(t.substr(close + 1));
        if (f < 0) { return ""; }
        return natReadDottedFrom(t, close + 1 + f + 4);
    }
    int f2 = natFromWord(t);
    if (f2 < 0) { return ""; }
    return natReadDottedFrom(t, f2 + 4);
}

// True when the inner carries a `from <source>` clause on its shape.
bool natImportHasFrom(string inner) {
    string t = inner.trim();
    if (t.startsWith("*")) { return natFromWord(t) >= 0; }
    if (t.startsWith("{")) {
        int close = -1;
        for (int i = 0; i < t.length; i++) {
            if (t[i] == '}') { close = i; break; }
        }
        if (close < 0) { return false; }
        return natFromWord(t.substr(close + 1)) >= 0;
    }
    return natFromWord(t) >= 0;
}

// Granted/plain names of one statement inner (empty for star forms).
string[] natImportNames(string inner) {
    string[] result = [];
    string t = inner.trim();
    if (t.startsWith("*")) { return result; }
    string head = t;
    if (t.startsWith("{")) {
        int close = -1;
        for (int i = 0; i < t.length; i++) {
            if (t[i] == '}') { close = i; break; }
        }
        if (close < 0) { return result; }
        head = t.substr(1, close - 1);
    } else {
        int f = natFromWord(t);
        if (f >= 0) { head = t.substr(0, f); }
    }
    string[] parts = head.split(",");
    for (int i = 0; i < parts.length; i++) {
        string p = parts[i].trim();
        if (p.length > 0) { result.add(p); }
    }
    return result;
}

bool natImportStar(string inner) {
    return inner.trim().startsWith("*");
}

// True when the aggregate program already declares `mod export <name>;`
// (project-local and `.qs` bundle Silver modules, already concatenated).
// Dotted declarations (`mod export mini_cg.windows;`) read whole, mirroring
// natReadDottedFrom; plain identifiers contain no dot and behave identically.
bool aggregateDeclaresModule(string source, string name) {
    int cursor = 0;
    while (cursor < source.length) {
        int pos = findCI(source, "mod export ", cursor);
        if (pos < 0) { return false; }
        if (pos > 0) {
            char prev = source[pos - 1];
            if (prev != '\n' && prev != '\r' && prev != ';') {
                cursor = pos + 1;
                continue;
            }
        }
        int s = pos + 11;
        while (s < source.length && (source[s] == ' ' || source[s] == '\t')) { s++; }
        int e = s;
        while (e < source.length && (isNatWordChar(source[e]) || source[e] == '.')) { e++; }
        string got = "";
        for (int k = s; k < e; k++) { got += source[k]; }
        if (got.toLower() == name.toLower()) { return true; }
        if (e <= pos + 11) { cursor = pos + 1; } else { cursor = e; }
    }
    return false;
}

// True when a bare name resolves to Silver (never native): interpreter
// native singletons, embedded modules, project-local or `.qs` stems,
// `mod export` declarations in the aggregate, or a std/beside-script file.
bool natSilverResolves(string name, string source, string inputFile, string target) {
    if (nativeModule(name) || moduleAlwaysResolvable(name)) { return true; }
    if (customNativeSilverShadow(name)) { return true; }
    if (aggregateDeclaresModule(source, name)) { return true; }
    string modSrc = readStdModule(name, inputFile, source, target);
    return modSrc.length > 0;
}

// DOCS/261 -- `.qs` bundle spans in flattened text: flat [begin, end]
// pairs of 1-based line ranges strictly inside a
// `//__silveri_qs_begin__` / `//__silveri_qs_end__` pair (emitted by the
// project loader around each bundled module source). Imports there belong
// to the `.qs` library and always verify custom natives against the
// consumer's declarations.
int[] qsBundleSpans(string source) {
    int[] spans = [];
    int lineNo = 1;
    int lineStart = 0;
    int openBegin = -1;
    for (int li = 0; li <= source.length; li++) {
        bool eol = li == source.length || source[li] == '\n';
        if (!eol) { continue; }
        string lineText = "";
        for (int k = lineStart; k < li; k++) { lineText += source[k]; }
        if (lineText.trim() == "//__silveri_qs_begin__") { openBegin = lineNo; }
        else if (lineText.trim() == "//__silveri_qs_end__") {
            if (openBegin >= 0) {
                spans.add(openBegin);
                spans.add(lineNo);
                openBegin = -1;
            }
        }
        lineNo++;
        lineStart = li + 1;
    }
    return spans;
}

int natImportLine(string source, int importPos) {
    int line = 1;
    for (int q = 0; q < importPos; q++) {
        if (source[q] == '\n') { line++; }
    }
    return line;
}

bool natInBundle(int[] spans, int line) {
    for (int b = 0; b + 1 < spans.length; b += 2) {
        if (spans[b] < line && line < spans[b + 1]) { return true; }
    }
    return false;
}

// Grouped interpreter diagnostics: `[file]` headers over unchanged bodies.
//
// silverc-rs prints one `[file]` header per file on the error stream and keeps
// every error body byte-identical; the self-host mirrors that shape on the
// stream its diagnostics already use (stdout via printline), and so does the
// interpreter here: headers and bodies all go through printline, the stream
// these diagnostics already use.
//
// The interpreter lexes and parses the import-resolved program as ONE unit,
// so per-file attribution is impossible and every diagnostic belongs to the
// entry file: a single `[input-as-given]` header, bodies untouched. Errors
// with no attributable file likewise fall under the entry header. The
// per-file owner list stays explicit (stable grouping: first-seen file order,
// source order within a file) so the shape matches the reference printers.
void printGroupedDiagnostics(string[] msgs, string entryName) {
    if (msgs.length == 0) { return; }
    string[] owners = [];
    for (int m = 0; m < msgs.length; m++) { owners.add(entryName); }
    string[] order = [];
    for (int m = 0; m < owners.length; m++) {
        bool seen = false;
        for (int o = 0; o < order.length; o++) {
            if (order[o] == owners[m]) { seen = true; break; }
        }
        if (!seen) { order.add(owners[m]); }
    }
    for (int o = 0; o < order.length; o++) {
        printline("[" + order[o] + "]");
        for (int m = 0; m < msgs.length; m++) {
            if (owners[m] == order[o]) { printline(msgs[m]); }
        }
    }
}

// A file-attributable native/import diagnostic: single `[input-as-given]`
// header with the unchanged body, then abort (these sites always exited
// right after printing).
void failEntryDiagnostic(string msg, string entryName) {
    printline("[" + entryName + "]");
    printline(msg);
    exit(1);
}

// DOCS/261 -- validate one parsed import against the fixed tables plus the
// manifest's custom declarations. Failures print the contract message and
// exit, mirroring the compilers' import-site errors in interpreter style.
void checkOneNativeImport(string origin, string[] names, bool star, bool inBundle, string source, string inputFile, string target) {
    if (origin == "") {
        // Plain module lists (`import a, b;`): Silver spellings stay
        // silent; only declared custom singletons verify (wrong side, then
        // the single-export hint, mirroring the compilers' module-grant
        // rejection for bare whole-module imports).
        for (int i = 0; i < names.length; i++) {
            string n = names[i];
            if (natSilverResolves(n, source, inputFile, target)) { continue; }
            if (!customNativeDeclared(n)) { continue; }
            if (customNativeFileFor(n, target) == "") {
                failEntryDiagnostic(customNativeSideError(n, target), inputFile);
            }
            failEntryDiagnostic(customNativeStarMsg(n), inputFile);
        }
        return;
    }
    if (origin == "win32" || (origin.length > 6 && origin.substr(0, 6) == "win32.")) {
        if (origin == "win32") {
            // `import * from win32;` grants the fixed modules only; custom
            // modules are never pulled in implicitly.
            if (star) { return; }
            for (int i = 0; i < names.length; i++) {
                string full = "win32." + names[i];
                if (fixedWin32Module(full)) { continue; }
                if (customNativeHasWin(names[i])) {
                    failEntryDiagnostic(customNativeStarMsg(full), inputFile);
                }
                failEntryDiagnostic(customNativeUndeclaredMsg(full), inputFile);
            }
            return;
        }
        string winMod = origin.substr(6);
        // A custom name colliding with a fixed module resolves to fixed.
        if (fixedWin32Module(origin)) { return; }
        if (!customNativeHasWin(winMod)) {
            failEntryDiagnostic(customNativeUndeclaredMsg(origin), inputFile);
        }
        // Declared custom modules take single-export grants only.
        if (star) {
            failEntryDiagnostic(customNativeStarMsg(origin), inputFile);
        }
        return;
    }
    if (origin == "linux" || (origin.length > 6 && origin.substr(0, 6) == "linux.")) {
        if (origin == "linux") {
            if (star) { return; }
            for (int j = 0; j < names.length; j++) {
                string full = "linux." + names[j];
                if (fixedLinuxModule(full)) { continue; }
                if (customNativeHasLin(names[j])) {
                    failEntryDiagnostic(customNativeStarMsg(full), inputFile);
                }
                failEntryDiagnostic(customNativeUndeclaredMsg(full), inputFile);
            }
            return;
        }
        string linMod = origin.substr(6);
        if (fixedLinuxModule(origin)) { return; }
        if (!customNativeHasLin(linMod)) {
            failEntryDiagnostic(customNativeUndeclaredMsg(origin), inputFile);
        }
        if (star) {
            failEntryDiagnostic(customNativeStarMsg(origin), inputFile);
        }
        return;
    }
    // MAC (additive, mirrors the linux arm): fixed mac modules resolve on
    // the fixed path. Prefixed custom mac modules are not supported (the
    // manifest declares windows/linux files only; eval.sr and parser.sr
    // grant custom names without a mac prefix), so a non-fixed `mac.X`
    // names the declaration to add.
    if (origin == "mac" || (origin.length > 4 && origin.substr(0, 4) == "mac.")) {
        if (origin == "mac") {
            if (star) { return; }
            for (int k = 0; k < names.length; k++) {
                string full = "mac." + names[k];
                if (fixedMacModule(full)) { continue; }
                failEntryDiagnostic(customNativeUndeclaredMsg(full), inputFile);
            }
            return;
        }
        if (fixedMacModule(origin)) { return; }
        failEntryDiagnostic(customNativeUndeclaredMsg(origin), inputFile);
    }
    if (nativeModule(origin) || moduleAlwaysResolvable(origin)) { return; }
    // Bare-name precedence: project-local sources, `.qs` bundle modules,
    // and std modules win over custom native names.
    if (natSilverResolves(origin, source, inputFile, target)) { return; }
    if (!customNativeDeclared(origin)) {
        // Inside a manifest that opts into `nativeModules`, or inside a
        // consumed `.qs` bundle flattened into the aggregate, an
        // unresolvable bare source names the declaration to add;
        // standalone runs keep the driver's historical diagnostics.
        if (inBundle || customNativeOptIn()) {
            failEntryDiagnostic(customNativeUndeclaredMsg(origin), inputFile);
        }
        return;
    }
    if (customNativeFileFor(origin, target) == "") {
        failEntryDiagnostic(customNativeSideError(origin, target), inputFile);
    }
    if (star && customNativeStarExports(origin, target).length == 0) {
        failEntryDiagnostic(customNativeStarMsg(origin), inputFile);
    }
}

// DOCS/261 -- validate every import statement's native source in the
// flattened program (project sources plus consumed `.qs` bundle sources,
// so a bundle needing an undeclared custom module fails naming the
// declaration). Statement-boundary anchored like resolveImports; same-line
// `//` marks a commented-out import, never a statement.
void validateNativeImports(string source, string inputFile, string target) {
    int[] spans = qsBundleSpans(source);
    int cursor = 0;
    while (cursor < source.length) {
        // Word match on `import` (not `"import "`): minified `.qs` bundle
        // sources spell imports without spaces (`import{f}from m;`), and
        // the lexer accepts those shapes too.
        int importPos = -1;
        int probe = cursor;
        while (probe < source.length) {
            int at = findCI(source, "import", probe);
            if (at < 0) { break; }
            bool preOk = at == 0 || source[at - 1] == '\n' || source[at - 1] == '\r' || source[at - 1] == ';';
            int after = at + 6;
            bool postOk = after >= source.length || !isNatWordChar(source[after]);
            if (preOk && postOk) { importPos = at; break; }
            probe = at + 1;
        }
        if (importPos < 0) { break; }
        bool commented = false;
        int lineStart = importPos;
        while (lineStart > 0 && source[lineStart - 1] != '\n' && source[lineStart - 1] != '\r') { lineStart--; }
        for (int ci = lineStart; ci + 1 < importPos; ci++) {
            if (source[ci] == '/' && source[ci + 1] == '/') { commented = true; }
        }
        int semi = -1;
        for (int si = importPos; si < source.length; si++) {
            if (source[si] == ';') { semi = si; break; }
        }
        if (semi < 0) { break; }
        if (commented) {
            cursor = semi + 1;
            continue;
        }
        string inner = "";
        for (int ii = importPos + 6; ii < semi; ii++) { inner += source[ii]; }
        bool star = natImportStar(inner);
        bool brace = inner.trim().startsWith("{");
        if ((star || brace) && !natImportHasFrom(inner)) {
            cursor = semi + 1;
            continue;
        }
        string origin = natImportSource(inner);
        string[] names = natImportNames(inner);
        checkOneNativeImport(origin, names, star, natInBundle(spans, natImportLine(source, importPos)), source, inputFile, target);
        cursor = semi + 1;
    }
}

// Known built-in module names used for did-you-mean suggestions on imports
// (SYNTAX_EXCEPTIONS.md).
string[] knownModuleNames = [
    "fs", "json", "yaml", "env",
    "url", "hash", "path", "bom",
    "console", "math", "http",
    "llmai", "os", "keyboard",
    "mouse", "time", "exception",
    "process", "notifications", "registry",
    "system_tray", "gui", "string",
    "cli", "win32"
];

// Compute the 1-based line and column of a character offset in src.
int[] diagSourceLoc(string src, int off) {
    int total = src.length;
    if (off > total) { off = total; }
    if (off < 0) { off = 0; }
    int line = 1;
    int lineStart = 0;
    for (int i = 0; i < off; i++) {
        if (src[i] == '\n') { line++; lineStart = i + 1; }
    }
    int[] loc = [];
    loc.add(line);
    loc.add(off - lineStart + 1);
    return loc;
}

// Resolve `import * from <module>` statements in `source` by prepending
// std/<module>.sr content for non-native modules. Native modules are
// handled directly by the interpreter and must not be loaded from disk.
// Unknown modules are reported with SYNTAX_EXCEPTIONS.md diagnostics.
// The total length of the prepended region is reported through
// prependLen[0] so the evaluator knows where the project's own sources
// begin (the `internal` visibility boundary).
// Match `import * from <name>` at pos with any spacing around the star
// and `from`: project sources spell `import * from net;` while minified
// `.qs` bundle sources spell `import*from net;`. Sets bounds[0]/bounds[1]
// to the module name bounds and returns true; otherwise false (the
// caller skips past). The `from` keyword match is case-insensitive like
// the import finder; a longer word (`fromage`) never matches.
bool matchStarImport(string source, int pos, int[] bounds) {
    int i = pos + 6;
    while (i < source.length && source[i] == ' ') { i++; }
    if (i >= source.length || source[i] != '*') { return false; }
    i++;
    while (i < source.length && source[i] == ' ') { i++; }
    if (i + 4 > source.length) { return false; }
    string w = "";
    for (int k = i; k < i + 4; k++) { w += source[k]; }
    if (w.lower() != "from") { return false; }
    int after = i + 4;
    if (after < source.length && isNatWordChar(source[after])) { return false; }
    i = after;
    while (i < source.length && source[i] == ' ') { i++; }
    int ns = i;
    while (i < source.length && (isNatWordChar(source[i]) || source[i] == '.')) { i++; }
    if (i == ns) { return false; }
    bounds[0] = ns;
    bounds[1] = i;
    return true;
}

// `import NAME from SRC;` / `import {A, B} from SRC;` -- the source module
// (dotted allowed) lands in bounds, mirroring matchStarImport. Star forms are
// left to matchStarImport. The binding name / brace list before `from` is
// skipped; resolution loads SRC and its classes/functions become visible.
bool matchFromImport(string source, int pos, int[] bounds) {
    int i = pos + 6;
    while (i < source.length && source[i] == ' ') { i++; }
    if (i >= source.length) { return false; }
    if (source[i] == '*') { return false; }
    if (source[i] == '{') {
        while (i < source.length && source[i] != '}') { i++; }
        if (i >= source.length) { return false; }
        i++;
    } else {
        while (i < source.length && (isNatWordChar(source[i]) || source[i] == '.')) { i++; }
    }
    while (i < source.length && source[i] == ' ') { i++; }
    if (i + 4 > source.length) { return false; }
    string w = "";
    for (int k = i; k < i + 4; k++) { w += source[k]; }
    if (w.lower() != "from") { return false; }
    int after = i + 4;
    if (after < source.length && isNatWordChar(source[after])) { return false; }
    i = after;
    while (i < source.length && source[i] == ' ') { i++; }
    int ns = i;
    while (i < source.length && (isNatWordChar(source[i]) || source[i] == '.')) { i++; }
    if (i == ns) { return false; }
    bounds[0] = ns;
    bounds[1] = i;
    return true;
}

string resolveImports(string source, string inputFile, int[] prependLen, string target) {    if (prependLen.length == 0) { prependLen.add(0); } else { prependLen[0] = 0; }
    string prepend = "";
    bool badModule = false;
    // Unknown-module bodies buffered in source order; the driver prints them
    // grouped under the single `[input-as-given]` header below.
    string[] unknownModMsgs = [];
    // DOCS/259 -- fixpoint star-import resolution: pass 1 scans the user
    // source; later passes re-scan the accumulated prepend, so nested
    // source imports (dialogs -> msgbox, ftps -> net, sysinfo -> env, ...)
    // resolve too. seenMods guards cycles and double-prepends (importing
    // both dialogs and msgbox prepends msgbox exactly once); each pass
    // prepends at least one module or the loop ends. First-pass behavior
    // is unchanged (aggregate == source while prepend is empty).
    string seenMods = ";";
    bool changed = true;
    while (changed) {
        changed = false;
        string aggregate = prepend + source;
        int[] aggSpans = qsBundleSpans(aggregate);
    int cursor = 0;
    while (cursor < aggregate.length) {
        int importPos = findCI(aggregate, "import", cursor);
        if (importPos < 0) { break; }
        // Only treat a match as an import statement when it starts at a
        // statement boundary; otherwise it is `import` text inside a
        // string literal or comment and must be skipped. The keyword must
        // also stand alone (`myimport` is not an import).
        if (importPos > 0) {
            char prev = aggregate[importPos - 1];
            if (prev != '\n' && prev != '\r' && prev != ';') {
                cursor = importPos + 1;
                continue;
            }
        }
        int afterImport = importPos + 6;
        if (afterImport < aggregate.length && isNatWordChar(aggregate[afterImport])) {
            cursor = importPos + 1;
            continue;
        }
        // Star-import shape with any spacing (`import * from m;` in
        // sources, `import*from m;` in minified `.qs` bundles), and the
        // named/braced `from` shapes (`import x from m;`,
        // `import {a, b} from m;`) -- DOCS/260. Any other `import` spelling
        // (a bare `import m;`) belongs to the plain pass below.
        int[] mm = [];
        mm.add(0);
        mm.add(0);
        if (!matchStarImport(aggregate, importPos, mm) && !matchFromImport(aggregate, importPos, mm)) {
            cursor = importPos + 1;
            continue;
        }
        int semi = -1;
        for (int si = importPos; si < aggregate.length; si++) {
            if (aggregate[si] == ';') { semi = si; break; }
        }
        if (semi < 0) { break; }
        int nameStart = mm[0];
        int nameEnd = mm[1];
        // Dotted module names (`mylib.sub`) already read whole by the
        // matcher, mirroring the compilers' projectImportModule; native
        // dotted sources are skipped below before any file probe.
        string module = "";
        for (int mi = nameStart; mi < nameEnd; mi++) {
            module += aggregate[mi];
        }
        // Already prepended (or otherwise settled) on an earlier pass:
        // skip so cycles terminate and double imports prepend once.
        if (module.length > 0 && seenMods.contains(";" + module + ";")) {
            cursor = semi + 1;
            continue;
        }
        if (module.length > 0) { seenMods += module + ";"; }
        // Fixed win32/linux/mac natives (and bare `win32`/`linux`/`mac`)
        // never come from disk: native prefix handling stays before file
        // probing, and validateNativeImports owns their diagnostics and
        // grants.
        if (module.length > 0 && !nativeModule(module)
            && !fixedWin32Module(module) && !fixedLinuxModule(module)
            && !fixedMacModule(module)) {
            string modSrc = readStdModule(module, inputFile, source, target);
            if (modSrc.length > 0) {
                prepend += modSrc + "\n";
                changed = true;
            } else if (aggregateDeclaresModule(aggregate, module)) {
                // Satisfied by a project-local or `.qs` bundle module
                // already in the aggregate: Silver wins over custom names.
            } else if (moduleAlwaysResolvable(module)) {
                // Fixed/embedded modules need no source.
            } else if (customNativeDeclared(module)) {
                // DOCS/261 -- star import on a declared custom native:
                // wrong-target side and missing export list fail here with
                // the contract message; the grant itself registers later.
                if (customNativeFileFor(module, target) == "") {
                    failEntryDiagnostic(customNativeSideError(module, target), inputFile);
                }
                if (customNativeStarExports(module, target).length == 0) {
                    failEntryDiagnostic(customNativeStarMsg(module), inputFile);
                }
            } else if (natInBundle(aggSpans, natImportLine(aggregate, importPos)) || customNativeOptIn()) {
                // The manifest opts into custom natives (or the star comes
                // from a consumed `.qs` bundle): an unresolvable star
                // source names the declaration to add.
                failEntryDiagnostic(customNativeUndeclaredMsg(module), inputFile);
            } else {
                // SYNTAX_EXCEPTIONS.md ? unknown module, with a did-you-mean
                // suggestion when it resembles a known one.
                badModule = true;
                int[] loc = diagSourceLoc(aggregate, nameStart);
                string sugg = diagClosestMatch(module, knownModuleNames);
                if (sugg.length > 0) {
                    unknownModMsgs.add("did you mean to import the module \"" + sugg + "\"?, unknown module \"" + module + "\" was found at line " + (string)loc[0] + " column " + (string)loc[1]);
                } else {
                    unknownModMsgs.add("unknown module \"" + module + "\" was found at line " + (string)loc[0] + ", column " + (string)loc[1] + ". module either doesn't exist or not installed.");
                }
            }
        }
        cursor = semi + 1;
    }
    }
    if (badModule) {
        printGroupedDiagnostics(unknownModMsgs, inputFile);
        exit(1);
    }
    // Plain source-module imports (`import helper_suite;`) load the module's
    // source too when it can be found, mirroring the compiler driver. Star/
    // list forms with a `from <target>` clause were handled above; bare-name
    // imports name the source module directly. Resolution stays best-effort:
    // an unfound plain module is skipped silently (historical behavior).
    string plainPrepend = "";
    int cursor2 = 0;
    while (cursor2 < source.length) {
        int importPos2 = findCI(source, "import ", cursor2);
        if (importPos2 < 0) { break; }
        if (importPos2 > 0) {
            char prev2 = source[importPos2 - 1];
            if (prev2 != '\n' && prev2 != '\r' && prev2 != ';') {
                cursor2 = importPos2 + 1;
                continue;
            }
        }
        int semi2 = -1;
        for (int si2 = importPos2; si2 < source.length; si2++) {
            if (source[si2] == ';') { semi2 = si2; break; }
        }
        if (semi2 < 0) { break; }
        int p = importPos2 + 7;
        string stmtText = "";
        for (int ci = p; ci < semi2; ci++) { stmtText += source[ci]; }
        // Skip star forms (`import * from x;`) -- already handled above --
        // and win32/native-list forms (`import { a } from win32;`,
        // `import kernel32 from win32;`).
        string trimmed = stmtText.trim();
        if (trimmed.startsWith("*") || trimmed.contains("{")
            || trimmed.startsWith("kernel32") || trimmed.contains(" from ")) {
            cursor2 = semi2 + 1;
            continue;
        }
        // Comma-separated bare module names.
        string[] parts = trimmed.split(",");
        for (int pi = 0; pi < parts.length; pi++) {
            string modName = parts[pi].trim();
            if (modName.length == 0) { continue; }
            if (nativeModule(modName) || moduleAlwaysResolvable(modName)) { continue; }
            string modSrc = readStdModule(modName, inputFile, source, target);
            if (modSrc.length > 0) {
                plainPrepend += modSrc + "\n";
            }
        }
        cursor2 = semi2 + 1;
    }
    string combined = prepend;
    if (plainPrepend.length > 0) {
        combined += plainPrepend + "\n";
    }
    if (combined.length > 0) {
        prependLen[0] = combined.length;
        return combined + source;
    }
    return source;
}

void printHelp() {
    printline("silveri " + APP_VERSION);
    printline("Copyright: © 2025 Edan M.");
    printline("License: " + APP_LICENSE);
    printline("Silver language version: " + LANG_VERSION);
    printline("");
    printline("Usage: silveri [options] <filename>");
    printline("");
    printline("Options:");
    printline("  -i <file>      Input Silver source file");
    printline("  -o <file>      Output file (ignored in interpreter)");
    printline("  --cache-bytecode  Run bytecode interpretation via the persistent cache");
    printline("  --os windows|linux|mac  Target OS for std region filtering (default: host)");
    printline("  --diag  Write per-call/per-block diagnostic crumbs to build/diag/ (slow)");
    printline("  --help, -h     Show this help message");
    printline("  --version      Show version information");
    printline("");
    printline("Examples:");
    printline("  silveri script.sr              Run a Silver script");
    printline("  silveri -i script.sr           Run a Silver script");
}

void main() {
    // Diagnostic crumbs go into a subfolder so they never pollute the
    // working directory (e.g. when running tests/ scripts).
    // Option parsing goes through the `cli` module (DOCS/252) so the same
    // spelling rules apply as silverc and the self-hosted compiler.
    string[] args = cargs;

    if (args.length < 2) {
        printHelp();
        exit(1);
    }

    string filename = "";
    string[] scriptArgs = [];
    bool cacheBytecode = false;
    string osOverride = "";
    bool diagCrumbs = false;

    for (int i = 1; i < args.length; i++) {
        string arg = args[i];
        if (arg == "-h" || arg == "--help") {
            printHelp();
            return;
        }
        if (arg == "--version") {
            printline("silveri " + APP_VERSION);
            printline("Silver " + LANG_VERSION);
            printline("Copyright: © 2025 Edan M.");
            printline("License: " + APP_LICENSE);
            return;
        }
        if (arg == "--cache-bytecode") {
            cacheBytecode = true;
        } else if (arg == "--diag") {
            diagCrumbs = true;
        } else if (arg == "--os") {
            // Preprocessor target override (lowercase windows/linux/mac is
            // the documented form; UPPERCASE also accepted, mirroring
            // silverc/compiler/cli_flags.sr). A missing or unknown value
            // is fatal here, like the compilers' flag validation.
            string v = cli.valueAfter(args, i);
            if (v.toLower() == "windows") {
                osOverride = "WINDOWS";
                i++;
            } else if (v.toLower() == "linux") {
                osOverride = "LINUX";
                i++;
            } else if (v.toLower() == "mac") {
                osOverride = "MAC";
                i++;
            } else {
                printline("Error: --os expects one of windows, linux, mac (WINDOWS, LINUX, MAC also accepted), got '" + v + "'");
                exit(1);
            }
        } else if (arg == "-i") {
            string v = cli.valueAfter(args, i);
            if (v != "") {
                filename = v;
                i++;
            } else {
                printline("Error: -i requires a filename");
                exit(1);
            }
        } else if (arg == "-o") {
            // -o is accepted for command compatibility but ignored because
            // silveri executes source directly instead of producing a
            // compiled output file.
            string v = cli.valueAfter(args, i);
            if (v != "") {
                i++;
            } else {
                printline("Error: -o requires a filename");
                exit(1);
            }
        } else if (cli.isOption(arg)) {
            printline("Error: Unknown option '" + arg + "'");
            printHelp();
            exit(1);
        } else if (filename == "") {
            filename = arg;
        } else {
            // DOCS/124 -- trailing positional arguments after the script name
            // are the script's own command-line arguments (cargs).
            scriptArgs.add(arg);
        }
    }

    if (filename == "") {
        printline("Error: No input file specified");
        printline("Usage: silveri [options] <filename>");
        exit(1);
    }

    string inputSource = "";
    // Region-filter target: explicit `--os` wins, otherwise the host OS
    // the interpreter itself was built for (interpHostOs).
    string target = interpTargetOsFor(osOverride);
    if (filename.endsWith(".srp")) {
        // Own-source load point (v2 fold): the .srp aggregate builder reads
        // each source file raw, so the region filter runs on the assembled
        // text here -- silveri's own src files now carry `#on WINDOWS ... #off`
        // regions (builtins.sr's folded backend), and the interpreter's
        // parser must never see the directive lines. The filter blanks
        // directive lines but preserves every other line, so line counts
        // (and the prepend boundary computed below) stay file-accurate.
        inputSource = filterStdRegions(loadProjectSource(filename), target);
    } else {
        // `.col` declarations require a project manifest. Reuse the project
        // loader's validation so standalone scripts report
        // UnknownCollectionException instead of a generic parser error.
        // Same filter as the project path: a script (or its .col expansions)
        // carrying regions is filtered before lexing.
        inputSource = filterStdRegions(projExpandCollections(fs.readFile(filename), ".", ""), target);
    }

    // Resolve `import * from <module>` statements by prepending the module
    // source (like the compiler driver does) so its classes, constants and
    // functions are registered before the user source runs.
    int[] prependLen = [];
    inputSource = resolveImports(inputSource, filename, prependLen, target);

    // DOCS/261 -- validate native import sources (fixed plus the manifest's
    // custom declarations) before lexing, so undeclared names, wrong-target
    // sides, and list-less star imports fail with the contract message.
    validateNativeImports(inputSource, filename, target);

    // `internal` visibility boundary: the first line of the project's own
    // sources in the flattened program. Everything the driver prepended
    // before it belongs to external modules whose internal items are off
    // limits to project code.
    int boundaryLine = 0;
    if (prependLen.length > 0 && prependLen[0] > 0) {
        int newlines = 0;
        for (int bi = 0; bi < prependLen[0] && bi < inputSource.length; bi++) {
            if (inputSource[bi] == '\n') { newlines++; }
        }
        boundaryLine = newlines + 1;
    }

    Token[] tokens;
    int[] lineLens = [];
    if (cacheBytecode) {
        string cacheRoot = projDirname(filename);
        string cacheProject = "";
        int lastDot = -1;
        int lastSep = -1;
        for (int di = 0; di < filename.length; di++) {
            if (filename[di] == '.' && di > lastSep) { lastDot = di; }
            if (filename[di] == '/' || filename[di] == '\\') { lastSep = di; }
        }
        if (lastDot > lastSep + 1) {
            for (int ci = lastSep + 1; ci < lastDot; ci++) { cacheProject += filename[ci]; }
        } else {
            cacheProject = "silveri_default";
        }
        CacheSession cache = new CacheSession(cacheRoot, cacheProject);
        tokens = cache.tokensFor(filename, inputSource);
        cache.flush();
        // Cached-path lex diagnostics print grouped under the entry header
        // like the direct path; control flow is unchanged (historically the
        // cached path continued past lex errors).
        if (cache.lexErrors > 0) {
            printGroupedDiagnostics(cache.lexMessages, filename);
        }
        // Compute line lengths from the source for bracket diagnostics.
        int current = 0;
        for (int i = 0; i < inputSource.length; i++) {
            char c = inputSource[i];
            if (c == '\n') {
                lineLens.add(current);
                current = 0;
            } else if (c != '\r') {
                current++;
            }
        }
        lineLens.add(current);
    } else {
        Lexer lexer = new Lexer(inputSource);
        tokens = lexer.tokenize();
        if (lexer.errorCount() > 0) {
            printGroupedDiagnostics(lexer.messages(), filename);
            exit(1);
        }
        lineLens = lexer.lineLengths();
    }

    Parser p = new Parser(tokens);
    p.setLineLengths(lineLens);
    p.setCustomTarget(target);
    Node[] program = p.parseProgram();
    if (p.errorCount() > 0) {
        printGroupedDiagnostics(p.messages(), filename);
        exit(1);
    }

    Evaluator evaluator = new Evaluator();
    evaluator.setDiagCrumbs(diagCrumbs);
    evaluator.setProjectBoundary(boundaryLine);
    evaluator.setCustomTarget(target);
    string[] userCargs = [];
    userCargs.add(filename);
    for (int i = 0; i < scriptArgs.length; i++) {
        userCargs.add(scriptArgs[i]);
    }
    evaluator.setScriptArgs(userCargs);
    string preludeSrc = source();
    Lexer preludeLexer = new Lexer(preludeSrc);
    Token[] preludeTokens = preludeLexer.tokenize();
    // Prelude lex diagnostics print grouped under the entry header;
    // control flow is unchanged (historically non-fatal here).
    if (preludeLexer.errorCount() > 0) {
        printGroupedDiagnostics(preludeLexer.messages(), filename);
    }
    Parser preludeParser = new Parser(preludeTokens);
    preludeParser.setLineLengths(preludeLexer.lineLengths());
    Node[] llmaiPrelude = preludeParser.parseProgram();
    if (preludeParser.errorCount() > 0) {
        printGroupedDiagnostics(preludeParser.messages(), filename);
        exit(1);
    }
    evaluator.register(llmaiPrelude);

    string excSrc = exceptionSource();
    Lexer excLexer = new Lexer(excSrc);
    Token[] excTokens = excLexer.tokenize();
    // Exception-prelude lex diagnostics: same grouped, non-fatal treatment.
    if (excLexer.errorCount() > 0) {
        printGroupedDiagnostics(excLexer.messages(), filename);
    }
    Parser excParser = new Parser(excTokens);
    excParser.setLineLengths(excLexer.lineLengths());
    Node[] excPrelude = excParser.parseProgram();
    if (excParser.errorCount() > 0) {
        printGroupedDiagnostics(excParser.messages(), filename);
        exit(1);
    }
    evaluator.register(excPrelude);

    // Post-parse call diagnostics (SYNTAX_EXCEPTIONS.md unknown method,
    // VALUE_EXCEPTION.md filesystem path literals) run on the user program
    // once the whole symbol table is visible.
    p.checkCallDiagnostics(program);
    if (p.errorCount() > 0) {
        printGroupedDiagnostics(p.messages(), filename);
        exit(1);
    }

    MemoryGuard guard = new MemoryGuard();
    guard.checkProgram(program);

    evaluator.run(program);
}
