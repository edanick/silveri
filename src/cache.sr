mod export cache;

import resource;
import * from string;

// Raw OS enablers for the cache writers and stamps (kernel32 handles/writes,
// msvcrt time) — file-top grant, mirroring the unified std fold shape.
#on WINDOWS
import * from win32.kernel32;
import * from win32.msvcrt;
#on LINUX
import * from linux.libc;
#on MAC
import * from mac.libsystem;
#off

// OVERHAUL.md --cache-bytecode — persistent bytecode cache for the
// interpreter. Same reference binary formats as the compilers; everything
// the tier writes lives under the project's `bytecode\` subdirectory:
//   %APPDATA%\silver cache\<project>\bytecode\project.sbcr  (record, WINDOWS)
//   %APPDATA%\silver cache\<project>\bytecode\<file>.srbc   (tokens, WINDOWS)
//   /var/cache/silver/<project>/bytecode/project.sbcr  (record, LINUX)
//   /var/cache/silver/<project>/bytecode/<file>.srbc   (tokens, LINUX)
//   /Library/Caches/Silver/<project>/bytecode/project.sbcr  (record, MAC)
//   /Library/Caches/Silver/<project>/bytecode/<file>.srbc   (tokens, MAC)
// (mirrors silverc/compiler/bcache.sr: same .sbcr/.srbc formats, only the
// root and the separators differ). The `<os>-<arch>\` object dirs stay
// beside `bytecode\`, not under it.
//
// Migration (OVERHAUL.md): caches written before this layout (record +
// `.srbc` files directly under `<project>\`) are legacy. Tools read ONLY
// the `bytecode\` location — legacy entries are treated as absent (full
// re-sync into `bytecode\`) and never reused. Orphaned legacy files the
// tool itself owns may be deleted best-effort, but a legacy layout must
// never fail a build.
//
// MAC.md section 5b (UNVALIDATED code-only): the MAC root is
// /Library/Caches/Silver/<project>/ (machine-wide Library/Caches,
// capital Silver -- NOT /var/cache, NOT /tmp, NOT the per-user
// ~/Library), fixed root with no `$HOME` lookup, never a hardcoded
// /Users/... path. Same layout and same .sbcr/.srbc binary formats, only
// the root differs; path joins use `/` separators inside the MAC branch
// only. The WINDOWS APPDATA construction and the LINUX /var/cache branch
// stay byte-identical.
//
// **.sbcr (Silver ByteCode Record) v1** — little-endian:
//   magic "SBCR" | u16 version=1 | u64 created (ms since epoch)
//   u32 name_len + UTF-8 project name
//   u32 entry_count
//   per entry: u32 rel_path_len + UTF-8 '/'-separated path,
//              u64 creation_millis u64 modified_millis
//              u64 fnv1_hash       u64 last_cached_millis
//
// **.srbc (Silver ByteCode) v1** — the linear token stream of one file:
//   magic "SRBC" | u16 version=1
//   u64 fnv1_hash   u64 last_cached_millis
//   u32 token_count
//   per token: u16 kind_tag, payload, u32 line, u32 col
//
// Tag space matches the reference: 0..118 unit kinds in reference declaration
// order, 200+ payload kinds (200 int i64 LE, 201 float f64 bits, 202 string
// u32len+bytes, 203 char u32, 204 identifier, 205 annotation, 206 EOF).
// Tokens without a reference spelling (float literals, interpreter-only
// keywords like switch/case/assert/fun/loop/typealias) never cache: the whole
// file falls back to a fresh lex so behavior stays identical to AST mode.
//
// Binary artifacts are written byte-exactly for toolchain compatibility;
// NUL-free text companions (".sbcri" / ".srbc.t") are the authoritative read
// side because the compiled runtime reads files through strlen-based strings.

class CacheSession {
    public prop bool ok;
    public prop string dir;
    public prop string root;
    public prop string projectName;
    public prop string[] keys;
    public prop string[] cTimesStr;
    public prop string[] mTimesStr;
    public prop string[] hashesStr;
    public prop string[] cachedAtStr;
    public prop int64 createdStamp;
    public prop string oldIndexText;
    public prop int dirtyCount;
    public prop int lexErrors;
    // Raw .srbc.t companion text of the last tokensFor call: the synced
    // bytecode itself on a cache hit, "" on a miss. The --cache-object tier
    // packs this as the object payload when present (two-tier flow) and
    // falls back to source otherwise (mirrors silverc/compiler/bcache.sr).
    public prop string lastPayload;
    // OVERHAUL.md --cache-object case 2 (--cache-object alone with a
    // populated bytecode tier): the tier is READ ONLY — hits decode the
    // synced .srbc, misses lex fresh, and nothing is ever written back (no
    // .srbc/.sbcr/companions, no record updates, not even creating the tier
    // directory). The driver passes ro=true when --cache-bytecode is absent;
    // tokensFor then stores nothing and flush is a no-op.
    public prop bool readOnly;
    // Buffered lex diagnostic bodies from the last tokensFor lexing, in
    // source order. Surfaced so the driver can print them under the `[file]`
    // header exactly like the non-cached path (bodies byte-identical).
    public prop string[] lexMessages;

    construct (string rootDir, string projName, bool ro = false) {
        this.ok = false;
        this.dir = "";
        this.root = rootDir;
        this.projectName = projName;
        this.keys = [];
        this.cTimesStr = [];
        this.mTimesStr = [];
        this.hashesStr = [];
        this.cachedAtStr = [];
        this.createdStamp = 0;
        this.oldIndexText = "";
        this.dirtyCount = 0;
        this.lexErrors = 0;
        this.lexMessages = [];
        this.lastPayload = "";
        this.readOnly = ro;
        // Linux cache root (mirrors silverc/compiler/bcache.sr): same
        // .sbcr/.srbc formats under /var/cache/silver/<project>/bytecode/
        // with `/` separators. The WINDOWS APPDATA construction below is untouched.
        // MAC root (MAC.md section 5b, UNVALIDATED code-only): same formats
        // under /Library/Caches/Silver/<project>/bytecode/ (machine-wide, capital
        // Silver) with `/` separators and a fixed root (no $HOME lookup);
        // an unwritable root degrades gracefully downstream like the Linux
        // branch.
        #on LINUX
        this.dir = "/var/cache/silver/" + icSanitize(projName) + "/bytecode";
        if (!ro) {
            this.dropLegacyRecords(icDirname(this.dir));
            icEnsureDirTree(this.dir);
        }
        this.loadRecords();
        this.ok = true;
        return;
        #on MAC
        this.dir = "/Library/Caches/Silver/" + icSanitize(projName) + "/bytecode";
        if (!ro) {
            this.dropLegacyRecords(icDirname(this.dir));
            icEnsureDirTree(this.dir);
        }
        this.loadRecords();
        this.ok = true;
        return;
        #off
        // fs.getenv lowers to native GetEnvironmentVariableA, "" when unset.
        string appdata = fs.getenv("APPDATA");
        if (appdata.length == 0) { return; }
        this.dir = appdata + "\\silver cache\\" + icSanitize(projName) + "\\bytecode";
        if (!ro) {
            this.dropLegacyRecords(icDirname(this.dir));
            icEnsureDirTree(this.dir);
        }
        this.loadRecords();
        // A fresh cache stamps its own creation time; an existing record file
        // preserves the stored one (mirrors the reference cache.rs `open`).
        if (this.oldIndexText.length == 0) { this.createdStamp = icNowMillis(); }
        this.ok = true;
    }

    private string keyOf(int i) {
        string sep = "|";
        return this.keys[i] + sep + this.cTimesStr[i] + sep + this.mTimesStr[i]
            + sep + this.hashesStr[i] + sep + this.cachedAtStr[i];
    }

    // Return cached tokens for absPath when its contents are unchanged and
    // the stored bytecode decodes; otherwise lex source fresh, store the new
    // bytecode, and return those tokens — unless readOnly (--cache-object
    // alone: case 2 serves the hit from disk and case 1 lexes fresh, both
    // storing nothing). Source is the combined, import-
    // resolved text that would otherwise be handed to the Lexer.
    public Token[] tokensFor(string absPath, string source) {
        this.lastPayload = "";
        if (!this.ok) { return this.icLexSet(source); }
        string key = this.relKey(absPath);
        if (key.length == 0) { return this.icLexSet(source); }
        int64 hash = icFnv1(source);
        int size = source.length;
        string hashKey = (string)hash;
        string sizeKey = (string)size;
        int idx = this.keys.indexOf(key);
        if (idx >= 0) {
            if (this.hashesStr[idx] == hashKey && this.mTimesStr[idx] == sizeKey) {
                Token[] cached = this.loadSrbcText(absPath, hashKey);
                if (cached.length > 0) {
                    this.lexErrors = 0;
                    this.lexMessages = [];
                    return cached;
                }
            }
        }
        Token[] tokens = this.icLexSet(source);
        // Read-only (--cache-object alone) sessions never store: a miss
        // simply returns the fresh lex (case 1 writes NOTHING to bytecode\
        // either way).
        if (this.readOnly) { return tokens; }
        if (this.lexErrors > 0) { return tokens; }
        int stamp = icNowMillis();
        if (this.encodable(tokens)) {
            this.storeSrbc(absPath, tokens, stamp, hashKey, sizeKey);
            string created = (string)stamp;
            if (idx >= 0) {
                created = this.cTimesStr[idx];
                this.mTimesStr[idx] = sizeKey;
                this.hashesStr[idx] = hashKey;
                this.cachedAtStr[idx] = (string)stamp;
            } else {
                this.keys.add(key);
                this.cTimesStr.add(created);
                this.mTimesStr.add(sizeKey);
                this.hashesStr.add(hashKey);
                this.cachedAtStr.add((string)stamp);
            }
            this.dirtyCount++;
        }
        return tokens;
    }

    public void flush() {
        if (!this.ok) { return; }
        // Read-only (--cache-object alone) sessions never flush (case 2:
        // bytecode\ is READ ONLY — no writes, no record updates, no mtime
        // changes).
        if (this.readOnly) { return; }
        int w = 0;
        for (int i = 0; i < this.keys.length; i++) {
            string abs = icResolveRel(this.root, this.keys[i]);
            if (file.exists(abs)) {
                this.keys[w] = this.keys[i];
                this.cTimesStr[w] = this.cTimesStr[i];
                this.mTimesStr[w] = this.mTimesStr[i];
                this.hashesStr[w] = this.hashesStr[i];
                this.cachedAtStr[w] = this.cachedAtStr[i];
                w++;
            } else {
                string srbcPath = this.srbcPathFor(this.keys[i]);
                if (srbcPath.length > 0 && file.exists(srbcPath)) {
                    file.delete(srbcPath);
                    file.delete(srbcPath + ".t");
                }
            }
        }
        while (this.keys.length > w) { this.keys.pop(); }
        while (this.cTimesStr.length > w) { this.cTimesStr.pop(); }
        while (this.mTimesStr.length > w) { this.mTimesStr.pop(); }
        while (this.hashesStr.length > w) { this.hashesStr.pop(); }
        while (this.cachedAtStr.length > w) { this.cachedAtStr.pop(); }

        this.sortRecords();

        string indexText = "created " + (string)this.createdStamp + "\n";
        indexText += "name " + this.projectName + "\n";
        for (int r = 0; r < this.keys.length; r++) {
            indexText += "f " + this.keyOf(r) + "\n";
        }
        if (indexText == this.oldIndexText) { return; }

        icEnsureDirTree(this.dir);
        string sbcriOut = this.dir + "\\project.sbcri";
        #on LINUX or MAC
        sbcriOut = this.dir + "/project.sbcri";
        #off
        file.writeString(sbcriOut, indexText);

        // Reference-format binary record (little-endian, see module docs),
        // streamed in adaptive bounded chunks like the .srbc artifacts.
        string sbcrOut = this.dir + "\\project.sbcr";
        #on LINUX or MAC
        sbcrOut = this.dir + "/project.sbcr";
        #off
        BcBinWriter bw = new BcBinWriter(sbcrOut);
        if (bw.ok()) {
            bw.b8(83);
            bw.b8(66);
            bw.b8(67);
            bw.b8(82);
            bw.b16(1);
            bw.b64(this.createdStamp);
            string pn = this.projectName;
            bw.b32(pn.length);
            for (int ni = 0; ni < pn.length; ni++) {
                bw.b8(pn[ni] & 0xFF);
            }
            bw.b32(this.keys.length);
            for (int rb = 0; rb < this.keys.length; rb++) {
                string kp = this.keys[rb];
                bw.b32(kp.length);
                for (int pi = 0; pi < kp.length; pi++) {
                    bw.b8(kp[pi] & 0xFF);
                }
                bw.b64(icDecToI64(this.cTimesStr[rb]));
                bw.b64(icDecToI64(this.mTimesStr[rb]));
                bw.b64(icDecToI64(this.hashesStr[rb]));
                bw.b64(icDecToI64(this.cachedAtStr[rb]));
            }
        }
        bw.close();
    }

    private void loadRecords() {
        string sbcriPath = this.dir + "\\project.sbcri";
        #on LINUX or MAC
        sbcriPath = this.dir + "/project.sbcri";
        #off
        string text = icTryReadText(sbcriPath);
        if (text.length == 0) { return; }
        this.oldIndexText = text;
        int pos = 0;
        while (pos < text.length) {
            int eol = pos;
            while (eol < text.length && text[eol] != '\n') { eol++; }
            string line = icSliceRange(text, pos, eol);
            pos = eol + 1;
            if (icStartsWith(line, "created ")) {
                this.createdStamp = icDecToI64(icSliceRange(line, 8, line.length));
            } else if (icStartsWith(line, "f ")) {
                string rest = icSliceRange(line, 2, line.length);
                string f1 = icWordAtSep(rest, 0, '|');
                string f2 = icWordAtSep(rest, 1, '|');
                string f3 = icWordAtSep(rest, 2, '|');
                string f4 = icWordAtSep(rest, 3, '|');
                string f5 = icWordAtSep(rest, 4, '|');
                if (f5.length > 0) {
                    this.keys.add(f1);
                    this.cTimesStr.add(f2);
                    this.mTimesStr.add(f3);
                    this.hashesStr.add(f4);
                    this.cachedAtStr.add(f5);
                }
            }
        }
    }

    private void sortRecords() {
        int n = this.keys.length;
        for (int i = 1; i < n; i++) {
            string k = this.keys[i];
            string c = this.cTimesStr[i];
            string m = this.mTimesStr[i];
            string h = this.hashesStr[i];
            string lc = this.cachedAtStr[i];
            int j = i - 1;
            while (j >= 0 && k < this.keys[j]) {
                this.keys[j + 1] = this.keys[j];
                this.cTimesStr[j + 1] = this.cTimesStr[j];
                this.mTimesStr[j + 1] = this.mTimesStr[j];
                this.hashesStr[j + 1] = this.hashesStr[j];
                this.cachedAtStr[j + 1] = this.cachedAtStr[j];
                j--;
            }
            this.keys[j + 1] = k;
            this.cTimesStr[j + 1] = c;
            this.mTimesStr[j + 1] = m;
            this.hashesStr[j + 1] = h;
            this.cachedAtStr[j + 1] = lc;
        }
    }

    // Migration (OVERHAUL.md): best-effort removal of the orphaned legacy
    // record files this tool owns (directly under <project>\, never read).
    // Guarded by exists so a legacy layout never fails a build.
    private void dropLegacyRecords(string baseDir) {
        string rec = baseDir + "\\project.sbcr";
        string idx = baseDir + "\\project.sbcri";
        #on LINUX or MAC
        rec = baseDir + "/project.sbcr";
        idx = baseDir + "/project.sbcri";
        #off
        if (file.exists(rec)) { file.delete(rec); }
        if (file.exists(idx)) { file.delete(idx); }
    }

    private string srbcPathFor(string keyOrAbs) {
        // Linux layout (mirrors silverc/compiler/bcache.sr): `/`
        // separators kept as-is under the cache root. MAC layout is the
        // same (MAC.md section 5b: `/` separators under /Library/Caches/Silver).
        #on LINUX or MAC
        string relL = this.relKey(keyOrAbs);
        if (relL.length == 0) { return ""; }
        string dottedL = relL;
        if (dottedL.endsWith(".sr")) {
            dottedL = icSliceRange(dottedL, 0, dottedL.length - 3);
        }
        return this.dir + "/" + dottedL + ".srbc";
        #off
        string rel = this.relKey(keyOrAbs);
        if (rel.length == 0) { return ""; }
        string dotted = rel;
        if (dotted.endsWith(".sr")) {
            dotted = icSliceRange(dotted, 0, dotted.length - 3);
        }
        return this.dir + "\\" + dotted.replaceAll("/", "\\") + ".srbc";
    }

    private void storeSrbc(string absPath, Token[] tokens, int stamp, string hashKey, string sizeKey) {
        string path = this.srbcPathFor(absPath);
        if (path.length == 0) { return; }
        icEnsureDirTree(icDirname(path));

        // Reference-format binary stream (see module docs), flushed in
        // adaptive bounded chunks straight to disk — never materialized as
        // one string or one whole-file array. The on-disk bytes are
        // identical to the previous one-shot write regardless of the
        // host-picked chunk size.
        BcBinWriter bw = new BcBinWriter(path);
        if (bw.ok()) {
            bw.b8(83);
            bw.b8(82);
            bw.b8(66);
            bw.b8(67);
            bw.b16(1);
            bw.b64(icDecToI64(hashKey));
            int64 sv = stamp;
            bw.b64(sv);
            bw.b32(tokens.length);
            for (int ib = 0; ib < tokens.length; ib++) {
                Token tb = tokens[ib];
                int tag = icTagOf(tb);
                bw.b16(tag);
                if (tag == 200) {
                    bw.b64(tb.intVal);
                } else if (tag == 203) {
                    int ccv = tb.charVal;
                    bw.b32(ccv);
                } else if (tag == 202 || tag == 204 || tag == 205) {
                    string sv2 = tb.strVal;
                    bw.b32(sv2.length);
                    for (int si3 = 0; si3 < sv2.length; si3++) {
                        bw.b8(sv2[si3] & 0xFF);
                    }
                }
                bw.b32(tb.line);
                bw.b32(tb.col);
            }
        }
        bw.close();

        // NUL-free text companion (authoritative read side), streamed the
        // same way; hex payloads spill in bounded windows so no line is
        // ever built with per-char concatenation.
        BcTextWriter tw = new BcTextWriter(path + ".t");
        if (tw.ok()) {
            tw.put(hashKey);
            tw.put(" ");
            tw.put((string)stamp);
            tw.put(" ");
            tw.put((string)tokens.length);
            tw.put("\n");
            for (int i = 0; i < tokens.length; i++) {
                this.writeTokenLine(tw, tokens[i]);
            }
        }
        tw.close();
        // Migration (OVERHAUL.md): best-effort removal of the orphaned
        // legacy payload this tool owns (same relative file directly under
        // <project>\). Derived by re-rooting the fresh path, so no path
        // logic is cloned; guarded by exists so legacy never fails a build.
        if (path.length > this.dir.length) {
            string legacySrbc = icDirname(this.dir) + icSliceRange(path, this.dir.length, path.length);
            if (file.exists(legacySrbc)) { file.delete(legacySrbc); }
            if (file.exists(legacySrbc + ".t")) { file.delete(legacySrbc + ".t"); }
        }
    }

    // One token as one companion line: <tag> <line> <col> <payload>
    // (payload "-" for unit tags, decimal for int/char, "<byteLen>:<hex>"
    // for string payloads), emitted piecewise into the streaming writer.
    private void writeTokenLine(BcTextWriter t, Token tok) {
        int tag = icTagOf(tok);
        t.put((string)tag);
        t.put(" ");
        t.put((string)tok.line);
        t.put(" ");
        t.put((string)tok.col);
        if (tag == 200) {
            t.put(" ");
            t.put((string)tok.intVal);
            t.put("\n");
            return;
        }
        if (tag == 203) {
            int cvEnc = tok.charVal;
            t.put(" ");
            t.put((string)cvEnc);
            t.put("\n");
            return;
        }
        if (tag == 202 || tag == 204 || tag == 205) {
            t.put(" ");
            string s = tok.strVal;
            t.put((string)s.length);
            t.put(":");
            string hex = "";
            for (int i = 0; i < s.length; i++) {
                hex += icHexDigits(s[i] & 0xFF);
                if (hex.length >= 64) {
                    t.put(hex);
                    hex = "";
                }
            }
            t.put(hex);
            t.put("\n");
            return;
        }
        t.put(" -\n");
    }

    private Token[] loadSrbcText(string absPath, string expectHash) {
        string path = this.srbcPathFor(absPath);
        if (path.length == 0) { return []; }
        string text = icTryReadText(path + ".t");
        if (text.length == 0) { return []; }
        this.lastPayload = text;
        Token[] tokens = icTokensFromText(text, expectHash);
        if (tokens.length == 0) { this.lastPayload = ""; return []; }
        return tokens;
    }

    private bool encodable(Token[] tokens) {
        for (int i = 0; i < tokens.length; i++) {
            if (icTagOf(tokens[i]) < 0) { return false; }
        }
        return true;
    }

    private Token[] icLexSet(string source) {
        Lexer lx = new Lexer(source);
        Token[] toks = lx.tokenize();
        this.lexErrors = lx.errorCount();
        this.lexMessages = lx.messages();
        return toks;
    }

    private string relKey(string absPath) {
        return icRelPath(this.root, absPath);
    }
}

// Decode .srbc.t companion text into tokens (the authoritative read side,
// shared by the bytecode tier and the --cache-object runner). Returns []
// on any malformation — header hash mismatch, bad count, undecodable line,
// or length mismatch — so callers fall back to a fresh lex.
public Token[] icTokensFromText(string text, string expectHash) {
    int pos = 0;
    string header = "";
    while (pos < text.length && text[pos] != '\n') {
        header += text[pos];
        pos++;
    }
    pos++;
    // The header is "<fnv1 hash> <cached at millis> <token count>"; the
    // hash must match the record's, mirroring the reference load_srbc.
    string headerHash = icWordAt(header, 0);
    if (headerHash != expectHash) { return []; }
    string countStr = icWordAt(header, 2);
    if (countStr.length == 0) { return []; }
    int count = icStrToInt(countStr);
    if (count <= 0) { return []; }
    Token[] tokens = [];
    for (int i = 0; i < count && pos < text.length; i++) {
        string line = "";
        while (pos < text.length && text[pos] != '\n') {
            line += text[pos];
            pos++;
        }
        pos++;
        Token t = icTokenFromLine(line);
        if (t == null) { return []; }
        tokens.add(t);
    }
    if (tokens.length != count) { return []; }
    return tokens;
}

// '/'-separated path of absPath relative to rootDir ("" when absPath is not
// under the root). Shared by the bytecode record keys and the --cache-object
// record keys so both tiers key entries identically.
public string icRelPath(string rootDir, string absPath) {
    string norm = icNormalizeSlashes(absPath);
    string rootNorm = icNormalizeSlashes(rootDir);
    if (rootNorm.length > 0 && norm.length > rootNorm.length + 1) {
        bool prefix = true;
        for (int i = 0; i < rootNorm.length; i++) {
            if (norm[i] != rootNorm[i]) { prefix = false; break; }
        }
        if (prefix && norm[rootNorm.length] == '/') {
            return icSliceRange(norm, rootNorm.length + 1, norm.length);
        }
    }
    return norm;
}

// ---------------------------------------------------------------------------
// Streaming writers (memory bounds for --cache-bytecode).
//
// String concatenation allocates a fresh buffer on every `+` and the
// runtime never frees the old one, so accumulating a whole artifact with
// `s = s + piece` is quadratic in both time and peak memory. These sinks
// keep only a bounded chunk resident and push bytes to disk with direct
// kernel32 writes:
//
//   BcBinWriter  — .srbc/.sbcr bytes: a bounded int[] chunk staged through
//                  a scratch file (file.writeBytes) and appended to the
//                  artifact with a direct kernel32 WriteFile of the exact
//                  byte count (the raw kernel32 calls sit inside the class
//                  bodies' #on WINDOWS regions). The full stream never
//                  exists as one string or one whole-file array.
//   BcTextWriter — NUL-free text (.srbc.t / project.sbcri): a preallocated
//                  writable string buffer appended in place with lstrcatA
//                  and flushed with WriteFile, reset in place with
//                  lstrcpyA("") — the same raw kernel32 mechanism, inside
//                  #on WINDOWS regions, so no per-piece allocation at all.
//
// Buffer sizes are memory-adaptive (see resource.rsCacheChunk): on
// low-memory hosts they shrink so a cache write never overcommits RAM, on
// big hosts they grow so large artifacts stream in fewer, larger flushes.
// The on-disk byte format is independent of the buffer size — only the
// flush cadence changes, so .srbc/.sbcr artifacts stay byte-identical
// whatever buffer size the host picks.
// ---------------------------------------------------------------------------

class BcBinWriter {
    public prop string path;
    public prop int handle;
    public prop int[] buf;
    public prop string scratch;
    public prop int failed;
    public prop int chunk;

    construct (string outPath) {
        this.path = outPath;
        this.buf = [];
        this.failed = 0;
        this.chunk = resource.rsCacheChunk(8192);
        this.scratch = outPath + ".part";
        icEnsureDirTree(icDirname(outPath));
        // CREATE_ALWAYS: every artifact is rewritten whole on change.
        #on WINDOWS
        this.handle = CreateFileA(outPath, 0x40000000, 0, null, 2, 0x80, 0);
        #off
        if (this.handle == -1 || this.handle == 0) {
            this.handle = 0;
            this.failed = 1;
        }
    }

    public bool ok() {
        return this.failed == 0;
    }

    public void b8(int64 v) {
        this.buf.add(v & 0xFF);
        if (this.buf.length >= this.chunk) { this.flush(); }
    }

    public void b16(int64 v) {
        this.b8(v);
        this.b8(v >> 8);
    }

    public void b32(int64 v) {
        for (int i = 0; i < 4; i++) { this.b8((v >> (i * 8)) & 0xFF); }
    }

    public void b64(int64 v) {
        for (int i = 0; i < 8; i++) { this.b8((v >> (i * 8)) & 0xFF); }
    }

    public void flush() {
        int n = this.buf.length;
        if (n > 0 && this.failed == 0) {
            // Chunk staging through a scratch file keeps this portable
            // across bootstrap stages: file.writeBytes compacts the array's
            // low bytes in place on the self-hosted backend but copies to a
            // separate heap buffer on the Rust bootstrap, so the array
            // itself must never be handed to WriteFile. The round trip
            // (write dense bytes, read them back into a heap buffer, append
            // with an explicit byte count) is byte-exact on both, NULs
            // included — the carrier's strlen-based .length is never
            // consulted.
            file.writeBytes(this.scratch, this.buf);
            if (file.getSize(this.scratch) == n) {
                string carrier = file.readString(this.scratch);
                #on WINDOWS
                int w = 0;
                WriteFile(this.handle, carrier, n, &w, null);
                #off
            } else {
                this.failed = 1;
            }
        }
        // pop() only drops the length slot; the buffer and its capacity
        // stay alive so the next chunk reuses them without reallocation.
        while (this.buf.length > 0) { this.buf.pop(); }
    }

    public void close() {
        this.flush();
        if (this.handle != 0) {
            #on WINDOWS
            CloseHandle(this.handle);
            #off
            this.handle = 0;
        }
        if (file.exists(this.scratch)) { file.delete(this.scratch); }
    }
}

class BcTextWriter {
    public prop string path;
    public prop int handle;
    public prop string buf;
    public prop int cap;
    public prop int thresh;

    construct (string outPath) {
        this.path = outPath;
        this.handle = 0;
        this.buf = "";
        this.cap = resource.rsCacheChunk(4096);
        this.thresh = this.cap - 96;
        if (this.thresh < 160) { this.thresh = 160; }
        icEnsureDirTree(icDirname(outPath));
        int h = 0;
        // CREATE_ALWAYS: the text companion is rewritten whole on change.
        #on WINDOWS
        h = CreateFileA(outPath, 0x40000000, 0, null, 2, 0x80, 0);
        #off
        if (h == -1 || h == 0) { return; }
        this.handle = h;
        // Heap-allocated capacity buffer (never a literal: lstrcatA writes
        // through the pointer), emptied in place so appends stay within it.
        // cap comes from rsCacheChunk (floor 256), so no non-positive
        // guard is needed: repeat handles the count directly.
        this.buf = " ".repeat(this.cap);
        #on WINDOWS
        lstrcpyA(this.buf, "");
        #off
    }

    public bool ok() {
        return this.handle != 0;
    }

    // NUL-free text only: the buffer is a plain C string, so lstrcatA
    // appends in place and .length stays truthful.
    public void put(string s) {
        if (s.length == 0 || this.handle == 0) { return; }
        if (s.length >= this.thresh) {
            this.flush();
            #on WINDOWS
            int w = 0;
            WriteFile(this.handle, s, s.length, &w, null);
            #off
            return;
        }
        if (this.buf.length + s.length > this.thresh) { this.flush(); }
        #on WINDOWS
        lstrcatA(this.buf, s);
        #off
    }

    public void flush() {
        if (this.handle == 0 || this.buf.length == 0) { return; }
        #on WINDOWS
        int w = 0;
        WriteFile(this.handle, this.buf, this.buf.length, &w, null);
        lstrcpyA(this.buf, "");
        #off
    }

    public void close() {
        this.flush();
        if (this.handle != 0) {
            #on WINDOWS
            CloseHandle(this.handle);
            #off
            this.handle = 0;
        }
    }
}

public int icNowMillis() {
    // Seconds-since-epoch * 1000 — msvcrt time, matching silverc's
    // bcache.sr. Inside the region: no portable epoch builtin exists.
    // LINUX branch uses clock_gettime (CLOCK_REALTIME) via linux.libc,
    // same ms shape (mirrors bcNowMillis exactly). MAC branch uses
    // clock_gettime (CLOCK_REALTIME = 0 on Darwin too, <time.h>) via
    // mac.libsystem (UNVALIDATED code-only, MAC.md section 10).
    #on WINDOWS
    return time(0) * 1000;
    #off
    #on LINUX or MAC
    int[] ts = [];
    for (int i = 0; i < 16; i++) { ts.add(0); }
    clock_gettime(0, ts);
    int secLow = ts[0] + ts[1] * 256 + ts[2] * 65536 + ts[3] * 16777216;
    int nsecLow = ts[8] + ts[9] * 256 + ts[10] * 65536 + ts[11] * 16777216;
    return secLow * 1000 + nsecLow / 1000000;
    #off
    return 0;
}

// FNV-1 64-bit hash of the source text. Compiled int64 arithmetic wraps in
// two's complement, matching the reference's u64 wrapping bit for bit.
public int64 icFnv1(string data) {
    int64 hash = -3750763034362895579;
    for (int i = 0; i < data.length; i++) {
        hash = hash * 1099511628211;
        int64 b = data[i];
        hash = hash ^ b;
    }
    return hash;
}

public string icSanitize(string name) {
    string r = "";
    for (int i = 0; i < name.length; i++) {
        char c = name[i];
        if (c == '<' || c == '>' || c == ':' || c == '"' || c == '/'
            || c == '\\' || c == '|' || c == '?' || c == '*') {
            r += '_';
        } else {
            r += c;
        }
    }
    return r;
}

public string icNormalizeSlashes(string path) {
    string r = "";
    for (int i = 0; i < path.length; i++) {
        if (path[i] == '\\') { r += '/'; }
        else { r += path[i]; }
    }
    return r;
}

public string icDirname(string path) {
    int last = -1;
    for (int i = 0; i < path.length; i++) {
        if (path[i] == '\\' || path[i] == '/') { last = i; }
    }
    if (last < 0) { return "."; }
    return icSliceRange(path, 0, last);
}

public string icResolveRel(string root, string rel) {
    // Linux joins with `/` (mirrors silverc/compiler/bcache.sr resolveRel).
    // MAC joins with `/` too (MAC.md section 5b).
    #on LINUX or MAC
    if (root.length == 0 || root == ".") { return rel; }
    return root + "/" + rel;
    #off
    string winRel = rel.replaceAll("/", "\\");
    if (root.length == 0 || root == ".") { return winRel; }
    return root + "\\" + winRel;
}

public void icEnsureDirTree(string dir) {
    // Linux dir creation with raw mkdir (mode 0755 = 493) via the file-top
    // linux.libc grant — the same call shape as std/fs.sr createDir. This
    // deliberately does NOT ride fs.createDir like bcache.sr does: the
    // compiled fs.createDir lowering is broken on Linux (segfaults under
    // silverc-rs, silently no-ops under self-hosted stage3), while raw
    // mkdir is proven working. Behavior matches the reference (levels that
    // already exist fail harmlessly). The WINDOWS loop below is untouched.
    // MAC (additive, code-only -- MAC.md section 10, UNVALIDATED until
    // probed on Mac hardware): same raw mkdir (mode 0755 = 493) via the
    // file-top mac.libsystem grant, `/` separators like Linux.
    #on LINUX or MAC
    string curL = "";
    for (int i = 0; i < dir.length; i++) {
        char c = dir[i];
        if (c == '\\' || c == '/') {
            if (curL.length >= 2) { mkdir(curL, 493); }
            curL += '/';
        } else {
            curL += c;
        }
    }
    if (curL.length >= 2) { mkdir(curL, 493); }
    return;
    #off
    string cur = "";
    for (int i = 0; i < dir.length; i++) {
        char c = dir[i];
        if (c == '\\' || c == '/') {
            if (cur.length >= 2) {
                #on WINDOWS
                CreateDirectoryA(cur, null);
                #off
            }
            cur += '\\';
        } else {
            cur += c;
        }
    }
    if (cur.length >= 2) {
        #on WINDOWS
        CreateDirectoryA(cur, null);
        #off
    }
}

public string icSliceRange(string s, int start, int end) {
    string r = "";
    for (int i = start; i < end && i < s.length; i++) { r += s[i]; }
    return r;
}

private bool icStartsWith(string s, string prefix) {
    if (s.length < prefix.length) { return false; }
    for (int i = 0; i < prefix.length; i++) {
        if (s[i] != prefix[i]) { return false; }
    }
    return true;
}

private string icWordAt(string s, int which) {
    return icWordAtSep(s, which, ' ');
}

private string icWordAtSep(string s, int which, char sep) {
    int idx = 0;
    int i = 0;
    while (i < s.length) {
        while (i < s.length && s[i] == sep) { i++; }
        int start = i;
        while (i < s.length && s[i] != sep) { i++; }
        if (i > start) {
            if (idx == which) { return icSliceRange(s, start, i); }
            idx++;
        }
    }
    return "";
}

private int icStrToInt(string s) {
    int v = 0;
    for (int i = 0; i < s.length; i++) {
        char c = s[i];
        if (c < '0' || c > '9') { return -1; }
        v = v * 10 + (c - '0');
    }
    return v;
}

private int64 icDecToI64(string s) {
    bool neg = false;
    int i = 0;
    if (s.length > 0 && s[0] == '-') { neg = true; i = 1; }
    int64 v = 0;
    for (; i < s.length; i++) {
        char c = s[i];
        if (c < '0' || c > '9') { break; }
        v = v * 10 + (c - '0');
    }
    if (neg) { v = -v; }
    return v;
}

private string icTryReadText(string path) {
    string result = "";
    try {
        result = file.readString(path);
    } catch (int e) {
        result = "";
    }
    return result;
}

// ---------------------------------------------------------------------------
// Reference tag space (must match silverc-rs src/cache.rs SIMPLE_KINDS order
// and silverc/compiler/bcache.sr). Tokens without a reference spelling return
// -1 and the whole file falls back to a fresh lex.
// ---------------------------------------------------------------------------

private int icTagOf(Token t) {
    int k = t.kind;
    if (k == 0) { return 206; }
    if (k == 1) { return 200; }
    if (k == 2) { return -1; }
    if (k == 3) { return 202; }
    if (k == 4) { return 203; }
    if (k == 5) {
        if (t.text.length == 4 && t.text[0] == 't') { return 32; }
        return 33;
    }
    if (k == 6) { return 34; }
    if (k == 7) { return 204; }
    if (k == 8) { return 205; }
    if (k == 10) { return 0; }
    if (k == 11) { return 1; }
    if (k == 12) { return 2; }
    if (k == 13) { return 3; }
    if (k == 14) { return 4; }
    if (k == 15) { return 5; }
    if (k == 16) { return 6; }
    if (k == 17) { return 7; }
    if (k == 18) { return 8; }
    if (k == 19) { return 9; }
    if (k == 20) { return 10; }
    if (k == 21) { return 11; }
    if (k == 22) { return 12; }
    if (k == 23) { return 13; }
    if (k == 24) { return 14; }
    if (k == 25) { return 15; }
    if (k == 26) { return 17; }
    if (k == 27) { return 18; }
    if (k == 28) { return 19; }
    if (k == 29) { return 20; }
    if (k == 30) { return 21; }
    if (k == 31) { return 22; }
    if (k == 32) { return 23; }
    if (k == 33) { return 24; }
    if (k == 34) { return 25; }
    if (k == 35) { return 26; }
    if (k == 36) { return 27; }
    if (k == 37) { return 28; }
    if (k == 38) { return 29; }
    if (k == 39) { return 30; }
    if (k == 40) { return 31; }
    if (k == 41) { return 32; }
    if (k == 42) { return 33; }
    if (k == 43) { return 34; }
    if (k == 44) { return 35; }
    if (k == 45) { return 36; }
    if (k == 46) { return 37; }
    if (k == 47) { return 38; }
    if (k == 48) { return 39; }
    if (k == 49) { return 40; }
    if (k == 50) { return 47; }
    if (k == 51) { return 48; }
    if (k == 52) { return 49; }
    if (k == 53) { return 50; }
    if (k == 54) { return 57; }
    if (k == 55) { return 53; }
    if (k == 56 || k == 57 || k == 58) { return -1; }
    if (k == 59) { return 59; }
    if (k == 60 || k == 61) { return -1; }
    if (k == 62) { return 56; }
    if (k == 63) { return 64; }
    if (k == 64) { return 65; }
    if (k == 65) { return 52; }
    if (k == 66) { return 51; }
    if (k == 67) { return 55; }
    if (k == 68) { return 41; }
    if (k == 69) { return 42; }
    if (k == 70) { return 43; }
    if (k == 71) { return 44; }
    if (k == 72) { return 45; }
    if (k == 73) { return 46; }
    if (k == 74 || k == 75) { return -1; }
    if (k == 100) { return 66; }
    if (k == 101) { return 67; }
    if (k == 102) { return 68; }
    if (k == 103) { return 69; }
    if (k == 104) { return 70; }
    if (k == 105) { return 71; }
    if (k == 106) { return 72; }
    if (k == 107) { return 73; }
    if (k == 108) { return 74; }
    if (k == 109) { return 75; }
    if (k == 110) { return 76; }
    if (k == 111) { return 77; }
    if (k == 112) { return 78; }
    if (k == 113) { return 79; }
    if (k == 114) { return 80; }
