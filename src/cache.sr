    if (k == 117) { return 83; }
    if (k == 118) { return 84; }
    if (k == 119) { return 85; }
    if (k == 120) { return 86; }
    if (k == 121) { return 87; }
    if (k == 122) { return 88; }
    if (k == 123) { return 89; }
    if (k == 124) { return 91; }
    if (k == 125) { return 93; }
