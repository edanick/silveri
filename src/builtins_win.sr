}

internal int bwinGetDoubleClickTime() {
    return GetDoubleClickTime();
}

internal int bwinSetDoubleClickTime(int v) {
    return SetDoubleClickTime(v);
}

internal int bwinRegisterHotKey(int a, int b, int c, int d) {
    return RegisterHotKey(a, b, c, d);
}

internal int bwinUnregisterHotKey(int a, int b) {
    return UnregisterHotKey(a, b);
}

internal int bwinMessageBeep(int t) {
