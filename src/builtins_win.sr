import * from win32.user32;
import * from win32.kernel32;

internal mod export builtins_win;

// ---------------------------------------------------------------------------
// builtins_win - INTERNAL Windows backend of the interpreter's builtin
// method table (UNIFIED_CORE_LIBRARY.md phase 3).
//
// Every raw user32/kernel32 DLL call that builtins.sr needs lives here and
// nowhere else: the public builtin modules (keyboard, mouse, process, env,
// gui passthroughs) contain zero win32 imports and reach this code through
// the internal wrappers below. The wrappers are one-to-one forwards to the
// aliased exports, so behavior is bit-identical to the pre-split direct
// calls. The `internal` marker plus `internal mod export` keeps the backend
// from leaking to interpreted user programs; same-project callers (builtins.sr)
// resolve the wrappers through the flattened bare-name namespace.
//
// Win32 by-ref out-parameters (GetWindowThreadProcessId's LPDWORD, WriteFile's
// lpNumberOfBytesWritten) are kept INSIDE the wrappers so no cross-function
// pointer passing is ever needed.
// ---------------------------------------------------------------------------

internal void bwinKeybdEvent(int a, int b, int c, int d) {
    keybd_event(a, b, c, d);
}

internal void bwinMouseEvent(int a, int b, int c, int d, int e) {
    mouse_event(a, b, c, d, e);
}

internal int bwinGetKeyState(int vk) {
    return GetKeyState(vk);
}

internal int bwinGetAsyncKeyState(int vk) {
    return GetAsyncKeyState(vk);
}

internal int bwinMapVirtualKeyA(int a, int b) {
    return MapVirtualKeyA(a, b);
}

internal int bwinVkKeyScanA(string s) {
    return VkKeyScanA(s);
}

internal int bwinGetCursorX() {
    return GetCursorX();
}

internal int bwinGetCursorY() {
    return GetCursorY();
}

