internal void bwinSleep(int64 ms) {
    Sleep(ms);
}

// One native stderr write (GetStdHandle(STD_ERROR_HANDLE) + WriteFile), the
// by-ref bytes-written counter stays internal.
internal void bwinWriteStderr(string msg, int n) {
    int h = GetStdHandle(-12);
    if (h == -1 || h == 0) { return; }
    int w = 0;
    WriteFile(h, msg, n, &w, null);
}

internal void bwinSystemInfo(string buf) {
    GetSystemInfo(buf);
}

internal int bwinGlobalMemoryStatusEx(string buf) {
    return GlobalMemoryStatusEx(buf);
}
