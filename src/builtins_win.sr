}

internal int bwinGetRawInputData(int a, int b, int c, int d, int e) {
    return GetRawInputData(a, b, c, d, e);
}

internal int bwinGetRawInputDeviceList(int a, int b, int c) {
    return GetRawInputDeviceList(a, b, c);
}

internal int bwinGetForegroundWindow() {
    return GetForegroundWindow();
}

internal int bwinGetWindowTextA(int a, int b, int c) {
    return GetWindowTextA(a, b, c);
}

// Fills an internal local DWORD with the window's process id and returns it
// (the pre-split code took the pid through a &local by-ref argument).
internal int bwinGetWindowThreadProcessIdPid(int hwnd) {
    int pid = 0;
    GetWindowThreadProcessId(hwnd, &pid);
    return pid;
}

// Raw passthrough: the caller supplies the LPDWORD address itself (the
// callBuiltin export arm forwards an interpreted script's pointer int).
// Returns the thread id, exactly as the export does.
internal int bwinGetWindowThreadProcessIdPtr(int hwnd, int pidPtr) {
    return GetWindowThreadProcessId(hwnd, pidPtr);
}

internal int bwinOpenProcess(int a, int b, int c) {
    return OpenProcess(a, b, c);
}

internal int bwinQueryFullProcessImageNameA(int a, int b, int c, int d) {
    return QueryFullProcessImageNameA(a, b, c, d);
}

internal int bwinCloseHandle(int h) {
    return CloseHandle(h);
}

internal int bwinGetModuleHandleA(int h) {
    return GetModuleHandleA(h);
}

internal int bwinGetSystemMetrics(int i) {
