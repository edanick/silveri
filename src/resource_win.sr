import * from win32.kernel32;
import * from win32.msvcrt;

internal mod export resource_win;

// ---------------------------------------------------------------------------
// resource_win - INTERNAL Windows backend of the interpreter's adaptive
// resource layer (UNIFIED_CORE_LIBRARY.md phase 3).
//
// resource.sr keeps the pure-Silver parsing and clamping; the raw
// kernel32/msvcrt struct-buffer queries it cannot route through the unified
// std live here: GetSystemInfo/GlobalMemoryStatusEx fill caller-owned string
// buffers in place (the managed string lowers to the struct buffer pointer,
// the same contract the self-hosted resource.sr relies on), and the
// MEMORYSTATUSEX priming (memset to zero + dwLength = 64 via lstrcpyA("@"))
// is byte-identical to the pre-split direct calls.
//
// Everything in this file is project-internal: `internal mod export` plus
// `internal` on every function keeps the backend from leaking to interpreted
// user programs.
// ---------------------------------------------------------------------------

// Logical-processor query: fills a SYSTEM_INFO over the buffer.
internal void rwinSystemInfo(string buf) {
    GetSystemInfo(buf);
}

// MEMORYSTATUSEX query: returns the BOOL success flag.
internal int rwinMemoryStatusEx(string buf) {
    return GlobalMemoryStatusEx(buf);
}

// Zero the 64-byte MEMORYSTATUSEX buffer (memset).
internal void rwinZeroBuf(string buf) {
    memset(buf, 0, 64);
}

// Prime dwLength to sizeof(MEMORYSTATUSEX) == 64 by copying "@" (0x40)
// into the first byte (lstrcpyA).
internal void rwinPrimeBuf(string buf) {
    lstrcpyA(buf, "@");
}
