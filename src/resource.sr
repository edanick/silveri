mod export resource;

// Raw OS enablers for the adaptive resource layer (kernel32 struct queries,
// msvcrt memset) — file-top grant, mirroring the unified std fold shape.
#on WINDOWS
import * from win32.kernel32;
import * from win32.msvcrt;
#on LINUX
import * from linux.libc;
#on MAC
import * from mac.libsystem;
#off

// ---------------------------------------------------------------------------
// Adaptive resource layer — auto-adjust to the host machine.
//
// The interpreter scales to whatever system it runs on: big machines (many
// CPU threads, lots of RAM) or small ones (less). Every size decision
// derives from live system state queried through the Windows API below —
// there are no hardcoded assumptions about machine size. Targets ~90% of
// system resources with a 10% safety margin, never overcommitting.
//
// Win32 struct buffers (SYSTEM_INFO, MEMORYSTATUSEX) are queried through
// preallocated writable string buffers: strings lower to dense char buffers
// on every backend, so an index reads one raw byte and a bare call passes
// the buffer pointer straight across the boundary. The MEMORYSTATUSEX
// dwLength member is primed to sizeof(MEMORYSTATUSEX) == 64 by copying a
// single "@" (0x40) into the first byte after zeroing the buffer — the same
// trick the self-hosted compiler's resource.sr relies on. The raw
// kernel32/msvcrt calls are inline inside their `#on WINDOWS` regions
// (UNIFIED_CORE_LIBRARY.md §4 rule 6: no _win backend, no wrapper
// indirection — the public function IS the only function).
// ---------------------------------------------------------------------------

private int64 LOW_MEMORY_FLOOR = 1073741824; // 1 GiB

// Writable string buffer of n bytes (spaces) for Win32 struct queries.
private string rsBuf(int n) {
    string r = "";
    for (int i = 0; i < n; i++) { r += " "; }
    return r;
}

// Little-endian DWORD at byte offset `off` in a string buffer.
private int rsDword(string buf, int off) {
    int v = 0;
    for (int i = 0; i < 4; i++) {
        int b = buf[off + i];
        v += (b << (i * 8));
    }
    return v;
}

// Logical processor count from GetSystemInfo (dwNumberOfProcessors).
// GetSystemInfo fills the SYSTEM_INFO over the caller-owned buffer in
// place (the managed string lowers to the struct buffer pointer, the same
// contract the self-hosted resource.sr relies on).
// LINUX (additive, mirrors silverc-rs/src/resource.rs non-Windows branch
// semantics: available_parallelism): sysconf(_SC_NPROCESSORS_ONLN=84),
// floored at 1. The WINDOWS region above stays byte-identical; the LINUX
// early return keeps the shared decode below as dead-but-compiling code on
// Linux so Windows bytes never change.
// MAC (additive, code-only -- MAC.md sections 6/10, UNVALIDATED until
// probed on Mac hardware): sysctlbyname hw.ncpu (the MAC.md-blessed shape;
// there is NO /proc on macOS), floored at 1 the same way.
public int rsCpuThreadCount() {
    string buf = rsBuf(48);
    #on WINDOWS
    GetSystemInfo(buf);
    #off
    #on LINUX
    int nLin = sysconf(84);
    if (nLin < 1) { nLin = 1; }
    return nLin;
    #on MAC
    int[] ncpuBuf = new int[1];
    int ncpuLen = 4;
    int ncpuRc = sysctlbyname("hw.ncpu", ncpuBuf, &ncpuLen, null, 0);
    int nMac = ncpuBuf[0];
    if (ncpuRc != 0 || nMac < 1) { nMac = 1; }
    return nMac;
    #off
    int n = rsDword(buf, 32);
    if (n < 1) { n = 1; }
    return n;
}

// One physical-RAM field of MEMORYSTATUSEX at byte offset `startOff`
// (ullTotalPhys at 8, ullAvailPhys at 16), read as a little-endian QWORD.
// The 64-byte buffer is zeroed (memset) and its dwLength member primed to
// sizeof(MEMORYSTATUSEX) == 64 by copying a single "@" (0x40) into the
// first byte (lstrcpyA) — byte-identical to the pre-split direct calls —
// before GlobalMemoryStatusEx fills it; a failing call yields 0.
// LINUX (additive, mirrors silverc-rs/src/resource.rs linux_memory_bytes:
// /proc/meminfo MemTotal/MemAvailable kB-to-bytes, (0,0) when unreadable):
// the LINUX early return defines `ok` so the shared `if (ok==0)` below
// still compiles on Linux (dead code there); helpers below are whole-
// function #on LINUX so Windows never sees them.
// MAC (additive, code-only -- MAC.md sections 5b-table/6/10, UNVALIDATED
// until probed on Mac hardware): sysctlbyname hw.memsize (total bytes) /
// hw.usermem (user-available bytes, the closest "free" analog without mach
// vm_statistics plumbing) via mac.libsystem -- there is NO /proc on macOS,
// so the /proc helpers below stay LINUX-only. The MAC early return defines
// `ok` exactly like the LINUX one so the shared tail still compiles.
private int64 rsRamField(int startOff) {
    string buf = rsBuf(64);
    #on WINDOWS
    memset(buf, 0, 64);
    lstrcpyA(buf, "@");
    int ok = GlobalMemoryStatusEx(buf);
    #off
    #on LINUX
    int ok = 1;
    int64 linKB = 0;
    if (startOff == 8) {
        linKB = rsLinuxMemKB("MemTotal");
    } else {
        linKB = rsLinuxMemKB("MemAvailable");
    }
    return linKB * 1024;
    #on MAC
    int ok = 1;
    int[] memBuf = new int[1];
    int memLen = 8;
    if (startOff == 8) {
        int rcTotal = sysctlbyname("hw.memsize", memBuf, &memLen, null, 0);
        if (rcTotal != 0) { ok = 0; }
    } else {
        int rcAvail = sysctlbyname("hw.usermem", memBuf, &memLen, null, 0);
        if (rcAvail != 0) { ok = 0; }
    }
    if (ok == 0) { return 0; }
    return memBuf[0];
    #off
    if (ok == 0) { return 0; }
    int64 v = 0;
    for (int i = 0; i < 8; i++) {
        int64 b = buf[startOff + i];
        v += (b << (i * 8));
    }
    return v;
}

#on LINUX
string rsLinuxReadFile(string path) {
    int fd = open(path, 0, 0);
    if (fd < 0) { return ""; }
    string out = "";
    while (true) {
        int[] chunk = new int[512];
        int n = read(fd, chunk, 4096);
        if (n <= 0) { break; }
        for (int i = 0; i < n; i++) {
            int b = (chunk[i / 8] >> ((i % 8) * 8)) & 0xFF;
            out += char(b);
        }
        if (n < 4096) { break; }
    }
    close(fd);
    return out;
}
#off

#on LINUX
int64 rsLinuxMemKB(string key) {
    string mem = rsLinuxReadFile("/proc/meminfo");
    string want = key + ":";
    int at = mem.indexOf(want);
    if (at < 0) { return 0; }
    int p = at + want.length();
    while (p < mem.length() && (mem[p] == ' ' || mem[p] == '\t')) { p++; }
    int64 v = 0;
    while (p < mem.length() && mem[p] >= '0' && mem[p] <= '9') {
        v = v * 10 + int(mem[p]) - 48;
        p++;
    }
    return v;
}
#off

// Bytes of physical RAM currently available (ullAvailPhys).
public int64 rsAvailableRamBytes() {
    return rsRamField(16);
}

// Total physical RAM bytes (ullTotalPhys).
public int64 rsTotalRamBytes() {
    return rsRamField(8);
}

// Default worker count: 90% of logical processors, never exceeding total
// and never below 1. On very small machines (e.g. 2 threads → 1.8 → 2)
// the clamp ensures total is never exceeded.
public int rsDefaultThreadCount() {
    int total = rsCpuThreadCount();
    float scaled = float(total) * 0.9 + 0.5;
    int n = int(scaled);
    if (n < 1) { n = 1; }
    if (n > total) { n = total; }
    return n;
}

// 90% of currently available physical RAM (10% safety margin).
public int64 rsMemoryBudgetBytes() {
    int64 avail = rsAvailableRamBytes();
    float scaled = float(avail) * 0.9;
    return int64(scaled);
}

// True when the host is memory-constrained (available RAM < 1 GiB).
public bool rsIsLowMemory() {
    return rsAvailableRamBytes() < LOW_MEMORY_FLOOR;
}

// Memory-budget-aware chunk size for parallel partitioning.
// `hint` is the caller's preferred per-worker item count. The result is
// clamped so the total concurrent working set of all active workers stays
// within the adaptive memory budget: each worker holds at most
// budget / threads / 1024 items' worth of memory, never below 1.
public int rsAdaptiveChunkSize(int hint) {
    int threads = rsDefaultThreadCount();
    if (threads < 1) { threads = 1; }
    int64 budget = rsMemoryBudgetBytes();
    int64 perWorker = budget / threads / 1024;
    if (perWorker < 1) { perWorker = 1; }
    int cap = int(perWorker);
    if (hint < 1) { hint = 1; }
    if (hint < cap) { return hint; }
    return cap;
}

// Cache-write buffer sizing. BcBinWriter's chunk size and BcTextWriter's
// buffer size derive from the memory budget: on low-memory hosts the
// buffers shrink to a quarter of the caller's baseline so a cache write
// never overcommits RAM; on big hosts they grow with the whole-GiB portion
// of the 90% budget so large artifacts stream in fewer, larger flushes.
// The on-disk .srbc/.sbcr byte format is independent of the buffer size —
// only the flush cadence changes.
public int rsCacheChunk(int hint) {
    if (hint < 256) { hint = 256; }
    if (rsIsLowMemory()) {
        int small = hint / 4;
        if (small < 256) { small = 256; }
        return small;
    }
    int64 budget = rsMemoryBudgetBytes();
    int64 gb = budget / 1073741824;
    if (gb < 1) { gb = 1; }
    if (gb > 64) { gb = 64; }
    int64 extra = gb * 4096;
    int64 total = hint + extra;
    if (total > 65536) { total = 65536; }
    int64 cap = budget / 2048;
    if (cap < 512) { cap = 512; }
    if (total > cap) { total = cap; }
    return int(total);
}
