mod export env;

import value;
import gc;

class Env {
    public prop dict<string, Value> vars;
    public prop Env parent;
    public prop string[] varNames;
    public prop bool gcMark;
    public prop int64 gcEpoch;
    public prop dict<string, string> aliasOf;
    private prop dict<string, string> declaredTypes;

    construct {
        this.vars = {};
        this.parent = null;
        this.varNames = [];
        this.gcMark = false;
        this.gcEpoch = 0;
        this.aliasOf = {};
        this.declaredTypes = {};
    }

    construct (Env parent) {
        this.vars = {};
        this.parent = parent;
        this.varNames = [];
        this.gcMark = false;
        this.gcEpoch = 0;
        this.aliasOf = {};
        this.declaredTypes = {};
    }

    public void define(string name, Value val) {
        this.removeDeclaredType(name);
        if (!this.vars.contains(name)) {
            this.varNames.add(name);
        }
        this.vars[name] = val;
        GC.writeBarrierEnv(this, val);
    }

    public void recordDeclaredType(string name, string typeName) { this.declaredTypes[name] = typeName; }

    public void removeDeclaredType(string name) {
        if (this.declaredTypes.contains(name)) { this.declaredTypes.remove(name); }
    }

    public string declaredType(string name) {
        if (this.aliasOf.contains(name)) { return this.declaredType(this.aliasOf[name]); }
        if (this.vars.contains(name)) {
            if (this.declaredTypes.contains(name)) { return this.declaredTypes[name]; }
            return "";
        }
        if (this.parent != null) { return this.parent.declaredType(name); }
        return "";
    }

    public void setAlias(string name, string targetName) {
        this.aliasOf[name] = targetName;
        this.define(name, makeNull());
    }

    public Value get(string name) {
        if (this.aliasOf.contains(name)) {
            return this.get(this.aliasOf[name]);
        }
        if (this.vars.contains(name)) {
            return this.vars[name];
        }
        if (this.parent != null) {
            return this.parent.get(name);
        }
        return null;
    }

    public bool set(string name, Value val) {
        if (this.aliasOf.contains(name)) {
            return this.set(this.aliasOf[name], val);
        }
        if (this.vars.contains(name)) {
            this.vars[name] = val;
            GC.writeBarrierEnv(this, val);
            return true;
        }
        if (this.parent != null) {
            return this.parent.set(name, val);
        }
        return false;
    }

    public bool exists(string name) {
        if (this.aliasOf.contains(name) || this.vars.contains(name)) { return true; }
        if (this.parent != null) { return this.parent.exists(name); }
        return false;
    }

    public void remove(string name) {
        if (this.vars.contains(name)) {
            this.vars[name] = makeNull();
        }
    }

    public Env push() {
        // No aliasOf reset here: acquireEnv already returns pooled
        // environments with every stale key removed in place.
        Env child = GC.acquireEnv(this);
        return child;
    }
}

// Same-module GC-flag access for the collector. Cross-module reads/writes
// of Env's flag fields miscompile (the same backend limitation documented
// for Value's high-offset fields in value.sr: isMarked/setMarked), so
// gc.sr must go through these helpers. Touching e.gcMark/e.gcEpoch from
// gc.sr directly either never records the mark (live call-frame
// environments get swept once allocation pressure triggers a collection,
// corrupting every local they hold) or never clears it. The low-offset
// container fields (vars/varNames/parent) stay on direct access.
public bool envIsMarked(Env e) {
    return e.gcMark;
}

public void setEnvMarked(Env e, bool m) {
    e.gcMark = m;
}

public int64 envEpoch(Env e) {
    return e.gcEpoch;
}

public void setEnvEpoch(Env e, int64 v) {
    e.gcEpoch = v;
}
