mod export progress;

import * from win32.kernel32;

// Compilation progress reporting (ported from silverc-rs src/progress.rs,
// silverc/compiler/progress.sr). Prints one STDERR line per module processed
// so the user sees how far a compile has advanced: files done / files total,
// percentage complete, and an estimated time remaining. STDERR is used on
// purpose — stdout stays clean for program output.
//
// `total` is discovered up front (entry + transitively resolved imports).
//
// This module uses raw Win32 writes to stderr (GetStdHandle + WriteFile)
// so it compiles under all Silver compilers (silverc-rs and silverc) and
// runs inside the interpreter, without needing a language-level `eprintln`
// builtin.

class ProgressReporter {
    private prop int total;
    private prop int processed;
    private prop int startTick;
    private prop bool enabled;

    construct (int total) {
        this.total = total;
        this.processed = 0;
        this.startTick = GetTickCount();
        this.enabled = true;
    }

    public int processedCount() {
        return this.processed;
    }

    public int totalCount() {
        return this.total;
    }

    public int elapsedMs() {
        int ms = GetTickCount() - this.startTick;
        if (ms < 0) { return 0; }
        return ms;
    }

    public void moduleDone(string name) {
        this.processed = this.processed + 1;
        if (this.enabled) {
            this.printLine(name);
        }
    }

    public void finish() {
        if (!this.enabled) { return; }
        int total = this.total;
        if (total < this.processed) { total = this.processed; }
        writeStderr(this.percentOf(total).toString() + "% done\n");
    }

    private void printLine(string name) {
        int total = this.total;
        if (total < this.processed) { total = this.processed; }
        int pct = this.percentOf(total);
        if (this.processed >= total) {
            writeStderr("[" + this.processed.toString() + "/" + total.toString() + "] module " + name + " 100% done\n");
        } elif (this.processed == 0) {
            writeStderr("[" + this.processed.toString() + "/" + total.toString() + "] module " + name + " " + pct.toString() + "% ~estimating... left\n");
        } else {
            writeStderr("[" + this.processed.toString() + "/" + total.toString() + "] module " + name + " " + pct.toString() + "% ~" + this.eta() + " left\n");
        }
    }

    public string eta() {
        int elapsedMs = GetTickCount() - this.startTick;
        if (elapsedMs < 0) { elapsedMs = 0; }
        int remaining = this.total - this.processed;
        if (remaining < 0) { remaining = 0; }
        if (this.processed == 0 || remaining == 0) {
            return "estimating...";
        }
        int etaSecs = (elapsedMs * remaining / this.processed + 500) / 1000;
        return formatDuration(etaSecs);
    }

    public int percentOf(int total) {
        if (total <= 0) { return 100; }
        int pct = this.processed * 100 / total;
        int rem = (this.processed * 100) % total;
        if (rem * 2 >= total) { pct = pct + 1; }
        if (pct > 100) { pct = 100; }
        return pct;
    }
}

public string formatDuration(int secs) {
    if (secs == 0) { return "<1s"; }
    if (secs < 60) { return secs.toString() + "s"; }
    int minutes = secs / 60;
    int seconds = secs % 60;
    if (minutes < 60) { return minutes.toString() + "m " + seconds.toString() + "s"; }
    int hours = minutes / 60;
    int remMinutes = minutes % 60;
    return hours.toString() + "h " + remMinutes.toString() + "m";
}

// Write a string to STD_ERROR_HANDLE using Win32 WriteFile.
// STD_ERROR_HANDLE = -12.
private void writeStderr(string msg) {
    if (msg.length == 0) { return; }
    int h = GetStdHandle(-12);
    if (h == -1 || h == 0) { return; }
    int w = 0;
    WriteFile(h, msg, msg.length, &w, null);
}