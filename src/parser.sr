mod export parser;

import token;
import lexer;
import ast;
class Parser {
    private prop Token[] tokens;
    private prop int pos;
    // Inside a `[...]` index, a top-level `..` starts a slice rather than
    // a binary range expression.
    private bool rangeIsSliceBoundary;
    private prop int parseErrors;
    // ---- EXCEPTIONS/*.md diagnostics --------------------------------------
    // Missing-semicolon positions, flushed as ONE merged message at the end
    // of parseProgram (SYNTAX_EXCEPTIONS.md).
    private int[] missingSemiLines;
    private int[] missingSemiCols;
    // Lowercase user-declared type names (def/enum/struct/class/typealias):
    // `direction dir = ...` is a declaration, not an unknown keyword.
    private string[] declaredTypes;
    // Identifiers with known meaning that may appear as bare statements.
    private string[] knownIdents;
    // Parsed function signatures for TYPE_EXCEPTIONS call-arg checks:
    // parallel arrays; types/names joined with commas per signature.
    private string[] sigNames;
    private string[] sigTypes;
    private string[] sigParams;
    private int[] sigVariadic;
    // Per-line character lengths (1-based indexing via line-1) used to point
    // just past the end of a line for missing-bracket diagnostics.
    private int[] lineLens;
    // win32 grants recorded from import statements (DOCS/213) so the
    // post-parse unknown-method walk never flags granted native calls.
    private bool win32AllModules;
    private string[] win32OpenModules;
    private string[] win32GrantNames;
    // Set when a top-level `internal` modifier was peeled; attached to the
    // next parsed item (functions, var decls, consts, structs, classes,
    // defs, `mod export`).
    private bool pendingInternal;

    construct (Token[] toks) {
        file.writeBytes("build/diag/TP_c.txt", [49]);
        this.tokens = toks;
        this.pos = 0;
        this.rangeIsSliceBoundary = false;
        this.parseErrors = 0;
        this.missingSemiLines = [];
        this.missingSemiCols = [];
        this.declaredTypes = [];
        this.knownIdents = [];
        this.sigNames = [];
        this.sigTypes = [];
        this.sigParams = [];
        this.sigVariadic = [];
        this.lineLens = [];
        this.win32AllModules = false;
        this.win32OpenModules = [];
        this.win32GrantNames = [];
        this.pendingInternal = false;
    }

    public int errorCount() {
        return this.parseErrors;
    }

    // Provide per-line character lengths so bracket diagnostics can point
    // just past the end of a line (SYNTAX_EXCEPTIONS.md #3).
    public void setLineLengths(int[] lens) {
        this.lineLens = lens;
    }

    // Record a diagnostic and keep going (one message per line, source order).
    private void recordError(string msg) {
        this.parseErrors += 1;
        printline(msg);
    }

    private bool strEq(string a, string b) {
        if (a.length != b.length) { return false; }
        for (int i = 0; i < a.length; i++) {
            if (a[i] != b[i]) { return false; }
        }
        return true;
    }

    // Source width of a token (quotes included for literals), used for
    // insertion-point columns of missing `;` / `,` / `)`.
    private int tokenSrcLen(Token t) {
        if (t.kind == TK_STRING_LIT || t.kind == TK_CHAR_LIT) { return t.text.length + 2; }
        return t.text.length;
    }

    private int prevEndLine() {
        if (this.pos == 0) { return this.peek().line; }
        return this.tokens[this.pos - 1].line;
    }

    private int prevEndCol() {
        if (this.pos == 0) { return this.peek().col; }
        Token prev = this.tokens[this.pos - 1];
        return prev.col + this.tokenSrcLen(prev);
    }

    // Column one past the last character of the given line (1-based), or -1
    // when line lengths were not provided.
    private int lineEndCol(int line) {
        if (line >= 1 && line <= this.lineLens.length) { return this.lineLens[line - 1] + 1; }
        return -1;
    }

    // Statement-final semicolon: consume it, or record the position and keep
    // parsing (SYNTAX_EXCEPTIONS.md "Missing semicolons"). EOF tolerates
    // the final statement of a file, and a preceding `}` already terminates
    // braced statements (match/switch/block expressions).
    private void expectSemi() {
        if (this.check(TK_SEMI)) { this.advance(); return; }
        if (this.check(TK_EOF)) { return; }
        if (this.pos > 0 && this.tokens[this.pos - 1].kind == TK_RBRACE) { return; }
        this.missingSemiLines.add(this.prevEndLine());
        this.missingSemiCols.add(this.prevEndCol());
    }

    // All Silver keywords, used for did-you-mean suggestions.
    public string[] keywordCandidates() {
        string[] cands = [];
        cands.add("if"); cands.add("else"); cands.add("elif"); cands.add("while");
        cands.add("for"); cands.add("foreach"); cands.add("return"); cands.add("match");
        cands.add("void"); cands.add("int"); cands.add("int32"); cands.add("int64");
        cands.add("uint"); cands.add("float"); cands.add("float64"); cands.add("double");
        cands.add("bool"); cands.add("byte"); cands.add("char"); cands.add("string");
        cands.add("var"); cands.add("struct"); cands.add("class"); cands.add("enum");
        cands.add("def"); cands.add("found"); cands.add("collect"); cands.add("mod");
        cands.add("export"); cands.add("import"); cands.add("from"); cands.add("as");
        cands.add("new"); cands.add("const"); cands.add("true"); cands.add("false");
        cands.add("null"); cands.add("public"); cands.add("private"); cands.add("static");
        cands.add("internal");
        cands.add("prop"); cands.add("construct"); cands.add("unset"); cands.add("local");
        cands.add("alias"); cands.add("fixed"); cands.add("live"); cands.add("once");
        cands.add("shared"); cands.add("mut"); cands.add("ref"); cands.add("try");
        cands.add("catch"); cands.add("finally"); cands.add("throw"); cands.add("to");
        cands.add("in"); cands.add("break"); cands.add("continue"); cands.add("switch");
        cands.add("case"); cands.add("typealias"); cands.add("loop");
        return cands;
    }

    private bool identStartsLower(string word) {
        if (word.length == 0) { return false; }
        char fc = word[0];
        return fc >= 'a' && fc <= 'z';
    }

    private bool isDeclaredTypeName(string name) {
        for (int i = 0; i < this.declaredTypes.length; i++) {
            if (this.strEq(this.declaredTypes[i], name)) { return true; }
        }
        return false;
    }

    private void registerDeclaredType(string name) {
        if (!this.isDeclaredTypeName(name)) { this.declaredTypes.add(name); }
    }

    private bool knownIdentName(string name) {
        for (int i = 0; i < this.knownIdents.length; i++) {
            if (this.strEq(this.knownIdents[i], name)) { return true; }
        }
        if (this.strEq(name, "cargs") || this.strEq(name, "getCommandLine")
            || this.strEq(name, "print") || this.strEq(name, "printline")
            || this.strEq(name, "eprint") || this.strEq(name, "eprintln")
            || this.strEq(name, "exit") || this.strEq(name, "input")
            || this.strEq(name, "sleep") || this.strEq(name, "assert")
            || this.strEq(name, "strlen") || this.strEq(name, "now")) { return true; }
        return false;
    }

    // True when a statement-leading lowercase identifier is an unknown
    // keyword: not a declared type heading a declaration shape, and not an
    // identifier with known meaning (SYNTAX_EXCEPTIONS.md).
    private bool identShouldFlag(Token cur, int nk) {
        if (!this.identStartsLower(cur.text)) { return false; }
        // Primitive type words that lex as identifiers head declarations,
        // never unknown keywords.
        if (this.strEq(cur.text, "double") || this.strEq(cur.text, "long")
            || this.strEq(cur.text, "uint") || this.strEq(cur.text, "byte")
            || this.strEq(cur.text, "int32") || this.strEq(cur.text, "int64")
            || this.strEq(cur.text, "float64") || this.strEq(cur.text, "boolean")) { return false; }
        bool declShape = nk == TK_IDENT || nk == TK_LBRACKET || nk == TK_LESS || nk == TK_COLON;
        if (declShape) {
            // `T name (` is a function-signature shape — legacy sources use
            // non-keyword return spellings there; leave it to the decl parser.
            if (nk == TK_IDENT && this.pos + 2 < this.tokens.length && this.tokens[this.pos + 2].kind == TK_LPAREN) {
                return false;
            }
            return !this.isDeclaredTypeName(cur.text);
        }
        return !this.knownIdentName(cur.text);
    }

    // Can the token kind continue an identifier as a real expression or
    // declaration? If not, a lowercase statement-leading identifier is an
    // unknown keyword (SYNTAX_EXCEPTIONS.md).
    private bool tokenContinuesExpr(int nk) {
        if (nk == TK_LPAREN || nk == TK_DOT || nk == TK_LBRACKET || nk == TK_ASSIGN) { return true; }
        if (nk == TK_PLUS_EQ || nk == TK_MINUS_EQ || nk == TK_STAR_EQ || nk == TK_SLASH_EQ || nk == TK_PERCENT_EQ) { return true; }
        if (nk == TK_AMP_EQ || nk == TK_PIPE_EQ || nk == TK_CARET_EQ || nk == TK_SHL_EQ || nk == TK_SHR_EQ) { return true; }
        if (nk == TK_INC || nk == TK_DEC || nk == TK_QUESTION || nk == TK_QUESTIONQUESTION) { return true; }
        if (nk == TK_COLON || nk == TK_RANGE || nk == TK_SPREAD || nk == TK_LESS) { return true; }
        if (nk == TK_SHL) { return true; }
        return false;
    }

    // Flag an unknown keyword / keyword typo at the token's position.
    private void flagUnknownKeywordAt(Token t) {
        string sugg = diagClosestMatch(t.text, this.keywordCandidates());
        if (sugg.length > 0) {
            this.recordError("did you mean \"" + sugg + "\"?, at line " + t.line.toString() + ", column " + t.col.toString());
        } else {
            this.recordError("unknown keyword \"" + t.text + "\" at line " + t.line.toString() + ", column " + t.col.toString());
        }
    }

    // No-op expression-statement node used during error recovery.
    private Node noopNode() {
        Node n = new Node(ND_EXPR_STMT, 0, 0);
        n.addChild(new Node(ND_INT_LIT, 0, 0));
        return n;
    }

    // Skip ahead to the next top-level statement boundary: past a terminating
    // semicolon, or to the first token on a later line — whichever first.
    private void syncToStatementEnd() {
        while (!this.check(TK_EOF) && !this.check(TK_RBRACE)) {
            int line = this.peek().line;
            if (this.check(TK_SEMI)) { this.advance(); return; }
            this.advance();
            if (this.pos < this.tokens.length && this.tokens[this.pos].line > line) { return; }
        }
    }

    private Token peek() {
        if (this.pos < this.tokens.length) {
            return this.tokens[this.pos];
        }
        return new Token(TK_EOF, "", 0, 0);
    }

    private int peekKind() {
        return this.peek().kind;
    }

    private Token advance() {
        Token t = this.peek();
        this.pos += 1;
        return t;
    }

    private bool check(int kind) {
        return this.peekKind() == kind;
    }

    private bool checkType() {
        int k = this.peekKind();
        return k == TK_INT || k == TK_INT32 || k == TK_INT64 || k == TK_UINT
            || k == TK_FLOAT || k == TK_FLOAT64 || k == TK_DOUBLE
            || k == TK_BOOL || k == TK_CHAR || k == TK_STRING
            || k == TK_VOID;
    }

    private Token expect(int kind) {
        if (this.peekKind() == kind) {
            return this.advance();
        }
        Token t = this.peek();
        this.parseErrors += 1;
        printline("Parse error at " + t.line.toString() + ":" + t.col.toString() + ": expected " + kindToString(kind) + " but got " + kindToString(t.kind) + " '" + t.text + "'");
        return t;
    }

    private string expectIdent() {
        Token t = this.peek();
        if (t.kind == TK_IDENT) {
            this.advance();
            return t.text;
        }
        // Keywords may serve as identifiers when no specific keyword match
        // (e.g. `int match = true;` or `string mod = ...;`).
        if (t.kind != TK_EOF && t.text.length > 0) {
            this.advance();
            return t.text;
        }
        this.parseErrors += 1;
        printline("Parse error: expected identifier at " + t.line.toString() + ":" + t.col.toString());
        return "_err";
    }

    private int line() { return this.peek().line; }
    private int col() { return this.peek().col; }

public Node[] parseProgram() {
    file.writeBytes("build/diag/TP_p.txt", [49]);
    Node[] items = [];
    int safety = 0;
    // Bound by the token count rather than a fixed 100: large preludes (the
    // embedded exception hierarchy has 100+ classes) must all be parsed. The
    // advance-on-stuck guard below guarantees forward progress, so the token
    // count is a safe upper bound.
    int safetyLimit = this.tokens.length + 16;
    while (!this.check(TK_EOF) && safety < safetyLimit) {
        safety += 1;
        int oldPos = this.pos;
        Node? item = this.parseItem();
        if (item != null) {
            items.add(item);
        }
        if (this.pos == oldPos) {
            this.advance();
        }
    }
    // Flush the merged missing-semicolon message (single line listing
    // every position, joined with "and").
    if (this.missingSemiLines.length > 0) {
        string msg = "you forgot to put a semicolon \";\" in ";
        for (int si = 0; si < this.missingSemiLines.length; si++) {
            if (si > 0) { msg = msg + " and "; }
            msg = msg + "line " + this.missingSemiLines[si].toString() + ", column " + this.missingSemiCols[si].toString();
        }
        this.recordError(msg);
        this.missingSemiLines = [];
        this.missingSemiCols = [];
    }
    return items;
}

private Node? parseItem() {
    file.writeBytes("build/diag/TP_i.txt", [49]);
    if (this.check(TK_HASH)) {
            return this.parseAnnotation();
        }
        if (this.check(TK_PUBLIC) || this.check(TK_PRIVATE) || this.check(TK_STATIC)) {
            // Skip top-level access/static modifiers (e.g. `public const`,
            // `public void show(...)` in std module sources) before dispatching
            // to the declaration parser below.
            this.advance();
            return this.parseItem();
        }
        if (this.check(TK_INTERNAL)) {
            // Record the project-bound visibility modifier and attach it to
            // whatever declaration follows.
            this.advance();
            this.pendingInternal = true;
            return this.parseItem();
        }
        Node? item = this.parseItemBody();
        if (item != null && this.pendingInternal) {
            item.isInternal = true;
        }
        this.pendingInternal = false;
        return item;
    }

    private Node? parseItemBody() {
        if (this.check(TK_MOD)) { return this.parseModule(); }
        if (this.check(TK_IMPORT)) { return this.parseImport(); }
        if (this.check(TK_CONST)) { return this.parseConst(); }
        if (this.check(TK_DEF)) { return this.parseDef(); }
        if (this.check(TK_FUN)) { return this.parseFun(); }
        if (this.check(TK_STRUCT)) { return this.parseStruct(); }
        if (this.check(TK_CLASS)) { return this.parseClass(); }
        if (this.check(TK_COLLECT)) { return this.parseCollect(); }
        if (this.check(TK_FOUND)) { return this.parseFound(); }
        if (this.checkType()) {
            // `int.parseInt("42")` at top level is a static conversion call,
            // not a declaration headed by a primitive type.
            if (!(this.pos + 1 < this.tokens.length && this.tokens[this.pos + 1].kind == TK_DOT)) {
                return this.parseFunctionOrVarDecl();
            }
        }
        if (this.check(TK_IDENT)) {
            // Unknown keyword at top level (e.g. a typo like `impor`), with a
            // did-you-mean suggestion when it resembles a real keyword.
            // Recovery resyncs to the next statement boundary so the damaged
            // region does not cascade into unrelated follow-on errors.
            Token curTok = this.peek();
            bool isTupleWord = this.strEq(curTok.text, "tuple");
            if (!isTupleWord) {
                int nk = -1;
                if (this.pos + 1 < this.tokens.length) { nk = this.tokens[this.pos + 1].kind; }
                bool continuesExpr = this.tokenContinuesExpr(nk);
                // `print"hello world");` — a call missing its open parenthesis.
                if (!continuesExpr && nk == TK_STRING_LIT) {
                    Node stmt = this.parseCallMissingOpenParen();
                    return stmt;
                }
                if (!continuesExpr && this.identShouldFlag(curTok, nk)) {
                    this.advance();
                    this.flagUnknownKeywordAt(curTok);
                    this.syncToStatementEnd();
                    return null;
                }
            }
            // Look ahead to see if this is a named type decl or an expression statement
            int saved = this.pos;
            string first = this.expectIdent();
            if (this.check(TK_IDENT) || this.check(TK_MUT)) {
                this.pos = saved;
                Node? result = this.parseNamedTypeDecl();
                return result ?? null;
            }
            this.pos = saved;
        }
        if (this.check(TK_VAR)) {
            return this.parseVarDeclItem();
        }
        if (this.check(TK_LOCAL) || this.check(TK_ALIAS) || this.check(TK_TYPEALIAS) || this.check(TK_FIXED) || this.check(TK_LIVE) || this.check(TK_ONCE) || this.check(TK_SHARED)) {
            return this.parseStmt();
        }
        // Fall back to expression statement (for top-level printline, etc.)
        Node expr = this.parseExpr(0);
        this.expectSemi();
        Node n = new Node(ND_EXPR_STMT, this.line(), this.col());
        n.addChild(expr);
        return n;
    }

    private Node parseAnnotation() {
        int ln = this.line();
        int c = this.col();
        this.advance();
        string content = "";
        while (!this.check(TK_SEMI) && !this.check(TK_EOF)) {
            content += this.advance().text + " ";
        }
        if (this.check(TK_SEMI)) { this.advance(); }
        Node n = new Node(ND_ANNOTATION, ln, c);
        n.strVal = content.trim();
        return n;
    }

    private Node parseModule() {
        int ln = this.line(); int c = this.col();
        this.advance();
        if (this.check(TK_IDENT) && this.peek().text == "export") {
            this.advance();
            string name = this.expectIdent();
            this.expectSemi();
            Node n = new Node(ND_MODULE, ln, c);
            n.name = name;
            n.strVal = "export";
            return n;
        }
            string name = this.expectIdent();
            this.expectSemi();
            Node n = new Node(ND_MODULE, ln, c);
        n.name = name;
        n.children = items;
        return n;
    }

    private Node parseImport() {
        int ln = this.line(); int c = this.col();
        this.advance();
        string[] names = [];
        bool all = false;
        if (this.check(TK_STAR)) {
            this.advance();
            all = true;
        } elif (this.check(TK_LBRACE)) {
            // DOCS/213 -- import { a, b } from win32;
            this.advance();
            names.add(this.expectIdent());
            while (this.check(TK_COMMA)) {
                this.advance();
                names.add(this.expectIdent());
            }
            this.expect(TK_RBRACE);
        } else {
            names.add(this.expectIdent());
            while (this.check(TK_COMMA)) {
                this.advance();
                names.add(this.expectIdent());
            }
        }
        string source = "";
        if (this.check(TK_FROM) || this.peek().text == "from") {
            this.advance();
            source = this.expectIdent();
            while (this.check(TK_DOT)) {
                this.advance();
                source += "." + this.expectIdent();
            }
        }
        // Remember win32 grants for the post-parse unknown-method walk
        // (DOCS/213): free Win32 calls resolve only through these imports.
        this.recordWin32ImportGrant(source, all, names);
        this.expectSemi();
        Node n = new Node(ND_IMPORT, ln, c);
        n.strVal = source;
        if (all) {
            n.name = "*";
        } else {
            string result = names[0];
            for (int i = 1; i < names.length; i++) {
                result += "," + names[i];
            }
            n.name = result;
        }
        return n;
    }

    private Node parseConst() {
        int ln = this.line(); int c = this.col();
        this.advance();
        string typ = this.parseTypeStr();
        string name = this.expectIdent();
        this.knownIdents.add(name);
        Node n = new Node(ND_CONST, ln, c);
        n.name = name;
        n.typeHint = typ;
        if (this.check(TK_ASSIGN)) {
            this.advance();
            n.addChild(this.parseExpr(0));
        }
        // TYPE_EXCEPTIONS.md — flag an initializer literal whose value kind
        // can never fit the declared scalar type (`const int X = "hello"`).
        if (n.childCount() > 0) {
            this.checkDeclValueType(typ, n.child(0), name);
        }
        this.expectSemi();
        return n;
    }

    private Node parseFun() {
        int ln = this.line(); int c = this.col();
        this.advance();
        string name = this.expectIdent();
        this.expect(TK_LPAREN);
        Node n = new Node(ND_FUNC, ln, c);
        n.name = name;
        n.typeHint = "void";
        n.addChild(this.parseParamList());
        this.expect(TK_RPAREN);
        n.addChild(this.parseBlock());
        return n;
    }

    private Node parseDef() {
        int ln = this.line(); int c = this.col();
        this.advance();
        string name = this.expectIdent();
        if (this.check(TK_ASSIGN)) {
            this.advance();
            if (this.check(TK_ENUM)) {
                this.advance();
                this.expect(TK_LBRACE);
                string[] variants = [];
                while (!this.check(TK_RBRACE) && !this.check(TK_EOF)) {
                    variants.add(this.expectIdent());
                    if (this.check(TK_COMMA)) { this.advance(); }
                }
                this.expect(TK_RBRACE);
                this.expectSemi();
                Node n = new Node(ND_ENUM_DEF, ln, c);
                n.name = name;
                this.registerDeclaredType(name);
                string joined = "";
                string prefix = "";
                for (int i = 0; i < variants.length; i++) {
                    joined += prefix + variants[i];
                    prefix = "|";
                }
                n.strVal = joined;
                return n;
            }
        }
        this.expectSemi();
        Node n = new Node(ND_DEF_UNIT, ln, c);
        n.name = name;
        return n;
    }

    private Node parseStruct() {
        int ln = this.line(); int c = this.col();
        this.advance();
        string name = this.expectIdent();
        this.expect(TK_LBRACE);
        Node n = new Node(ND_STRUCT_DEF, ln, c);
        n.name = name;
        this.registerDeclaredType(name);
        while (!this.check(TK_RBRACE) && !this.check(TK_EOF)) {
            string typ = this.parseTypeStr();
            string fieldName = this.expectIdent();
            this.expectSemi();
            Node field = new Node(ND_VAR_DECL, ln, c);
            field.name = fieldName;
            field.typeHint = typ;
            n.addChild(field);
        }
        this.expect(TK_RBRACE);
        return n;
    }

    private Node parseClass() {
        int ln = this.line(); int c = this.col();
        this.advance();
        string name = this.expectIdent();
        string parent = "";
        if (this.check(TK_COLON) || this.check(TK_EXTENDS)) {
            this.advance();
            parent = this.expectIdent();
        }
        this.expect(TK_LBRACE);
        Node n = new Node(ND_CLASS_DEF, ln, c);
        n.name = name;
        n.parentClass = parent;
        this.registerDeclaredType(name);
        bool sectionInternal = false;
        while (!this.check(TK_RBRACE) && !this.check(TK_EOF)) {
            if (this.check(TK_PUBLIC) && this.pos + 1 < this.tokens.length && this.tokens[this.pos + 1].kind == TK_COLON) {
                this.advance(); this.advance(); sectionInternal = false; continue;
            }
            if (this.check(TK_PRIVATE) && this.pos + 1 < this.tokens.length && this.tokens[this.pos + 1].kind == TK_COLON) {
                this.advance(); this.advance(); sectionInternal = false; continue;
            }
            if (this.check(TK_INTERNAL) && this.pos + 1 < this.tokens.length && this.tokens[this.pos + 1].kind == TK_COLON) {
                this.advance(); this.advance(); sectionInternal = true; continue;
            }
            bool isPub = true;
            bool isStat = false;
            bool isInt = sectionInternal;
            bool sawModifier = true;
            while (sawModifier) {
                sawModifier = false;
                if (this.check(TK_PUBLIC)) { this.advance(); isPub = true; sectionInternal = false; sawModifier = true; }
                elif (this.check(TK_PRIVATE)) { this.advance(); isPub = false; sectionInternal = false; sawModifier = true; }
                elif (this.check(TK_INTERNAL)) { this.advance(); isInt = true; sawModifier = true; }
                elif (this.check(TK_STATIC)) { this.advance(); isStat = true; sawModifier = true; }
            }
            if (this.check(TK_DEF)) {
                this.advance();
                int dln = this.line(); int dc = this.col();
                if (this.check(TK_CONSTRUCT)) {
                    Node ctor = this.parseConstructor(name);
                    ctor.isPublic = isPub;
                    ctor.isStatic = isStat;
                    ctor.isInternal = isInt;
                    n.addChild(ctor);
                    continue;
                }
                string mname = this.expectIdent();
                this.expect(TK_LPAREN);
                Node params = this.parseParamList();
                this.expect(TK_RPAREN);
                string retType = "";
                if (this.check(TK_ARROW)) {
                    this.advance();
                    retType = this.parseTypeStr();
                }
                Node fn = new Node(ND_FUNC, dln, dc);
                fn.name = mname;
                fn.typeHint = retType;
                fn.isPublic = isPub;
                fn.isStatic = isStat;
                fn.isInternal = isInt;
                fn.addChild(params);
                if (this.check(TK_SHL)) {
                    this.advance();
                    Node bodyExpr = this.parseExpr(0);
                    Node body = new Node(ND_BLOCK, dln, dc);
                    Node ret = new Node(ND_RETURN, dln, dc);
                    ret.addChild(bodyExpr);
                    body.addChild(ret);
                    fn.addChild(body);
                    this.expectSemi();
                } else if (this.check(TK_LBRACE)) {
                    fn.addChild(this.parseBlock());
                }
                if (!isStat) { this.prependThisParam(fn, name); }
                n.addChild(fn);
                continue;
            }
            if (this.check(TK_CONSTRUCT)) {
                Node ctor = this.parseConstructor(name);
                ctor.isPublic = isPub;
                ctor.isStatic = isStat;
                ctor.isInternal = isInt;
                n.addChild(ctor);
                continue;
            }
            if (this.check(TK_PROP)) {
                this.advance();
                string typ = this.parseTypeStr();
                string fieldName = this.expectIdent();
                this.expectSemi();
                Node field = new Node(ND_VAR_DECL, ln, c);
                field.name = fieldName;
                field.typeHint = typ;
                field.isPublic = isPub;
                field.isInternal = isInt;
                n.addChild(field);
                continue;
            }
            if (this.check(TK_STAR)) {
                this.advance();
                string typ = this.parseTypeStr();
                string fieldName = this.expectIdent();
                this.expectSemi();
                Node field = new Node(ND_VAR_DECL, ln, c);
                field.name = fieldName;
                field.typeHint = typ;
                field.isPublic = false;
                field.isInternal = isInt;
                n.addChild(field);
                continue;
            }
            if (this.checkType() || this.check(TK_IDENT)) {
                string retType = this.parseTypeStr();
                string mname = this.expectIdent();
                if (this.check(TK_LPAREN)) {
                    Node fn = this.parseFunctionDef(isPub, isStat, isInt, retType, mname);
                    if (!isStat) {
                        this.prependThisParam(fn, name);
                    }
                    n.addChild(fn);
                } else {
                    if (this.check(TK_SEMI)) { this.advance(); }
                    Node field = new Node(ND_VAR_DECL, ln, c);
                    field.name = mname;
                    field.typeHint = retType;
                    field.isPublic = isPub;
                    field.isInternal = isInt;
                    n.addChild(field);
                }
                continue;
            }
            break;
        }
        this.expect(TK_RBRACE);
        return n;
    }

    private Node parseConstructor(string className) {
        int ln = this.line(); int c = this.col();
        this.advance();
        this.expect(TK_LPAREN);
        Node n = new Node(ND_FUNC, ln, c);
        n.name = "construct";
        n.parentType = className;
        n.addChild(this.parseParamList());
        this.expect(TK_RPAREN);
        n.addChild(this.parseBlock());
        this.prependThisParam(n, className);
        return n;
    }

    private void prependThisParam(Node fn, string className) {
        Node params = fn.child(0);
        Node thisParam = new Node(ND_VAR_DECL, 0, 0);
        thisParam.name = "this";
        thisParam.typeHint = className;
        params.prependChild(thisParam);
    }

    private Node parseCollect() {
        int ln = this.line(); int c = this.col();
        this.advance();
        string name = this.expectIdent();
        this.expect(TK_ASSIGN);
        this.expect(TK_LPAREN);
        string[] types = [];
        while (!this.check(TK_RPAREN) && !this.check(TK_EOF)) {
            types.add(this.parseTypeStr());
            if (this.check(TK_COMMA)) { this.advance(); }
        }
        this.expect(TK_RPAREN);
        this.expectSemi();
        Node n = new Node(ND_COLLECT, ln, c);
        n.name = name;
        this.registerDeclaredType(name);
        string joined = "";
        string prefix = "";
        for (int i = 0; i < types.length; i++) {
            joined += prefix + types[i];
            prefix = ",";
        }
        n.strVal = joined;
        return n;
    }

    private Node parseFound() {
        int ln = this.line(); int c = this.col();
        this.advance();
        string name = this.expectIdent();
        this.expect(TK_LBRACE);
        Node n = new Node(ND_FOUND, ln, c);
        n.name = name;
        while (!this.check(TK_RBRACE) && !this.check(TK_EOF)) {
            string retType = this.parseTypeStr();
            string mname = this.expectIdent();
            this.expect(TK_LPAREN);
            Node params = this.parseParamList();
            this.expect(TK_RPAREN);
            this.expectSemi();
            Node sig = new Node(ND_FUNC, ln, c);
            sig.name = mname;
            sig.typeHint = retType;
            sig.addChild(params);
            n.addChild(sig);
        }
        this.expect(TK_RBRACE);
        return n;
    }

private Node parseFunctionOrVarDecl() {
    int ln = this.line(); int c = this.col();
    bool isPub = false;
    bool isStat = false;
    if (this.check(TK_PUBLIC)) { this.advance(); isPub = true; }
    if (this.check(TK_STATIC)) { this.advance(); isStat = true; }
    string retType = this.parseTypeStr();
    // `int32 as KM;` (DOCS/48) -- the `T as Name;` spelling of a type alias.
    if (this.check(TK_AS)) {
        this.advance();
        string aliasName = this.expectIdent();
        Node al = new Node(ND_ALIAS_DECL, ln, c);
        al.name = aliasName;
        al.typeHint = retType;
        al.isAlias = true;
        this.expectSemi();
        return al;
    }
    string name = this.expectIdent();
    this.knownIdents.add(name);
    if (this.check(TK_LPAREN)) {
        Node fn = this.parseFunctionDef(isPub, isStat, false, retType, name);
        return fn;
        }
        Node init = new Node(ND_NULL_LIT, ln, c);
        if (this.check(TK_ASSIGN)) {
            this.advance();
            init = this.parseExpr(0);
        }
        // TYPE_EXCEPTIONS.md — flag an initializer literal whose value kind
        // can never fit the declared scalar type (`int x = "hello"`).
        this.checkDeclValueType(retType, init, name);
        this.expectSemi();
        Node n = new Node(ND_VAR_DECL, ln, c);
        n.name = name;
        n.typeHint = retType;
        n.isPublic = isPub;
        n.isStatic = isStat;
        n.addChild(init);
        return n;
    }

private Node parseFunctionDef(bool isPub, bool isStat, bool isInt, string retType, string name) {
    int ln = this.line(); int c = this.col();
    Token openParen = this.peek();
    this.expect(TK_LPAREN);
        Node params = this.parseParamList();
        // `void main( {` — the closing parenthesis is missing; it is
        // reported just past the opening one.
        if (this.check(TK_RPAREN)) {
            this.advance();
        } else {
            this.recordError("Missing close parenthesis at line " + openParen.line.toString() + ", column " + (openParen.col + 1).toString());
        }
        Node n = new Node(ND_FUNC, ln, c);
        n.name = name;
        n.typeHint = retType;
        n.isPublic = isPub;
        n.isStatic = isStat;
        n.isInternal = isInt;
        n.addChild(params);
        // TYPE_EXCEPTIONS.md — remember this signature for call-arg checks.
        this.recordSignature(n.name, params);
        if (this.check(TK_SHL)) {
            this.advance();
            Node bodyExpr = this.parseExpr(0);
            Node body = new Node(ND_BLOCK, ln, c);
            Node ret = new Node(ND_RETURN, ln, c);
            ret.addChild(bodyExpr);
            body.addChild(ret);
            n.addChild(body);
            this.expectSemi();
        } else if (this.check(TK_LBRACE)) {
            n.addChild(this.parseBlock());
        } elif (this.check(TK_RBRACE) || this.check(TK_EOF)) {
            // `void main()` followed by `}` on the next line: the opening
            // curly bracket is missing; point just past the signature's
            // end-of-line.
            int sigLine = this.prevEndLine();
            int sigEndCol = this.lineEndCol(sigLine);
            if (sigEndCol < 0) { sigEndCol = this.prevEndCol(); }
            this.recordError("Missing opening curly bracket at line " + sigLine.toString() + ", column " + sigEndCol.toString());
            if (this.check(TK_RBRACE)) { this.advance(); }
            n.addChild(new Node(ND_BLOCK, ln, c));
        }
        return n;
    }

    private void recordSignature(string fnName, Node params) {
        string joinTypes = "";
        string joinNames = "";
        for (int spi = 0; spi < params.childCount(); spi++) {
            Node sp = params.child(spi);
            if (spi > 0) { joinTypes = joinTypes + ","; joinNames = joinNames + ","; }
            joinTypes = joinTypes + sp.typeHint;
            joinNames = joinNames + sp.name;
        }
        this.sigNames.add(fnName);
        this.sigTypes.add(joinTypes);
        this.sigParams.add(joinNames);
        this.sigVariadic.add(0);
    }

    private Node parseParamList() {
        int ln = this.line(); int c = this.col();
        Node params = new Node(ND_BLOCK, ln, c);
        bool sawParam = false;
        while (!this.check(TK_RPAREN) && !this.check(TK_EOF)) {
            // Consume the separating comma, or report its absence
            // (`int add(int x int y)`).
            if (this.check(TK_COMMA)) {
                this.advance();
            } elif (sawParam) {
                Token prevT = this.tokens[this.pos - 1];
                this.recordError("you forgot a comma \",\" at line " + prevT.line.toString() + ", column " + (prevT.col + this.tokenSrcLen(prevT)).toString());
            }
            // A `{` (or any token that cannot start a type) before the
            // closing parenthesis means the `)` itself is missing.
            if (this.check(TK_LBRACE) || !this.tokenStartsParam(this.peek().kind)) { break; }
            string typ = this.parseTypeStr();
            string pname = this.expectIdent();
            Node param = new Node(ND_VAR_DECL, ln, c);
            param.name = pname;
            param.typeHint = typ;
            if (this.check(TK_ASSIGN)) {
                this.advance();
                param.addChild(this.parseExpr(0));
            }
            params.addChild(param);
            sawParam = true;
        }
        return params;
    }

    // True when the token can begin a parameter type in a parameter list.
    private bool tokenStartsParam(int k) {
        return k == TK_INT || k == TK_INT32 || k == TK_INT64 || k == TK_UINT
            || k == TK_FLOAT || k == TK_FLOAT64 || k == TK_DOUBLE
            || k == TK_BOOL || k == TK_CHAR || k == TK_STRING || k == TK_VAR
            || k == TK_IDENT || k == TK_REF || k == TK_MUT || k == TK_LESS;
    }

    private Node parseNamedTypeDecl() {
        int ln = this.line(); int c = this.col();
        string typeName = this.expectIdent();
        bool isMut = false;
        if (this.check(TK_MUT)) { this.advance(); isMut = true; }
        string name = this.expectIdent();
        // A named type followed by '(' is a function whose return type is a
        // class/type name (e.g. `Spinner dots() { ... }`), not a variable
        // declaration.
        if (this.check(TK_LPAREN)) {
            return this.parseFunctionDef(false, false, false, typeName, name);
        }
        Node init = new Node(ND_NULL_LIT, ln, c);
        if (this.check(TK_ASSIGN)) {
            this.advance();
            init = this.parseExpr(0);
        }
        this.knownIdents.add(name);
        // TYPE_EXCEPTIONS.md — flag an initializer literal whose value kind
        // can never fit the declared scalar type.
        this.checkDeclValueType(typeName, init, name);
        this.expectSemi();
        Node n = new Node(ND_VAR_DECL, ln, c);
        n.name = name;
        n.typeHint = typeName;
        n.isMut = isMut;
        n.addChild(init);
        return n;
    }

    private Node parseVarDeclItem() {
        int ln = this.line(); int c = this.col();
        this.advance();
        string name = this.expectIdent();
        Node init = new Node(ND_NULL_LIT, ln, c);
        if (this.check(TK_ASSIGN)) {
            this.advance();
            init = this.parseExpr(0);
        }
        this.expectSemi();
        Node n = new Node(ND_VAR_DECL, ln, c);
        n.name = name;
        n.addChild(init);
        return n;
    }

    private Node parseBlock() {
        int ln = this.line(); int c = this.col();
        this.expect(TK_LBRACE);
        Node block = new Node(ND_BLOCK, ln, c);
        while (!this.check(TK_RBRACE) && !this.check(TK_EOF)) {
            int oldPos = this.pos;
            Node? stmt = this.parseStmt();
            if (stmt != null) { block.addChild(stmt); }
            if (this.pos == oldPos) {
                this.advance();
            }
        }
        if (this.check(TK_RBRACE)) {
            this.advance();
        } else {
            // Missing `}` at end of file: reported one line after the last
            // line of code inside the block, column 1
            // (SYNTAX_EXCEPTIONS.md #3 bracket position).
            int closeLine = this.prevEndLine() + 1;
            this.recordError("Missing closing curly bracket at line " + closeLine.toString() + ", column 1");
        }
        return block;
    }

    private Node? parseStmt() {
        // A stray `;` is an empty statement (also the recovery anchor used
        // after an unknown-keyword error).
        if (this.check(TK_SEMI)) { this.advance(); return this.noopNode(); }
        if (this.check(TK_FOR)) { return this.parseFor(); }
        if (this.check(TK_FOREACH)) { return this.parseForeach(); }
        if (this.check(TK_WHILE)) { return this.parseWhile(); }
        if (this.check(TK_IF)) { return this.parseIf(); }
        if (this.check(TK_ELIF)) { return this.parseIf(); }
        if (this.check(TK_MATCH)) { return this.parseMatchStmt(); }
        if (this.check(TK_TRY)) { return this.parseTryCatch(); }
        if (this.check(TK_THROW)) { return this.parseThrow(); }
        if (this.check(TK_RETURN)) { return this.parseReturn(); }
        if (this.check(TK_SHR)) { return this.parseReturnShortcut(); }
        if (this.check(TK_UNSET)) { return this.parseUnset(); }
        if (this.check(TK_LOCAL)) {
            this.advance();
            return this.parseVarDecl();
        }
        if (this.check(TK_FIXED)) {
            this.advance();
            Node n = this.parseVarDecl();
            n.isFixed = true;
            return n;
        }
        if (this.check(TK_LIVE)) {
            this.advance();
            Node n = this.parseVarDecl();
            n.isLive = true;
            return n;
        }
        if (this.check(TK_ONCE)) {
            this.advance();
            Node n = this.parseVarDecl();
            n.isOnce = true;
            return n;
        }
        if (this.check(TK_SHARED)) {
            this.advance();
            Node n = this.parseVarDecl();
            n.isShared = true;
            return n;
        }
        if (this.check(TK_ALIAS)) {
            int ln = this.line(); int c = this.col();
            this.advance();
            string typ = this.parseTypeStr();
            string name = this.expectIdent();
            Node n = new Node(ND_ALIAS_DECL, ln, c);
            n.name = name;
            n.typeHint = typ;
            n.isAlias = true;
            if (this.check(TK_ASSIGN)) {
                this.advance();
                n.addChild(this.parseExpr(0));
            }
            this.expectSemi();
            return n;
        }
        if (this.check(TK_TYPEALIAS)) {
            // `typealias Name = T;` (DOCS/48) -- the keyword spelling of the
            // type alias declaration. Produces the same ND_ALIAS_DECL node as
            // the `T as Name;` form.
            int ln = this.line(); int c = this.col();
            this.advance();
            string name = this.expectIdent();
            this.expect(TK_ASSIGN);
            string typ = this.parseTypeStr();
            Node n = new Node(ND_ALIAS_DECL, ln, c);
            n.name = name;
            n.typeHint = typ;
            n.isAlias = true;
            this.expectSemi();
            return n;
        }
        if (this.check(TK_SWITCH)) { return this.parseSwitch(); }
        if (this.check(TK_LOOP)) { return this.parseLoop(); }
        if (this.check(TK_BREAK)) { this.advance(); this.expectSemi(); return new Node(ND_BREAK, this.line(), this.col()); }
        if (this.check(TK_CONTINUE)) { this.advance(); this.expectSemi(); return new Node(ND_CONTINUE, this.line(), this.col()); }
        if (this.check(TK_VAR)) { return this.parseVarDecl(); }
        if (this.checkType()) {
            // `int.parseInt("42")` — a static conversion call, not a
            // declaration headed by a primitive type.
            if (this.pos + 1 < this.tokens.length && this.tokens[this.pos + 1].kind == TK_DOT) {
                Node convExpr = this.parseExpr(0);
                this.expectSemi();
                Node convStmt = new Node(ND_EXPR_STMT, this.line(), this.col());
                convStmt.addChild(convExpr);
                return convStmt;
            }
            return this.parseTypedDecl();
        }
        if (this.check(TK_IDENT)) {
            // Unknown-keyword detection (SYNTAX_EXCEPTIONS.md). A statement
            // that begins with a lowercase identifier not followed by any
            // expression continuation (`(`, `.`, `=`, `[`, ...) is an unknown
            // keyword or a typo of one. Uppercase-led identifiers stay on the
            // user-defined type-declaration path below.
            Token curTok = this.peek();
            bool isTupleWord = this.strEq(curTok.text, "tuple");
            if (!isTupleWord) {
                int nk = -1;
                if (this.pos + 1 < this.tokens.length) { nk = this.tokens[this.pos + 1].kind; }
                bool continuesExpr = this.tokenContinuesExpr(nk);
                // `print"hello world");` — a call missing its open parenthesis.
                if (!continuesExpr && nk == TK_STRING_LIT) {
                    return this.parseCallMissingOpenParen();
                }
                if (!continuesExpr && this.identShouldFlag(curTok, nk)) {
                    this.advance();
                    this.flagUnknownKeywordAt(curTok);
                    return this.noopNode();
                }
            }
            int saved = this.pos;
            string typeName = this.expectIdent();
            bool isTypeDecl = this.check(TK_IDENT) || this.check(TK_MUT);
            if (!isTypeDecl && this.check(TK_LBRACKET) && this.pos + 1 < this.tokens.length && this.tokens[this.pos + 1].kind == TK_RBRACKET) {
                this.advance(); this.advance();
                isTypeDecl = this.check(TK_IDENT) || this.check(TK_MUT);
            }
            if (!isTypeDecl && this.check(TK_QUESTION)) {
                this.advance();
                isTypeDecl = this.check(TK_IDENT) || this.check(TK_MUT);
            }
            if (!isTypeDecl && this.check(TK_LESS)) {
                int depth = 1;
                this.advance();
                while (depth > 0 && this.pos < this.tokens.length && !this.check(TK_EOF)) {
                    if (this.check(TK_LESS)) { depth += 1; }
                    elif (this.check(TK_GREATER)) { depth -= 1; }
                    this.advance();
                }
                // `tuple<...> (x, y) = t;` is the tuple destructuring form
                // (DOCS/18), so a paren after a tuple generic is a type decl.
                isTypeDecl = this.check(TK_IDENT) || this.check(TK_MUT)
                    || (typeName == "tuple" && this.check(TK_LPAREN));
            }
            this.pos = saved;
            if (isTypeDecl) {
                return this.parseNamedTypeDeclStmt();
            }
        }
        Node expr = this.parseExpr(0);
        this.expectSemi();
        Node n = new Node(ND_EXPR_STMT, this.line(), this.col());
        n.addChild(expr);
        return n;
    }

    private Node parseFor() {
        int ln = this.line(); int c = this.col();
        this.advance();
        this.expect(TK_LPAREN);
        // Range-style for loop: `for (type name as start to end) { body }`
        // (DOCS/14). Look ahead for the `type name as` pattern and produce an
        // ND_FOR_RANGE node when present.
        int saved = this.pos;
        bool isRange = false;
        string rangeType = "";
        string rangeVar = "";
        if (this.checkType() || this.check(TK_VAR) || this.check(TK_IDENT)) {
            rangeType = this.advance().text;
            if (this.check(TK_IDENT)) {
                rangeVar = this.advance().text;
                if (this.check(TK_AS)) {
                    isRange = true;
                }
            }
        }
        this.pos = saved;
        if (isRange) {
            this.advance();
            this.advance();
            this.advance();
            Node start = this.parseExpr(0);
            this.expect(TK_TO);
            Node end = this.parseExpr(0);
            this.expect(TK_RPAREN);
            Node body = this.parseBlock();
            Node rn = new Node(ND_FOR_RANGE, ln, c);
            rn.name = rangeVar;
            rn.typeHint = rangeType;
            rn.addChild(start);
            rn.addChild(end);
            rn.addChild(body);
            return rn;
        }
        Node n = new Node(ND_FOR_C, ln, c);
        Node init = new Node(ND_EXPR_STMT, ln, c);
        if (this.check(TK_SEMI)) {
            this.advance();
        } elif (this.checkType() || this.check(TK_VAR)) {
            init = this.parseVarDecl();
        } else {
            Node expr = this.parseExpr(0);
            init.addChild(expr);
            this.expect(TK_SEMI);
        }
        Node cond = this.parseExpr(0);
        this.expect(TK_SEMI);
        Node update = this.parseExpr(0);
        this.expect(TK_RPAREN);
        Node body = this.parseBlock();
        n.addChild(init);
        n.addChild(cond);
        n.addChild(update);
        n.addChild(body);
        return n;
    }

    private Node parseForeach() {
        int ln = this.line(); int c = this.col();
        this.advance();
        this.expect(TK_LPAREN);
        string typ = "";
        if (this.checkType()) { typ = this.parseTypeStr(); }
        elif (this.check(TK_VAR)) { this.advance(); typ = "var"; }
        elif (this.check(TK_IDENT)) {
            int saved = this.pos;
            string first = this.expectIdent();
            bool isTyped = !this.check(TK_IN);
            this.pos = saved;
            if (isTyped) { typ = this.parseTypeStr(); }
        }
        string var_ = this.expectIdent();
        this.expect(TK_IN);
        Node collection = this.parseExpr(0);
        this.expect(TK_RPAREN);
        Node body = this.parseBlock();
        Node n = new Node(ND_FOREACH, ln, c);
        n.name = var_;
        n.typeHint = typ;
        n.addChild(collection);
        n.addChild(body);
        return n;
    }

    private Node parseWhile() {
        int ln = this.line(); int c = this.col();
        this.advance();
        this.expect(TK_LPAREN);
        Node cond = this.parseExpr(0);
        this.expect(TK_RPAREN);
        Node body = this.parseBlock();
        Node n = new Node(ND_WHILE, ln, c);
        n.addChild(cond);
        n.addChild(body);
        return n;
    }

    // `loop { body }` (DOCS/12): an infinite loop exited only by `break`.
    // `continue` restarts the body.
    private Node parseLoop() {
        int ln = this.line(); int c = this.col();
        this.advance();
        Node body = this.parseBlock();
        Node n = new Node(ND_LOOP, ln, c);
        n.addChild(body);
        return n;
    }

    private Node parseIf() {
        int ln = this.line(); int c = this.col();
        this.advance();
        this.expect(TK_LPAREN);
        Node cond = this.parseExpr(0);
        this.expect(TK_RPAREN);
        Node then = this.parseBlock();
        Node n = new Node(ND_IF_STMT, ln, c);
        n.addChild(cond);
        n.addChild(then);
        if (this.check(TK_ELSE)) {
            this.advance();
            if (this.check(TK_IF)) {
                Node? elseIf = this.parseIf();
                if (elseIf != null) { n.addChild(elseIf); }
            } else {
                n.addChild(this.parseBlock());
            }
        }
        if (this.check(TK_ELIF)) {
            Node? elseIf = this.parseIf();
            if (elseIf != null) { n.addChild(elseIf); }
        }
        return n;
    }

    private Node parseMatchStmt() {
        int ln = this.line(); int c = this.col();
        this.advance();
        if (this.check(TK_LPAREN)) { this.advance(); }
        Node expr = this.parseExpr(0);
        if (this.check(TK_RPAREN)) { this.advance(); }
        this.expect(TK_LBRACE);
        Node n = new Node(ND_MATCH_STMT, ln, c);
        n.addChild(expr);
        while (!this.check(TK_RBRACE) && !this.check(TK_EOF)) {
            Node pattern = this.parsePattern();
            this.expect(TK_FAT_ARROW);
            Node body = this.parseExpr(0);
            if (this.check(TK_SEMI)) { this.advance(); }
            if (this.check(TK_COMMA)) { this.advance(); }
            Node arm = new Node(ND_TUPLE_LIT, ln, c);
            arm.addChild(pattern);
            arm.addChild(body);
            n.addChild(arm);
        }
        this.expect(TK_RBRACE);
        return n;
    }

    private Node parseTryCatch() {
        int ln = this.line(); int c = this.col();
        this.advance();
        Node n = new Node(ND_TRY_CATCH, ln, c);
        n.addChild(this.parseBlock());
        if (this.check(TK_CATCH)) {
            this.advance();
            this.expect(TK_LPAREN);
            string catchType = this.parseTypeStr();
            string catchVar = this.expectIdent();
            this.expect(TK_RPAREN);
            n.name = catchVar;
            n.typeHint = catchType;
            n.addChild(this.parseBlock());
        } else {
            Node empty = new Node(ND_BLOCK, ln, c);
            n.addChild(empty);
        }
        if (this.check(TK_FINALLY)) {
            this.advance();
            n.hasFinally = true;
            n.addChild(this.parseBlock());
        }
        return n;
    }

    private Node parseThrow() {
        int ln = this.line(); int c = this.col();
        this.advance();
        Node n = new Node(ND_THROW, ln, c);
        n.addChild(this.parseExpr(0));
        this.expectSemi();
        return n;
    }

    private Node parseReturn() {
        int ln = this.line(); int c = this.col();
        this.advance();
        Node n = new Node(ND_RETURN, ln, c);
        if (!this.check(TK_SEMI)) {
            n.addChild(this.parseExpr(0));
        }
        this.expectSemi();
        return n;
    }

    private Node parseReturnShortcut() {
        int ln = this.line(); int c = this.col();
        this.advance();
        Node n = new Node(ND_RETURN, ln, c);
        n.addChild(this.parseExpr(0));
        this.expectSemi();
        return n;
    }

    private Node parseUnset() {
        int ln = this.line(); int c = this.col();
        this.advance();
        string name = this.expectIdent();
        this.expectSemi();
        Node n = new Node(ND_UNSET, ln, c);
        n.name = name;
        return n;
    }

    private Node parseSwitch() {
        int ln = this.line(); int c = this.col();
        this.advance();
        this.expect(TK_LPAREN);
        Node expr = this.parseExpr(0);
        this.expect(TK_RPAREN);
        this.expect(TK_LBRACE);
        Node n = new Node(ND_SWITCH, ln, c);
        n.addChild(expr);
        while (!this.check(TK_RBRACE) && !this.check(TK_EOF)) {
            if (this.check(TK_CASE)) {
                this.advance();
                Node caseExpr = this.parseExpr(0);
                Node caseBody = this.parseBlock();
                Node arm = new Node(ND_TUPLE_LIT, ln, c);
                arm.addChild(caseExpr);
                arm.addChild(caseBody);
                n.addChild(arm);
            } else if (this.check(TK_ELSE)) {
                this.advance();
                Node elseBody = this.parseBlock();
                Node arm = new Node(ND_TUPLE_LIT, ln, c);
                arm.name = "else";
                arm.addChild(new Node(ND_NULL_LIT, ln, c));
                arm.addChild(elseBody);
                n.addChild(arm);
            } else {
                break;
            }
        }
        this.expect(TK_RBRACE);
        return n;
    }

    private Node parseVarDecl() {
        int ln = this.line(); int c = this.col();
        this.advance();
        string name = this.expectIdent();
        this.knownIdents.add(name);
        Node n = new Node(ND_VAR_DECL, ln, c);
        n.name = name;
        if (this.check(TK_ASSIGN)) {
            this.advance();
            n.addChild(this.parseExpr(0));
        }
        if (this.check(TK_SHL)) {
            this.advance();
            Node rhs = this.parseExpr(0);
            Node move = new Node(ND_BINARY, n.line, n.col);
            move.op = OP_MOVE;
            Node src = new Node(ND_IDENT, n.line, n.col);
            src.name = n.name;
            move.addChild(src);
            move.addChild(rhs);
            n.addChild(move);
            this.expectSemi();
            return n;
        }
        this.expectSemi();
        return n;
    }

    private Node parseTypedDecl() {
        int ln = this.line(); int c = this.col();
        string typ = this.parseTypeStr();
        // `int32 as KM;` (DOCS/48) -- the `T as Name;` spelling of a type
        // alias declaration.
        if (this.check(TK_AS)) {
            this.advance();
            string aliasName = this.expectIdent();
            Node al = new Node(ND_ALIAS_DECL, ln, c);
            al.name = aliasName;
            al.typeHint = typ;
            al.isAlias = true;
            this.registerDeclaredType(aliasName);
            this.expectSemi();
            return al;
        }
        bool isMut = false;
        if (this.check(TK_MUT)) { this.advance(); isMut = true; }
        string name = this.expectIdent();
        if (this.check(TK_COMMA)) {
            int saved = this.pos;
            Node d = new Node(ND_DESTRUCT, ln, c);
            d.typeHint = typ;
            Node firstN = new Node(ND_IDENT, ln, c);
            firstN.name = name;
            d.addChild(firstN);
            while (this.check(TK_COMMA)) {
                this.advance();
                Node nn = new Node(ND_IDENT, ln, c);
                nn.name = this.expectIdent();
                d.addChild(nn);
            }
            if (this.check(TK_ASSIGN)) {
                this.advance();
                d.addChild(this.parseExpr(0));
                this.expectSemi();
                return d;
            }
            this.pos = saved;
        }
        Node n = new Node(ND_VAR_DECL, ln, c);
        n.name = name;
        n.typeHint = typ;
        n.isMut = isMut;
        bool isFixed = false;
        int fixedSize = 0;
        if (this.check(TK_LBRACKET) && !(this.pos + 1 < this.tokens.length && this.tokens[this.pos + 1].kind == TK_RBRACKET)) {
            this.advance();
            Node size = this.parseExpr(0);
            this.expect(TK_RBRACKET);
            isFixed = true;
            if (size.kind == ND_INT_LIT) { fixedSize = size.intVal; }
            n.typeHint = typ + "[]";
        }
        if (this.check(TK_ASSIGN)) {
            this.advance();
            n.addChild(this.parseExpr(0));
        } elif (isFixed) {
            // Materialize zero elements so the interpreter's normal array
            // representation has the requested length and can be indexed or
            // passed to native out-parameter helpers.
            Node arr = new Node(ND_ARRAY_LIT, ln, c);
            for (int i = 0; i < fixedSize; i = i + 1) {
                Node zero = new Node(ND_INT_LIT, ln, c);
                zero.intVal = 0;
                arr.addChild(zero);
            }
            n.addChild(arr);
        }
        if (this.check(TK_SHL)) {
            this.advance();
            Node rhs = this.parseExpr(0);
            Node move = new Node(ND_BINARY, n.line, n.col);
            move.op = OP_MOVE;
            Node src = new Node(ND_IDENT, n.line, n.col);
            src.name = n.name;
            move.addChild(src);
            move.addChild(rhs);
            n.addChild(move);
            this.expectSemi();
            return n;
        }
        // TYPE_EXCEPTIONS.md — flag an initializer literal whose value kind
        // can never fit the declared scalar type (`int x = "hello"`).
        if (n.childCount() > 0 && !isFixed) {
            this.checkDeclValueType(typ, n.child(0), name);
        }
        this.knownIdents.add(name);
        this.expectSemi();
        return n;
    }

    private Node parseNamedTypeDeclStmt() {
        int ln = this.line(); int c = this.col();
        string typeName = this.parseTypeStr();
        // Tuple destructuring: `tuple<T...> (x, y, z) = expr;` (DOCS/18)
        if (this.check(TK_LPAREN)) {
            this.advance();
            Node d = new Node(ND_DESTRUCT, ln, c);
            d.typeHint = typeName;
            while (!this.check(TK_RPAREN) && !this.check(TK_EOF)) {
                Node nn = new Node(ND_IDENT, ln, c);
                nn.name = this.expectIdent();
                d.addChild(nn);
                if (this.check(TK_COMMA)) { this.advance(); }
            }
            this.expect(TK_RPAREN);
            this.expect(TK_ASSIGN);
            d.addChild(this.parseExpr(0));
            this.expectSemi();
            return d;
        }
        bool isMut = false;
        if (this.check(TK_MUT)) { this.advance(); isMut = true; }
        string name = this.expectIdent();
        // Comma-separated destructure: `tuple<int,string> a, b = t;` (DOCS/18)
        if (this.check(TK_COMMA)) {
            int saved = this.pos;
            Node d = new Node(ND_DESTRUCT, ln, c);
            d.typeHint = typeName;
            Node firstN = new Node(ND_IDENT, ln, c);
            firstN.name = name;
            d.addChild(firstN);
            while (this.check(TK_COMMA)) {
                this.advance();
                Node nn = new Node(ND_IDENT, ln, c);
                nn.name = this.expectIdent();
                d.addChild(nn);
            }
            if (this.check(TK_ASSIGN)) {
                this.advance();
                d.addChild(this.parseExpr(0));
                this.expectSemi();
                return d;
            }
            this.pos = saved;
        }
        Node n = new Node(ND_VAR_DECL, ln, c);
        n.name = name;
        n.typeHint = typeName;
        n.isMut = isMut;
        bool isFixed = false;
        int fixedSize = 0;
        if (this.check(TK_LBRACKET) && !(this.pos + 1 < this.tokens.length && this.tokens[this.pos + 1].kind == TK_RBRACKET)) {
            this.advance();
            Node size = this.parseExpr(0);
            this.expect(TK_RBRACKET);
            isFixed = true;
            if (size.kind == ND_INT_LIT) { fixedSize = size.intVal; }
            n.typeHint = typeName + "[]";
        }
        if (this.check(TK_ASSIGN)) {
            this.advance();
            n.addChild(this.parseExpr(0));
        } elif (isFixed) {
            Node arr = new Node(ND_ARRAY_LIT, ln, c);
            for (int i = 0; i < fixedSize; i = i + 1) {
                Node zero = new Node(ND_INT_LIT, ln, c);
                zero.intVal = 0;
                arr.addChild(zero);
            }
            n.addChild(arr);
        }
        if (this.check(TK_SHL)) {
            this.advance();
            Node rhs = this.parseExpr(0);
            Node move = new Node(ND_BINARY, n.line, n.col);
            move.op = OP_MOVE;
            Node src = new Node(ND_IDENT, n.line, n.col);
            src.name = n.name;
            move.addChild(src);
            move.addChild(rhs);
            n.addChild(move);
            this.expectSemi();
            return n;
        }
        // TYPE_EXCEPTIONS.md — flag an initializer literal whose value kind
        // can never fit the declared scalar type (`int x = "hello"`).
        if (n.childCount() > 0 && !isFixed) {
            this.checkDeclValueType(typeName, n.child(0), name);
        }
        this.knownIdents.add(name);
        this.expectSemi();
        return n;
    }

    private Node parsePattern() {
        int ln = this.line(); int c = this.col();
        if (this.check(TK_UNDERSCORE)) {
            this.advance();
            Node n = new Node(ND_NULL_LIT, ln, c);
            n.name = "_";
            return n;
        }
        if (this.check(TK_NULL_LIT)) {
            this.advance();
            Node n = new Node(ND_NULL_LIT, ln, c);
            n.name = "null";
            return n;
        }
        if (this.check(TK_BOOL_LIT)) {
            Node n = new Node(ND_BOOL_LIT, ln, c);
            n.boolVal = this.advance().text == "true";
            return n;
        }
        if (this.check(TK_INT_LIT)) {
            Node n = new Node(ND_INT_LIT, ln, c);
            n.intVal = this.advance().intVal;
            return n;
        }
        if (this.check(TK_FLOAT_LIT)) {
            Node n = new Node(ND_FLOAT_LIT, ln, c);
            n.strVal = this.advance().strVal;
            return n;
        }
        if (this.check(TK_STRING_LIT)) {
            Node n = new Node(ND_STRING_LIT, ln, c);
            n.strVal = this.advance().strVal;
            return n;
        }
        if (this.check(TK_CHAR_LIT)) {
            Node n = new Node(ND_CHAR_LIT, ln, c);
            n.charVal = this.advance().charVal;
            return n;
        }
        if (this.check(TK_LESS)) {
            this.advance();
            string typ = this.parseTypeStr();
            this.expect(TK_GREATER);
            string bindName = this.expectIdent();
            Node n = new Node(ND_IDENT, ln, c);
            n.name = bindName;
            n.typeHint = typ;
            return n;
        }
        if (this.check(TK_LPAREN)) {
            this.advance();
            Node n = new Node(ND_TUPLE_LIT, ln, c);
            while (!this.check(TK_RPAREN) && !this.check(TK_EOF)) {
                n.addChild(this.parsePattern());
                if (this.check(TK_COMMA)) { this.advance(); }
            }
            this.expect(TK_RPAREN);
            return n;
        }
        if (this.check(TK_IDENT)) {
            string name = this.expectIdent();
            if (this.check(TK_DOT)) {
                this.advance();
                string variant = this.expectIdent();
                Node n = new Node(ND_IDENT, ln, c);
                n.name = name + "." + variant;
                return n;
            }
            Node n = new Node(ND_IDENT, ln, c);
            n.name = name;
            return n;
        }
        this.advance();
        return new Node(ND_NULL_LIT, ln, c);
    }

    private Node parseExpr(int minPrec) {
        Node lhs = this.parsePrefix();
        while (this.isInfix() && this.getInfixPrec() >= minPrec) {
            lhs = this.parseInfix(lhs);
        }
        return lhs;
    }

    private bool isInfix() {
        int k = this.peekKind();
        if (k == TK_RANGE && this.rangeIsSliceBoundary) {
            // `..` inside a `[...]` index starts a slice, so it is not an
            // infix operator there.
            return false;
        }
        return k == TK_PLUS || k == TK_MINUS || k == TK_STAR || k == TK_SLASH || k == TK_PERCENT
            || k == TK_EQ || k == TK_NEQ || k == TK_LESS || k == TK_LEQ || k == TK_GREATER || k == TK_GEQ
            || k == TK_AND || k == TK_OR
            || k == TK_SHL || k == TK_SHR
            || k == TK_ASSIGN || k == TK_PLUS_EQ || k == TK_MINUS_EQ || k == TK_STAR_EQ || k == TK_SLASH_EQ
            || k == TK_PERCENT_EQ || k == TK_AMP_EQ || k == TK_PIPE_EQ || k == TK_CARET_EQ || k == TK_SHL_EQ || k == TK_SHR_EQ
            || k == TK_RANGE
            || k == TK_SPREAD
            || k == TK_LPAREN || k == TK_LBRACKET || k == TK_DOT
            || k == TK_AMP || k == TK_PIPE || k == TK_CARET
            || k == TK_INC || k == TK_DEC || k == TK_QUESTION || k == TK_QUESTIONQUESTION
            || k == TK_FAT_ARROW;
    }

    private int getInfixPrec() {
        int k = this.peekKind();
        if (k == TK_ASSIGN || k == TK_PLUS_EQ || k == TK_MINUS_EQ || k == TK_STAR_EQ || k == TK_SLASH_EQ
            || k == TK_PERCENT_EQ || k == TK_AMP_EQ || k == TK_PIPE_EQ || k == TK_CARET_EQ || k == TK_SHL_EQ || k == TK_SHR_EQ) { return 1; }
        if (k == TK_QUESTION || k == TK_QUESTIONQUESTION) { return 1; }
        if (k == TK_OR) { return 2; }
        if (k == TK_AND) { return 3; }
        if (k == TK_EQ || k == TK_NEQ) { return 4; }
        if (k == TK_LESS || k == TK_LEQ || k == TK_GREATER || k == TK_GEQ) { return 5; }
        if (k == TK_PIPE) { return 6; }
        if (k == TK_AMP || k == TK_CARET) { return 7; }
        if (k == TK_SHL || k == TK_SHR) { return 8; }
        if (k == TK_PLUS || k == TK_MINUS) { return 9; }
        if (k == TK_STAR || k == TK_SLASH || k == TK_PERCENT) { return 10; }
        if (k == TK_RANGE || k == TK_SPREAD) { return 11; }
        if (k == TK_LPAREN || k == TK_LBRACKET || k == TK_DOT) { return 12; }
        if (k == TK_INC || k == TK_DEC) { return 12; }
        if (k == TK_FAT_ARROW) { return 13; }
        return 0;
    }

    private Node parsePrefix() {
        int ln = this.line(); int c = this.col();
        if (this.check(TK_INT_LIT)) {
            Node n = new Node(ND_INT_LIT, ln, c);
            n.intVal = this.advance().intVal;
            return n;
        }
        if (this.check(TK_FLOAT_LIT)) {
            Node n = new Node(ND_FLOAT_LIT, ln, c);
            n.strVal = this.advance().strVal;
            return n;
        }
        if (this.check(TK_STRING_LIT)) {
            Token t = this.advance();
            Node n = new Node(ND_STRING_LIT, ln, c);
            n.strVal = t.strVal;
            return n;
        }
        if (this.check(TK_CHAR_LIT)) {
            Node n = new Node(ND_CHAR_LIT, ln, c);
            n.charVal = this.advance().charVal;
            return n;
        }
        if (this.check(TK_BOOL_LIT)) {
            Node n = new Node(ND_BOOL_LIT, ln, c);
            n.boolVal = this.advance().text == "true";
            return n;
        }
        if (this.check(TK_NULL_LIT)) {
            this.advance();
            return new Node(ND_NULL_LIT, ln, c);
        }
        if (this.check(TK_DOLLAR)) {
            this.advance();
            Token t = this.expect(TK_STRING_LIT);
            return this.parseInterpolation(t.strVal, ln, c);
        }
        if (this.check(TK_MINUS)) {
            this.advance();
            Node n = new Node(ND_UNARY, ln, c);
            n.op = UOP_NEG;
            n.addChild(this.parseExpr(10));
            return n;
        }
        if (this.check(TK_BANG)) {
            this.advance();
            Node n = new Node(ND_UNARY, ln, c);
            n.op = UOP_NOT;
            n.addChild(this.parseExpr(10));
            return n;
        }
        if (this.check(TK_TILDE)) {
            this.advance();
            Node n = new Node(ND_UNARY, ln, c);
            n.op = UOP_BITNOT;
            n.addChild(this.parseExpr(10));
            return n;
        }
        if (this.check(TK_STAR)) {
            this.advance();
            Node n = new Node(ND_UNARY, ln, c);
            n.op = UOP_DEREF;
            n.addChild(this.parseExpr(10));
            return n;
        }
        if (this.check(TK_AMP)) {
            this.advance();
            Node n = new Node(ND_UNARY, ln, c);
            n.op = UOP_REF;
            n.addChild(this.parseExpr(10));
            return n;
        }
        if (this.check(TK_AT)) {
            this.advance();
            Node addr = new Node(ND_ADDRESS_OF, ln, c);
            addr.addChild(this.parseExpr(10));
            return addr;
        }
        if (this.check(TK_NEW)) {
            this.advance();
            string typeName = this.expectIdent();
            if (this.check(TK_LBRACKET)) {
                // Primitive array construction, currently including the
                // documented `new byte[count]` form. Keep ND_NEW so the
                // evaluator can share the existing construction path.
                this.advance();
                Node size = this.parseExpr(0);
                this.expect(TK_RBRACKET);
                Node n = new Node(ND_NEW, ln, c);
                n.name = typeName;
                n.addChild(size);
                return n;
            }
            this.expect(TK_LPAREN);
            Node[] args = [];
            while (!this.check(TK_RPAREN) && !this.check(TK_EOF)) {
                args.add(this.parseExpr(0));
                if (this.check(TK_COMMA)) { this.advance(); }
            }
            this.expect(TK_RPAREN);
            Node n = new Node(ND_NEW, ln, c);
            n.name = typeName;
            foreach (Node a in args) { n.addChild(a); }
            return n;
        }
        if (this.check(TK_MATCH)) {
            this.advance();
            if (this.check(TK_LPAREN)) { this.advance(); }
            Node expr = this.parseExpr(0);
            if (this.check(TK_RPAREN)) { this.advance(); }
            this.expect(TK_LBRACE);
            Node n = new Node(ND_MATCH, ln, c);
            n.addChild(expr);
            while (!this.check(TK_RBRACE) && !this.check(TK_EOF)) {
                Node pattern = this.parsePattern();
                this.expect(TK_FAT_ARROW);
                Node body = this.parseExpr(0);
                if (this.check(TK_SEMI)) { this.advance(); }
                if (this.check(TK_COMMA)) { this.advance(); }
                Node arm = new Node(ND_TUPLE_LIT, ln, c);
                arm.addChild(pattern);
                arm.addChild(body);
                n.addChild(arm);
            }
            this.expect(TK_RBRACE);
            return n;
        }
        if (this.check(TK_LPAREN)) {
            // C-style cast `(type) expr` (DOCS/113) when a type keyword follows
            // the opening paren.
            if (this.pos + 1 < this.tokens.length) {
                TokenKind k2 = this.tokens[this.pos + 1].kind;
                if (k2 == TK_INT || k2 == TK_INT32 || k2 == TK_INT64 || k2 == TK_UINT
                    || k2 == TK_FLOAT || k2 == TK_FLOAT64 || k2 == TK_DOUBLE
                    || k2 == TK_BOOL || k2 == TK_CHAR || k2 == TK_BYTE || k2 == TK_STRING) {
                    this.advance();
                    string castType = this.parseTypeStr();
                    this.expect(TK_RPAREN);
                    Node cast = new Node(ND_CAST, ln, c);
                    cast.typeHint = castType;
                    cast.addChild(this.parseExpr(12));
                    return cast;
                }
            }
            this.advance();
            Node first = this.parseExpr(0);
            if (this.check(TK_COMMA)) {
                Node n = new Node(ND_TUPLE_LIT, ln, c);
                n.addChild(first);
                while (this.check(TK_COMMA)) {
                    this.advance();
                    n.addChild(this.parseExpr(0));
                }
                this.expect(TK_RPAREN);
                return n;
            }
            this.expect(TK_RPAREN);
            Node n = new Node(ND_PAREN, ln, c);
            n.addChild(first);
            return n;
        }
        if (this.check(TK_LBRACKET)) {
            this.advance();
            Node n = new Node(ND_ARRAY_LIT, ln, c);
            while (!this.check(TK_RBRACKET) && !this.check(TK_EOF)) {
                if (this.check(TK_SPREAD)) {
                    this.advance();
                    Node spread = this.parseExpr(0);
                    spread.name = "spread";
                    n.addChild(spread);
                } else {
                    n.addChild(this.parseExpr(0));
                }
                if (this.check(TK_COMMA)) { this.advance(); }
            }
            this.expect(TK_RBRACKET);
            return n;
        }
        if (this.check(TK_LBRACE)) {
            this.advance();
            if (this.check(TK_STRING_LIT) || this.check(TK_INT_LIT)) {
                int look = this.pos + 1;
                if (look < this.tokens.length && this.tokens[look].kind == TK_COLON) {
                    Node n = new Node(ND_DICT_LIT, ln, c);
                    while (!this.check(TK_RBRACE) && !this.check(TK_EOF)) {
                        Node key = this.parseExpr(0);
                        this.expect(TK_COLON);
                        Node val = this.parseExpr(0);
                        Node pair = new Node(ND_TUPLE_LIT, ln, c);
                        pair.addChild(key);
                        pair.addChild(val);
                        n.addChild(pair);
                        if (this.check(TK_COMMA)) { this.advance(); }
                    }
                    this.expect(TK_RBRACE);
                    return n;
                }
            }
            if (this.check(TK_RBRACE)) {
                this.advance();
                return new Node(ND_DICT_LIT, ln, c);
            }
            if (this.check(TK_IDENT) && this.pos + 1 < this.tokens.length && this.tokens[this.pos + 1].kind == TK_COLON) {
                Node n = new Node(ND_STRUCT_LIT, ln, c);
                while (!this.check(TK_RBRACE) && !this.check(TK_EOF)) {
                    string fieldName = this.expectIdent();
                    this.expect(TK_COLON);
                    Node val = this.parseExpr(0);
                    Node field = new Node(ND_VAR_DECL, ln, c);
                    field.name = fieldName;
                    field.addChild(val);
                    n.addChild(field);
                    if (this.check(TK_COMMA)) { this.advance(); }
                }
                this.expect(TK_RBRACE);
                return n;
            }
            this.pos -= 1;
            return this.parseBlock();
        }
        if (this.check(TK_IDENT)) {
            Node n = new Node(ND_IDENT, ln, c);
            n.name = this.advance().text;
            return n;
        }
        // Primitive type keywords are callable in expression position:
        // `string(x)`, `int(x)`, `float(x)` etc. are casts, resolved here as
        // ordinary calls so they dispatch to the matching builtin (e.g.
        // `string` -> string_cast). Mirroring the compiler, keep the keyword's
        // source text as the callee name.
        if (this.check(TK_INT) || this.check(TK_INT32) || this.check(TK_INT64) || this.check(TK_UINT)
            || this.check(TK_FLOAT) || this.check(TK_FLOAT64) || this.check(TK_DOUBLE)
            || this.check(TK_BOOL) || this.check(TK_CHAR) || this.check(TK_STRING) || this.check(TK_VOID)) {
            Node n = new Node(ND_IDENT, ln, c);
            n.name = this.advance().text;
            return n;
        }
        this.advance();
        return new Node(ND_NULL_LIT, ln, c);
    }

    private Node parseInfix(Node lhs) {
        int ln = this.line(); int c = this.col();
        int k = this.peekKind();

        if (k == TK_QUESTION) {
            this.advance();
            Node thenExpr = this.parseExpr(1);
            this.expect(TK_COLON);
            Node elseExpr = this.parseExpr(1);
            Node n = new Node(ND_TERNARY, ln, c);
            n.addChild(lhs);
            n.addChild(thenExpr);
            n.addChild(elseExpr);
            return n;
        }
        if (k == TK_QUESTIONQUESTION) {
            this.advance();
            Node n = new Node(ND_BINARY, ln, c);
            n.op = OP_COALESCE;
            n.addChild(lhs);
            n.addChild(this.parseExpr(1));
            return n;
        }
        if (k == TK_ASSIGN) {
            this.advance();
            Node n = new Node(ND_BINARY, ln, c);
            n.op = OP_ASSIGN;
            n.addChild(lhs);
            n.addChild(this.parseExpr(1));
            return n;
        }
        if (k == TK_PLUS_EQ) { this.advance(); return this.makeAssignOp(lhs, OP_ADD_ASSIGN, ln, c); }
        if (k == TK_MINUS_EQ) { this.advance(); return this.makeAssignOp(lhs, OP_SUB_ASSIGN, ln, c); }
        if (k == TK_STAR_EQ) { this.advance(); return this.makeAssignOp(lhs, OP_MUL_ASSIGN, ln, c); }
        if (k == TK_SLASH_EQ) { this.advance(); return this.makeAssignOp(lhs, OP_DIV_ASSIGN, ln, c); }
        if (k == TK_PERCENT_EQ) { this.advance(); return this.makeAssignOp(lhs, OP_MOD_ASSIGN, ln, c); }
        if (k == TK_AMP_EQ) { this.advance(); return this.makeAssignOp(lhs, OP_BIT_AND_ASSIGN, ln, c); }
        if (k == TK_PIPE_EQ) { this.advance(); return this.makeAssignOp(lhs, OP_BIT_OR_ASSIGN, ln, c); }
        if (k == TK_CARET_EQ) { this.advance(); return this.makeAssignOp(lhs, OP_BIT_XOR_ASSIGN, ln, c); }
        if (k == TK_SHL_EQ) { this.advance(); return this.makeAssignOp(lhs, OP_SHL_ASSIGN, ln, c); }
        if (k == TK_SHR_EQ) { this.advance(); return this.makeAssignOp(lhs, OP_SHR_ASSIGN, ln, c); }
        if (k == TK_INC) {
            this.advance();
            Node n = new Node(ND_BINARY, ln, c);
            n.op = OP_ADD_ASSIGN;
            n.addChild(lhs);
            Node one = new Node(ND_INT_LIT, ln, c);
            one.intVal = 1;
            n.addChild(one);
            return n;
        }
        if (k == TK_DEC) {
            this.advance();
            Node n = new Node(ND_BINARY, ln, c);
            n.op = OP_SUB_ASSIGN;
            n.addChild(lhs);
            Node one = new Node(ND_INT_LIT, ln, c);
            one.intVal = 1;
            n.addChild(one);
            return n;
        }
        if (k == TK_RANGE) {
            this.advance();
            Node n = new Node(ND_BINARY, ln, c);
            n.op = OP_RANGE;
            n.addChild(lhs);
            n.addChild(this.parseExpr(11));
            return n;
        }
        if (k == TK_SPREAD) {
            this.advance();
            Node n = new Node(ND_BINARY, ln, c);
            n.op = OP_REPEAT;
            n.addChild(lhs);
            n.addChild(this.parseExpr(11));
            return n;
        }
        if (k == TK_LPAREN) {
            this.advance();
            // `add (1 2)` — argument separation and the closing parenthesis
            // are recovered with doc-specified diagnostics
            // (SYNTAX_EXCEPTIONS.md).
            Token openTok = this.tokens[this.pos - 1];
            Node[] args = [];
            while (!this.check(TK_RPAREN) && !this.check(TK_EOF)) {
                if (this.check(TK_COMMA)) {
                    this.advance();
                } elif (args.length > 0) {
                    Token prevT = this.tokens[this.pos - 1];
                    this.recordError("you forgot a comma \",\" at line " + prevT.line.toString() + ", column " + (prevT.col + this.tokenSrcLen(prevT)).toString());
                }
                args.add(this.parseExpr(0));
            }
            if (this.check(TK_RPAREN)) {
                this.advance();
            } else {
                // Missing closing parenthesis: reported just past the
                // opening one.
                this.recordError("Missing close parenthesis at line " + openTok.line.toString() + ", column " + (openTok.col + 1).toString());
            }
            if (lhs.kind == ND_IDENT) {
                Node n = new Node(ND_CALL, lhs.line, lhs.col);
                n.name = lhs.name;
                foreach (Node a in args) { n.addChild(a); }
                // TYPE_EXCEPTIONS.md — chained parameter type mismatches.
                this.checkCallArgTypes(n);
                return n;
            }
            if (lhs.kind == ND_MEMBER) {
                Node n = new Node(ND_METHOD_CALL, ln, c);
                n.addChild(lhs.child(0));
                n.name = lhs.name;
                foreach (Node a in args) { n.addChild(a); }
                // VALUE_EXCEPTION.md — numeric parse conversions on a literal
                // string argument (`int.parseInt("hello")`).
                if (lhs.child(0).kind == ND_IDENT && args.length == 1) {
                    this.checkParseValueException(lhs.child(0).name, lhs.name, args[0]);
                }
                return n;
            }
            Node n = new Node(ND_CALL, ln, c);
            n.name = lhs.name;
            foreach (Node a in args) { n.addChild(a); }
            return n;
        }
        if (k == TK_LBRACKET) {
            this.advance();
            // Inside the brackets, `..` is a slice boundary rather than a
            // binary range operator, so the index expression stops there.
            bool oldBoundary = this.rangeIsSliceBoundary;
            this.rangeIsSliceBoundary = true;
            Node idx = this.parseExpr(0);
            bool isSlice = this.check(TK_RANGE);
            Node n;
            if (isSlice) {
                this.advance();
                Node end = this.parseExpr(0);
                this.expect(TK_RBRACKET);
                n = new Node(ND_SLICE, ln, c);
                n.addChild(lhs);
                n.addChild(idx);
                n.addChild(end);
            } else {
                this.expect(TK_RBRACKET);
                n = new Node(ND_INDEX, ln, c);
                n.addChild(lhs);
                n.addChild(idx);
            }
            this.rangeIsSliceBoundary = oldBoundary;
            return n;
        }
        if (k == TK_DOT) {
            this.advance();
            string member = "";
            if (this.check(TK_IDENT)) {
                member = this.expectIdent();
            } elif (this.check(TK_INT_LIT)) {
                member = this.advance().text;
            } elif (this.check(TK_FLOAT_LIT)) {
                // `t.0.toString()` lexes the index as the float "0."; a float
                // made of digits and a bare trailing dot is the tuple-index
                // member form, so strip the trailing dot.
                string ftext = this.advance().text;
                if (ftext.length > 1 && ftext[ftext.length - 1] == '.') {
                    member = ftext.substr(0, ftext.length - 1);
                } else {
                    this.parseErrors += 1;
                    printline("Parse error: expected identifier or integer literal after '.' at " + this.peek().line.toString() + ":" + this.peek().col.toString());
                    member = "_err";
                }
            } else {
                this.parseErrors += 1;
                printline("Parse error: expected identifier or integer literal after '.' at " + this.peek().line.toString() + ":" + this.peek().col.toString());
                member = "_err";
            }
            Node n = new Node(ND_MEMBER, ln, c);
            n.addChild(lhs);
            n.name = member;
            return n;
        }
        if (k == TK_FAT_ARROW) {
            this.advance();
            Node body = this.parseExpr(0);
            Node n = new Node(ND_TUPLE_LIT, ln, c);
            n.addChild(lhs);
            n.addChild(body);
            n.name = "arrow";
            return n;
        }

        int op = this.tokenToOp(k);
        if (op >= 0) {
            this.advance();
            int prec = this.opToPrec(op);
            Node n = new Node(ND_BINARY, ln, c);
            n.op = op;
            n.addChild(lhs);
            n.addChild(this.parseExpr(prec));
            return n;
        }
        this.advance();
        return lhs;
    }

    private Node makeAssignOp(Node lhs, int op, int ln, int c) {
        Node n = new Node(ND_BINARY, ln, c);
        n.op = op;
        n.addChild(lhs);
        if (this.check(TK_INT_LIT) && this.peek().intVal == 1) {
            if (op == OP_ADD_ASSIGN || op == OP_SUB_ASSIGN) {
                this.advance();
                Node one = new Node(ND_INT_LIT, ln, c);
                one.intVal = 1;
                n.addChild(one);
                return n;
            }
        }
        n.addChild(this.parseExpr(1));
        return n;
    }

    private int tokenToOp(int k) {
        if (k == TK_PLUS) { return OP_ADD; }
        if (k == TK_MINUS) { return OP_SUB; }
        if (k == TK_STAR) { return OP_MUL; }
        if (k == TK_SLASH) { return OP_DIV; }
        if (k == TK_PERCENT) { return OP_MOD; }
        if (k == TK_EQ) { return OP_EQ; }
        if (k == TK_NEQ) { return OP_NEQ; }
        if (k == TK_LESS) { return OP_LT; }
        if (k == TK_LEQ) { return OP_LEQ; }
        if (k == TK_GREATER) { return OP_GT; }
        if (k == TK_GEQ) { return OP_GEQ; }
        if (k == TK_AND) { return OP_AND; }
        if (k == TK_OR) { return OP_OR; }
        if (k == TK_SHL) { return OP_SHL; }
        if (k == TK_SHR) { return OP_SHR; }
        if (k == TK_AMP) { return OP_BIT_AND; }
        if (k == TK_PIPE) { return OP_BIT_OR; }
        if (k == TK_CARET) { return OP_BIT_XOR; }
        return -1;
    }

    private int opToPrec(int op) {
        if (op == OP_AND) { return 3; }
        if (op == OP_OR) { return 2; }
        if (op == OP_EQ || op == OP_NEQ) { return 4; }
        if (op == OP_LT || op == OP_LEQ || op == OP_GT || op == OP_GEQ) { return 5; }
        if (op == OP_BIT_OR) { return 6; }
        if (op == OP_BIT_AND || op == OP_BIT_XOR) { return 7; }
        if (op == OP_SHL || op == OP_SHR) { return 8; }
        if (op == OP_ADD || op == OP_SUB) { return 9; }
        if (op == OP_MUL || op == OP_DIV || op == OP_MOD) { return 10; }
        return 9;
    }

    private Node parseInterpolation(string raw, int ln, int c) {
        Node n = new Node(ND_INTERP, ln, c);
        string currentText = "";
        int i = 0;
        while (i < raw.length) {
            if (raw[i] == '{') {
                if (currentText.length > 0) {
                    Node text = new Node(ND_STRING_LIT, ln, c);
                    text.strVal = currentText;
                    n.addChild(text);
                    currentText = "";
                }
                i += 1;
                string exprStr = "";
                int depth = 1;
                while (i < raw.length && depth > 0) {
                    if (raw[i] == '{') { depth += 1; }
                    else if (raw[i] == '}') { depth -= 1; if (depth == 0) { break; } }
                    exprStr += raw[i].toString();
                    i += 1;
                }
                Lexer subLexer = new Lexer(exprStr);
                Token[] subTokens = subLexer.tokenize();
                Parser subParser = new Parser(subTokens);
                Node exprNode = subParser.parseExpr(0);
                n.addChild(exprNode);
                i += 1;
            } else {
                currentText += raw[i].toString();
                i += 1;
            }
        }
        if (currentText.length > 0) {
            Node text = new Node(ND_STRING_LIT, ln, c);
            text.strVal = currentText;
            n.addChild(text);
        }
        return n;
    }

    private string parseTypeStr() {
        if (this.check(TK_INT)) { this.advance(); return this.applyTypeSuffix("int"); }
        if (this.check(TK_INT32)) { this.advance(); return this.applyTypeSuffix("int32"); }
        if (this.check(TK_INT64)) { this.advance(); return this.applyTypeSuffix("int64"); }
        if (this.check(TK_UINT)) { this.advance(); return this.applyTypeSuffix("uint"); }
        if (this.check(TK_FLOAT)) { this.advance(); return this.applyTypeSuffix("float"); }
        if (this.check(TK_FLOAT64)) { this.advance(); return this.applyTypeSuffix("float64"); }
        if (this.check(TK_DOUBLE)) { this.advance(); return this.applyTypeSuffix("double"); }
        if (this.check(TK_BOOL)) { this.advance(); return this.applyTypeSuffix("bool"); }
        if (this.check(TK_CHAR)) { this.advance(); return this.applyTypeSuffix("char"); }
        if (this.check(TK_STRING)) { this.advance(); return this.applyTypeSuffix("string"); }
        if (this.check(TK_VOID)) { this.advance(); return "void"; }
        if (this.check(TK_IDENT)) {
            string name = this.advance().text;
            if (this.check(TK_LESS)) {
                this.advance();
                string inner = this.parseTypeStr();
                while (this.check(TK_PIPE) || this.check(TK_COMMA)) {
                    string sep = this.advance().text;
                    inner += sep + this.parseTypeStr();
                }
                this.expect(TK_GREATER);
                return name + "<" + inner + ">" + this.typeSuffix();
            }
            return this.applyTypeSuffix(name);
        }
        if (this.check(TK_LESS)) {
            this.advance();
            string inner = this.parseTypeStr();
            while (this.check(TK_PIPE) || this.check(TK_COMMA)) {
                string sep = this.advance().text;
                inner += sep + this.parseTypeStr();
            }
            this.expect(TK_GREATER);
            return "<" + inner + ">" + this.typeSuffix();
        }
        return "var";
    }

    private string applyTypeSuffix(string base) {
        string result = base;
        while (this.check(TK_LBRACKET) && this.pos + 1 < this.tokens.length && this.tokens[this.pos + 1].kind == TK_RBRACKET) {
            this.advance(); this.advance();
            result += "[]";
        }
        if (this.check(TK_QUESTION)) { this.advance(); result += "?"; }
        if (this.check(TK_STAR)) { this.advance(); result += "*"; }
        return result;
    }

    private string typeSuffix() {
        if (this.check(TK_LBRACKET) && this.pos + 1 < this.tokens.length && this.tokens[this.pos + 1].kind == TK_RBRACKET) {
            this.advance(); this.advance();
            return "[]";
        }
        if (this.check(TK_QUESTION)) { this.advance(); return "?"; }
        return "";
    }

    // ---- EXCEPTIONS/*.md value/type diagnostics ----------------------------

    // TYPE_EXCEPTIONS.md fundamental value classes that must never mix
    // silently: numbers/chars interoperate; strings and booleans do not.
    private int typeFamily(string t) {
        for (int i = 0; i < t.length; i++) {
            char c = t[i];
            if (c == '[' || c == ']' || c == '?' || c == '<' || c == '>' || c == '.' || c == ',') { return -1; }
        }
        if (this.strEq(t, "int") || this.strEq(t, "int32") || this.strEq(t, "int64")
            || this.strEq(t, "uint") || this.strEq(t, "byte") || this.strEq(t, "float")
            || this.strEq(t, "float64") || this.strEq(t, "double") || this.strEq(t, "char")) { return 0; }
        if (this.strEq(t, "string")) { return 1; }
        if (this.strEq(t, "bool")) { return 2; }
        return -1;
    }

    private int literalFamily(Node n) {
        if (n.kind == ND_INT_LIT || n.kind == ND_FLOAT_LIT || n.kind == ND_CHAR_LIT) { return 0; }
        if (n.kind == ND_STRING_LIT) { return 1; }
        if (n.kind == ND_BOOL_LIT) { return 2; }
        return -1;
    }

    private string literalTypeName(Node n) {
        if (n.kind == ND_INT_LIT) { return "int"; }
        if (n.kind == ND_FLOAT_LIT) { return "float"; }
        if (n.kind == ND_STRING_LIT) { return "string"; }
        if (n.kind == ND_CHAR_LIT) { return "char"; }
        if (n.kind == ND_BOOL_LIT) { return "bool"; }
        return "var";
    }

    // `an int`, `a string`, ... for exception message phrasing.
    private string articleOf(string typeName) {
        if (typeName.length == 0) { return "a " + typeName; }
        char fc = typeName[0];
        if (fc == 'a' || fc == 'e' || fc == 'i' || fc == 'o') { return "an " + typeName; }
        return "a " + typeName;
    }

    // Split a comma-joined signature component back into entries.
    private string[] splitSigList(string joined) {
        string[] parts = [];
        string cur = "";
        for (int i = 0; i < joined.length; i++) {
            char c = joined[i];
            if (c == ',') { parts.add(cur); cur = ""; }
            else { cur = cur + c.toString(); }
        }
        parts.add(cur);
        return parts;
    }

    // VALUE_EXCEPTION.md — a numeric parse conversion receiving a non-numeric
    // string literal raises a ValueException pointing at the literal.
    private bool stringIsNumber(string s, bool wantInt) {
        string t = "";
        int start = 0;
        int end = s.length;
        while (start < end && s[start] == ' ') { start += 1; }
        while (end > start && s[end - 1] == ' ') { end -= 1; }
        for (int i = start; i < end; i++) { t = t + s[i].toString(); }
        int len = t.length;
        if (len == 0) { return false; }
        int i2 = 0;
        if (t[0] == '+' || t[0] == '-') { i2 = 1; }
        if (i2 >= len) { return false; }
        bool sawDigit = false;
        bool sawDot = false;
        bool sawExp = false;
        while (i2 < len) {
            char c = t[i2];
            if (c >= '0' && c <= '9') { sawDigit = true; }
            elif (c == '.' && !wantInt && !sawDot && !sawExp) { sawDot = true; }
            elif ((c == 'e' || c == 'E') && !wantInt && sawDigit && !sawExp) {
                sawExp = true;
                if (i2 + 1 < len && (t[i2 + 1] == '+' || t[i2 + 1] == '-')) { i2 += 1; }
                if (i2 + 1 >= len) { return false; }
            }
            else { return false; }
            i2 += 1;
        }
        return sawDigit;
    }

    private void checkParseValueException(string recv, string method, Node arg) {
        bool isIntRecv = this.strEq(recv, "int") || this.strEq(recv, "int64");
        bool isDblRecv = this.strEq(recv, "double") || this.strEq(recv, "float") || this.strEq(recv, "float64");
        if (!isIntRecv && !isDblRecv) { return; }
        bool wantsInt = this.strEq(method, "parseInt") || this.strEq(method, "toInt")
            || this.strEq(method, "parseLong") || this.strEq(method, "toInt64");
        bool wantsDouble = this.strEq(method, "parseDouble") || this.strEq(method, "toDouble")
            || this.strEq(method, "parseFloat");
        if (!wantsInt && !wantsDouble) { return; }
        if (arg.kind != ND_STRING_LIT) { return; }
        if (this.stringIsNumber(arg.strVal, wantsInt)) { return; }
        this.recordError("expected a string of a number at line " + arg.line.toString() + ", column " + arg.col.toString() + ", got \"" + arg.strVal + "\"");
    }

    // TYPE_EXCEPTIONS.md — a declaration whose initializer's value kind
    // cannot possibly fit (`int x = "hello"`) points at the value and names
    // the declared type and variable.
    private void checkDeclValueType(string declaredType, Node value, string varName) {
        int df = this.typeFamily(declaredType);
        if (df < 0) { return; }
        int vf = this.literalFamily(value);
        if (vf < 0 || vf == df) { return; }
        this.recordError("wrong value type at line " + value.line.toString() + ", column " + value.col.toString() + ", expected " + this.articleOf(declaredType) + " got " + this.articleOf(this.literalTypeName(value)) + " for " + declaredType + " \"" + varName + "\"");
    }

    // TYPE_EXCEPTIONS.md — chained parameter type mismatches for a plain
    // call whose callee matches a signature parsed in this file.
    private void checkCallArgTypes(Node call) {
        string joined = ",";
        for (int s = 0; s < this.sigNames.length; s++) {
            joined = joined + this.sigNames[s] + ",";
        }
        if (joined.indexOf("," + call.name + ",") < 0) { return; }
        string bestSegs = "";
        int bestCount = 0;
        // Accept the call when any same-named signature fits its arguments.
        for (int m = 0; m < this.sigNames.length; m++) {
            if (!this.strEq(this.sigNames[m], call.name)) { continue; }
            string[] types = this.splitSigList(this.sigTypes[m]);
            string[] names = this.splitSigList(this.sigParams[m]);
            int limit = types.length;
            if (call.childCount() < limit) { limit = call.childCount(); }
            string segs = "";
            int count = 0;
            for (int j = 0; j < limit; j++) {
                int pf = this.typeFamily(types[j]);
                if (pf < 0) { continue; }
                Node arg = call.child(j);
                int af = this.literalFamily(arg);
                if (af < 0 || af == pf) { continue; }
                if (count > 0) { segs = segs + ", and "; }
                segs = segs + "line " + arg.line.toString() + ", column " + arg.col.toString() + " for \"" + names[j] + "\" parameter expected " + this.articleOf(types[j]) + " got " + this.articleOf(this.literalTypeName(arg));
                count += 1;
            }
            if (count == 0) { return; }
            if (count > 0) { bestSegs = segs; bestCount = count; }
        }
        if (bestCount > 0) {
            this.recordError("wrong value type at " + bestSegs);
        }
    }

    // ---- Post-parse call diagnostics (EXCEPTIONS/*.md) ---------------------
    // Runs once after parseProgram (user programs only) so the whole symbol
    // table (functions, methods, types, win32 grants) is visible.

    public void checkCallDiagnostics(Node[] ast) {
        for (int i = 0; i < ast.length; i++) {
            this.walkCallDiagnostics(ast[i]);
        }
    }

    private void walkCallDiagnostics(Node n) {
        if (n.kind == ND_CALL && n.line > 0) {
            this.checkPlainCallTarget(n);
            this.checkFreePathValueException(n);
        }
        if (n.kind == ND_METHOD_CALL && n.line > 0) {
            this.checkMemberPathValueException(n);
        }
        // Struct/class bodies are opaque to this pass: their member functions
        // are not symbol-checked (the reference checker walks free functions
        // only).
        if (n.kind == ND_STRUCT_DEF || n.kind == ND_CLASS_DEF) { return; }
        for (int i = 0; i < n.childCount(); i++) {
            this.walkCallDiagnostics(n.child(i));
        }
    }

    // SYNTAX_EXCEPTIONS.md — undefined plain calls emit `unknown method`,
    // with a did-you-mean suggestion when the name resembles a known one.
    // Uppercase-led names follow the native/Win32 export convention and stay
    // unchecked, as do compiler-intrinsic `makeXxx` value factories.
    private void checkPlainCallTarget(Node call) {
        string name = call.name;
        if (name.length == 0) { return; }
        if (!this.identStartsLower(name)) { return; }
        if (name.startsWith("make") && name.length > 4 && name[4] >= 'A' && name[4] <= 'Z') { return; }
        if (this.isKnownCallableName(name)) { return; }
        string sugg = diagClosestMatch(name, this.callableCandidates());
        if (sugg.length > 0) {
            this.recordError("did you mean \"" + sugg + "\"?, at line " + call.line.toString() + ", column " + call.col.toString());
        } else {
            this.recordError("unknown method \"" + name + "\", at line " + call.line.toString() + ", column " + call.col.toString());
        }
    }

    private bool isAllCapsName(string name) {
        if (name.length == 0) { return false; }
        bool allCaps = true;
        for (int c = 0; c < name.length; c++) {
            char ch = name[c];
            if (!((ch >= 'A' && ch <= 'Z') || ch == '_')) { allCaps = false; }
        }
        return allCaps;
    }

    private bool isKnownCallableName(string name) {
        for (int i = 0; i < this.sigNames.length; i++) {
            if (this.strEq(this.sigNames[i], name)) { return true; }
        }
        if (this.isDeclaredTypeName(name)) { return true; }
        if (this.knownIdentName(name)) { return true; }
        if (this.builtinCallableName(name)) { return true; }
        if (this.win32Resolvable(name)) { return true; }
        if (this.isAllCapsName(name)) { return true; }
        if (name.length > 2 && name[0] == '_' && name[1] == '_') { return true; }
        return false;
    }

    // Names the evaluator always resolves: builtins, native module
    // singletons, and tray/registry bridges.
    private bool builtinCallableName(string name) {
        if (this.strEq(name, "print") || this.strEq(name, "printline")
            || this.strEq(name, "eprint") || this.strEq(name, "eprintln")
            || this.strEq(name, "input") || this.strEq(name, "exit")
            || this.strEq(name, "end") || this.strEq(name, "sleep")
            || this.strEq(name, "assert") || this.strEq(name, "now")
            || this.strEq(name, "int") || this.strEq(name, "float")
            || this.strEq(name, "double") || this.strEq(name, "char")
            || this.strEq(name, "byte") || this.strEq(name, "string")
            || this.strEq(name, "bool") || this.strEq(name, "void")
            || this.strEq(name, "main") || this.strEq(name, "super")
            || this.strEq(name, "strlen") || this.strEq(name, "string_cast")
            || this.strEq(name, "readFile") || this.strEq(name, "readString")
            || this.strEq(name, "writeFile") || this.strEq(name, "writeString")
            || this.strEq(name, "writeBytes") || this.strEq(name, "exists")
            || this.strEq(name, "delete") || this.strEq(name, "deleteFile")
            || this.strEq(name, "rename") || this.strEq(name, "mkdir")
            || this.strEq(name, "toString") || this.strEq(name, "toInt")
            || this.strEq(name, "toUpper") || this.strEq(name, "toLower")
            || this.strEq(name, "nativeToastShow")
            // Native module singletons usable in expression position.
            || this.strEq(name, "fs") || this.strEq(name, "file")
            || this.strEq(name, "folder") || this.strEq(name, "url")
            || this.strEq(name, "hash") || this.strEq(name, "path")
            || this.strEq(name, "bom") || this.strEq(name, "console")
            || this.strEq(name, "math") || this.strEq(name, "llmai")
            || this.strEq(name, "LLMAI") || this.strEq(name, "keyboard")
            || this.strEq(name, "mouse") || this.strEq(name, "time")
            || this.strEq(name, "env") || this.strEq(name, "process")
            || this.strEq(name, "Process") || this.strEq(name, "notifications")
            || this.strEq(name, "json") || this.strEq(name, "yaml")
            // Tray and registry bridges registered by the evaluator.
            || this.strEq(name, "trayAdd") || this.strEq(name, "traySetTooltip")
            || this.strEq(name, "trayDelete") || this.strEq(name, "trayRemove")
            || this.strEq(name, "traySetMenu") || this.strEq(name, "trayRunLoop")
            || this.strEq(name, "trayPollMenu") || this.strEq(name, "trayPollClick")
            || this.strEq(name, "regOpen") || this.strEq(name, "regCreate")
            || this.strEq(name, "regClose") || this.strEq(name, "regSubKey")
            || this.strEq(name, "regGetString") || this.strEq(name, "regSetString")
            || this.strEq(name, "regGetInt") || this.strEq(name, "regSetInt")
            || this.strEq(name, "regGetInt64") || this.strEq(name, "regSetInt64")
            || this.strEq(name, "regDeleteValue") || this.strEq(name, "regDeleteKey")
            || this.strEq(name, "regValueExists") || this.strEq(name, "regEnumSubKeyName")
            || this.strEq(name, "regEnumValueName") || this.strEq(name, "regSubKeyCount")
            || this.strEq(name, "regValueCount")) { return true; }
        return false;
    }

    private string[] callableCandidates() {
        string[] cands = [];
        for (int i = 0; i < this.sigNames.length; i++) { cands.add(this.sigNames[i]); }
        cands.add("print"); cands.add("printline"); cands.add("eprint"); cands.add("eprintln"); cands.add("exit");
        cands.add("input"); cands.add("sleep"); cands.add("assert");
        cands.add("int"); cands.add("float"); cands.add("double");
        cands.add("char"); cands.add("byte"); cands.add("string_cast");
        cands.add("now"); cands.add("cargs");
        cands.add("getCommandLine");
        cands.add("readFile"); cands.add("readString");
        cands.add("writeBytes"); cands.add("writeString");
        cands.add("writeFile"); cands.add("strlen");
        cands.add("exists"); cands.add("delete");
        cands.add("deleteFile");
        cands.add("toString"); cands.add("toInt");
        cands.add("toUpper"); cands.add("toLower");
        return cands;
    }

    // DOCS/213 -- remember import grants for the unknown-method walk.
    private void recordWin32ImportGrant(string src, bool all, string[] names) {
        if (this.strEq(src, "win32")) {
            if (all || names.length == 0) { this.win32AllModules = true; return; }
            for (int j = 0; j < names.length; j++) {
                this.win32OpenModules.add(names[j]);
            }
            return;
        }
        if (src.length > 6 && this.strEq(src.substr(0, 6), "win32.")) {
            string module = src.substr(6);
            if (all || names.length == 0) {
                this.win32OpenModules.add(module);
                return;
            }
            for (int j2 = 0; j2 < names.length; j2++) {
                this.win32GrantNames.add(names[j2]);
            }
        }
    }

    private string win32ModuleNameDll(string module) {
        if (this.strEq(module, "kernel32")) { return "kernel32.dll"; }
        if (this.strEq(module, "ws2_32")) { return "ws2_32.dll"; }
        if (this.strEq(module, "winhttp")) { return "winhttp.dll"; }
        if (this.strEq(module, "wininet")) { return "wininet.dll"; }
        if (this.strEq(module, "shell32")) { return "shell32.dll"; }
        if (this.strEq(module, "msvcrt")) { return "msvcrt.dll"; }
        if (this.strEq(module, "user32")) { return "user32.dll"; }
        if (this.strEq(module, "registry") || this.strEq(module, "advapi32")) { return "advapi32.dll"; }
        if (this.strEq(module, "version")) { return "version.dll"; }
        return "";
    }

    // The raw Win32 exports the interpreter can execute, mapped to their
    // owning DLL (mirrors Evaluator.win32DllForFn).
    private string win32DllForFn(string fn) {
        if (this.strEq(fn, "keybd_event") || this.strEq(fn, "mouse_event")
            || this.strEq(fn, "VkKeyScanA") || this.strEq(fn, "GetKeyState")
            || this.strEq(fn, "GetAsyncKeyState") || this.strEq(fn, "MapVirtualKeyA")
            || this.strEq(fn, "GetCursorPos") || this.strEq(fn, "SetCursorPos")
            || this.strEq(fn, "SendInput") || this.strEq(fn, "SetCursor")
            || this.strEq(fn, "ClipCursor") || this.strEq(fn, "GetClipCursor")
            || this.strEq(fn, "GetDoubleClickTime") || this.strEq(fn, "SetDoubleClickTime")
            || this.strEq(fn, "RegisterHotKey") || this.strEq(fn, "UnregisterHotKey")
            || this.strEq(fn, "MessageBeep") || this.strEq(fn, "RegisterRawInputDevices")
            || this.strEq(fn, "GetRawInputData") || this.strEq(fn, "GetRawInputDeviceList")
            || this.strEq(fn, "GetForegroundWindow") || this.strEq(fn, "GetWindowTextA")
            || this.strEq(fn, "GetWindowThreadProcessId") || this.strEq(fn, "RegisterClassExA")
            || this.strEq(fn, "CreateWindowExA") || this.strEq(fn, "ShowWindow")
            || this.strEq(fn, "UpdateWindow") || this.strEq(fn, "SetWindowTextA")
            || this.strEq(fn, "DestroyWindow") || this.strEq(fn, "GetSystemMetrics")
            || this.strEq(fn, "LoadImageA") || this.strEq(fn, "SendMessageA")) { return "user32.dll"; }
        if (this.strEq(fn, "OpenProcess") || this.strEq(fn, "QueryFullProcessImageNameA")
            || this.strEq(fn, "CloseHandle") || this.strEq(fn, "GetModuleHandleA")) { return "kernel32.dll"; }
        return "";
    }

    private bool win32Resolvable(string name) {
        if (this.win32AllModules) { return true; }
        for (int g = 0; g < this.win32GrantNames.length; g++) {
            if (this.strEq(this.win32GrantNames[g], name)) { return true; }
        }
        string fnDll = this.win32DllForFn(name);
        if (fnDll.length > 0) {
            for (int m = 0; m < this.win32OpenModules.length; m++) {
                if (this.strEq(this.win32ModuleNameDll(this.win32OpenModules[m]), fnDll)) { return true; }
            }
        }
        return false;
    }

    // Filesystem entry points whose first argument must be a file path
    // (VALUE_EXCEPTION.md).
    private bool isPathFirstArgMethod(string m) {
        if (this.strEq(m, "readString") || this.strEq(m, "readFile")) { return true; }
        if (this.strEq(m, "readBytes") || this.strEq(m, "writeString")) { return true; }
        if (this.strEq(m, "writeFile") || this.strEq(m, "writeBytes")) { return true; }
        if (this.strEq(m, "exists") || this.strEq(m, "delete")) { return true; }
        if (this.strEq(m, "deleteFile") || this.strEq(m, "rename")) { return true; }
        if (this.strEq(m, "copy") || this.strEq(m, "mkdir")) { return true; }
        if (this.strEq(m, "createDirectory") || this.strEq(m, "createDir")) { return true; }
        if (this.strEq(m, "directoryExists") || this.strEq(m, "folderExists")) { return true; }
        if (this.strEq(m, "isFile") || this.strEq(m, "isDirectory")) { return true; }
        if (this.strEq(m, "size") || this.strEq(m, "listFiles")) { return true; }
        return false;
    }

    private void checkFreePathValueException(Node call) {
        if (!this.isPathFirstArgMethod(call.name)) { return; }
        this.checkPathLiteralArg(call, 0);
        // rename(src, dst) / copy(src, dst): both arguments are paths.
        if (this.strEq(call.name, "rename") || this.strEq(call.name, "copy")) {
            this.checkPathLiteralArg(call, 1);
        }
    }

    private void checkMemberPathValueException(Node call) {
        if (call.childCount() < 1) { return; }
        Node recv = call.child(0);
        if (recv.kind != ND_IDENT) { return; }
        if (!this.strEq(recv.name, "fs") && !this.strEq(recv.name, "file")
            && !this.strEq(recv.name, "folder")) { return; }
        if (!this.isPathFirstArgMethod(call.name)) { return; }
        // Children are [receiver, arg0, arg1, ...].
        this.checkPathLiteralArg(call, 1);
        if (this.strEq(call.name, "rename") || this.strEq(call.name, "copy")) {
            this.checkPathLiteralArg(call, 2);
        }
    }

    private void checkPathLiteralArg(Node call, int idx) {
        if (idx < 0 || idx >= call.childCount()) { return; }
        Node arg = call.child(idx);
        if (arg.kind != ND_STRING_LIT) { return; }
        if (this.looksLikeUrl(arg.strVal)) {
            this.recordError("expected a string of a file path at line " + arg.line.toString() + ", column " + arg.col.toString() + ", got a url");
            return;
        }
        if (this.isInvalidPathLiteral(arg.strVal)) {
            this.recordError("expected a valid file path at line " + arg.line.toString() + ", column " + arg.col.toString() + ", got an invalid path");
        }
    }

    private bool looksLikeUrl(string s) {
        string lo = diagToLower(s);
        if (lo.startsWith("http://") || lo.startsWith("https://")) { return true; }
        if (lo.startsWith("http:") || lo.startsWith("https:")) { return true; }
        if (lo.startsWith("ftp://") || lo.startsWith("ftps://")) { return true; }
        if (lo.startsWith("file://")) { return true; }
        if (lo.startsWith("www.")) { return true; }
        return false;
    }

    // A literal is an unusable local path when it is empty, carries
    // characters Windows forbids in paths, or sits on a drive that does not
    // exist. Drive validity is probed with folder.exists on the bare root:
    // the folder listing builtin fails gracefully on nonexistent drives
    // where the file attribute builtins crash.
    // A literal is an unusable local path when it is empty or carries
    // characters Windows forbids in paths. Drive existence cannot be probed
    // safely at parse time (the fs builtins are only stable once the
    // evaluator is running), so dead-drive detection happens at runtime in
    // the filesystem dispatch instead.
    private bool isInvalidPathLiteral(string s) {
        if (s.length == 0) { return true; }
        for (int i = 0; i < s.length; i++) {
            char c = s[i];
            if (c == '<' || c == '>' || c == '"' || c == '|' || c == '?' || c == '*') { return true; }
            if (c < 32) { return true; }
        }
        return false;
    }

    // `print"hello world");` — an identifier immediately followed by a string
    // literal: the open parenthesis of the call is missing and is reported at
    // the string literal's position.
    private Node parseCallMissingOpenParen() {
        Token nameTok = this.advance();
        Token strTok = this.peek();
        string lit = "";
        if (strTok.kind == TK_STRING_LIT) { lit = strTok.strVal; }
        this.advance();
        if (this.check(TK_RPAREN)) { this.advance(); }
        this.recordError("Missing open parenthesis at line " + strTok.line.toString() + ", column " + strTok.col.toString());
        this.expectSemi();
        Node call = new Node(ND_CALL, 0, 0);
        call.name = nameTok.text;
        Node strNode = new Node(ND_STRING_LIT, strTok.line, strTok.col);
        strNode.strVal = lit;
        call.addChild(strNode);
        Node stmt = new Node(ND_EXPR_STMT, nameTok.line, nameTok.col);
        stmt.addChild(call);
        return stmt;
    }
}

// ---- Suggestion helpers (SYNTAX_EXCEPTIONS.md did-you-mean) ---------------

string diagToLower(string word) {
    string lo = "";
    for (int i = 0; i < word.length; i++) {
        char c = word[i];
        if (c >= 'A' && c <= 'Z') { c = c + 32; }
        lo = lo + c.toString();
    }
    return lo;
}

int diagLevenshtein(string a, string b) {
    int alen = a.length;
    int blen = b.length;
    if (alen == 0) { return blen; }
    if (blen == 0) { return alen; }
    int[] prev = [];
    int[] cur = [];
    for (int j = 0; j <= blen; j++) { prev.add(j); cur.add(0); }
    for (int i = 1; i <= alen; i++) {
        cur[0] = i;
        for (int j = 1; j <= blen; j++) {
            int cost = 1;
            if (a[i - 1] == b[j - 1]) { cost = 0; }
            int del = prev[j] + 1;
            int ins = cur[j - 1] + 1;
            int sub = prev[j - 1] + cost;
            int best = del;
            if (ins < best) { best = ins; }
            if (sub < best) { best = sub; }
            cur[j] = best;
        }
        for (int k = 0; k <= blen; k++) { prev[k] = cur[k]; }
    }
    return prev[blen];
}

// Smallest-edit-distance suggestion lookup (Levenshtein). A candidate
// qualifies when it differs by one edit, or by two edits with the same first
// two letters (a real typo shape, not merely similar junk).
string diagClosestMatch(string needle, string[] candidates) {
    string needleLc = diagToLower(needle);
    if (needleLc.length == 0) { return ""; }
    string best = "";
    int bestDist = 0;
    for (int i = 0; i < candidates.length; i++) {
        string candLc = diagToLower(candidates[i]);
        if (candLc.length == 0) { continue; }
        int d = diagLevenshtein(needleLc, candLc);
        bool acceptable = false;
        if (d == 1) { acceptable = true; }
        elif (d == 2 && needleLc.length >= 3) {
            if (needleLc[0] == candLc[0] && needleLc[1] == candLc[1]) { acceptable = true; }
        }
        if (acceptable) {
            if (best.length == 0 || d < bestDist) {
                best = candidates[i];
                bestDist = d;
            }
        }
    }
    return best;
}
